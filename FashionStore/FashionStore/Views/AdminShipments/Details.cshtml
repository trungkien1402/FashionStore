@model FashionStore.Models.Entities.Shipment
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Chi tiết lượt giao hàng";
    var activeShippers = ViewBag.Shippers as List<ApplicationUser> ?? new List<ApplicationUser>();

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };

    string GetStatusBadgeClass(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "bg-secondary",
        ShipmentStatus.PickedUp => "bg-info text-dark",
        ShipmentStatus.InTransit => "bg-primary",
        ShipmentStatus.Delivered => "bg-success",
        ShipmentStatus.Failed => "bg-danger",
        ShipmentStatus.Returned => "bg-dark",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase">Vận chuyển</div>
            <h2 class="fw-bold mb-0">Mã vận đơn: @Model.TrackingCode</h2>
            <p class="text-muted mb-0">
                Đơn hàng liên kết:
                <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold text-decoration-none">
                    @Model.Order?.OrderCode
                </a>
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách vận đơn
            </a>
            <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-dark">
                <i class="bi bi-receipt me-1"></i> Xem đơn hàng
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- THÔNG TIN VẬN ĐƠN & GIAO HÀNG -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-truck me-2"></i>Thông tin vận chuyển
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted">Mã vận đơn</small>
                            <div class="fw-bold fs-5 text-primary">@Model.TrackingCode</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Trạng thái hiện tại</small>
                            <div>
                                <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">
                                    @GetShipmentStatusName(Model.Status)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Shipper phụ trách</small>
                            <div class="fw-semibold">@(Model.Shipper?.FullName ?? "Chưa rõ")</div>
                            <small class="text-muted">SĐT: @(Model.Shipper?.PhoneNumber ?? "Chưa cập nhật")</small>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Tiền COD cần thu</small>
                            <div class="fw-bold fs-5 text-danger">
                                @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " đ" : "0 đ (Đã thanh toán)")
                            </div>
                        </div>

                        <div class="col-12">
                            <small class="text-muted">Ghi chú giao hàng ban đầu</small>
                            <div class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- THÔNG TIN NGƯỜI NHẬN & ĐỊA CHỈ -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-geo-alt me-2"></i>Địa chỉ & Người nhận
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <strong>Họ tên:</strong> @Model.Order?.ReceiverName
                    </div>
                    <div class="mb-2">
                        <strong>Số điện thoại:</strong> @Model.Order?.Phone
                    </div>
                    <div class="mb-0">
                        <strong>Địa chỉ giao:</strong> @Model.Order?.Address
                    </div>
                </div>
            </div>

            <!-- SẢN PHẨM TRONG ĐƠN -->
            @if (Model.Order?.Items != null && Model.Order.Items.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-box-seam me-2"></i>Kiện hàng (@Model.Order.Items.Count sản phẩm)
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th>Số lượng</th>
                                    <th class="text-end pe-3">Đơn giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order.Items)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@item.ProductName</td>
                                        <td>Size @item.Size - @item.Color</td>
                                        <td>x @item.Quantity</td>
                                        <td class="text-end pe-3">@item.UnitPrice.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- LỊCH SỬ TIẾN TRÌNH GIAO HÀNG -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history me-2"></i>Nhật ký vận chuyển
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Histories != null && Model.Histories.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var h in Model.Histories)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge @GetStatusBadgeClass(h.NewStatus)">
                                            @GetShipmentStatusName(h.NewStatus)
                                        </span>
                                        <small class="text-muted">
                                            @h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div class="text-muted small">
                                        Người thực hiện: <strong>@(h.ChangedByUser?.FullName ?? "Hệ thống")</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Note))
                                    {
                                        <div class="mt-1 small bg-light p-2 rounded">
                                            @h.Note
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có nhật ký vận chuyển.</p>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: ĐIỀU PHỐI LẠI SHIPPER -->
        <div class="col-lg-4">
            @if (Model.Status != ShipmentStatus.Delivered && Model.Status != ShipmentStatus.Returned)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-arrow-repeat me-2"></i>Điều phối lại Shipper
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Reassign" method="post"
                              onsubmit="return confirm('Bạn có chắc muốn chuyển giao đơn này cho shipper khác?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Chọn Shipper mới</label>
                                <select name="newShipperId" class="form-select" required>
                                    <option value="">-- Chọn shipper --</option>
                                    @foreach (var s in activeShippers)
                                    {
                                        if (s.Id != Model.ShipperId)
                                        {
                                            <option value="@s.Id">@s.FullName (@(s.PhoneNumber ?? s.UserName))</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do điều phối lại</label>
                                <textarea name="note" class="form-control" rows="2"
                                          placeholder="VD: Shipper cũ bận, đổi tuyến giao..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-outline-dark w-100">
                                <i class="bi bi-person-check me-1"></i> Lưu thay đổi shipper
                            </button>
                        </form>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle me-2"></i>Tóm tắt tiền
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền đơn hàng:</span>
                        <span class="fw-bold">@Model.Order?.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phương thức TT:</span>
                        <span>@Model.Order?.PaymentMethod</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Trạng thái TT:</span>
                        <span>@Model.Order?.PaymentStatus</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Tiền COD thu:</span>
                        <span class="fs-5 fw-bold text-danger">
                            @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " đ" : "0 đ")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
