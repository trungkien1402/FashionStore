@model FashionStore.Models.Entities.Shipment
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Vận đơn " + Model.TrackingCode;
    var activeShippers = ViewBag.Shippers as List<ApplicationUser> ?? new List<ApplicationUser>();

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };
}

<!-- EXECUTIVE HEADER (ATELIER STANDARD) -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN CHUYỂN</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">Vận đơn #@Model.TrackingCode</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="adm-title-main font-monospace">@Model.TrackingCode</h1>
                <button type="button" class="btn btn-sm adm-btn-outline p-1 px-2" onclick="copyAdmText(this, '@Model.TrackingCode')" title="Sao chép mã vận đơn">
                    <i class="bi bi-copy"></i>
                </button>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> <span>Quay lại điều phối</span>
            </a>
            <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-receipt"></i> <span>Xem đơn #@Model.Order?.OrderCode</span>
            </a>
            <button type="button" onclick="window.print()" class="adm-action-btn adm-btn-primary">
                <i class="bi bi-printer"></i> <span>In vận đơn</span>
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN: SHIPMENT DETAILS, TIMELINE & PACKAGE -->
    <div class="col-lg-8">
        <!-- SHIPMENT SPECS CARD -->
        <div class="adm-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-truck fs-5" style="color: var(--adm-gold, #D97706);"></i>
                    <h5 class="fw-bold mb-0 adm-heading">Thông tin Giao nhận</h5>
                </div>
                <div>
                    @switch (Model.Status)
                    {
                        case ShipmentStatus.Assigned:
                            <span class="adm-pill adm-pill-faint">Đã phân công</span>
                            break;
                        case ShipmentStatus.PickedUp:
                        case ShipmentStatus.InTransit:
                            <span class="adm-pill adm-pill-blue">Đang giao hàng</span>
                            break;
                        case ShipmentStatus.Delivered:
                            <span class="adm-pill adm-pill-emerald">Giao thành công</span>
                            break;
                        case ShipmentStatus.Failed:
                        case ShipmentStatus.Returned:
                            <span class="adm-pill adm-pill-rose">Thất bại / Hoàn</span>
                            break;
                        default:
                            <span class="adm-pill adm-pill-faint">@Model.Status</span>
                            break;
                    }
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0);">
                        <div class="text-muted small">Shipper phụ trách</div>
                        <div class="fw-bold adm-heading fs-5 mt-1">@(Model.Shipper?.FullName ?? "Chưa rõ")</div>
                        <div class="text-muted font-monospace small mt-1">
                            <i class="bi bi-telephone me-1"></i>@(Model.Shipper?.PhoneNumber ?? "Chưa cập nhật")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0);">
                        <div class="text-muted small">Tiền COD Shipper cần thu</div>
                        <div class="fs-4 fw-bold mt-1 @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                            @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫ (Đã thanh toán trước)")
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem;">Phải đối soát & nộp quỹ sau ca giao</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0); font-size: 0.85rem;">
                            <span class="text-muted fw-semibold">Ghi chú giao nhận ban đầu:</span>
                            <div class="adm-heading fw-medium mt-1">@Model.Note</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ITEMS IN PACKAGE (WITH REAL PRODUCT THUMBNAILS & DETAILS) -->
        @if (Model.Order?.Items != null && Model.Order.Items.Any())
        {
            <div class="adm-card mb-4 p-0 overflow-hidden">
                <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam fs-5" style="color: var(--adm-gold, #D97706);"></i>
                        <h5 class="fw-bold mb-0 adm-heading">Kiện hàng (@Model.Order.Items.Count sản phẩm)</h5>
                    </div>
                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #E2E8F0); font-size: 0.78rem; font-weight: 600;">
                        TỔNG SỐ LƯỢNG: @Model.Order.Items.Sum(i => i.Quantity) món
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="adm-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">SẢN PHẨM</th>
                                <th>PHÂN LOẠI</th>
                                <th class="text-center">SỐ LƯỢNG</th>
                                <th class="text-end">ĐƠN GIÁ</th>
                                <th class="text-end pe-4">THÀNH TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Order.Items)
                            {
                                var productImg = item.ProductVariant?.Product?.ImageUrl;
                                if (string.IsNullOrEmpty(productImg)) productImg = "/images/placeholder.svg";

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-2 overflow-hidden flex-shrink-0" style="width: 48px; height: 48px; background: #F8FAFC; border: 1px solid #E2E8F0;">
                                                <img src="@productImg" alt="@item.ProductName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/placeholder.svg'" />
                                            </div>
                                            <div>
                                                <div class="fw-bold adm-heading" style="font-size: 0.88rem;">@item.ProductName</div>
                                                <div class="text-muted font-monospace" style="font-size: 0.75rem;">SKU: @(item.ProductVariant?.SKU ?? "N/A")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="badge" style="background: var(--adm-surface-hover, #F1F5F9); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1); font-size: 0.75rem;">
                                                    Size @item.Size
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Color))
                                            {
                                                <span class="badge" style="background: var(--adm-surface-hover, #F1F5F9); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1); font-size: 0.75rem;">
                                                    @item.Color
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold adm-heading">x @item.Quantity</td>
                                    <td class="text-end font-monospace text-muted">@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-end pe-4 fw-bold font-monospace adm-heading">@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- SHIPMENT HISTORY TIMELINE -->
        <div class="adm-card mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-clock-history fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Nhật ký Hành trình Vận chuyển</h5>
            </div>

            @{
                var historyList = Model.Histories?.OrderBy(h => h.CreatedAt).ToList() ?? new List<FashionStore.Models.Entities.ShipmentHistory>();
            }

            @if (historyList.Any())
            {
                <div class="adm-timeline">
                    @for (int i = 0; i < historyList.Count; i++)
                    {
                        var h = historyList[i];
                        var isLatest = i == historyList.Count - 1;

                        <div class="adm-timeline-item">
                            <div class="adm-timeline-dot @(isLatest ? "active" : "")"></div>
                            <div class="adm-timeline-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold adm-heading small">@GetShipmentStatusName(h.NewStatus)</span>
                                    <span class="text-muted font-monospace" style="font-size: 0.72rem;">
                                        @h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="text-muted small">
                                    Ghi nhận bởi: <strong class="adm-text-contrast">@(h.ChangedByUser?.FullName ?? "Hệ thống")</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(h.Note))
                                {
                                    <div class="p-2 rounded mt-2" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0); font-size: 0.78rem;">
                                        @h.Note
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small py-3 text-center">
                    <i class="bi bi-info-circle me-1"></i> Chưa có nhật ký ghi nhận hành trình cho vận đơn này.
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: RECIPIENT & REASSIGN SHIPPER -->
    <div class="col-lg-4">
        <!-- RECIPIENT & ADDRESS -->
        <div class="adm-card mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-geo-alt fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Địa chỉ Giao Hàng</h5>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Người nhận:</div>
                <div class="fw-bold adm-heading fs-6 mt-0.5">@Model.Order?.ReceiverName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Số điện thoại:</div>
                <div class="font-monospace fw-semibold adm-heading mt-0.5">
                    <a href="tel:@Model.Order?.Phone" class="text-decoration-none" style="color: inherit;">
                        <i class="bi bi-telephone-outbound me-1 text-primary"></i>@Model.Order?.Phone
                    </a>
                </div>
            </div>

            <div class="mb-0">
                <div class="text-muted small">Địa chỉ điểm đến:</div>
                <div class="adm-text-contrast small mt-0.5 p-2 rounded-2" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0);">
                    @Model.Order?.Address
                </div>
            </div>
        </div>

        <!-- REASSIGN SHIPPER FORM -->
        @if (Model.Status != ShipmentStatus.Delivered && Model.Status != ShipmentStatus.Returned)
        {
            <div class="adm-card mb-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                    <i class="bi bi-arrow-repeat fs-5" style="color: var(--adm-gold, #D97706);"></i>
                    <h5 class="fw-bold mb-0 adm-heading">Điều phối lại Shipper</h5>
                </div>

                <form asp-action="Reassign" method="post"
                      onsubmit="return confirm('Bạn có chắc muốn chuyển giao vận đơn này cho Shipper khác?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="adm-form-label">Chọn Shipper mới</label>
                        <select name="newShipperId" class="form-select adm-input-dark" required>
                            <option value="">-- Chọn nhân viên giao --</option>
                            @foreach (var s in activeShippers)
                            {
                                if (s.Id != Model.ShipperId)
                                {
                                    <option value="@s.Id">@s.FullName (@(s.PhoneNumber ?? s.UserName))</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="adm-form-label">Lý do điều phối lại</label>
                        <textarea name="note" class="form-control adm-input-dark" rows="2"
                                  placeholder="VD: Shipper cũ bận việc gấp, đổi khu vực tuyến đường..."></textarea>
                    </div>

                    <button type="submit" class="btn adm-btn-atelier w-100 py-2 justify-content-center">
                        <i class="bi bi-person-check me-1"></i> Lưu thay đổi Shipper
                    </button>
                </form>
            </div>
        }

        <!-- ORDER FINANCIAL SUMMARY -->
        <div class="adm-card">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-calculator fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Tài chính Vận đơn</h5>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Tổng giá trị đơn:</span>
                <span class="fw-bold font-monospace adm-heading">@Model.Order?.TotalAmount.ToString("N0") ₫</span>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Hình thức thanh toán:</span>
                <span class="adm-heading fw-medium">@Model.Order?.PaymentMethod</span>
            </div>

            <div class="d-flex justify-content-between mb-3 small">
                <span class="text-muted">Trạng thái thanh toán:</span>
                <span class="fw-semibold @(Model.Order?.PaymentStatus == PaymentStatus.Paid ? "text-success" : "text-warning")">
                    @Model.Order?.PaymentStatus
                </span>
            </div>

            <hr class="my-2" style="border-color: var(--adm-border, #E2E8F0);" />

            <div class="d-flex justify-content-between align-items-center pt-1">
                <span class="fw-bold adm-heading">TIỀN COD CẦN THU:</span>
                <span class="fs-5 fw-bold font-monospace @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                    @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫")
                </span>
            </div>
        </div>
    </div>
</div>
