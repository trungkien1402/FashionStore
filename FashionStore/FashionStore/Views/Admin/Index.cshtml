@model FashionStore.Models.ViewModels.AdminDashboardViewModel

@using System.Text.Json
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Dashboard";

    var maxQuantity = Model.TopSellingProducts.Any()
        ? Model.TopSellingProducts.Max(p => p.TotalQuantity)
        : 1;

    var revenueLabels = JsonSerializer.Serialize(Model.RevenueChartLabels);
    var revenueData = JsonSerializer.Serialize(Model.RevenueChartData);

    var statusLabels = JsonSerializer.Serialize(Model.OrderStatusLabels);
    var statusData = JsonSerializer.Serialize(Model.OrderStatusData);

    var paymentLabels = JsonSerializer.Serialize(Model.PaymentMethodLabels);
    var paymentData = JsonSerializer.Serialize(Model.PaymentMethodData);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">
            Tổng quan tình hình kinh doanh FashionStore.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Admin"
           asp-action="ExportReport"
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i>
            Xuất Excel
        </a>

        <button type="button" onclick="window.print()" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>
            In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc thời gian -->
<div class="admin-card mb-4">
    <form asp-controller="Admin" asp-action="Index" method="get"
          class="row g-3 align-items-end">

        <div class="col-md-4">
            <label class="form-label fw-semibold">Từ ngày</label>
            <input type="date"
                   name="startDate"
                   class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Đến ngày</label>
            <input type="date"
                   name="endDate"
                   class="form-control"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark">
                <i class="bi bi-funnel me-1"></i>
                Lọc dữ liệu
            </button>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Đặt lại
            </a>
        </div>
    </form>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small">Tổng sản phẩm</div>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalProducts</h3>
                </div>
                <div class="admin-stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <a asp-controller="AdminProducts"
               asp-action="Index"
               class="small text-decoration-none mt-3 d-inline-block">
                Quản lý sản phẩm →
            </a>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small">Tổng danh mục</div>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalCategories</h3>
                </div>
                <div class="admin-stat-icon bg-success-subtle text-success">
                    <i class="bi bi-tags"></i>
                </div>
            </div>
            <a asp-controller="AdminCategories"
               asp-action="Index"
               class="small text-decoration-none mt-3 d-inline-block">
                Quản lý danh mục →
            </a>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small">Tổng đơn hàng</div>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalOrders</h3>
                </div>
                <div class="admin-stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="small text-decoration-none mt-3 d-inline-block">
                Quản lý đơn hàng →
            </a>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small">Chờ xác nhận</div>
                    <h3 class="fw-bold mt-2 mb-0">@Model.PendingOrders</h3>
                </div>
                <div class="admin-stat-icon bg-danger-subtle text-danger">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="small text-decoration-none mt-3 d-inline-block">
                Kiểm tra đơn hàng →
            </a>
        </div>
    </div>

</div>

<!-- Doanh thu -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="text-muted small">Tổng doanh thu</div>
            <h4 class="fw-bold mt-2 mb-0">
                @Model.TotalRevenue.ToString("N0") đ
            </h4>
            <div class="text-muted small mt-2">Từ trước đến nay</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="text-muted small">Doanh thu hôm nay</div>
            <h4 class="fw-bold mt-2 mb-0">
                @Model.TodayRevenue.ToString("N0") đ
            </h4>
            <div class="text-muted small mt-2">Đơn đã giao thành công</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="text-muted small">Doanh thu tháng này</div>
            <h4 class="fw-bold mt-2 mb-0">
                @Model.MonthlyRevenue.ToString("N0") đ
            </h4>
            <div class="text-muted small mt-2">Đơn đã giao thành công</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="admin-card h-100">
            <div class="text-muted small">Doanh thu khoảng đã chọn</div>
            <h4 class="fw-bold mt-2 mb-0 text-success">
                @Model.RevenueInRange.ToString("N0") đ
            </h4>
            <div class="text-muted small mt-2">
                @Model.StartDate.ToString("dd/MM/yyyy")
                – @Model.EndDate.ToString("dd/MM/yyyy")
            </div>
        </div>
    </div>

</div>

<!-- Biểu đồ -->
<div class="row g-4 mb-4">

    <div class="col-xl-8">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-1">Biểu đồ doanh thu</h5>
            <p class="text-muted small mb-4">
                Doanh thu theo ngày trong khoảng thời gian đã chọn.
            </p>
            <div style="height:320px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-1">Trạng thái đơn hàng</h5>
            <p class="text-muted small mb-4">
                Phân loại đơn hàng theo trạng thái.
            </p>
            <div style="height:320px;">
                <canvas id="orderStatusChart"></canvas>
            </div>
        </div>
    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-xl-5">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-1">Phương thức thanh toán</h5>
            <p class="text-muted small mb-4">
                Số lượng đơn theo phương thức thanh toán.
            </p>
            <div style="height:280px;">
                <canvas id="paymentChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-3">Doanh thu theo danh mục</h5>

            @if (!Model.CategoryRevenues.Any())
            {
                <div class="text-center text-muted py-5">
                    Chưa có dữ liệu doanh thu theo danh mục.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>Danh mục</th>
                                <th class="text-end">Số lượng bán</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.CategoryRevenues)
                            {
                                <tr>
                                    <td class="fw-semibold">@category.CategoryName</td>
                                    <td class="text-end">@category.TotalQuantity</td>
                                    <td class="text-end fw-semibold">
                                        @category.TotalRevenue.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

<!-- Đơn hàng và top sản phẩm -->
<div class="row g-4 mb-4">

    <div class="col-xl-7">
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Đơn hàng mới nhất</h5>
                <a asp-controller="AdminOrders"
                   asp-action="Index"
                   class="small text-decoration-none">
                    Xem tất cả →
                </a>
            </div>

            <div class="table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Người nhận</th>
                            <th>Ngày đặt</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Chưa có đơn hàng nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-semibold">@order.OrderCode</td>
                                    <td>@order.ReceiverName</td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.PendingConfirmation:
                                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                                break;
                                            case OrderStatus.Confirmed:
                                                <span class="badge bg-info text-dark">Đã xác nhận</span>
                                                break;
                                            case OrderStatus.Processing:
                                                <span class="badge bg-primary">Đang xử lý</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="badge bg-info">Đang giao</span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span class="badge bg-success">Đã giao</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            case OrderStatus.DeliveryFailed:
                                                <span class="badge bg-danger">Giao thất bại</span>
                                                break;
                                            case OrderStatus.Returned:
                                                <span class="badge bg-secondary">Đã hoàn trả</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-4">Top 10 sản phẩm bán chạy</h5>

            @if (!Model.TopSellingProducts.Any())
            {
                <div class="text-center text-muted py-4">
                    Chưa có dữ liệu bán hàng.
                </div>
            }
            else
            {
                @for (int i = 0; i < Model.TopSellingProducts.Count; i++)
                {
                    var product = Model.TopSellingProducts[i];
                    var percentage = (double)product.TotalQuantity / maxQuantity * 100;

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2 gap-2">
                            <div class="fw-semibold">
                                @(i + 1). @product.ProductName
                            </div>
                            <div class="text-muted small text-nowrap">
                                @product.TotalQuantity sản phẩm
                            </div>
                        </div>

                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-dark"
                                 role="progressbar"
                                 style="width:@percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>

                        <div class="text-muted small mt-2">
                            Doanh thu: @product.TotalRevenue.ToString("N0") đ
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>

<!-- Cảnh báo tồn kho -->
<div class="admin-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                Cảnh báo sắp hết hàng
            </h5>
            <p class="text-muted small mb-0">
                Các biến thể có số lượng tồn kho không quá 5.
            </p>
        </div>
    </div>

    @if (!Model.LowStockProducts.Any())
    {
        <div class="text-center text-success py-4">
            <i class="bi bi-check-circle fs-3"></i>
            <div class="mt-2">Không có sản phẩm nào sắp hết hàng.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>SKU</th>
                        <th>Kích thước</th>
                        <th>Màu sắc</th>
                        <th class="text-end">Tồn kho</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LowStockProducts)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td>@item.SKU</td>
                            <td>@item.Size</td>
                            <td>@item.Color</td>
                            <td class="text-end">
                                <span class="badge bg-danger">
                                    @item.StockQuantity
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const revenueLabels = @Html.Raw(revenueLabels);
        const revenueData = @Html.Raw(revenueData);

        const statusLabels = @Html.Raw(statusLabels);
        const statusData = @Html.Raw(statusData);

        const paymentLabels = @Html.Raw(paymentLabels);
        const paymentData = @Html.Raw(paymentData);

        // Biểu đồ doanh thu
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: revenueData,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.12)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return Number(value).toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });

        // Biểu đồ trạng thái đơn hàng
        new Chart(document.getElementById('orderStatusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: [
                        '#f59e0b',
                        '#0ea5e9',
                        '#2563eb',
                        '#06b6d4',
                        '#16a34a',
                        '#dc2626',
                        '#f97316',
                        '#64748b'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Biểu đồ phương thức thanh toán
        new Chart(document.getElementById('paymentChart'), {
            type: 'pie',
            data: {
                labels: paymentLabels,
                datasets: [{
                    data: paymentData,
                    backgroundColor: ['#111827', '#2563eb'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}