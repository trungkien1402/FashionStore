@model List<FashionStore.Models.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var keyword = ViewBag.Keyword as string;
    bool? isActive = ViewBag.IsActive as bool?;
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase mb-2">Administration</div>
            <h1 style="font-family:'Playfair Display',serif;">Quản lý sản phẩm</h1>
            <p class="text-muted mb-0">Quản lý danh sách sản phẩm của cửa hàng.</p>
        </div>

        <a asp-action="Create" class="fs-btn fs-btn-dark">
            + Thêm sản phẩm
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@keyword"
                   class="form-control" placeholder="Tìm theo tên sản phẩm..." />
        </div>

        <div class="col-md-3">
            <select name="isActive" class="form-select">
                <option value="">Tất cả sản phẩm</option>
                <option value="true" selected="@(isActive == true)">Đang hiển thị</option>
                <option value="false" selected="@(isActive == false)">Đã ẩn</option>
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>

    <div class="border table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            Không tìm thấy sản phẩm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     style="width:65px;height:75px;object-fit:cover;"
                                     onerror="this.style.display='none'" />
                            </td>
                            <td>
                                <div class="fw-semibold">@product.Name</div>
                                <small class="text-muted">@product.Slug</small>
                            </td>
                            <td>@product.Category?.Name</td>
                            <td class="fw-semibold">@product.Price.ToString("N0") đ</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-dark">
                                    Sửa
                                </a>

                                <form asp-action="ToggleActive"
                                      asp-route-id="@product.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    @if (product.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Bạn có chắc muốn ẩn sản phẩm này?')">
                                            Ẩn
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Hiện
                                        </button>
                                    }
                                </form>
                                <a asp-controller="AdminProductVariants"
                                   asp-action="Index"
                                   asp-route-productId="@product.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-box-seam"></i>
                                    Biến thể
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="text-muted small mt-3">
        Tổng số: @Model.Count sản phẩm trong kết quả.
    </div>
</section>