@model FashionStore.Models.ViewModels.AdminUserResetPasswordViewModel

@{
    ViewData["Title"] = $"Đặt lại mật khẩu - {Model.FullName}";
}

<div class="container-fluid px-0">
    <div class="mb-3">
        <a asp-action="Details" asp-route-id="@Model.UserId" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết tài khoản
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-0">
                    <h4 class="fw-bold mb-0">Đặt lại mật khẩu người dùng</h4>
                    <p class="text-muted small mb-0">Thiết lập mật khẩu mới trực tiếp cho người dùng.</p>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-light border mb-4">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-person-circle fs-3 me-3 text-secondary"></i>
                            <div>
                                <div class="fw-bold">@Model.FullName</div>
                                <div class="small text-muted">@Model.Email</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự, gồm số và chữ hoa" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-warning small">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            Lưu ý: Sau khi đặt lại mật khẩu, tất cả các phiên đăng nhập hiện tại của người dùng này sẽ bị hủy bỏ ngay lập tức.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold">
                                <i class="bi bi-key-fill me-1"></i> Đặt lại mật khẩu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
