@model FashionStore.Models.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<header class="adm-dashboard-header mb-4">
    <div>
        <p class="adm-dashboard-kicker">&#9670; &nbsp; QUẢN TRỊ HỆ THỐNG</p>
        <h1>Quản lý tài khoản &amp; Phân quyền</h1>
        <p class="adm-dashboard-period">Tổng cộng: @Model.TotalCount tài khoản người dùng</p>
    </div>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FILTER BAR -->
<div class="adm-filter-bar mb-4">
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-4">
            <label class="d-none d-md-block text-muted small">Tìm kiếm</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tên, email hoặc số điện thoại..." />
            </div>
        </div>
        <div class="col-md-3">
            <label class="d-none d-md-block text-muted small">Vai trò</label>
            <select name="role" class="form-select">
                <option value="">Tất cả vai trò</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="d-none d-md-block text-muted small">Trạng thái</label>
            <select name="isActive" class="form-select">
                <option value="">Tất cả</option>
                <option value="true" selected="@(Model.IsActive == true)">Hoạt động</option>
                <option value="false" selected="@(Model.IsActive == false)">Đã khóa</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="d-none d-md-block text-muted small">Sắp xếp</label>
            <select name="sort" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Mới nhất</option>
                <option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option>
                <option value="name" selected="@(Model.Sort == "name")">Tên A-Z</option>
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn adm-btn-atelier w-100 justify-content-center">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </form>
</div>

<!-- USERS TABLE -->
<div class="adm-card p-0 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="adm-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">NGƯỜI DÙNG</th>
                    <th>SỐ ĐIỆN THOẠI</th>
                    <th>VAI TRÒ</th>
                    <th>ĐƠN HÀNG</th>
                    <th>TỔNG CHI TIÊU</th>
                    <th>NGÀY ĐĂNG KÝ</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end pe-4">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var isSelf = user.Id == currentUserId;
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: #1e293b; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem;">
                                    @(string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="fw-bold adm-heading">
                                        @user.FullName
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-primary bg-opacity-75 ms-1" style="font-size: 0.65rem;">Bạn</span>
                                        }
                                    </div>
                                    <div class="text-muted small">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                        <td>
                            @foreach (var r in user.Roles)
                            {
                                var badgeClass = r switch
                                {
                                    "Admin" => "badge bg-warning text-dark fw-bold",
                                    "Manager" => "badge bg-info text-dark",
                                    "Staff" => "badge bg-primary",
                                    "Shipper" => "badge bg-success",
                                    _ => "badge bg-secondary"
                                };
                                <span class="@badgeClass me-1">@r</span>
                            }
                        </td>
                        <td><span class="fw-bold font-monospace">@user.OrderCount</span> đơn</td>
                        <td><span class="fw-bold" style="color: var(--adm-gold);">@user.TotalSpent.ToString("N0") ₫</span></td>
                        <td><span class="text-muted small">@user.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="adm-pill adm-pill-emerald">Hoạt động</span>
                            }
                            else
                            {
                                <span class="adm-pill adm-pill-faint text-danger fw-bold">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm adm-btn-outline py-1 px-2" title="Xem chi tiết &amp; phân quyền">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (!isSelf)
                                {
                                    <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('@(user.IsActive ? "Khóa tài khoản " + user.FullName + "?" : "Mở khóa tài khoản " + user.FullName + "?")');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success") py-1 px-2"
                                                title="@(user.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            Không tìm thấy tài khoản nào khớp với điều kiện lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (Model.PageCount > 1)
{
    <nav aria-label="Page navigation" class="d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@p"
                       asp-route-search="@Model.Search"
                       asp-route-role="@Model.Role"
                       asp-route-isActive="@Model.IsActive"
                       asp-route-sort="@Model.Sort">@p</a>
                </li>
            }
        </ul>
    </nav>
}
