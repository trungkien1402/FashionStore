@model FashionStore.Models.ViewModels.AdminUserCreateViewModel

@{
    ViewData["Title"] = "Tạo tài khoản mới";
}

<div class="container-fluid px-0">
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-0">
                    <h4 class="fw-bold mb-0">Tạo tài khoản người dùng mới</h4>
                    <p class="text-muted small mb-0">Tạo tài khoản và phân quyền cho Quản lý, Nhân viên, Shipper hoặc Khách hàng.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                                <span asp-validation-for"FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email / Tên đăng nhập <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="admin@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label fw-semibold">Vai trò / Phân quyền <span class="text-danger">*</span></label>
                                <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select"></select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                                <div class="form-text small text-muted">
                                    Quyền hạn sẽ được áp dụng ngay sau khi tài khoản được tạo.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự, gồm chữ hoa, số" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked>
                                    <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                        Kích hoạt tài khoản ngay (Cho phép đăng nhập)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-dark px-4">
                                <i class="bi bi-check2-circle me-1"></i> Tạo tài khoản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
