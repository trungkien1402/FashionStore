@model FashionStore.Models.Entities.Shipment
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Chi tiết giao hàng #" + Model.TrackingCode;

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Mới phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };

    string GetStatusBadgeClass(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "bg-secondary",
        ShipmentStatus.PickedUp => "bg-info text-dark",
        ShipmentStatus.InTransit => "bg-primary",
        ShipmentStatus.Delivered => "bg-success",
        ShipmentStatus.Failed => "bg-danger",
        ShipmentStatus.Returned => "bg-dark",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase">Cổng thông tin Shipper</div>
            <h2 class="fw-bold mb-0">Mã vận đơn: @Model.TrackingCode</h2>
            <p class="text-muted mb-0">Mã đơn hàng: <strong>@Model.Order?.OrderCode</strong></p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN KHÁCH HÀNG & TIỀN THU -->
        <div class="col-lg-7">
            <!-- THẺ TIỀN COD PHẢI THU -->
            <div class="card border-0 shadow-sm mb-4 @(Model.CODAmount > 0 ? "border-start border-danger border-4" : "border-start border-success border-4")">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted text-uppercase fw-semibold">Số tiền cần thu của khách (COD)</small>
                            <h2 class="fw-bold mb-0 @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                                @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " đ" : "0 đ (Đã thanh toán trước)")
                            </h2>
                        </div>
                        <div class="text-end">
                            <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">
                                @GetShipmentStatusName(Model.Status)
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- THÔNG TIN NGƯỜI NHẬN -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person me-2"></i>Thông tin người nhận
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Họ tên người nhận</small>
                        <div class="fw-bold fs-5">@Model.Order?.ReceiverName</div>
                    </div>

                    <div class="mb-3 d-flex align-items-center gap-3">
                        <div>
                            <small class="text-muted">Số điện thoại</small>
                            <div class="fw-bold fs-5 text-dark">@Model.Order?.Phone</div>
                        </div>
                        <a href="tel:@Model.Order?.Phone" class="btn btn-success btn-sm px-3">
                            <i class="bi bi-telephone-fill me-1"></i> Gọi ngay
                        </a>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Địa chỉ giao hàng</small>
                        <div class="p-3 bg-light rounded mt-1 fw-semibold">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            @Model.Order?.Address
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div>
                            <small class="text-muted">Lưu ý của cửa hàng</small>
                            <div class="p-2 alert alert-warning mb-0">
                                <i class="bi bi-info-circle me-1"></i>@Model.Note
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- SẢN PHẨM CẦN GIAO -->
            @if (Model.Order?.Items != null)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-bag me-2"></i>Sản phẩm trong kiện
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th class="text-end pe-3">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order.Items)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@item.ProductName</td>
                                        <td>Size @item.Size - Màu @item.Color</td>
                                        <td class="text-end pe-3 fw-bold">x @item.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- CỘT PHẢI: HÀNH ĐỘNG CẬP NHẬT TRẠNG THÁI -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>Cập nhật tiến độ giao
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Trạng thái hiện tại:</small>
                        <div class="fw-bold fs-5 mt-1">@GetShipmentStatusName(Model.Status)</div>
                    </div>

                    @if (Model.Status == ShipmentStatus.Assigned)
                    {
                        <div class="alert alert-info small">
                            Đơn mới được phân công. Bạn vui lòng xác nhận khi đã lấy hàng từ kho/shop.
                        </div>

                        <form asp-action="UpdateStatus" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.PickedUp)" />
                            <button type="submit" class="btn btn-info w-100 py-2 fw-semibold">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Xác nhận đã lấy hàng
                            </button>
                        </form>
                    }
                    else if (Model.Status == ShipmentStatus.PickedUp)
                    {
                        <div class="alert alert-info small">
                            Đã lấy hàng. Bấm vào đây khi bạn bắt đầu di chuyển đi giao tới khách.
                        </div>

                        <form asp-action="UpdateStatus" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.InTransit)" />
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                <i class="bi bi-truck me-1"></i> Bắt đầu đi giao hàng
                            </button>
                        </form>
                    }
                    else if (Model.Status == ShipmentStatus.InTransit)
                    {
                        <div class="d-grid gap-2 mb-3">
                            <form asp-action="UpdateStatus" method="post"
                                  onsubmit="return confirm('Xác nhận khách đã nhận hàng và thu đủ tiền (nếu COD)?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Delivered)" />
                                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> GIAO THÀNH CÔNG @(Model.CODAmount > 0 ? "(& ĐÃ THU TIỀN)" : "")
                                </button>
                            </form>

                            <button type="button" class="btn btn-outline-danger w-100 py-2 fw-semibold"
                                    data-bs-toggle="collapse" data-bs-target="#failedForm">
                                <i class="bi bi-x-circle me-1"></i> Giao không thành công...
                            </button>
                        </div>

                        <!-- Form báo giao thất bại có lý do -->
                        <div class="collapse border p-3 rounded bg-light" id="failedForm">
                            <h6 class="fw-bold text-danger mb-2">Báo cáo giao không thành công</h6>
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Failed)" />

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Lý do thất bại <span class="text-danger">*</span></label>
                                    <textarea name="note" class="form-control" rows="3" required
                                              placeholder="VD: Gọi không nghe máy, khách hẹn ngày mai, địa chỉ sai..."></textarea>
                                </div>

                                <button type="submit" class="btn btn-danger w-100">
                                    Xác nhận giao thất bại
                                </button>
                            </form>
                        </div>
                    }
                    else if (Model.Status == ShipmentStatus.Failed)
                    {
                        <div class="alert alert-danger small mb-3">
                            Đơn hàng đang ở trạng thái giao thất bại. Bạn có thể hẹn giao lại hoặc mang trả về kho.
                        </div>

                        <div class="d-grid gap-2">
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.InTransit)" />
                                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Thử đi giao lại
                                </button>
                            </form>

                            <form asp-action="UpdateStatus" method="post"
                                  onsubmit="return confirm('Xác nhận đã mang hàng trả về lại kho FashionStore?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Returned)" />
                                <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">
                                    <i class="bi bi-arrow-return-left me-1"></i> Đã hoàn hàng về kho
                                </button>
                            </form>
                        </div>
                    }
                    else if (Model.Status == ShipmentStatus.Delivered)
                    {
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Đơn hàng đã được bạn giao thành công hoàn tất!
                        </div>
                    }
                    else if (Model.Status == ShipmentStatus.Returned)
                    {
                        <div class="alert alert-dark mb-0">
                            <i class="bi bi-archive-fill me-1"></i>
                            Đơn hàng đã được hoàn trả về kho và nhập lại tồn kho.
                        </div>
                    }
                </div>
            </div>

            <!-- LỊCH SỬ THAO TÁC -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">Lịch sử tiến trình</h6>
                </div>
                <div class="card-body">
                    @if (Model.Histories != null && Model.Histories.Any())
                    {
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var h in Model.Histories)
                            {
                                <li class="mb-3 border-bottom pb-2">
                                    <div class="d-flex justify-content-between">
                                        <span class="badge @GetStatusBadgeClass(h.NewStatus)">@GetShipmentStatusName(h.NewStatus)</span>
                                        <span class="text-muted">@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Note))
                                    {
                                        <div class="mt-1 text-muted">@h.Note</div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Chưa có lịch sử.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
