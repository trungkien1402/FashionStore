@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - Cổng Giao Vận HNMTSHOP</title>

    <!-- Google Fonts & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Dedicated Shipper Portal CSS -->
    <link rel="stylesheet" href="~/css/shipper-portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="shp-body">

    <!-- SHIPPER PORTAL TOPBAR -->
    <header class="shp-topbar sticky-top">
        <div class="container-xl">
            <div class="shp-topbar-inner">
                <!-- Left: Brand & Portal Badge -->
                <div class="shp-brand-wrap">
                    <a asp-controller="Shipper" asp-action="Index" class="shp-brand-link">
                        <div class="shp-brand-icon">
                            <i class="bi bi-truck-front-fill"></i>
                        </div>
                        <div class="shp-brand-text">
                            <span class="shp-brand-name">HNMTSHOP</span>
                            <span class="shp-brand-tag">EXPRESS LOGISTICS</span>
                        </div>
                    </a>
                </div>

                <!-- Center: Quick Nav -->
                <nav class="shp-nav d-none d-md-flex">
                    <a asp-controller="Shipper" asp-action="Index" 
                       class="shp-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-collection"></i> Tất cả đơn giao
                    </a>
                    <a asp-controller="Shipper" asp-action="Index" asp-route-status="3" 
                       class="shp-nav-item">
                        <i class="bi bi-send-fill text-primary"></i> Đang giao
                    </a>
                    <a asp-controller="Shipper" asp-action="Index" asp-route-status="4" 
                       class="shp-nav-item">
                        <i class="bi bi-check-circle-fill text-success"></i> Đã giao
                    </a>
                </nav>

                <!-- Right: Shipper Profile & Online Status -->
                <div class="shp-topbar-right">
                    <div class="shp-status-badge d-none d-sm-inline-flex">
                        <span class="shp-pulse-dot"></span>
                        <span>Trực tuyến</span>
                    </div>

                    <div class="dropdown">
                        <button class="shp-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="shp-avatar">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "S")
                            </span>
                            <div class="d-none d-lg-block text-start lh-1">
                                <div class="shp-user-name">@(User.Identity?.Name ?? "Nhân viên giao nhận")</div>
                                <span class="shp-user-role">Shipper ID: #@(User.FindFirstValue(ClaimTypes.NameIdentifier)?.Substring(0, Math.Min(6, User.FindFirstValue(ClaimTypes.NameIdentifier)?.Length ?? 0)))</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                            <li><h6 class="dropdown-header text-uppercase small fw-bold">Tài khoản Shipper</h6></li>
                            <li><span class="dropdown-item-text small text-muted">@User.Identity?.Name</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Shipper" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Đơn giao của tôi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-shop"></i> Xem trang chủ Store
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN SHIPPER CONTAINER -->
    <main class="shp-main-wrap">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="shp-footer">
        <div class="container-xl">
            <div class="shp-footer-inner">
                <div>
                    <strong>HNMTSHOP EXPRESS</strong> &copy; @DateTime.Now.Year &bull; Hệ thống quản lý giao nhận thời gian thực
                </div>
                <div>
                    Hotline Hỗ trợ Kho vận: <a href="tel:19008888" class="text-decoration-none fw-bold text-primary">1900 8888</a> (Phím 2)
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
