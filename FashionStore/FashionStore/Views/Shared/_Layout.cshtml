
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FashionStore</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/fashionstore.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Announcement -->
    <div class="fs-announcement">
        Free shipping for orders from 500.000 VND
    </div>

    <!-- Navbar -->
    <header class="fs-navbar">
        <div class="fs-navbar-inner">

            <!-- Logo -->
            <a asp-controller="Home"
               asp-action="Index"
               class="fs-logo">
                FASHION<span>STORE.</span>
            </a>

            <!-- Main navigation -->
            <ul class="fs-nav-links">

                <li>
                    <a asp-controller="Home"
                       asp-action="Index">
                        Trang chủ
                    </a>
                </li>

                <li>
                    <a asp-controller="Products"
                       asp-action="Index">
                        Sản phẩm
                    </a>
                </li>

                <!-- Chỉ khách hàng mới có giỏ hàng và đơn hàng cá nhân -->
                @if (User.Identity?.IsAuthenticated == true &&
                    !User.IsInRole("Admin") &&
                    !User.IsInRole("Manager") &&
                    !User.IsInRole("Staff") &&
                    !User.IsInRole("Shipper"))
                {
                    <li>
                        <a asp-controller="Cart"
                           asp-action="Index">
                            Giỏ hàng
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Orders"
                           asp-action="Index">
                            Đơn hàng
                        </a>
                    </li>
                }

                <li>
                    <a href="/Home/Index#about">
                        Về chúng tôi
                    </a>
                </li>

                <li>
                    <a href="/Home/Index#contact">
                        Liên hệ
                    </a>
                </li>

            </ul>

            <!-- User actions -->
            <div class="fs-nav-actions">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Profile" class="fs-user-name" title="Hồ sơ tài khoản">
                        Xin chào, @User.Identity.Name
                    </a>

                    <!-- Khu vực quản trị -->
                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Manager") ||
                         User.IsInRole("Staff"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           title="Trang quản trị">
                            Quản trị
                        </a>
                    }

                    <!-- Đăng xuất -->
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="m-0">

                        @Html.AntiForgeryToken()

                        <button type="submit">
                            Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }

            </div>
        </div>
    </header>

    <!-- Main content -->
    <main>

        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            </div>
        }

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="fs-footer" id="contact">

        <div class="fs-footer-inner">

            <div>
                <a asp-controller="Home"
                   asp-action="Index"
                   class="fs-logo">
                    FASHION<span>STORE.</span>
                </a>

                <p class="mt-3">
                    Khám phá phong cách của riêng bạn.
                    Thời trang tối giản, hiện đại và đầy cá tính.
                </p>
            </div>

            <div>
                <h6>Khám phá</h6>

                <div class="fs-footer-links">
                    <a asp-controller="Home"
                       asp-action="Index">
                        Trang chủ
                    </a>

                    <a asp-controller="Products"
                       asp-action="Index">
                        Sản phẩm
                    </a>

                    <a href="/Home/Index#about">
                        Về chúng tôi
                    </a>
                </div>
            </div>

            <div>
                <h6>Hỗ trợ khách hàng</h6>

                <div class="fs-footer-links">
                    <a href="/Home/Index#contact">
                        Liên hệ
                    </a>

                    <a href="#">
                        Chính sách giao hàng
                    </a>

                    <a href="#">
                        Chính sách đổi trả
                    </a>
                </div>
            </div>

        </div>

        <div class="fs-footer-bottom">
            © @DateTime.Now.Year FASHIONSTORE. ALL RIGHTS RESERVED.
        </div>

    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
