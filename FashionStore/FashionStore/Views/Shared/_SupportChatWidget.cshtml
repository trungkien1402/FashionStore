@inject FashionStore.Services.AdminPresenceService PresenceService
@{
    var customerChat = User.IsInRole("Customer");
    var isBackOffice = FashionStore.Services.AccessRoles.CanUseBackOffice(User);
    var isAdminOnline = PresenceService.IsAnyAdminOnline();
}
<div class="support-widget" data-support-chat data-thread="@Url.Action("Thread", "SupportChat")" data-admin-online-url="@Url.Action("AdminOnline", "SupportChat")" data-admin-presence-sse-url="@Url.Action("PresenceStream", "SupportChat")">
    <!-- MAIN SUPPORT PANEL -->
    <section class="support-panel" id="storeSupportPanel" aria-label="Trung tâm hỗ trợ khách hàng" hidden>
        <!-- HEADER -->
        <header class="support-chat-head">
            <div class="support-brand">
                <span class="support-avatar"><i class="bi bi-headset" aria-hidden="true"></i></span>
                <div>
                    <strong>Hỗ trợ khách hàng</strong>
                    <small data-admin-status>
                        <span class="admin-presence-dot @(isAdminOnline ? "is-online" : "")" data-admin-status-dot></span>
                        <span>HNMTSHOP · </span><span data-admin-status-text style="color: @(isAdminOnline ? "#22c55e" : "#94a3b8")">@(isAdminOnline ? "Đang hoạt động" : "Vắng mặt")</span>
                    </small>
                </div>
            </div>
            <button type="button" data-chat-hide aria-label="Thu gọn"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>

        <!-- QUICK HOTLINE / ZALO BAR -->
        <div class="support-quick-bar">
            <a href="tel:19008888" class="quick-item" title="Gọi tổng đài miễn phí">
                <i class="bi bi-telephone-fill text-success"></i> <span>1900 8888</span>
            </a>
            <span class="divider">|</span>
            <button type="button" class="quick-item quick-item-btn" title="Xem Zalo Minh Quân (0938 774 315)" data-open-zalo-modal>
                <i class="bi bi-chat-dots-fill text-primary"></i> <span>Zalo</span>
            </button>
            <span class="divider">|</span>
            <span class="quick-item text-muted" style="cursor: default;">
                <i class="bi bi-clock"></i> <span>8h - 22h</span>
            </span>
        </div>

        <!-- CHAT BODY -->
        <div class="support-chat-body">
            @if (User.IsInRole("Customer"))
            {
                <div class="support-welcome-note">
                    <p class="mb-2 text-muted small">Chào bạn! Bạn cần hỗ trợ thông tin gì?</p>
                    <div class="support-topics">
                        <button type="button" data-chat-topic="Mình cần tư vấn chọn size cho sản phẩm ">Tư vấn size</button>
                        <button type="button" data-chat-topic="Mình muốn hỏi về tình trạng đơn hàng mã ">Kiểm tra đơn</button>
                        <button type="button" data-chat-topic="Mình cần hỗ trợ chính sách đổi trả cho đơn ">Đổi trả hàng</button>
                    </div>
                </div>
                <partial name="_SupportChatMessages" />
                <form asp-controller="SupportChat" asp-action="Send" method="post" class="support-compose">
                    <label class="support-sr-only" for="supportMessage">Tin nhắn</label>
                    <textarea id="supportMessage" name="message" rows="1" maxlength="1000" required placeholder="Nhập câu hỏi cần hỗ trợ..."></textarea>
                    <button type="submit" aria-label="Gửi tin nhắn"><i class="bi bi-send-fill" aria-hidden="true"></i></button>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <div class="support-chat-guest">
                    <span class="support-welcome-icon"><i class="bi bi-chat-heart" aria-hidden="true"></i></span>
                    <h2>Cửa hàng sẵn sàng hỗ trợ</h2>
                    <p>Liên hệ hotline tổng đài hoặc đăng nhập tài khoản để chat trực tiếp cùng chuyên viên tư vấn.</p>
                    <div class="support-guest-actions">
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn-login-support">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập để nhắn tin
                        </a>
                    </div>
                </div>
            }
            else if (FashionStore.Services.AccessRoles.CanUseBackOffice(User))
            {
                <div class="support-chat-guest">
                    <span class="support-welcome-icon"><i class="bi bi-inbox" aria-hidden="true"></i></span>
                    <h2>Hộp thư hỗ trợ khách hàng</h2>
                    <p>Bạn đang đăng nhập bằng tài khoản quản trị/vận hành.</p>
                    <a asp-controller="SupportChat" asp-action="Inbox">
                        Mở Hộp thư hỗ trợ <i class="bi bi-arrow-up-right ms-1"></i>
                    </a>
                </div>
            }
            else
            {
                <div class="support-chat-guest"><a asp-controller="Home" asp-action="Contact">Liên hệ cửa hàng</a></div>
            }
        </div>

        <!-- FOOTNOTE -->
        <footer class="support-chat-footnote">
            <i class="bi bi-shield-check me-1" aria-hidden="true"></i> HNMTSHOP Hotline 1900 8888
        </footer>
    </section>

    <!-- ZALO PROFILE POPUP OVERLAY (EXACT ZALO.ME WEB PAGE STYLE - IMAGE 1) -->
    <div class="zalo-page-overlay" id="zaloModal" hidden>
        <div class="zalo-page-container">
            <!-- TOP BAR -->
            <header class="zalo-page-header">
                <div class="zalo-page-logo">
                    <span class="zalo-logo-text">Zalo</span>
                </div>
                <div class="zalo-page-header-actions">
                    <span class="zalo-lang-select">Ngôn ngữ: <strong>Tiếng Việt</strong> <i class="bi bi-chevron-down"></i></span>
                    <button type="button" class="zalo-modal-close-btn" id="closeZaloModal" aria-label="Đóng popup">&times;</button>
                </div>
            </header>

            <!-- MAIN BODY WITH CENTER CARD -->
            <div class="zalo-page-body">
                <div class="zalo-main-card">
                    <div class="zalo-card-left">
                        <div class="zalo-user-header">
                            <div class="zalo-user-avatar">
                                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="zalo-default-avatar-svg">
                                    <circle cx="20" cy="20" r="20" fill="#CFD8DC"/>
                                    <circle cx="20" cy="15" r="7" fill="#FFFFFF"/>
                                    <path d="M7 34C7 26.8203 12.8203 23 20 23C27.1797 23 33 26.8203 33 34" fill="#FFFFFF"/>
                                </svg>
                            </div>
                            <div class="zalo-user-info">
                                <h2 class="zalo-user-name">Minh Quân</h2>
                                <span class="zalo-user-sub">Liên hệ</span>
                            </div>
                        </div>

                        <div class="zalo-chat-action">
                            <a href="https://zalo.me/0938774315" target="_blank" rel="noopener noreferrer" class="zalo-btn-chat">
                                <i class="bi bi-chat-dots-fill me-1"></i>
                                <span>Nhắn tin</span>
                            </a>
                        </div>

                        <div class="zalo-detail-section">
                            <h3 class="zalo-section-title">Thông tin chi tiết</h3>
                            <ul class="zalo-info-list">
                                <li>
                                    <i class="bi bi-telephone"></i>
                                    <a href="tel:0938774315" class="zalo-link-phone">0938 774 315</a>
                                </li>
                                <li>
                                    <i class="bi bi-clock"></i>
                                    <span>Hoạt động: 8h - 22h (Hỗ trợ 24/7)</span>
                                </li>
                                <li>
                                    <i class="bi bi-globe"></i>
                                    <a href="/" target="_blank" class="zalo-link-web">https://fashionstore.vn</a>
                                </li>
                            </ul>
                            <p class="zalo-bio-text">
                                Mang tinh thần phục vụ tận tâm vào từng trải nghiệm mua sắm! Minh Quân luôn sẵn sàng tư vấn size, phối đồ và giải đáp mọi thông tin đơn hàng cho quý khách.
                            </p>
                        </div>
                    </div>

                    <div class="zalo-card-right">
                        <div class="zalo-qr-box">
                            <img src="~/images/zalo/zalo-qr-minhquan.png" asp-append-version="true" alt="Mã QR Zalo Minh Quân" class="zalo-qr-img" />
                        </div>
                        <p class="zalo-qr-instruction">Mở Zalo, bấm quét QR để quét và xem trên điện thoại</p>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <footer class="zalo-page-footer">
                © Copyright 2021 Zalo Group. All right Reserved.
            </footer>
        </div>
    </div>

    <!-- LAUNCHER BUTTON -->
    <button type="button" class="support-launcher" data-chat-toggle aria-expanded="false" aria-controls="storeSupportPanel">
        <i class="bi bi-chat-dots-fill"></i>
        <span>Hỗ trợ</span>
    </button>
</div>
