<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HNMTSHOP Admin</title>

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Atelier Admin Theme (Light & Dark Dual Mode) -->
    <link rel="stylesheet" href="~/css/admin-atelier.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <link rel="stylesheet" href="~/css/notification-bell.css" asp-append-version="true" />
        <script src="~/js/notification-bell.js" asp-append-version="true" defer></script>
    }
</head>

<body class="adm-body">

    <!-- SIDEBAR -->
    <aside class="adm-sidebar" id="admSidebar">
        <a asp-controller="Admin" asp-action="Index" class="adm-brand" aria-label="HNMTSHOP Atelier Backoffice">
            <div class="adm-brand-wrap">
                <div class="adm-brand-badge">
                    <i class="bi bi-gem"></i>
                </div>
                <div class="adm-brand-info">
                    <span class="adm-brand-name">HNMTSHOP</span>
                    <span class="adm-brand-subtitle">ATELIER BACKOFFICE</span>
                </div>
            </div>
            <!-- Backward compatibility hook -->
            <div class="adm-brand-signature d-none">HnmtShop</div>
        </a>

        <nav class="adm-nav" aria-label="Quản trị cửa hàng">
            <div class="adm-nav-label">Tổng quan</div>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <a asp-controller="Admin" asp-action="Index"
               class="adm-nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>

            <div class="adm-nav-label">Vận hành</div>

            <a asp-controller="AdminOrders" asp-action="Index"
               class="adm-nav-link @(currentController == "AdminOrders" ? "active" : "")">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Đơn hàng</span>
            </a>

            <a asp-controller="AdminProducts" asp-action="Index"
               class="adm-nav-link @(currentController == "AdminProducts" || currentController == "AdminProductVariants" ? "active" : "")">
                <i class="bi bi-box-seam"></i>
                <span>Sản phẩm</span>
            </a>

            <a asp-controller="AdminSupportRequests" asp-action="Index"
               class="adm-nav-link @(currentController == "AdminSupportRequests" ? "active" : "")">
                <i class="bi bi-envelope-paper" aria-hidden="true"></i><span>Yêu cầu hỗ trợ</span>
            </a>

            <a asp-controller="SupportChat" asp-action="Inbox"
               class="adm-nav-link @(currentController == "SupportChat" ? "active" : "")">
                <i class="bi bi-chat-dots" aria-hidden="true"></i><span>Chat hỗ trợ</span>
            </a>

            @if (FashionStore.Services.AccessRoles.CanManage(User))
            {
                <a asp-controller="AdminCategories" asp-action="Index"
                   class="adm-nav-link @(currentController == "AdminCategories" ? "active" : "")">
                    <i class="bi bi-tags"></i>
                    <span>Danh mục</span>
                </a>
            }

            <a asp-controller="AdminShipments" asp-action="Index"
               class="adm-nav-link @(currentController == "AdminShipments" ? "active" : "")">
                <i class="bi bi-truck"></i>
                <span>Vận chuyển</span>
            </a>

            @if (FashionStore.Services.AccessRoles.CanManage(User))
            {
                <div class="adm-nav-label">Kinh doanh</div>
                <a asp-controller="AdminOperations" asp-action="Alerts" class="adm-nav-link">
                    <i class="bi bi-bell"></i><span>Thông báo</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Reviews" class="adm-nav-link">
                    <i class="bi bi-chat-square-text"></i><span>Đánh giá</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Import" class="adm-nav-link">
                    <i class="bi bi-upload"></i><span>Nhập sản phẩm</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Inventory" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")">
                    <i class="bi bi-boxes"></i><span>Kho hàng</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Customers" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Customers" ? "active" : "")">
                    <i class="bi bi-people"></i><span>Khách hàng</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Returns" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Returns" ? "active" : "")">
                    <i class="bi bi-arrow-return-left"></i><span>Đổi trả</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Promotions" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Promotions" ? "active" : "")">
                    <i class="bi bi-ticket-perforated"></i><span>Khuyến mãi</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Analytics" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i><span>Phân tích</span>
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <div class="adm-nav-label">Quản trị</div>
                <a asp-controller="AdminUsers" asp-action="Index" class="adm-nav-link @(currentController == "AdminUsers" ? "active" : "")">
                    <i class="bi bi-person-badge"></i><span>Tài khoản &amp; Phân quyền</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Staff" class="adm-nav-link">
                    <i class="bi bi-person-gear"></i><span>Nhân viên</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Settings" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear"></i><span>Cài đặt</span>
                </a>
                <a asp-controller="AdminOperations" asp-action="Audit" class="adm-nav-link @(currentController == "AdminOperations" && ViewContext.RouteData.Values["action"]?.ToString() == "Audit" ? "active" : "")">
                    <i class="bi bi-journal-text"></i><span>Nhật ký</span>
                </a>
            }

            @if (User.IsInRole("Shipper"))
            {
                <div class="adm-nav-label">Giao nhận</div>
                <a asp-controller="Shipper" asp-action="Index"
                   class="adm-nav-link @(currentController == "Shipper" ? "active" : "")">
                    <i class="bi bi-geo-alt"></i>
                    <span>Tác vụ Shipper</span>
                </a>
            }

        </nav>

        <div class="adm-sidebar-footer">
            <div class="adm-user-profile-card">
                <div class="adm-user-avatar-wrap">
                    <div class="adm-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <span class="adm-user-status-dot" title="Đang trực tuyến"></span>
                </div>
                <div class="adm-user-info">
                    <div class="adm-user-name" title="@User.Identity?.Name">
                        @User.Identity?.Name
                    </div>
                    <div class="adm-user-role">
                        QUẢN TRỊ VIÊN
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 ms-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="adm-user-logout-btn" title="Đăng xuất khỏi hệ thống">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div class="adm-main-wrap">

        <!-- TOPBAR -->
        <header class="adm-topbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="adm-topbar-icon-btn d-lg-none" id="admSidebarToggle"
                        aria-label="Menu quản trị" aria-controls="admSidebar" aria-expanded="false">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <div class="adm-topbar-breadcrumb d-flex align-items-center gap-2">
                    <span class="adm-breadcrumb-chip">
                        <i class="bi bi-gem me-1 text-primary"></i>
                        <span>HNMT</span>
                    </span>
                    <i class="bi bi-chevron-right text-muted" style="font-size: 0.65rem;"></i>
                    <span class="adm-breadcrumb-page">@(ViewData["Title"] ?? "Quản trị")</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <partial name="_NotificationBell" view-data='@new ViewDataDictionary(ViewData) { { "BellButtonClass", "adm-topbar-icon-btn" } }' />

                <!-- THEME SWITCHER (SÁNG / TỐI - MINIMAL ICON TOGGLE) -->
                <button type="button" class="adm-topbar-icon-btn adm-theme-btn" id="admThemeToggle" title="Chuyển đổi giao diện Sáng / Tối" aria-label="Chuyển đổi giao diện Sáng / Tối">
                    <i class="bi bi-sun-fill text-warning" id="admThemeIcon"></i>
                    <span class="visually-hidden" id="admThemeText">Chế độ Sáng</span>
                </button>

                <a asp-controller="Home" asp-action="Index" class="adm-topbar-store-btn" target="_blank" aria-label="Xem cửa hàng" title="Xem giao diện khách hàng">
                    <span class="d-none d-sm-inline">Xem cửa hàng</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </header>

        <!-- CONTENT BODY -->
        <main class="adm-content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" style="background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.25) !important;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" style="background: rgba(244, 63, 94, 0.12); color: #e11d48; border: 1px solid rgba(244, 63, 94, 0.25) !important;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @{
                var liveController = ViewContext.RouteData.Values["controller"]?.ToString();
                var liveAction = ViewContext.RouteData.Values["action"]?.ToString();
                var liveEnabled = (liveController is "AdminOrders" or "AdminSupportRequests" or "AdminShipments")
                    && (liveAction is "Index" or "Details")
                    || liveController == "AdminOperations" && liveAction == "Returns";
            }
            @if (liveEnabled)
            {
                <div data-admin-live-content>@RenderBody()</div>
            }
            else
            {
                @RenderBody()
            }
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-atelier.js" asp-append-version="true"></script>
    <script src="~/js/admin-live.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
