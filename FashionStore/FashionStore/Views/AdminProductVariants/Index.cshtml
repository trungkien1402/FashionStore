@model List<FashionStore.Models.Entities.ProductVariant>

@{
    ViewData["Title"] = "Quản lý biến thể";
    var product = ViewBag.Product as FashionStore.Models.Entities.Product;
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase mb-2">Quản lý sản phẩm</div>
            <h1 style="font-family:'Playfair Display',serif;">
                Biến thể sản phẩm
            </h1>
            <p class="text-muted mb-0">
                Sản phẩm: <strong>@product?.Name</strong>
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="AdminProducts" asp-action="Index"
               class="btn btn-outline-dark">Quay lại</a>

            <a asp-action="Create" asp-route-productId="@product?.Id"
               class="btn btn-dark">+ Thêm biến thể</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="border p-5 text-center">
            <h5>Sản phẩm chưa có biến thể</h5>
            <p class="text-muted">Hãy thêm Size, màu sắc và số lượng tồn kho.</p>
        </div>
    }
    else
    {
        <div class="table-responsive border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">SKU</th>
                        <th>Size</th>
                        <th>Màu sắc</th>
                        <th>Giá</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.SKU</td>
                            <td>@item.Size</td>
                            <td>@item.Color</td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td>
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="text-danger fw-semibold">Hết hàng</span>
                                }
                                else
                                {
                                    <span>@item.StockQuantity</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-dark">Sửa</a>

                                <form asp-action="ToggleActive"
                                      asp-route-id="@item.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">
                                        @(item.IsActive ? "Ẩn" : "Hiện")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>