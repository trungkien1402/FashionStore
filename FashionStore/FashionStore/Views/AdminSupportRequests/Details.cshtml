@model FashionStore.Models.Entities.SupportRequest
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = $"Chi tiết yêu cầu #{Model.Id}";
}

<!-- EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">TICKET #@Model.Id</span>
            </div>
            <h1 class="adm-title-main">@Model.Subject</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> <span>Quay lại danh sách</span>
            </a>
            @switch (Model.Status)
            {
                case SupportRequestStatus.Pending:
                    <span class="adm-pill adm-pill-amber fs-6 py-2 px-3">Chờ xử lý</span>
                    break;
                case SupportRequestStatus.InProgress:
                    <span class="adm-pill adm-pill-blue fs-6 py-2 px-3">Đang xử lý</span>
                    break;
                case SupportRequestStatus.Resolved:
                    <span class="adm-pill adm-pill-emerald fs-6 py-2 px-3">Đã giải quyết</span>
                    break;
                case SupportRequestStatus.Closed:
                    <span class="adm-pill adm-pill-faint fs-6 py-2 px-3">Đã đóng</span>
                    break;
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- LEFT: CONTENT -->
    <div class="col-lg-8">
        <div class="adm-card mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-chat-left-text fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Nội dung phản ánh từ khách hàng</h5>
            </div>

            <div class="p-4 rounded-3 mb-3" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0); font-size: 1rem; line-height: 1.7; white-space: pre-wrap;">@Model.Message</div>

            @if (!string.IsNullOrEmpty(Model.OrderCode))
            {
                <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background: rgba(37, 99, 235, 0.08); border: 1px solid rgba(37, 99, 235, 0.2);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt fs-5 text-primary"></i>
                        <span class="small text-muted">Mã đơn hàng liên quan:</span>
                        <strong class="font-monospace text-primary">#@Model.OrderCode</strong>
                    </div>
                    <a asp-controller="AdminOrders" asp-action="Index" asp-route-search="@Model.OrderCode" class="adm-action-btn adm-btn-secondary py-1 px-3" style="font-size: 0.78rem;">
                        Kiểm tra đơn hàng <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            }
        </div>

        <!-- FORM UPDATE STATUS & NOTE -->
        <div class="adm-card">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-pencil-square fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Cập nhật tiến độ & Ghi chú nội bộ</h5>
            </div>

            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="adm-form-label fw-bold">Trạng thái xử lý ticket</label>
                        <select name="status" class="form-select adm-input-dark">
                            <option value="@((int)SupportRequestStatus.Pending)" selected="@(Model.Status == SupportRequestStatus.Pending)">Chờ xử lý</option>
                            <option value="@((int)SupportRequestStatus.InProgress)" selected="@(Model.Status == SupportRequestStatus.InProgress)">Đang xử lý</option>
                            <option value="@((int)SupportRequestStatus.Resolved)" selected="@(Model.Status == SupportRequestStatus.Resolved)">Đã giải quyết</option>
                            <option value="@((int)SupportRequestStatus.Closed)" selected="@(Model.Status == SupportRequestStatus.Closed)">Đã đóng ticket</option>
                        </select>
                    </div>

                    @if (Model.ResolvedAt.HasValue)
                    {
                        <div class="col-md-6">
                            <label class="adm-form-label text-muted">Thời điểm hoàn tất</label>
                            <div class="form-control adm-input-dark" readonly style="background: var(--adm-surface-hover, #F8FAFC);">
                                @Model.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label class="adm-form-label fw-bold">Ghi chú xử lý / Nội bộ nhân viên</label>
                    <textarea name="adminNote" maxlength="1000" rows="4" class="form-control adm-input-dark"
                              placeholder="Nhập ghi chú phản hồi, nội dung đã gọi điện thoại/trao đổi với khách hàng...">@Model.AdminNote</textarea>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                        Ghi chú này được lưu trữ nội bộ nhằm đồng bộ giữa các nhân viên trong ca làm việc.
                    </div>
                </div>

                <button type="submit" class="adm-action-btn adm-btn-primary py-2 px-4">
                    <i class="bi bi-save me-1"></i> <span>Lưu cập nhật</span>
                </button>
            </form>
        </div>
    </div>

    <!-- RIGHT: CUSTOMER INFO -->
    <div class="col-lg-4">
        <div class="adm-card mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-person-circle fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Thông tin người liên hệ</h5>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Họ và tên:</div>
                <div class="fw-bold fs-6 adm-heading mt-0.5">@Model.FullName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Số điện thoại:</div>
                <div class="fw-bold mt-0.5">
                    <a href="tel:@Model.PhoneNumber" class="text-decoration-none adm-heading font-monospace">
                        <i class="bi bi-telephone-outbound me-1 text-primary"></i>@Model.PhoneNumber
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Email liên hệ:</div>
                <div class="mt-0.5">
                    <a href="mailto:@Model.Email" class="text-decoration-none adm-heading">
                        <i class="bi bi-envelope me-1 text-danger"></i>@Model.Email
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Tài khoản thành viên:</div>
                <div class="mt-1">
                    @if (Model.User != null)
                    {
                        <span class="adm-pill adm-pill-emerald"><i class="bi bi-person-check me-1"></i>Đã có tài khoản</span>
                        <div class="small text-muted mt-1 font-monospace">@Model.User.UserName</div>
                    }
                    else
                    {
                        <span class="adm-pill adm-pill-faint"><i class="bi bi-person me-1"></i>Khách vãng lai</span>
                    }
                </div>
            </div>

            <div class="pt-3 border-top border-secondary border-opacity-10">
                <div class="text-muted small">Thời gian gửi ticket:</div>
                <div class="small fw-semibold adm-heading font-monospace mt-0.5">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
            </div>
        </div>
    </div>
</div>
