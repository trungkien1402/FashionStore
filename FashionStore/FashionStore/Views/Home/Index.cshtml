@model List<FashionStore.Models.Entities.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO BANNER -->
<section class="fs-hero">
    <div class="fs-hero-image"></div>

    <div class="fs-hero-content">
        <p class="fs-eyebrow">NEW SEASON / 2026</p>
        <h1>Wear Your<br />Own Story.</h1>
        <p class="fs-hero-description">
            Không chỉ là trang phục. Đó là cách bạn thể hiện cá tính
            và phong cách của chính mình.
        </p>

        <a asp-controller="Products"
           asp-action="Index"
           class="fs-btn">
            Khám phá bộ sưu tập
            <span class="ms-2">→</span>
        </a>
    </div>

    <div class="fs-hero-caption">
        <span>FASHIONSTORE COLLECTION</span>
        <span>01 — 03</span>
    </div>
</section>

<!-- INTRO -->
<section class="fs-intro-section" id="about">
    <p class="fs-eyebrow">ABOUT FASHIONSTORE</p>
    <h2>
        Đơn giản trong thiết kế.<br />
        Khác biệt trong phong cách.
    </h2>
    <p>
        FashionStore mang đến những lựa chọn thời trang hiện đại,
        dễ ứng dụng và phù hợp với phong cách riêng của bạn.
    </p>
</section>

<!-- CATEGORY -->
<section class="fs-section">
    <div class="fs-section-heading">
        <div>
            <p class="fs-eyebrow">FIND YOUR STYLE</p>
            <h2>Khám phá danh mục</h2>
        </div>

        <a asp-controller="Products" asp-action="Index"
           class="fs-text-link">
            Tất cả sản phẩm <span>→</span>
        </a>
    </div>

    <div class="fs-category-grid">
        <a asp-controller="Products" asp-action="Index"
           class="fs-category-card">
            <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=85"
                 alt="Thời trang nữ" />
            <div class="fs-category-overlay">
                <span>01 / COLLECTION</span>
                <h3>Thời trang nữ</h3>
                <span class="fs-category-link">Khám phá →</span>
            </div>
        </a>

        <a asp-controller="Products" asp-action="Index"
           class="fs-category-card">
            <img src="https://images.unsplash.com/photo-1516257984-b1b4d707412e?auto=format&fit=crop&w=900&q=85"
                 alt="Thời trang nam" />
            <div class="fs-category-overlay">
                <span>02 / COLLECTION</span>
                <h3>Thời trang nam</h3>
                <span class="fs-category-link">Khám phá →</span>
            </div>
        </a>

        <a asp-controller="Products" asp-action="Index"
           class="fs-category-card">
            <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=900&q=85"
                 alt="Phong cách thường ngày" />
            <div class="fs-category-overlay">
                <span>03 / COLLECTION</span>
                <h3>Everyday Style</h3>
                <span class="fs-category-link">Khám phá →</span>
            </div>
        </a>
    </div>
</section>

<!-- LATEST PRODUCTS -->
<section class="fs-section fs-products-section">
    <div class="fs-section-heading">
        <div>
            <p class="fs-eyebrow">JUST ARRIVED</p>
            <h2>Sản phẩm mới nhất</h2>
            <p class="fs-section-description">
                Những thiết kế mới nhất dành cho phong cách của bạn.
            </p>
        </div>

        <a asp-controller="Products" asp-action="Index"
           class="fs-text-link">
            Xem tất cả <span>→</span>
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="fs-product-grid">
            @foreach (var product in Model)
            {
                <a asp-controller="Products"
                   asp-action="Details"
                   asp-route-id="@product.Id"
                   class="fs-product-card">

                    <div class="fs-product-image">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Name"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="fs-product-placeholder">
                                FASHIONSTORE
                            </div>
                        }

                        <span class="fs-product-tag">NEW</span>
                    </div>

                    <div class="fs-product-info">
                        <p class="fs-product-category">
                            @(product.Category?.Name ?? "Fashion")
                        </p>

                        <h3>@product.Name</h3>

                        <div class="fs-product-bottom">
                            <span class="fs-product-price">
                                @product.Price.ToString("N0") đ
                            </span>
                            <span class="fs-product-arrow">→</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="fs-empty-products">
            <h3>Sản phẩm đang được cập nhật</h3>
            <p>FashionStore sẽ sớm mang đến những bộ sưu tập mới nhất.</p>
        </div>
    }
</section>

<!-- COLLECTION BANNER -->
<section class="fs-collection-banner">
    <div class="fs-collection-content">
        <p class="fs-eyebrow">THE ART OF EVERYDAY STYLE</p>
        <h2>Less, But<br />Better.</h2>
        <p>
            Tìm kiếm vẻ đẹp trong những điều đơn giản.
            Chọn phong cách phù hợp với chính bạn.
        </p>
        <a asp-controller="Products"
           asp-action="Index"
           class="fs-btn fs-btn-outline">
            Mua sắm ngay
        </a>
    </div>
</section>

<!-- BENEFITS -->
<section class="fs-benefits">
    <div>
        <span class="fs-benefit-icon">01</span>
        <h4>Chất lượng chọn lọc</h4>
        <p>Chú trọng chất liệu và trải nghiệm sử dụng.</p>
    </div>

    <div>
        <span class="fs-benefit-icon">02</span>
        <h4>Phong cách hiện đại</h4>
        <p>Thiết kế dễ phối, phù hợp nhiều hoàn cảnh.</p>
    </div>

    <div>
        <span class="fs-benefit-icon">03</span>
        <h4>Hỗ trợ tận tâm</h4>
        <p>Đồng hành cùng bạn trong quá trình mua sắm.</p>
    </div>
</section>
