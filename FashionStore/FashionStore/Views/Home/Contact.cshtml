@model FashionStore.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Liên Hệ & Dịch Vụ Khách Hàng";
}

<div class="contact-page-wrapper">
    <!-- LUXURY CONCIERGE HERO HEADER -->
    <section class="contact-hero-luxury">
        <div class="contact-container">
            <h1 class="contact-title">Chăm Sóc Khách Hàng <em>&</em> Hỗ Trợ Độc Quyền</h1>
            <p class="contact-subtitle">
                Đội ngũ tư vấn viên HNMTSHOP hân hạnh lắng nghe mọi yêu cầu về kích cỡ, sản phẩm, quy trình đổi trả và trải nghiệm mua sắm của bạn.
            </p>
        </div>
    </section>

    <div class="contact-container">
        <!-- SUCCESS ALERT -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-alert-luxury success">
                <div class="alert-icon-box">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="alert-text-box">
                    <h5>Gửi yêu cầu thành công!</h5>
                    <p>@TempData["SuccessMessage"]</p>
                </div>
            </div>
        }

        <!-- 50:50 SPLIT: CONCIERGE SHOWROOM HUB (LEFT) & BESPOKE INQUIRY FORM (RIGHT) -->
        <div class="contact-grid">
            <!-- LEFT COLUMN: CONCIERGE SHOWROOM & DIRECT CHANNELS -->
            <div class="contact-concierge-col" id="stores">
                <!-- LIVE STATUS CARD -->
                <div class="concierge-status-card">
                    <div class="live-status-header">
                        <span class="live-pulse-dot"></span>
                        <span class="live-status-text">ĐANG TRỰC TUYẾN · PHẢN HỒI TRONG 15 PHÚT</span>
                    </div>
                    <h3 class="concierge-card-title">Kết nối trực tiếp cùng chúng tôi</h3>
                    <p class="concierge-card-desc">
                        Cần tư vấn chọn size gấp hoặc giải đáp thắc mắc về đơn hàng? Hãy liên hệ ngay qua các kênh phản hồi tức thì:
                    </p>

                    <div class="quick-channels-grid">
                        <a href="tel:+84988776655" class="channel-pill-item">
                            <div class="channel-icon-wrap phone">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div class="channel-info">
                                <span class="channel-tag">HOTLINE VIP 24/7</span>
                                <strong class="channel-val">0988 776 655</strong>
                            </div>
                        </a>

                        <a href="https://zalo.me" target="_blank" rel="noopener noreferrer" class="channel-pill-item">
                            <div class="channel-icon-wrap zalo">
                                <i class="bi bi-chat-dots-fill"></i>
                            </div>
                            <div class="channel-info">
                                <span class="channel-tag">ZALO OFFICIAL CARE</span>
                                <strong class="channel-val">Tư vấn viên Zalo</strong>
                            </div>
                        </a>

                        <a href="mailto:hotro@fashionstore.vn" class="channel-pill-item full-width">
                            <div class="channel-icon-wrap email">
                                <i class="bi bi-envelope-at-fill"></i>
                            </div>
                            <div class="channel-info">
                                <span class="channel-tag">HỘP THƯ CSKH</span>
                                <strong class="channel-val">hotro@fashionstore.vn · cskh@hnmtshop.vn</strong>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- SHOWROOM DETAILS & MAP -->
                <div class="showroom-detail-card">
                    <div class="showroom-info-header">
                        <span class="sub-badge">BOUTIQUE SHOWROOM</span>
                        <h4>Không gian trải nghiệm mua sắm</h4>
                        <p class="showroom-address">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span>123 Đường Thời Trang, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</span>
                        </p>
                    </div>

                    <div class="showroom-meta-grid">
                        <div class="meta-row">
                            <i class="bi bi-clock-fill"></i>
                            <div>
                                <strong>Thời gian mở cửa:</strong>
                                <span>08:30 – 21:30 (Mở cửa tất cả các ngày, bao gồm Lễ & Tết)</span>
                            </div>
                        </div>
                        <div class="meta-row">
                            <i class="bi bi-shield-check"></i>
                            <div>
                                <strong>Hotline bảo hành & đổi size:</strong>
                                <span>+84 901 234 567 (Đổi size miễn phí trong 7 ngày)</span>
                            </div>
                        </div>
                    </div>

                    <!-- EMBEDDED MAP -->
                    <div class="contact-map-frame">
                        <div class="map-topbar">
                            <span class="map-label"><i class="bi bi-compass"></i> Bản đồ chỉ đường Showroom</span>
                            <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="map-open-link">
                                Mở toàn màn hình <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </div>
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.460233486392!2d106.70248881471842!3d10.776019392321852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f447781b491%3A0x7d6a52140bbd0c88!2zQuG6v24gTmdow6ksIFF14bqtbiAxLCBUaMOgbmggcGjhu5EgSOG7kyBDaMOtIE1pbmgsIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1680000000000!5m2!1svi!2s" 
                            width="100%" 
                            height="230" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: THE BESPOKE INQUIRY FORM -->
            <div class="contact-form-card" id="contactFormCard">
                <div class="form-card-header">
                    <span class="sub-badge">GỬI YÊU CẦU TRỰC TUYẾN</span>
                    <h2>Gửi tin nhắn cho đội ngũ hỗ trợ</h2>
                    <p>Hãy điền thông tin bên dưới, nhân viên chăm sóc khách hàng sẽ liên hệ lại với bạn trong thời gian sớm nhất.</p>
                </div>

                <form asp-action="Contact" method="post" id="contactForm" class="contact-form-element">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="contact-val-summary"></div>

                    <div class="form-row-luxury">
                        <div class="form-group-luxury">
                            <label asp-for="FullName">Họ và tên <span class="required">*</span></label>
                            <input asp-for="FullName" class="form-control-luxury" placeholder="Ví dụ: Triển Huỳnh" required />
                            <span asp-validation-for="FullName" class="val-error"></span>
                        </div>

                        <div class="form-group-luxury">
                            <label asp-for="PhoneNumber">Số điện thoại <span class="required">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control-luxury" placeholder="Ví dụ: 0988776655" required />
                            <span asp-validation-for="PhoneNumber" class="val-error"></span>
                        </div>
                    </div>

                    <div class="form-group-luxury">
                        <label asp-for="Email">Địa chỉ Email <span class="required">*</span></label>
                        <input asp-for="Email" class="form-control-luxury" placeholder="email@domain.com" required />
                        <span asp-validation-for="Email" class="val-error"></span>
                    </div>

                    <div class="form-row-luxury">
                        <div class="form-group-luxury">
                            <label asp-for="Subject">Chủ đề cần hỗ trợ <span class="required">*</span></label>
                            <select asp-for="Subject" class="form-control-luxury" id="contactSubjectSelect" required>
                                <option value="">-- Chọn chủ đề hỗ trợ --</option>
                                <option value="Tư vấn sản phẩm & Chọn size">Tư vấn sản phẩm & Chọn size</option>
                                <option value="Hỏi về tiến độ đơn hàng">Hỏi về tiến độ đơn hàng</option>
                                <option value="Yêu cầu đổi size / Đổi trả hàng">Yêu cầu đổi size / Đổi trả hàng</option>
                                <option value="Thắc mắc thanh toán & Hoàn tiền">Thắc mắc thanh toán & Hoàn tiền</option>
                                <option value="Khiếu nại dịch vụ">Khiếu nại chất lượng dịch vụ</option>
                                <option value="Hợp tác kinh doanh">Hợp tác kinh doanh / Brand Ambassador</option>
                                <option value="Chủ đề khác">Chủ đề khác</option>
                            </select>
                            <span asp-validation-for="Subject" class="val-error"></span>
                        </div>

                        <div class="form-group-luxury">
                            <label asp-for="OrderCode">Mã đơn hàng <em>(nếu có)</em></label>
                            <input asp-for="OrderCode" class="form-control-luxury" placeholder="Ví dụ: FS-84920" />
                            <span asp-validation-for="OrderCode" class="val-error"></span>
                        </div>
                    </div>

                    <div class="form-group-luxury">
                        <label asp-for="Message">Nội dung yêu cầu chi tiết <span class="required">*</span></label>
                        <textarea asp-for="Message" id="contactMessageInput" rows="5" class="form-control-luxury textarea" placeholder="Mô tả cụ thể câu hỏi hoặc nhu cầu tư vấn của bạn..."></textarea>
                        <span asp-validation-for="Message" class="val-error"></span>
                    </div>

                    <div class="form-actions-luxury">
                        <button type="submit" class="contact-submit-luxury">
                            <span>GỬI YÊU CẦU NGAY</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                        <div class="security-guarantee">
                            <i class="bi bi-lock-fill"></i>
                            <span>Thông tin của bạn được cam kết bảo mật theo tiêu chuẩn SSL 256-bit.</span>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- REFINED FAQ ACCORDION SECTION -->
        <section class="contact-faq-luxury" id="faq">
            <div class="faq-section-header">
                <span class="sub-badge">HỎI ĐÁP & CHÍNH SÁCH</span>
                <h2>Câu hỏi thường gặp & Quy định (FAQ)</h2>
                <p>Những thông tin phổ biến giúp bạn giải đáp nhanh về vận chuyển, chính sách đổi hàng và mua sắm.</p>
            </div>

            <div class="faq-accordion-grid">
                <details class="faq-card" id="faq-shipping">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">01</span>
                            Thời gian & chi phí giao hàng tiêu chuẩn là bao lâu?
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>Đơn hàng nội thành TP.HCM và Hà Nội giao nhanh từ <strong>1 – 2 ngày làm việc</strong>. Đối với các tỉnh thành khác, thời gian giao hàng từ 2 – 4 ngày. Phí vận chuyển tiêu chuẩn toàn quốc là 30.000đ, miễn phí giao hàng cho tất cả đơn hàng từ 500.000đ.</p>
                    </div>
                </details>

                <details class="faq-card" id="faq-returns">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">02</span>
                            Chính sách đổi size và đổi trả hàng như thế nào?
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>HNMTSHOP hỗ trợ đổi size miễn phí trong vòng <strong>7 ngày</strong> kể từ khi bạn nhận hàng. Sản phẩm cần còn nguyên tem mác, hộp đựng (đối với giày và phụ kiện), chưa qua giặt ủi hay sử dụng. Nếu sản phẩm phát sinh lỗi từ nhà sản xuất, cửa hàng chịu 100% phí vận chuyển hai chiều.</p>
                    </div>
                </details>

                <details class="faq-card" id="faq-size">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">03</span>
                            Làm thế nào để chọn size chuẩn trước khi đặt đơn?
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>Bạn có thể sử dụng công cụ tính size thông minh tại trang <a asp-controller="Home" asp-action="SizeGuide" class="faq-link">Bảng Quy Đổi Kích Thước</a> hoặc gửi thông tin chiều cao, cân nặng trực tiếp qua form trên để chuyên viên tư vấn chi tiết từng mẫu trang phục.</p>
                    </div>
                </details>

                <details class="faq-card" id="faq-cod">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">04</span>
                            Tôi có quyền kiểm tra hàng trước khi thanh toán COD không?
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>Quý khách luôn được quyền <strong>đồng kiểm ngoại quan</strong> (kiểm tra chuẩn mẫu mã, màu sắc, size áo/quần và số lượng) cùng nhân viên giao vận trước khi thanh toán tiền mặt (COD).</p>
                    </div>
                </details>

                <details class="faq-card" id="faq-terms">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">05</span>
                            Điều khoản dịch vụ & quy định mua hàng trực tuyến
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>Khi đặt hàng tại HNMTSHOP, quý khách cam kết cung cấp chính xác thông tin liên hệ và địa chỉ nhận hàng. Giá sản phẩm niêm yết trên website đã bao gồm thuế GTGT. Chúng tôi luôn xác nhận đơn hàng qua SMS hoặc tổng đài trước khi gửi hàng đi.</p>
                    </div>
                </details>

                <details class="faq-card" id="faq-privacy">
                    <summary>
                        <span class="faq-q-text">
                            <span class="faq-num">06</span>
                            Chính sách bảo mật thông tin & dữ liệu cá nhân
                        </span>
                        <i class="bi bi-chevron-down faq-chevron"></i>
                    </summary>
                    <div class="faq-body">
                        <p>HNMTSHOP cam kết bảo mật tuyệt đối dữ liệu khách hàng (họ tên, số điện thoại, địa chỉ, lịch sử đơn hàng). Thông tin chỉ được sử dụng cho việc xử lý đơn hàng và chăm sóc dịch vụ, tuyệt đối không cung cấp cho bên thứ ba vì mục đích thương mại.</p>
                    </div>
                </details>
            </div>
        </section>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Auto-fill from query params if redirected from SizeGuide (e.g., ?subject=...&message=...)
        var urlParams = new URLSearchParams(window.location.search);
        var subjectParam = urlParams.get("subject");
        var messageParam = urlParams.get("message");

        if (subjectParam) {
            var subjectSelect = document.getElementById("contactSubjectSelect");
            if (subjectSelect) {
                for (var i = 0; i < subjectSelect.options.length; i++) {
                    if (subjectSelect.options[i].value === subjectParam) {
                        subjectSelect.selectedIndex = i;
                        break;
                    }
                }
            }
        }

        if (messageParam) {
            var messageInput = document.getElementById("contactMessageInput");
            if (messageInput && !messageInput.value.trim()) {
                messageInput.value = messageParam;
            }
        }
    });
</script>

<style>
/* ==========================================================================
   HNMTSHOP - CONTACT & LUXURY CONCIERGE (THE LUXURY CONCIERGE SPLIT)
   Style: Minimalist High Fashion / Farfetch & SSENSE Concierge Style - Softened
   Font Family: Plus Jakarta Sans & Playfair Display
   ========================================================================== */

.contact-page-wrapper {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding-bottom: 80px;
    min-height: 100vh;
}

.contact-container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
}

/* 1. HERO HEADER (ELEGANT LIGHT LUXURY) */
.contact-hero-luxury {
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    border-bottom: 1px solid #E2E8F0;
    padding: 48px 20px 40px;
    text-align: center;
    margin-bottom: 36px;
}

.contact-title {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #1E293B;
    margin: 0 auto 12px;
    max-width: 800px;
}

.contact-title em {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    color: #1E293B;
}

.contact-subtitle {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748B;
    max-width: 650px;
    margin: 0 auto;
    font-weight: 400;
}

/* 2. SUCCESS ALERT */
.contact-alert-luxury.success {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #ECFDF5;
    border: 1px solid #10B981;
    color: #065F46;
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 28px;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.08);
}

.alert-icon-box {
    font-size: 1.4rem;
    color: #10B981;
    line-height: 1;
}

.alert-text-box h5 {
    margin: 0 0 4px 0;
    font-size: 0.95rem;
    font-weight: 600;
}

.alert-text-box p {
    margin: 0;
    font-size: 0.88rem;
    color: #047857;
}

/* 3. MAIN 50:50 SPLIT GRID */
.contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 28px;
    align-items: start;
}

/* LEFT COLUMN: CONCIERGE & SHOWROOM */
.contact-concierge-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.concierge-status-card,
.showroom-detail-card,
.contact-form-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 28px;
    box-shadow: 0 2px 12px -2px rgba(15, 23, 42, 0.03);
}

.sub-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #475569;
    background: #F1F5F9;
    padding: 3px 8px;
    border-radius: 6px;
    margin-bottom: 10px;
}

/* LIVE STATUS BADGE */
.live-status-header {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
}

.live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22C55E;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulseDot 2s infinite;
}

@@keyframes pulseDot {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

.live-status-text {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #15803D;
}

.concierge-card-title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1E293B;
    margin: 0 0 6px;
}

.concierge-card-desc {
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.5;
    margin: 0 0 20px;
}

/* QUICK CHANNELS GRID */
.quick-channels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.channel-pill-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    color: #1E293B;
}

.channel-pill-item:hover {
    background: #FFFFFF;
    border-color: #CBD5E1;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    transform: translateY(-1px);
    color: #1E293B;
}

.channel-pill-item.full-width {
    grid-column: 1 / -1;
}

.channel-icon-wrap {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.channel-icon-wrap.phone {
    background: #EEF2F6;
    color: #1E293B;
}

.channel-icon-wrap.zalo {
    background: #E0F2FE;
    color: #0284C7;
}

.channel-icon-wrap.email {
    background: #FEF3C7;
    color: #D97706;
}

