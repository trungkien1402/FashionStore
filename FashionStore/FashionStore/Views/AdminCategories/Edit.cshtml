@model AdminCategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<!-- EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">CHỈNH SỬA</span>
            </div>
            <h1 class="adm-title-main">Chỉnh sửa: @Model.Name</h1>
        </div>
        <div>
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> <span>Quay lại danh sách</span>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="adm-card shadow-sm">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="adm-form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control adm-input-dark" required />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Slug" class="adm-form-label fw-bold">Đường dẫn tĩnh (Slug) <span class="text-danger">*</span></label>
                    <input asp-for="Slug" class="form-control adm-input-dark font-monospace" required />
                    <span asp-validation-for="Slug" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4 pt-3 border-top border-secondary border-opacity-10">
                    <div class="form-check form-switch p-0 mb-0 d-flex align-items-center justify-content-between">
                        <label class="form-check-label fw-semibold adm-heading" for="IsActive" style="cursor: pointer;">
                            <div>Kích hoạt hiển thị</div>
                            <div class="text-muted fw-normal" style="font-size: 0.75rem;">Danh mục đang bật sẽ xuất hiện trên menu khách hàng và bộ lọc sản phẩm.</div>
                        </label>
                        <input asp-for="IsActive" class="form-check-input ms-3" type="checkbox" role="switch" id="IsActive" style="cursor: pointer; width: 2.5em; height: 1.3em;" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-2 border-top border-secondary border-opacity-10">
                    <button type="submit" class="adm-action-btn adm-btn-primary py-2 px-4">
                        <i class="bi bi-save me-1"></i> <span>Lưu thay đổi</span>
                    </button>
                    <a asp-action="Index" class="adm-action-btn adm-btn-secondary py-2 px-3">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
