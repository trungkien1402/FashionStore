@model FashionStore.Models.ViewModels.AdminAlertsViewModel
@{
    ViewData["Title"] = "Trung tâm Thông báo & Cảnh báo Vận hành";
    var currentFilter = Model.CurrentFilter ?? "all";
}

@functions {
    string FormatTime(DateTime dt)
    {
        var local = dt.Kind == DateTimeKind.Utc ? dt.AddHours(7) : dt;
        var diff = DateTime.UtcNow.AddHours(7) - local;
        if (diff.TotalMinutes < 1) return "Vừa xong";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        return local.ToString("dd/MM/yyyy HH:mm");
    }
}

<!-- 1. EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · KINH DOANH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">TRUNG TÂM THÔNG BÁO</span>
            </div>
            <h1 class="adm-title-main">Thông báo &amp; Cảnh báo Vận hành</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Inventory" class="adm-action-btn adm-btn-secondary" title="Chuyển sang kiểm kê kho hàng">
                <i class="bi bi-boxes"></i> <span>Kho hàng</span>
            </a>
            <a asp-action="Alerts" asp-route-filter="@currentFilter" class="adm-action-btn adm-btn-secondary" title="Làm mới bảng thông báo">
                <i class="bi bi-arrow-clockwise"></i> <span>Làm mới</span>
            </a>
        </div>
    </div>

    <!-- 2. SUMMARY KPI COMMAND CARDS -->
    <div class="row g-3 mb-4">
        <!-- 1. ĐƠN CHỜ DUYỆT -->
        <div class="col-sm-6 col-xl-3">
            <div class="adm-card p-3 shadow-sm h-100 d-flex flex-column justify-content-between" style="border-left: 3px solid #F59E0B;">
                <div>
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(245, 158, 11, 0.12); color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold adm-heading mb-0" style="font-size: 0.86rem;">Đơn chờ duyệt</h6>
                                <div class="text-muted" style="font-size: 0.72rem;">Chờ xuất kho</div>
                            </div>
                        </div>
                        <span class="adm-pill @(Model.NewOrdersCount > 0 ? "adm-pill-amber fw-bold" : "adm-pill-faint")" style="font-size: 0.8rem;">
                            @Model.NewOrdersCount
                        </span>
                    </div>
                </div>
                <div class="pt-2 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                    <span class="text-muted" style="font-size: 0.72rem;">Luồng đơn mới</span>
                    <a asp-controller="AdminOrders" asp-action="Index" asp-route-status="PendingConfirmation"
                       class="adm-btn-table-action text-decoration-none" style="height: 28px; font-size: 0.74rem; padding: 0 10px;" title="Xử lý đơn chờ duyệt">
                        <span>Xử lý đơn</span> <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. BIẾN THỂ SẮP HẾT HÀNG -->
        <div class="col-sm-6 col-xl-3">
            <div class="adm-card p-3 shadow-sm h-100 d-flex flex-column justify-content-between" style="border-left: 3px solid #E11D48;">
                <div>
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(225, 29, 72, 0.12); color: #E11D48; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                <i class="bi bi-boxes"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold adm-heading mb-0" style="font-size: 0.86rem;">Sắp hết hàng (≤ 5)</h6>
                                <div class="text-muted" style="font-size: 0.72rem;">Tồn kho báo động</div>
                            </div>
                        </div>
                        <span class="adm-pill @(Model.LowStockCount > 0 ? "adm-pill-rose fw-bold" : "adm-pill-faint")" style="font-size: 0.8rem;">
                            @Model.LowStockCount mã
                        </span>
                    </div>
                </div>
                <div class="pt-2 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                    <span class="text-muted" style="font-size: 0.72rem;">Tồn kho showroom</span>
                    <a asp-action="Inventory" asp-route-low="true"
                       class="adm-btn-table-action text-decoration-none" style="height: 28px; font-size: 0.74rem; padding: 0 10px;" title="Xem các mã sắp hết tại kho">
                        <span>Xem kho</span> <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. VẬN ĐƠN THẤT BẠI -->
        <div class="col-sm-6 col-xl-3">
            <div class="adm-card p-3 shadow-sm h-100 d-flex flex-column justify-content-between" style="border-left: 3px solid #EF4444;">
                <div>
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(239, 68, 68, 0.12); color: #EF4444; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold adm-heading mb-0" style="font-size: 0.86rem;">Giao thất bại</h6>
                                <div class="text-muted" style="font-size: 0.72rem;">Cần điều phối lại</div>
                            </div>
                        </div>
                        <span class="adm-pill @(Model.FailedShipmentsCount > 0 ? "adm-pill-rose fw-bold" : "adm-pill-faint")" style="font-size: 0.8rem;">
                            @Model.FailedShipmentsCount
                        </span>
                    </div>
                </div>
                <div class="pt-2 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                    <span class="text-muted" style="font-size: 0.72rem;">Điều phối giao hàng</span>
                    <a asp-controller="AdminShipments" asp-action="Index" asp-route-status="Failed"
                       class="adm-btn-table-action text-decoration-none" style="height: 28px; font-size: 0.74rem; padding: 0 10px;" title="Xem vận đơn giao thất bại">
                        <span>Vận đơn</span> <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. YÊU CẦU ĐỔI TRẢ CHỜ DUYỆT -->
        <div class="col-sm-6 col-xl-3">
            <div class="adm-card p-3 shadow-sm h-100 d-flex flex-column justify-content-between" style="border-left: 3px solid #2563EB;">
                <div>
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(37, 99, 235, 0.12); color: #2563EB; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold adm-heading mb-0" style="font-size: 0.86rem;">Đổi trả RMA</h6>
                                <div class="text-muted" style="font-size: 0.72rem;">Yêu cầu khách gửi</div>
                            </div>
                        </div>
                        <span class="adm-pill @(Model.PendingReturnsCount > 0 ? "adm-pill-blue fw-bold" : "adm-pill-faint")" style="font-size: 0.8rem;">
                            @Model.PendingReturnsCount
                        </span>
                    </div>
                </div>
                <div class="pt-2 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                    <span class="text-muted" style="font-size: 0.72rem;">Chính sách hậu mãi</span>
                    <a asp-action="Returns"
                       class="adm-btn-table-action text-decoration-none" style="height: 28px; font-size: 0.74rem; padding: 0 10px;" title="Xử lý yêu cầu đổi trả">
                        <span>Xử lý RMA</span> <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. SEGMENTED FILTER CONTROLS (TIER 1 ATELIER STANDARD) -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="adm-segmented-control" role="group" aria-label="Bộ lọc thông báo">
            <a asp-action="Alerts" asp-route-filter="all"
               class="adm-segment @(currentFilter == "all" ? "active" : "")">
                Tất cả
            </a>
            <a asp-action="Alerts" asp-route-filter="orders"
               class="adm-segment @(currentFilter == "orders" ? "active" : "")">
                Đơn hàng @(Model.NewOrdersCount > 0 ? $"({Model.NewOrdersCount})" : "")
            </a>
            <a asp-action="Alerts" asp-route-filter="stock"
               class="adm-segment @(currentFilter == "stock" ? "active" : "")">
                Kho hàng @(Model.LowStockCount > 0 ? $"({Model.LowStockCount})" : "")
            </a>
            <a asp-action="Alerts" asp-route-filter="shipment"
               class="adm-segment @(currentFilter == "shipment" ? "active" : "")">
                Vận chuyển @(Model.FailedShipmentsCount > 0 ? $"({Model.FailedShipmentsCount})" : "")
            </a>
            <a asp-action="Alerts" asp-route-filter="returns"
               class="adm-segment @(currentFilter == "returns" ? "active" : "")">
                Đổi trả &amp; Đánh giá @(Model.PendingReturnsCount > 0 ? $"({Model.PendingReturnsCount})" : "")
            </a>
        </div>
    </div>
</div>

<!-- 4. TWO-COLUMN LAYOUT: MAIN FEED & SIDEBAR -->
<div class="row g-4">
    <!-- LEFT: NOTIFICATION FEED (8 cols) -->
    <div class="col-lg-8">
        <div class="adm-card p-0 overflow-hidden shadow-sm">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-bell text-muted"></i>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 0.88rem;">Danh sách Thông báo &amp; Cảnh báo</h5>
                </div>
                <span class="adm-pill adm-pill-faint" style="font-size: 0.72rem;">@Model.Notifications.Count mục</span>
            </div>

            @if (Model.Notifications.Any())
            {
                <div class="d-flex flex-column">
                    @foreach (var item in Model.Notifications)
                    {
                        <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex flex-wrap flex-md-nowrap align-items-center justify-content-between gap-3 adm-feed-row"
                             style="transition: background-color 0.15s ease;">
                            <!-- LEFT: ICON & METADATA -->
                            <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 42px; height: 42px; background: @item.IconBg; color: @item.IconColor; font-size: 1.2rem;">
                                    <i class="bi @item.Icon"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <!-- TITLE & TIME -->
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1.5">
                                        <span class="fw-bold adm-heading text-truncate" style="font-size: 0.9rem;">@item.Title</span>
                                        <span class="text-muted ms-auto pe-2" style="font-size: 0.72rem;">
                                            <i class="bi bi-clock me-1"></i>@FormatTime(item.Timestamp)
                                        </span>
                                    </div>

                                    <!-- VARIANT BADGES OR DETAILS SUBTITLE -->
                                    @if (item.Type == "Stock")
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="badge" style="background: #F1F5F9; color: #0F172A; border: 1px solid #CBD5E1; font-size: 0.74rem; font-weight: 600;">
                                                    Size @item.Size
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Color))
                                            {
                                                <span class="badge" style="background: #F1F5F9; color: #0F172A; border: 1px solid #CBD5E1; font-size: 0.74rem; font-weight: 500;">
                                                    @item.Color
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Sku))
                                            {
                                                <span class="text-muted font-monospace" style="font-size: 0.74rem;">
                                                    SKU: <code style="color: #475569; font-weight: 600;">@item.Sku</code>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted text-truncate" style="font-size: 0.78rem;">
                                            @item.Subtitle
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- RIGHT: PROMINENT KEY HIGHLIGHT BADGE + ACTION BUTTON -->
                            <div class="d-flex align-items-center gap-3 flex-shrink-0 ps-md-2 ms-auto ms-md-0">
                                @if (item.Type == "Stock")
                                {
                                    <div class="text-end">
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="adm-pill adm-pill-rose font-monospace fw-bold shadow-sm" style="font-size: 0.84rem; padding: 4px 12px; display: inline-flex; align-items: center; gap: 5px;">
                                                <span class="rounded-circle" style="width: 7px; height: 7px; background: #E11D48;"></span>
                                                HẾT HÀNG: 0
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="adm-pill adm-pill-amber font-monospace fw-bold shadow-sm" style="font-size: 0.84rem; padding: 4px 12px; display: inline-flex; align-items: center; gap: 5px;">
                                                <span class="rounded-circle" style="width: 7px; height: 7px; background: #D97706;"></span>
                                                TỒN KHO: @item.StockQuantity
                                            </span>
                                        }
                                    </div>
                                }
                                else if (item.Type == "Order")
                                {
                                    <div class="text-end">
                                        <span class="adm-pill adm-pill-amber font-monospace fw-bold shadow-sm" style="font-size: 0.84rem; padding: 4px 12px;">
                                            @item.HighlightText
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-end">
                                        <span class="adm-pill @item.HighlightClass font-monospace fw-bold shadow-sm" style="font-size: 0.84rem; padding: 4px 12px;">
                                            @item.HighlightText
                                        </span>
                                    </div>
                                }

                                <a href="@item.ActionUrl" class="adm-btn-table-action text-decoration-none" style="height: 32px; font-size: 0.76rem; padding: 0 12px;" title="@item.ActionText">
                                    <span>@item.ActionText</span> <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-check-circle text-success fs-2 d-block mb-2"></i>
                    <div class="fw-bold adm-heading mb-1" style="font-size: 0.95rem;">Không có thông báo mới</div>
                    <div class="small text-muted">Hiện tại không có sự cố hoặc cảnh báo nào trong danh mục này.</div>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT: RECENT OPERATIONS LOG & FAST SHORTCUTS (4 cols) -->
    <div class="col-lg-4">
        <!-- 1. RECENT OPERATIONS AUDIT LOG -->
        <div class="adm-card shadow-sm p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-muted"></i>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 0.88rem;">Nhật ký Vận hành Gần đây</h5>
                </div>
                <a asp-action="Audit" class="text-muted small text-decoration-none" style="font-size: 0.75rem;" title="Xem tất cả nhật ký">
                    Tất cả &rarr;
                </a>
            </div>

            @if (Model.RecentEvents.Any())
            {
                <div class="p-3">
                    <div class="d-flex flex-column">
                        @foreach (var ev in Model.RecentEvents)
                        {
                            <div class="d-flex align-items-start pb-2 mb-2 border-bottom border-secondary border-opacity-10 last-border-0">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-2 mt-1"
                                     style="width: 22px; height: 22px; background: rgba(16, 185, 129, 0.12); color: #10B981; font-size: 0.75rem;">
                                    <i class="bi bi-check2"></i>
                                </div>
                                <div class="flex-grow-1" style="font-size: 0.78rem;">
                                    <div class="d-flex justify-content-between align-items-center mb-0.5">
                                        <strong class="adm-heading font-monospace" style="color: #0F172A;">@ev.Action</strong>
                                        <span class="text-muted font-monospace" style="font-size: 0.7rem;">@ev.CreatedAt.AddHours(7).ToString("HH:mm · dd/MM")</span>
                                    </div>
                                    <div class="text-muted text-break" style="line-height: 1.4;">
                                        @ev.Detail
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted small">
                    Chưa có ghi nhận thao tác mới.
                </div>
            }
        </div>

        <!-- 2. FAST ACTION SHORTCUTS -->
        <div class="adm-card shadow-sm p-3">
            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-lightning-charge text-muted"></i>
                <h5 class="fw-bold mb-0 adm-heading" style="font-size: 0.88rem;">Lối tắt Nghiệp vụ</h5>
            </div>

            <div class="d-flex flex-column gap-2">
                <a asp-action="Inventory" class="adm-btn-table-action justify-content-between text-decoration-none py-2 px-3" style="height: auto; font-size: 0.8rem;">
                    <span><i class="bi bi-boxes me-2 text-muted"></i> Quản lý &amp; Kiểm kê Kho</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-controller="AdminShipments" asp-action="Index" class="adm-btn-table-action justify-content-between text-decoration-none py-2 px-3" style="height: auto; font-size: 0.8rem;">
                    <span><i class="bi bi-truck me-2 text-muted"></i> Điều phối Giao nhận Shipper</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="Reviews" class="adm-btn-table-action justify-content-between text-decoration-none py-2 px-3" style="height: auto; font-size: 0.8rem;">
                    <span><i class="bi bi-chat-square-quote me-2 text-muted"></i> Kiểm duyệt Đánh giá</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-action="Settings" class="adm-btn-table-action justify-content-between text-decoration-none py-2 px-3" style="height: auto; font-size: 0.8rem;">
                    <span><i class="bi bi-sliders me-2 text-muted"></i> Cấu hình Chính sách Vận hành</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>
