@model FashionStore.Controllers.OperationsAnalytics

@{
    ViewData["Title"] = "Phân tích Bán hàng & Hiệu quả";
    var report = Model.Report;
    var cancellationRate = report.TotalOrders == 0 ? 0m : (decimal)report.CancelledOrders / report.TotalOrders;
}

<!-- EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · KINH DOANH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@report.StartDate.ToString("dd/MM/yyyy") – @report.EndDate.ToString("dd/MM/yyyy")</span>
            </div>
            <h1 class="adm-title-main">Báo cáo & Phân tích Vận hành</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Forecast" class="adm-btn-table-action" style="height: 38px; padding: 0 16px; background: #0F172A !important; color: #FFFFFF !important; border-color: #0F172A !important; font-size: 0.82rem; font-weight: 600;">
                <i class="bi bi-graph-up-arrow me-1"></i> Dự báo &amp; Nhập hàng
            </a>
            <a asp-action="Analytics" class="adm-btn-table-action text-decoration-none" style="height: 38px; padding: 0 14px; font-size: 0.82rem; font-weight: 500;" title="Làm mới">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </a>
        </div>
    </div>

    <!-- 4 EXECUTIVE KPI METRICS -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        <div class="col">
            <div class="adm-card p-3 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng đơn trong kỳ</div>
                        <div class="fs-3 fw-bold font-monospace adm-heading mt-1">@report.TotalOrders.ToString("N0")</div>
                    </div>
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(59, 130, 246, 0.1); color: #2563EB; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="adm-card p-3 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold">Đơn giao thành công</div>
                        <div class="fs-3 fw-bold font-monospace adm-heading mt-1" style="color: #10B981;">@report.DeliveredOrders.ToString("N0")</div>
                    </div>
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(16, 185, 129, 0.1); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="adm-card p-3 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold">Tỷ lệ hủy đơn</div>
                        <div class="fs-3 fw-bold font-monospace adm-heading mt-1 @(cancellationRate > 0.1m ? "text-danger" : "text-muted")">@cancellationRate.ToString("P1")</div>
                    </div>
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(239, 68, 68, 0.1); color: #EF4444; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="adm-card p-3 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold">Hoàn tiền ghi nhận</div>
                        <div class="fs-3 fw-bold font-monospace adm-heading mt-1" style="color: var(--adm-gold, #D97706);">@Model.Refunds.ToString("N0") ₫</div>
                    </div>
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(245, 158, 11, 0.1); color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BEST SELLING PRODUCTS (TOP RANKING) -->
<div id="best-selling-products" class="adm-card p-0 overflow-hidden mb-4 shadow-sm">
    <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 adm-heading">
                <i class="bi bi-trophy me-2" style="color: var(--adm-gold, #D97706);"></i>Top Sản phẩm Bán chạy nhất
            </h5>
            <div class="text-muted small mt-0.5">Xếp hạng theo số lượng đã giao thành công trong kỳ (cộng gộp tất cả size, màu)</div>
        </div>
        <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">Top @Model.BestSellingProducts.Count</span>
    </div>

    @if (!Model.BestSellingProducts.Any())
    {
        <div class="p-4 text-center text-muted small">
            Chưa có sản phẩm nào trong đơn đã giao thành công của kỳ này.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 80px;">THỨ HẠNG</th>
                        <th>SẢN PHẨM</th>
                        <th class="text-end">SỐ LƯỢNG ĐÃ GIAO</th>
                        <th class="text-end pe-4">SỐ ĐƠN HOÀN TẤT</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.BestSellingProducts.Count; index++)
                    {
                        var product = Model.BestSellingProducts[index];
                        var rank = index + 1;
                        <tr>
                            <td class="ps-4">
                                @if (rank == 1)
                                {
                                    <span class="badge rounded-circle p-2" style="background: #F59E0B; color: #FFF; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                                }
                                else if (rank == 2)
                                {
                                    <span class="badge rounded-circle p-2" style="background: #94A3B8; color: #FFF; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                                }
                                else if (rank == 3)
                                {
                                    <span class="badge rounded-circle p-2" style="background: #D97706; color: #FFF; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                                }
                                else
                                {
                                    <span class="font-monospace text-muted fw-bold ps-2">#@rank</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@product.ProductId" class="fw-bold adm-heading text-decoration-none">
                                    @product.Name
                                </a>
                            </td>
                            <td class="text-end font-monospace fw-bold fs-6 adm-heading">
                                @product.Quantity.ToString("N0")
                            </td>
                            <td class="text-end pe-4 font-monospace text-muted">
                                @product.OrderCount.ToString("N0") đơn
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- 2 COLUMNS: POPULAR VARIANTS & VOUCHER EFFECTIVENESS -->
<div class="row g-4">
    <!-- LEFT: POPULAR SIZES & COLORS -->
    <div class="col-12 col-xl-6">
        <div class="adm-card p-0 overflow-hidden shadow-sm h-100">
            <div class="p-3 border-bottom border-secondary border-opacity-10">
                <h5 class="fw-bold mb-0 adm-heading fs-6">
                    <i class="bi bi-palette me-2" style="color: var(--adm-gold, #D97706);"></i>Size & Màu Sắc Phổ Biến
                </h5>
                <div class="text-muted small mt-0.5">Biến thể được đặt mua và giao thành công nhiều nhất</div>
            </div>

            <div class="table-responsive">
                <table class="adm-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">SIZE</th>
                            <th>MÀU SẮC</th>
                            <th class="text-end pe-3">SỐ LƯỢNG ĐÃ GIAO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Variants)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">@row.Size</span>
                                </td>
                                <td>
                                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">@(row.Color?.Contains("(") == true ? row.Color.Substring(0, row.Color.IndexOf('(')).Trim() : row.Color)</span>
                                </td>
                                <td class="text-end pe-3 font-monospace fw-bold adm-heading">
                                    @row.Units.ToString("N0")
                                </td>
                            </tr>
                        }
                        @if (!Model.Variants.Any())
                        {
                            <tr><td colspan="3" class="text-muted text-center py-3">Kỳ này chưa có biến thể nào đã giao.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RIGHT: VOUCHER REDEMPTION -->
    <div class="col-12 col-xl-6">
        <div class="adm-card p-0 overflow-hidden shadow-sm h-100">
            <div class="p-3 border-bottom border-secondary border-opacity-10">
                <h5 class="fw-bold mb-0 adm-heading fs-6">
                    <i class="bi bi-tag me-2" style="color: var(--adm-gold, #D97706);"></i>Hiệu Quả Mã Giảm Giá
                </h5>
                <div class="text-muted small mt-0.5">Số lượt áp dụng và tổng chiết khấu cho khách hàng</div>
            </div>

            <div class="table-responsive">
                <table class="adm-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">MÃ VOUCHER</th>
                            <th class="text-center">LƯỢT ÁP DỤNG</th>
                            <th class="text-end pe-3">TỔNG TIỀN GIẢM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Vouchers)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold" style="color: var(--adm-gold, #D97706);">
                                    @row.Code
                                </td>
                                <td class="text-center font-monospace">
                                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">@row.Uses.ToString("N0")</span>
                                </td>
                                <td class="text-end pe-3 font-monospace fw-bold adm-heading">
                                    @row.Discount.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                        @if (!Model.Vouchers.Any())
                        {
                            <tr><td colspan="3" class="text-muted text-center py-3">Chưa có mã giảm giá nào được sử dụng.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
