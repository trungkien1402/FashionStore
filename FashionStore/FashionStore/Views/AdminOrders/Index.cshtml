@model List<FashionStore.Models.Entities.Order>
@using FashionStore.Models.Enums
@using FashionStore.Services.Implementations

@{
    ViewData["Title"] = "Hàng đợi Đơn hàng";
    var currentStatus = ViewBag.SelectedStatus as OrderStatus?;
    var currentPaymentStatus = ViewBag.PaymentStatus as PaymentStatus?;
    var currentPaymentMethod = ViewBag.PaymentMethod as PaymentMethod?;
    var currentShipmentStatus = ViewBag.ShipmentStatus as ShipmentStatus?;
    var currentSort = ViewBag.Sort as string;
    var currentSearch = ViewBag.Search as string;
    var currentFrom = ViewBag.From as string;
    var currentTo = ViewBag.To as string;

    int countAll = ViewBag.CountAll ?? 0;
    int countPending = ViewBag.CountPending ?? 0;
    int countConfirmed = ViewBag.CountConfirmed ?? 0;
    int countShipping = ViewBag.CountShipping ?? 0;
    int countDelivered = ViewBag.CountDelivered ?? 0;
    int countCancelled = ViewBag.CountCancelled ?? 0;

    decimal pendingAmount = ViewBag.PendingAmount ?? 0m;
    decimal deliveredAmount = ViewBag.DeliveredAmount ?? 0m;
    decimal avgOrderValue = ViewBag.AvgOrderValue ?? 0m;
}

<!-- 1. EXECUTIVE HEADER (DASHBOARD STANDARD) -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@ViewBag.Count đơn</span>
            </div>
            <h1 class="adm-title-main">Hàng đợi Đơn hàng</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="adm-action-btn adm-btn-secondary" onclick="exportOrdersToCSV()" title="Xuất dữ liệu đơn hàng ra CSV">
                <i class="bi bi-file-earmark-excel"></i> <span>Xuất CSV</span>
            </button>
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" title="Làm mới dữ liệu">
                <i class="bi bi-arrow-clockwise"></i> <span>Làm mới</span>
            </a>
        </div>
    </div>

    <!-- TIER 1: APPLE SEGMENTED CONTROL TABS (STANDALONE FULL ROW) -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="adm-segmented-control" role="group" aria-label="Lọc trạng thái">
            <a asp-action="Index" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == null ? "active" : "")">Tất cả (@countAll)</a>
            <a asp-action="Index" asp-route-status="@OrderStatus.PendingConfirmation" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == OrderStatus.PendingConfirmation ? "active" : "")">Chờ duyệt (@countPending)</a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Confirmed" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == OrderStatus.Confirmed ? "active" : "")">Đã duyệt (@countConfirmed)</a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Shipping" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == OrderStatus.Shipping ? "active" : "")">Đang giao (@countShipping)</a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Delivered" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == OrderStatus.Delivered ? "active" : "")">Đã giao (@countDelivered)</a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Cancelled" asp-route-search="@currentSearch" asp-route-from="@currentFrom" asp-route-to="@currentTo" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == OrderStatus.Cancelled ? "active" : "")">Đã hủy (@countCancelled)</a>
        </div>
    </div>

    <!-- TIER 2: SEARCH INPUT STRETCHED TO FIT + COMPOUND CONTROLS (BALANCED HORIZONTAL ROW) -->
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2">
        @if (currentStatus.HasValue)
        {
            <input type="hidden" name="status" value="@currentStatus.Value" />
        }

        <!-- 1. Stretched Search Input -->
        <div class="adm-search-input-group-v2 flex-grow-1" style="min-width: 260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="search" maxlength="100" value="@currentSearch"
                   placeholder="Tìm kiếm theo mã đơn, người nhận hoặc số điện thoại..."
                   class="adm-search-input-v2"
                   style="padding-left: 42px !important; padding-right: 14px !important;" />
        </div>

        <!-- 2. Cohesive Date Range Input Compound -->
        <div class="adm-date-compound" style="height: 38px;">
            <i class="bi bi-calendar3 adm-date-icon"></i>
            <input type="date" name="from" value="@currentFrom" class="adm-date-native" aria-label="Từ ngày" />
            <span class="adm-date-arrow"><i class="bi bi-arrow-right"></i></span>
            <input type="date" name="to" value="@currentTo" class="adm-date-native" aria-label="Đến ngày" />
            <button type="submit" class="adm-date-apply-btn" title="Áp dụng ngày">
                <i class="bi bi-check-lg"></i>
            </button>
        </div>

        <!-- 3. Sort Dropdown -->
        <select name="sort" class="form-select adm-input-dark" style="height: 38px; font-size: 0.85rem; width: auto; min-width: 170px; border-radius: 8px;" onchange="this.form.submit()">
            <option value="">Sắp xếp: Mới nhất</option>
            <option value="oldest" selected="@(currentSort == "oldest")">Cũ nhất</option>
            <option value="amount" selected="@(currentSort == "amount")">Tổng tiền cao nhất</option>
        </select>

        <!-- 4. Reset Ghost Button -->
        @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue || currentPaymentStatus.HasValue || currentPaymentMethod.HasValue || !string.IsNullOrEmpty(currentFrom) || !string.IsNullOrEmpty(currentTo) || !string.IsNullOrEmpty(currentSort))
        {
            <a asp-action="Index" class="adm-reset-ghost-btn" style="height: 38px;" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i> <span>Đặt lại</span>
            </a>
        }
    </form>
</div>

<!-- 2. HERO KPI METRICS (4 TILES - EXACT DASHBOARD REPLICA) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <!-- KPI 1: CHỜ DUYỆT -->
    <div class="col">
        <a asp-action="Index" asp-route-status="@OrderStatus.PendingConfirmation" class="text-decoration-none">
            <div class="adm-kpi-card @(currentStatus == OrderStatus.PendingConfirmation ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Đơn hàng chờ duyệt</h2>
                    <div class="adm-kpi-chip amber" title="Cần duyệt ngay">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <div class="adm-kpi-number">
                    @countPending <span class="adm-kpi-unit">đơn</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Tổng giá trị: <strong>@pendingAmount.ToString("N0") ₫</strong></span>
                </div>
            </div>
        </a>
    </div>

    <!-- KPI 2: ĐANG GIAO -->
    <div class="col">
        <a asp-action="Index" asp-route-status="@OrderStatus.Shipping" class="text-decoration-none">
            <div class="adm-kpi-card @(currentStatus == OrderStatus.Shipping ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Đang luân chuyển</h2>
                    <div class="adm-kpi-chip blue" title="Đang giao">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
                <div class="adm-kpi-number">
                    @countShipping <span class="adm-kpi-unit">đơn</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Kho & Shipper đang giao</span>
                </div>
            </div>
        </a>
    </div>

    <!-- KPI 3: HOÀN TẤT GIAO HÀNG -->
    <div class="col">
        <a asp-action="Index" asp-route-status="@OrderStatus.Delivered" class="text-decoration-none">
            <div class="adm-kpi-card @(currentStatus == OrderStatus.Delivered ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Giao thành công</h2>
                    <div class="adm-kpi-chip emerald" title="Đã đối soát">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="adm-kpi-number">
                    @countDelivered <span class="adm-kpi-unit">đơn</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Đã thu: <strong class="text-success">@deliveredAmount.ToString("N0") ₫</strong></span>
                </div>
            </div>
        </a>
    </div>

    <!-- KPI 4: AOV -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Giá trị đơn trung bình</h2>
                <div class="adm-kpi-chip purple" title="Giá trị đơn trung bình">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @avgOrderValue.ToString("N0") <span class="adm-kpi-unit">₫</span>
            </div>
            <div class="adm-kpi-footer">
                <span>Tổng đơn: <strong>@countAll đơn toàn sàn</strong></span>
            </div>
        </div>
    </div>
</div>

<!-- 3. ORDERS DATA TABLE (EXACT DASHBOARD STYLE & TYPOGRAPHY) -->
@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Không có đơn hàng nào trong mục này</h5>
        <p class="text-muted small">Tất cả các đơn đã được điều phối hoặc chưa có giao dịch phát sinh.</p>
        <a asp-action="Index" class="btn adm-btn-outline mt-2">
            Xem toàn bộ đơn hàng
        </a>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="adm-table mb-0" id="ordersTable">
                <thead>
                    <tr>
                        <th style="width: 220px;">MÃ ĐƠN HÀNG</th>
                        <th style="width: 200px;">KHÁCH HÀNG</th>
                        <th style="width: 140px;">PHƯƠNG THỨC</th>
                        <th style="width: 160px;">TỔNG TIỀN</th>
                        <th style="width: 150px;">TRẠNG THÁI</th>
                        <th class="text-end pe-4" style="width: 160px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var isPending = order.Status == OrderStatus.PendingConfirmation;
                        var shortCode = order.OrderCode.Length > 12
                            ? "#" + order.OrderCode.Substring(order.OrderCode.Length - 10)
                            : "#" + order.OrderCode;

                        <tr>
                            <!-- ORDER CODE & TIME (EXACT DASHBOARD REPLICA) -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold adm-heading font-monospace" style="font-size: 0.85rem;" title="@order.OrderCode">@shortCode</span>
                                    <button type="button" class="btn btn-sm p-0 text-muted" onclick="copyAdmText(this, '@order.OrderCode')" title="Sao chép toàn bộ mã đơn: @order.OrderCode">
                                        <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                                <div class="text-muted" style="font-size: 0.72rem;">@AdminReportService.ToVietnamTime(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</div>
                            </td>

                            <!-- CUSTOMER (EXACT DASHBOARD REPLICA) -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="adm-avatar-sm">
                                        @(string.IsNullOrWhiteSpace(order.ReceiverName) ? "K" : order.ReceiverName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold adm-heading" style="font-size: 0.84rem;">@order.ReceiverName</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@order.Phone</div>
                                    </div>
                                </div>
                            </td>

                            <!-- PAYMENT (EXACT DASHBOARD REPLICA) -->
                            <td>
                                @if (order.PaymentMethod == PaymentMethod.VietQR)
                                {
                                    <span class="badge" style="background: rgba(2, 132, 199, 0.1); color: #0284C7; border: 1px solid rgba(2, 132, 199, 0.25);">
                                        <i class="bi bi-qr-code me-1"></i> VietQR
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--adm-bg-soft); color: var(--adm-ink-muted); border: 1px solid var(--adm-border);">
                                        <i class="bi bi-cash me-1"></i> Tiền mặt COD
                                    </span>
                                }
                            </td>

                            <!-- AMOUNT (EXACT DASHBOARD REPLICA) -->
                            <td>
                                <span class="fw-bold adm-heading text-nowrap" style="font-size: 0.9rem;">
                                    @order.TotalAmount.ToString("N0") ₫
                                </span>
                            </td>

                            <!-- STATUS PILL (EXACT DASHBOARD REPLICA) -->
                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.PendingConfirmation:
                                        <span class="adm-pill adm-pill-amber">Chờ duyệt</span>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <span class="adm-pill adm-pill-blue">Đã duyệt</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="adm-pill adm-pill-blue">Xử lý kho</span>
                                        break;
                                    case OrderStatus.Shipping:
                                        <span class="adm-pill adm-pill-blue">Đang giao</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="adm-pill adm-pill-emerald">Đã giao</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="adm-pill adm-pill-rose">Đã hủy</span>
                                        break;
                                    case OrderStatus.DeliveryFailed:
                                        <span class="adm-pill adm-pill-rose">Giao thất bại</span>
                                        break;
                                    default:
                                        <span class="adm-pill adm-pill-faint">@order.Status</span>
                                        break;
                                }
                            </td>

                            <!-- ACTIONS (EXACT DASHBOARD REPLICA) -->
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (isPending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <input type="hidden" name="newStatus" value="@OrderStatus.Confirmed" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit"
                                                    class="adm-btn-table-action"
                                                    style="background: #0F172A !important; color: #FFFFFF !important; border-color: #0F172A !important;"
                                                    title="Duyệt đơn ngay">
                                                <i class="bi bi-check-lg"></i> <span>Duyệt</span>
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="Details" asp-route-id="@order.Id"
                                       class="adm-btn-table-action" title="Chi tiết đơn hàng">
                                        <i class="bi bi-eye"></i> <span>Chi tiết</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- 4. PAGINATION -->
@if (ViewBag.PageCount > 1)
{
    var routes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var entry in ViewContext.HttpContext.Request.Query)
    {
        if (!entry.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
            routes[entry.Key] = entry.Value.ToString();
    }

    var pageNum = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-2 my-4" aria-label="Phân trang đơn hàng">
        @if (pageNum > 1)
        {
            <a asp-action="Index" asp-all-route-data="routes" asp-route-page="@(pageNum - 1)" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-chevron-left"></i> Trang trước
            </a>
        }
        <span class="px-3 py-1 font-monospace text-dark fw-bold small">Trang @(pageNum) / @ViewBag.PageCount</span>
        @if (pageNum < ViewBag.PageCount)
        {
            <a asp-action="Index" asp-all-route-data="routes" asp-route-page="@(pageNum + 1)" class="adm-action-btn adm-btn-secondary">
                Trang sau <i class="bi bi-chevron-right"></i>
            </a>
        }
    </nav>
}

@section Scripts {
    <script>
        function copyAdmText(btn, text) {
            if (!navigator.clipboard) return;
            navigator.clipboard.writeText(text).then(() => {
                const icon = btn.querySelector('i');
                if (icon) {
                    const originalClass = icon.className;
                    icon.className = 'bi bi-check2 text-success';
                    setTimeout(() => { icon.className = originalClass; }, 1500);
                }
            });
        }

        function exportOrdersToCSV() {
            const table = document.getElementById('ordersTable');
            if (!table) return;

            let csv = [];
            const rows = table.querySelectorAll('tr');

            for (let i = 0; i < rows.length; i++) {
                const row = [];
                const cols = rows[i].querySelectorAll('th, td');
                for (let j = 0; j < cols.length - 1; j++) {
                    let text = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/\s+/g, ' ').trim();
                    text = text.replace(/"/g, '""');
                    row.push('"' + text + '"');
                }
                if (row.length > 0) {
                    csv.push(row.join(','));
                }
            }

            const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            const downloadLink = document.createElement("a");
            downloadLink.download = "DonHang_HNMTSHOP_" + new Date().toISOString().slice(0, 10) + ".csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
