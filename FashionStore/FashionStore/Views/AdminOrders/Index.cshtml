@model List<FashionStore.Models.Entities.Order>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var selectedStatus = ViewBag.SelectedStatus as OrderStatus?;

    string GetStatusName(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý",
        OrderStatus.Shipping => "Đang giao",
        OrderStatus.Delivered => "Đã giao",
        OrderStatus.Cancelled => "Đã hủy",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã hoàn hàng",
        _ => status.ToString()
    };

    string GetStatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "bg-warning text-dark",
        OrderStatus.Confirmed => "bg-info text-dark",
        OrderStatus.Processing => "bg-primary",
        OrderStatus.Shipping => "bg-primary",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        OrderStatus.DeliveryFailed => "bg-danger",
        OrderStatus.Returned => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <div class="text-muted small text-uppercase mb-1">Administration</div>
        <h2 class="fw-bold mb-1">Quản lý đơn hàng</h2>
        <p class="text-muted mb-0">Theo dõi, duyệt đơn và điều phối xử lý đơn hàng của cửa hàng.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <select name="status" class="form-select">
                        <option value="">Tất cả trạng thái đơn</option>
                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                        {
                            if (selectedStatus == status)
                            {
                                <option value="@((int)status)" selected>
                                    @GetStatusName(status)
                                </option>
                            }
                            else
                            {
                                <option value="@((int)status)">
                                    @GetStatusName(status)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-funnel me-1"></i> Lọc đơn hàng
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="py-4">
                <i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Chưa có đơn hàng nào</h5>
                <p class="text-muted">Đơn hàng mới của khách sẽ xuất hiện tại đây.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã đơn</th>
                            <th>Người nhận</th>
                            <th>Ngày đặt</th>
                            <th>Thanh toán</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@order.OrderCode</td>
                                <td>
                                    <div class="fw-semibold">@order.ReceiverName</div>
                                    <small class="text-muted">@order.Phone</small>
                                </td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div><small class="fw-semibold">@order.PaymentMethod</small></div>
                                    @if (order.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đã thanh toán</span>
                                    }
                                    else if (order.PaymentStatus == PaymentStatus.Pending)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Chưa thanh toán</span>
                                    }
                                    else if (order.PaymentStatus == PaymentStatus.Refunded)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Đã hoàn tiền</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Thất bại</span>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@order.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="badge @GetStatusBadge(order.Status)">
                                        @GetStatusName(order.Status)
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
