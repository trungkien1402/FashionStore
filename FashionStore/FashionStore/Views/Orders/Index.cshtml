</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('hnmtOrderSearchInput');
    const searchClearBtn = document.getElementById('hnmtSearchClearBtn');
    const statusSelect = document.getElementById('hnmtOrderStatusSelect');
    const dateFromInput = document.getElementById('hnmtOrderDateFrom');
    const dateToInput = document.getElementById('hnmtOrderDateTo');
    const resetBtn = document.getElementById('hnmtFilterResetBtn');
    const cards = document.querySelectorAll('.hnmt-order-card');
    const noResultsBox = document.getElementById('hnmtNoFilterResults');
    const statusTabs = document.querySelectorAll('.hnmt-status-tab');

    let currentKeyword = '';
    let currentStatus = 'all';
    let currentFromDate = '';
    let currentToDate = '';

    // Click chuyển tab trạng thái
    statusTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            statusTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            currentStatus = tab.dataset.status || 'all';
            if (statusSelect) {
                statusSelect.value = currentStatus;
            }
            applyOrderFilters();
        });
    });

    function applyOrderFilters() {
        let visibleCount = 0;

        cards.forEach(card => {
            const cardGroup = card.getAttribute('data-group') || '';
            const cardSearch = (card.getAttribute('data-search') || '').toLowerCase();
            const cardDate = card.getAttribute('data-date') || '';

            // 1. Kiểm tra trạng thái
            let statusMatch = (currentStatus === 'all');
            if (!statusMatch) {
                statusMatch = (cardGroup === currentStatus);
            }

            // 2. Kiểm tra từ khóa
            let keywordMatch = true;
            if (currentKeyword.trim()) {
                const words = currentKeyword.toLowerCase().trim().split(/\s+/);
                keywordMatch = words.every(word => cardSearch.includes(word));
            }

            // 3. Kiểm tra ngày tháng
            let dateMatch = true;
            if (currentFromDate && cardDate < currentFromDate) dateMatch = false;
            if (currentToDate && cardDate > currentToDate) dateMatch = false;

            if (statusMatch && keywordMatch && dateMatch) {
                card.classList.remove('is-hidden');
                visibleCount++;
            } else {
                card.classList.add('is-hidden');
            }
        });

        if (noResultsBox) {
            noResultsBox.style.display = (visibleCount === 0) ? 'block' : 'none';
        }

        if (searchClearBtn) {
            searchClearBtn.style.display = currentKeyword ? 'inline-flex' : 'none';
        }
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', (e) => {
            currentStatus = e.target.value;
            statusTabs.forEach(t => {
                if (t.dataset.status === currentStatus) t.classList.add('active');
                else t.classList.remove('active');
            });
            applyOrderFilters();
        });
    }

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            currentKeyword = e.target.value;
            applyOrderFilters();
        });
    }

    if (searchClearBtn) {
        searchClearBtn.addEventListener('click', () => {
            if (searchInput) {
                searchInput.value = '';
                currentKeyword = '';
                searchInput.focus();
                applyOrderFilters();
            }
        });
    }

    if (dateFromInput) {
        dateFromInput.addEventListener('change', (e) => {
            currentFromDate = e.target.value;
            applyOrderFilters();
        });
    }

    if (dateToInput) {
        dateToInput.addEventListener('change', (e) => {
            currentToDate = e.target.value;
            applyOrderFilters();
        });
    }

    window.resetAllOrderFilters = function() {
        currentStatus = 'all';
        currentKeyword = '';
        currentFromDate = '';
        currentToDate = '';

        statusTabs.forEach(t => {
            if (t.dataset.status === 'all') t.classList.add('active');
            else t.classList.remove('active');
        });

        if (statusSelect) statusSelect.value = 'all';
        if (searchInput) searchInput.value = '';
        if (dateFromInput) dateFromInput.value = '';
        if (dateToInput) dateToInput.value = '';

        applyOrderFilters();
    };

    if (resetBtn) {
        resetBtn.addEventListener('click', window.resetAllOrderFilters);
    }

    // ĐỒNG HỒ ĐẾM NGƯỢC VIETQR
    const qrCounters = document.querySelectorAll('[data-qr-countdown]');
    if (qrCounters.length > 0) {
        setInterval(() => {
            qrCounters.forEach(el => {
                let webSec = parseInt(el.getAttribute('data-web-sec'), 10) || 0;
                let actualSec = parseInt(el.getAttribute('data-actual-sec'), 10) || 0;

                if (actualSec <= 0) {
                    el.innerHTML = '<span class="hnmt-qr-pill is-expired"><span>Mã QR hết hạn</span></span>';
                    return;
                }

                if (webSec > 0) {
                    webSec--;
                    el.setAttribute('data-web-sec', webSec);
                    const timer = el.querySelector('.qr-timer');
                    if (timer) {
                        const m = String(Math.floor(webSec / 60)).padStart(2, '0');
                        const s = String(webSec % 60).padStart(2, '0');
                        timer.textContent = `${m}:${s}`;
                    }
                } else if (actualSec > 0) {
                    actualSec--;
                    el.setAttribute('data-actual-sec', actualSec);
                    let gracePill = el.querySelector('.hnmt-qr-pill.is-grace');
                    if (!gracePill) {
                        el.innerHTML = '<span class="hnmt-qr-pill is-grace"><span class="hnmt-status-dot"></span><span>Vùng đệm 5p: <strong class="qr-timer"></strong></span></span>';
                        gracePill = el.querySelector('.hnmt-qr-pill.is-grace');
                    }
                    const timer = el.querySelector('.qr-timer');
                    if (timer) {
                        const m = String(Math.floor(actualSec / 60)).padStart(2, '0');
                        const s = String(actualSec % 60).padStart(2, '0');
                        timer.textContent = `${m}:${s}`;
                    }
                }
            });
        }, 1000);
    }
});
</script>

