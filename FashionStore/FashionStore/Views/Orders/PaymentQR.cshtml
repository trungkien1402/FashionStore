@model FashionStore.Models.Entities.Order
@using FashionStore.Models.ViewModels
@using System.Globalization
@{
    Layout = "_PaymentLayout";
    ViewData["Title"] = "Thanh toán đơn hàng #" + Model.OrderCode;
    var info = ViewBag.PaymentInfo as PaymentInfoViewModel;
    var canPay = info?.CanPay == true && !string.IsNullOrWhiteSpace(info.QrImageUrl);
    var reported = info?.TransferReported ?? Model.TransferReportedAt.HasValue;
    string Money(decimal amount) => amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + " ₫";
}

<section class="payment-page" id="paymentPage" data-can-pay="@(canPay ? "true" : "false")" data-reported="@(reported ? "true" : "false")"
         data-status-url="@Url.Action("CheckPaymentStatus", "Orders", new { orderId = Model.Id })"
         data-details-url="@Url.Action("Details", "Orders", new { id = Model.Id })"
         data-success-url="@Url.Action("Success", "Orders", new { id = Model.Id })"
         data-web-seconds="@(ViewBag.RemainingWebSeconds ?? 600)"
         data-actual-seconds="@(ViewBag.RemainingActualSeconds ?? 900)">

    <!-- TIẾN TRÌNH 3 BƯỚC -->
    <nav class="hnmt-pay-steps" aria-label="Tiến trình đặt hàng">
        <div class="hnmt-pay-step is-done">
            <span class="hnmt-step-num">✓</span>
            <span class="hnmt-step-name">Thông tin</span>
        </div>
        <span class="hnmt-pay-step-line"></span>
        <div class="hnmt-pay-step is-active" aria-current="step">
            <span class="hnmt-step-num">02</span>
            <span class="hnmt-step-name">Thanh toán</span>
        </div>
        <span class="hnmt-pay-step-line"></span>
        <div class="hnmt-pay-step">
            <span class="hnmt-step-num">03</span>
            <span class="hnmt-step-name">Hoàn tất</span>
        </div>
    </nav>

    <!-- HEADING CHUẨN FINTECH -->
    <div class="hnmt-pay-heading">
        <h1 class="hnmt-pay-title">Thanh toán đơn hàng #@Model.OrderCode</h1>
        <p class="hnmt-pay-subtitle">Quét mã VietQR hoặc chuyển khoản theo thông tin bên dưới để hoàn tất đơn hàng.</p>
    </div>

    <div class="pay-grid">
        <!-- CỘT TRÁI: KHUNG QUÉT MÃ QR & TRẠNG THÁI REALTIME -->
        <article class="pay-panel">
            <div class="pay-panel-top">
                <h2 class="hnmt-card-title-clean">Mã VietQR thanh toán 24/7</h2>
                <span class="pay-pill">Chuyển khoản liên ngân hàng</span>
            </div>

            <div id="paymentClosed" class="pay-closed @(canPay ? "d-none" : "")" role="alert">
                <span class="pay-state-icon" aria-hidden="true">!</span>
                <h2>Thông tin thanh toán đã thay đổi</h2>
                <p id="paymentClosedText">Đơn hàng hiện không nhận thanh toán QR. Vui lòng xem trạng thái mới nhất.</p>
                <a asp-action="Details" asp-route-id="@Model.Id" class="pay-button">Xem chi tiết đơn hàng</a>
            </div>

            @if (canPay && info != null)
            {
                <div id="paymentControlsContainer">
                    <!-- COUNTDOWN BANNER -->
                    <div class="pay-countdown-banner" id="payCountdownBanner">
                        <div class="pay-countdown-icon"><i class="bi bi-clock-history"></i></div>
                        <div class="pay-countdown-content">
                            <span class="pay-countdown-label" id="payCountdownLabel">Thời gian quét mã QR còn:</span>
                            <span class="pay-countdown-time" id="payCountdownTime">10:00</span>
                        </div>
                    </div>

                    <!-- GRACE ALERT -->
                    <div class="pay-grace-alert d-none" id="payGraceAlert" role="alert">
                        <div class="pay-grace-badge">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>ĐÃ HẾT 10 PHÚT QUÉT MÃ QR</span>
                        </div>
                        <p>Nếu bạn <strong>vừa bấm chuyển khoản ở những giây cuối</strong>, hệ thống vẫn đang dành <strong>5 phút vùng đệm an toàn</strong> để nhận và đối soát tiền. Vui lòng bấm ngay nút <strong>"Tôi đã chuyển khoản"</strong> bên dưới!</p>
                    </div>

                    <!-- QR IMAGE BOX -->
                    <div class="pay-qr-frame">
                        <div class="pay-qr-corners">
                            <img id="qrImageElement" src="@info.QrImageUrl" alt="Mã QR thanh toán @Money(info.Amount) cho đơn @Model.OrderCode" width="240" height="280" />
                            <div class="pay-qr-overlay d-none" id="payQrOverlay">
                                <i class="bi bi-shield-lock-fill"></i>
                                <strong>MÃ QR ĐÃ ĐÓNG</strong>
                                <small>Đã qua 10 phút quét mã</small>
                            </div>
                        </div>
                    </div>

                    <div id="qrLoadError" class="pay-notice d-none" role="alert">
                        Không tải được mã QR. Bạn có thể chuyển khoản thủ công theo thông tin bên phải. 
                        <button id="retryQr" type="button" class="pay-text-button">Thử tải lại</button>
                    </div>

                    <p class="pay-qr-caption">Mở ứng dụng ngân hàng bất kỳ và chọn tính năng <strong>Quét mã QR</strong></p>

                    <!-- THÔNG TIN CHUYỂN KHOẢN THỦ CÔNG (CHO AI KHÔNG QUÉT ĐƯỢC QR) -->
                    <div class="pay-bank-card">
                        <div class="pay-bank-card-title">
                            <i class="bi bi-bank"></i>
                            <span>Thông tin chuyển khoản thủ công</span>
                        </div>

                        <div class="pay-transfer-row">
                            <div class="pay-transfer-info">
                                <span class="pay-transfer-label">Ngân hàng thụ hưởng</span>
                                <span class="pay-transfer-val">@info.BankName (@info.AccountName)</span>
                            </div>
                        </div>

                        <div class="pay-transfer-row">
                            <div class="pay-transfer-info">
                                <span class="pay-transfer-label">Số tài khoản nhận tiền</span>
                                <span class="pay-transfer-val">@info.AccountNo</span>
                            </div>
                            <button type="button" class="pay-copy-btn" data-copy="@info.AccountNo" aria-label="Sao chép số tài khoản">
                                <span>Sao chép</span>
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>

                        <div class="pay-transfer-row">
                            <div class="pay-transfer-info">
                                <span class="pay-transfer-label">Số tiền chính xác</span>
                                <span class="pay-transfer-val text-primary">@Money(info.Amount)</span>
                            </div>
                            <button type="button" class="pay-copy-btn" data-copy="@info.Amount.ToString("0")" aria-label="Sao chép số tiền">
                                <span>Sao chép</span>
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>

                        <div class="pay-transfer-row">
                            <div class="pay-transfer-info">
                                <span class="pay-transfer-label">Nội dung chuyển khoản (bắt buộc)</span>
                                <span class="pay-transfer-val text-danger">@info.TransferContent</span>
                            </div>
                            <button type="button" class="pay-copy-btn" data-copy="@info.TransferContent" aria-label="Sao chép nội dung">
                                <span>Sao chép</span>
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>

                        <p class="pay-help-text">Vui lòng giữ đúng số tiền và nội dung để hệ thống nhận diện tự động.</p>
                    </div>

                    <!-- FORM BÁO ĐÃ CHUYỂN KHOẢN -->
                    <form id="reportTransferForm" method="post" asp-controller="Orders" asp-action="ReportTransfer" hidden>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                    </form>
                    <div id="reportFeedback" class="d-none" role="status" aria-live="polite"></div>

                    <button id="btnReportTransfer" class="pay-button" type="button" disabled="@reported">
                        <span>@(reported ? "Đã gửi thông báo chuyển khoản" : "Tôi đã chuyển khoản")</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>

                    <div class="mt-3 text-center">
                        <button id="btnSimulateSePay" type="button" class="btn btn-sm btn-outline-success" style="font-size: 12px; border-radius: 999px; padding: 4px 14px;">
                            <i class="bi bi-lightning-charge-fill"></i> Giả lập SePay Webhook (Thanh toán tức thì)
                        </button>
                    </div>

                    <!-- REALTIME RADAR POLLING STATUS -->
                    <div class="pay-status-ping" id="pollingAlert">
                        <span class="pay-radar-dot" aria-hidden="true"></span>
                        <span id="pollingStatusText" aria-live="polite">
                            @(reported ? "Đã thông báo. Chờ cửa hàng xác nhận; không chuyển tiền lần nữa." : "Đang chờ tín hiệu giao dịch từ ngân hàng...")
                        </span>
                    </div>
                </div>
            }
        </article>

        <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & HƯỚNG DẪN 3 BƯỚC -->
        <aside class="pay-sidebar">
            <div class="pay-summary">
                <div class="hnmt-summary-header">
                    <h3 class="hnmt-summary-title">Tóm tắt thanh toán</h3>
                    <span class="hnmt-summary-count">#@Model.OrderCode</span>
                </div>

                <div class="hnmt-summary-calc">
                    <div class="hnmt-calc-row">
                        <span class="hnmt-calc-label">Tạm tính tiền hàng</span>
                        <span class="hnmt-calc-val">@Money(Model.SubTotal)</span>
                    </div>
                    <div class="hnmt-calc-row">
                        <span class="hnmt-calc-label">Phí vận chuyển</span>
                        <span class="hnmt-calc-val">@(Model.ShippingFee > 0 ? Money(Model.ShippingFee) : "Miễn phí")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="hnmt-calc-row">
                            <span class="hnmt-calc-label">Giảm giá voucher</span>
                            <span class="hnmt-calc-val text-success">−@Money(Model.DiscountAmount)</span>
                        </div>
                    }
                </div>

                <div class="hnmt-summary-divider"></div>

                <div class="hnmt-summary-grand-total">
                    <div>
                        <div class="hnmt-total-label">TỔNG THANH TOÁN</div>
                        <div class="hnmt-vat-note">Đã bao gồm VAT & phí ship</div>
                    </div>
                    <div class="hnmt-total-amount">@Money(Model.TotalAmount)</div>
                </div>

                <a class="pay-detail-link" asp-action="Details" asp-route-id="@Model.Id">
                    <span>Xem chi tiết kiện hàng</span>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <!-- HƯỚNG DẪN THANH TOÁN 3 BƯỚC -->
            <div class="pay-guide-card">
                <h4 class="pay-guide-title">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Hướng dẫn 3 bước thanh toán</span>
                </h4>
                <ul class="pay-guide-steps">
                    <li class="pay-guide-step-item">
                        <span class="pay-guide-step-num">01</span>
                        <div class="pay-guide-step-content">
                            <strong>Quét mã QR qua ứng dụng ngân hàng</strong>
                            <p>Mã đã điền sẵn số tiền và mã đơn hàng của bạn.</p>
                        </div>
                    </li>
                    <li class="pay-guide-step-item">
                        <span class="pay-guide-step-num">02</span>
                        <div class="pay-guide-step-content">
                            <strong>Xác nhận giao dịch chuyển tiền</strong>
                            <p>Kiểm tra số tiền và hoàn tất giao dịch trên app ngân hàng.</p>
                        </div>
                    </li>
                    <li class="pay-guide-step-item">
                        <span class="pay-guide-step-num">03</span>
                        <div class="pay-guide-step-content">
                            <strong>Hệ thống tự động kích hoạt đơn hàng</strong>
                            <p>Sau khi tiền vào tài khoản, đơn hàng sẽ tự động chuyển trạng thái ngay.</p>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="hnmt-sidebar-help-box">
                <i class="bi bi-headset"></i>
                <span>Gặp sự cố chuyển tiền? Gọi ngay hotline <strong>1900 8888</strong></span>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/payment.js" asp-append-version="true"></script>
}
