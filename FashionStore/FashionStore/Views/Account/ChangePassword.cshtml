@model FashionStore.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="container py-5" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Profile" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại hồ sơ tài khoản
        </a>
        <h1 class="display-6 mt-2" style="font-family:'Playfair Display',serif;">
            Đổi mật khẩu
        </h1>
        <p class="text-muted">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border p-4 shadow-sm">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                <input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu bạn đang sử dụng" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 8 ký tự, gồm chữ hoa và số" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Profile" class="btn btn-outline-secondary">Hủy bỏ</a>
                <button type="submit" class="fs-btn fs-btn-dark px-4">
                    ĐỔI MẬT KHẨU
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
