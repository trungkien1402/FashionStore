@model FashionStore.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ tài khoản";
}

<section class="container py-5" style="max-width: 900px;">
    <div class="mb-4">
        <div class="text-uppercase text-muted small mb-2" style="letter-spacing: 1.5px;">Tài khoản cá nhân</div>
        <h1 class="display-6" style="font-family:'Playfair Display',serif;">
            Hồ sơ của bạn
        </h1>
        <p class="text-muted">Quản lý thông tin cá nhân và thiết lập tài khoản.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border p-4 text-center">
                <div class="avatar-circle mx-auto mb-3 bg-dark text-white fw-bold d-flex align-items-center justify-content-center fs-2"
                     style="width: 80px; height: 80px; border-radius: 50%;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div class="badge bg-secondary mb-3">
                    @Model.Role
                </div>

                <hr />

                <div class="d-grid gap-2 text-start">
                    <a asp-action="Profile" class="btn btn-dark btn-sm text-start">
                        <i class="bi bi-person me-2"></i> Thông tin cá nhân
                    </a>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm text-start">
                        <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                    </a>
                    @if (User.IsInRole("Customer"))
                    {
                        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-bag me-2"></i> Đơn hàng của tôi
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Cập nhật thông tin</h5>

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Địa chỉ Email (Tên đăng nhập)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                        <div class="form-text small">Email không thể thay đổi vì dùng để xác thực và nhận thông báo đơn hàng.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small">Ngày tham gia</label>
                        <input type="text" class="form-control bg-light" value="@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" readonly disabled />
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="ChangePassword" class="text-decoration-none small">
                            <i class="bi bi-key me-1"></i> Bạn muốn đổi mật khẩu?
                        </a>
                        <button type="submit" class="fs-btn fs-btn-dark px-4">
                            LƯU THÔNG TIN
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
