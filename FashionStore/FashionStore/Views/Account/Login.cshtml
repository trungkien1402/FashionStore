@model FashionStore.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="fs-auth-page">
    <div class="fs-auth-image"
         style="background-image: url('https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1200&q=85')">
        <div class="fs-auth-image-content">
            <p class="text-uppercase small mb-3"
               style="letter-spacing: 3px;">FashionStore Collection</p>
            <h2>Style is a way to say who you are.</h2>
            <p class="mt-3 mb-0">
                Khám phá phong cách. Thể hiện cá tính.
            </p>
        </div>
    </div>

    <div class="fs-auth-panel">
        <div class="fs-auth-form">
            <p class="text-uppercase small fw-bold mb-3"
               style="letter-spacing: 2px; color: #a17c55;">
                Welcome back
            </p>

            <h1>Chào mừng trở lại</h1>
            <p class="fs-auth-subtitle">
                Đăng nhập để tiếp tục trải nghiệm mua sắm tại FashionStore.
            </p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="fs-alert"></div>

                <div class="fs-auth-field">
                    <label asp-for="Email" class="fs-form-label"></label>
                    <input asp-for="Email"
                           class="fs-form-control"
                           placeholder="name@example.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email"
                          class="fs-validation"></span>
                </div>

                <div class="fs-auth-field">
                    <label asp-for="Password" class="fs-form-label"></label>
                    <input asp-for="Password"
                           class="fs-form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password" />
                    <span asp-validation-for="Password"
                          class="fs-validation"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe"
                               class="form-check-input" />
                        <label asp-for="RememberMe"
                               class="form-check-label small"></label>
                    </div>
                </div>

                <button type="submit" class="fs-btn w-100">
                    Đăng nhập
                </button>
            </form>

            <div class="fs-auth-bottom">
                Bạn chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register">
                    Đăng ký ngay
                </a>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index"
                   class="small text-muted">
                    ← Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
