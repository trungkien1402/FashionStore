@model List<FashionStore.Models.Entities.SupportRequest>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Quản lý Yêu cầu Hỗ trợ";
    var selectedStatus = ViewBag.SelectedStatus as SupportRequestStatus?;
    var searchKeyword = ViewBag.SearchKeyword as string;
    var countPending = (int)(ViewBag.CountPending ?? 0);
    var countInProgress = (int)(ViewBag.CountInProgress ?? 0);
    var countResolved = (int)(ViewBag.CountResolved ?? 0);
    var countClosed = (int)(ViewBag.CountClosed ?? 0);
    var totalCount = countPending + countInProgress + countResolved + countClosed;
}

<!-- 1. EXECUTIVE HEADER (ATELIER STANDARD) -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@totalCount ticket</span>
            </div>
            <h1 class="adm-title-main">Yêu cầu Hỗ trợ Khách hàng</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="SupportChat" asp-action="Inbox" class="adm-action-btn adm-btn-primary">
                <i class="bi bi-chat-dots"></i> <span>Chat trực tiếp</span>
            </a>
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" title="Làm mới">
                <i class="bi bi-arrow-clockwise"></i> <span>Làm mới</span>
            </a>
        </div>
    </div>

    <!-- METRIC STAT CARDS -->
    <div class="row row-cols-2 row-cols-xl-4 g-3 mb-4">
        <div class="col">
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Pending)" class="adm-card p-3 d-block text-decoration-none shadow-sm" style="transition: transform 0.2s ease;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-semibold">Chờ xử lý</span>
                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #B45309;">Mới</span>
                </div>
                <strong class="d-block fs-3 font-monospace adm-heading mt-2" style="color: #F59E0B;">@countPending</strong>
            </a>
        </div>
        <div class="col">
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.InProgress)" class="adm-card p-3 d-block text-decoration-none shadow-sm" style="transition: transform 0.2s ease;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-semibold">Đang xử lý</span>
                    <i class="bi bi-gear-wide-connected text-primary"></i>
                </div>
                <strong class="d-block fs-3 font-monospace adm-heading mt-2" style="color: #2563EB;">@countInProgress</strong>
            </a>
        </div>
        <div class="col">
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Resolved)" class="adm-card p-3 d-block text-decoration-none shadow-sm" style="transition: transform 0.2s ease;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-semibold">Đã giải quyết</span>
                    <i class="bi bi-check-circle-fill text-success"></i>
                </div>
                <strong class="d-block fs-3 font-monospace adm-heading mt-2" style="color: #10B981;">@countResolved</strong>
            </a>
        </div>
        <div class="col">
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Closed)" class="adm-card p-3 d-block text-decoration-none shadow-sm" style="transition: transform 0.2s ease;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-semibold">Đã đóng</span>
                    <i class="bi bi-archive text-muted"></i>
                </div>
                <strong class="d-block fs-3 font-monospace adm-heading mt-2 text-muted">@countClosed</strong>
            </a>
        </div>
    </div>

    <!-- TIER 1: SEGMENTED CONTROLS -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="adm-segmented-control" role="group" aria-label="Lọc trạng thái yêu cầu">
            <a asp-action="Index" asp-route-search="@searchKeyword"
               class="adm-segment @(selectedStatus == null ? "active" : "")">Tất cả (@totalCount)</a>
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Pending)" asp-route-search="@searchKeyword"
               class="adm-segment @(selectedStatus == SupportRequestStatus.Pending ? "active" : "")">Chờ xử lý (@countPending)</a>
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.InProgress)" asp-route-search="@searchKeyword"
               class="adm-segment @(selectedStatus == SupportRequestStatus.InProgress ? "active" : "")">Đang xử lý (@countInProgress)</a>
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Resolved)" asp-route-search="@searchKeyword"
               class="adm-segment @(selectedStatus == SupportRequestStatus.Resolved ? "active" : "")">Đã giải quyết (@countResolved)</a>
            <a asp-action="Index" asp-route-status="@((int)SupportRequestStatus.Closed)" asp-route-search="@searchKeyword"
               class="adm-segment @(selectedStatus == SupportRequestStatus.Closed ? "active" : "")">Đã đóng (@countClosed)</a>
        </div>
    </div>

    <!-- TIER 2: SEARCH INPUT -->
    <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
        @if (selectedStatus.HasValue)
        {
            <input type="hidden" name="status" value="@((int)selectedStatus.Value)" />
        }

        <div class="adm-search-input-group-v2 flex-grow-1" style="min-width: 260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="search" maxlength="100" value="@searchKeyword"
                   placeholder="Tìm kiếm theo họ tên, email, SĐT hoặc mã đơn hàng..."
                   class="adm-search-input-v2"
                   style="padding-left: 42px !important; padding-right: 14px !important;" />
        </div>

        @if (!string.IsNullOrWhiteSpace(searchKeyword) || selectedStatus.HasValue)
        {
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" style="height: 38px;" title="Đặt lại bộ lọc">
                <i class="bi bi-x-lg"></i> <span>Đặt lại</span>
            </a>
        }
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SUPPORT REQUESTS TABLE -->
@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Không có yêu cầu hỗ trợ nào</h5>
        <p class="text-muted small mb-0">Hiện chưa có ticket nào phù hợp với bộ lọc hiện tại.</p>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">TICKET</th>
                        <th>KHÁCH HÀNG</th>
                        <th>CHỦ ĐỀ & NỘI DUNG</th>
                        <th>MÃ ĐƠN</th>
                        <th>THỜI GIAN GỬI</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="font-monospace fw-bold" style="color: var(--adm-gold, #D97706); font-size: 0.85rem;">#@item.Id</span>
                            </td>
                            <td>
                                <div class="fw-bold adm-heading">@item.FullName</div>
                                <div class="text-muted small font-monospace mt-0.5">
                                    <i class="bi bi-telephone me-1"></i>@item.PhoneNumber
                                </div>
                                <div class="text-muted small" style="font-size: 0.75rem;">
                                    <i class="bi bi-envelope me-1"></i>@item.Email
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold adm-heading" style="font-size: 0.88rem;">@item.Subject</div>
                                <div class="text-muted text-truncate mt-0.5" style="max-width: 280px; font-size: 0.78rem;">
                                    @item.Message
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.OrderCode))
                                {
                                    <span class="badge font-monospace" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1); font-size: 0.75rem;">
                                        #@item.OrderCode
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                <div class="adm-text-contrast small">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case SupportRequestStatus.Pending:
                                        <span class="adm-pill adm-pill-amber">Chờ xử lý</span>
                                        break;
                                    case SupportRequestStatus.InProgress:
                                        <span class="adm-pill adm-pill-blue">Đang xử lý</span>
                                        break;
                                    case SupportRequestStatus.Resolved:
                                        <span class="adm-pill adm-pill-emerald">Đã giải quyết</span>
                                        break;
                                    case SupportRequestStatus.Closed:
                                        <span class="adm-pill adm-pill-faint">Đã đóng</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="adm-btn-table-action" title="Xem chi tiết ticket">
                                        <i class="bi bi-eye"></i> <span>Chi tiết</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (ViewBag.PageCount > 1)
{
    var current = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3 my-4" aria-label="Phân trang yêu cầu hỗ trợ">
        @if (current > 1) { 
            <a asp-action="Index" asp-route-page="@(current - 1)" asp-route-status="@selectedStatus" asp-route-search="@searchKeyword" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-chevron-left me-1"></i> Trang trước
            </a> 
        }
        <span class="text-muted small fw-semibold">Trang @current / @ViewBag.PageCount</span>
        @if (current < ViewBag.PageCount) { 
            <a asp-action="Index" asp-route-page="@(current + 1)" asp-route-status="@selectedStatus" asp-route-search="@searchKeyword" class="adm-action-btn adm-btn-secondary">
                Trang sau <i class="bi bi-chevron-right ms-1"></i>
            </a> 
        }
    </nav>
}
