@model List<FashionStore.Models.Entities.ProductVariant>

@{
    ViewData["Title"] = "Quản lý biến thể sản phẩm";
    var product = ViewBag.Product as FashionStore.Models.Entities.Product;
    var totalStock = ViewBag.TotalStock is long ts ? ts : (Model?.Sum(x => x.StockQuantity) ?? 0);
    var countAll = ViewBag.CountAll is int ca ? ca : (Model?.Count ?? 0);
    var countLow = ViewBag.CountLow is int cl ? cl : 0;
    var countOut = ViewBag.CountOut is int co ? co : 0;
    var stockFilter = ViewBag.StockFilter as string;

    string ResolveColorCss(string? colorName)
    {
        if (string.IsNullOrWhiteSpace(colorName)) return "#18181B";
        var norm = colorName.Trim().ToLowerInvariant();

        if (norm.Contains('/') || norm.Contains('&'))
        {
            var parts = norm.Split(new[] { '/', '&' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
            {
                var h1 = SingleColorHex(parts[0].Trim());
                var h2 = SingleColorHex(parts[1].Trim());
                return $"linear-gradient(135deg, {h1} 50%, {h2} 50%)";
            }
        }
        return SingleColorHex(norm);
    }

    string SingleColorHex(string name) => name switch
    {
        "đen" or "black" => "#18181B",
        "trắng" or "white" => "#FFFFFF",
        "xám" or "ghi" or "gray" or "grey" => "#71717A",
        "be" or "kem" or "cream" or "beige" or "yến mạch" => "#E5D9C5",
        "nâu" or "brown" or "cafe" => "#78350F",
        "xanh navy" or "navy" or "xanh đen" => "#1E3A8A",
        "xanh rêu" or "rêu" or "olive" => "#4D7C0F",
        "xanh lá" or "green" => "#16A34A",
        "xanh dương" or "xanh" or "blue" => "#2563EB",
        "xanh cobalt" or "cobalt" => "#1D4ED8",
        "xanh mint" or "mint" => "#6EE7B7",
        "xanh bơ" => "#A3E635",
        "đỏ" or "red" => "#DC2626",
        "đỏ rượu" or "burgundy" or "maroon" => "#881337",
        "hồng" or "pink" => "#F472B6",
        "hồng pastel" => "#FBCFE8",
        "cam" or "orange" => "#EA580C",
        "vàng" or "yellow" => "#EAB308",
        "tím" or "purple" => "#7C3AED",
        "bạc" or "silver" => "#CBD5E1",
        "vàng đồng" or "gold" => "#D97706",
        _ => "#71717A"
    };
}

<!-- 1. BREADCRUMB & HEADER -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <a asp-controller="AdminProducts" asp-action="Index" class="adm-btn-action-secondary" style="height: 32px; padding: 0 12px; font-size: 0.78rem;">
            <i class="bi bi-arrow-left"></i>
            <span>Quay lại Showroom Sản phẩm</span>
        </a>
        <span class="text-muted" style="font-size: 0.75rem;">/</span>
        <span class="text-muted" style="font-size: 0.75rem;">HNMT ATELIER · QUẢN LÝ BIẾN THỂ</span>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            @if (product != null && !string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img src="@product.ImageUrl" alt="@product.Name" class="adm-prod-thumb" style="width: 52px; height: 52px;" onerror="this.src='/images/placeholder-product.png'" />
            }
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                    <span class="adm-pulse-dot"></span>
                    <span class="adm-kicker-text">PRODUCT VARIANTS &amp; INVENTORY</span>
                    <span class="adm-meta-divider">/</span>
                    <span class="adm-order-count-badge">@(product?.Category?.Name ?? "Sản phẩm")</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="adm-title-main mb-0" style="font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em;">
                        @product?.Name
                    </h1>
                    <span class="adm-pill gray" style="font-size: 0.78rem; font-weight: 600;">
                        Giá gốc: @(product?.Price.ToString("N0") ?? "0") ₫
                    </span>
                </div>
            </div>
        </div>

        <a asp-action="Create" asp-route-productId="@product?.Id" class="adm-action-btn adm-btn-primary" style="height: 38px; padding: 0 16px; font-size: 0.82rem; font-weight: 600;">
            <i class="bi bi-plus-lg"></i>
            <span>Thêm biến thể mới</span>
        </a>
    </div>
</div>

<!-- 2. HERO KPI METRICS (4 TILES - EXACT DASHBOARD REPLICA) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <!-- KPI 1: TỔNG BIẾN THỂ -->
    <div class="col">
        <a asp-action="Index" asp-route-productId="@product?.Id" class="text-decoration-none">
            <div class="adm-kpi-card @(stockFilter == null ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Tổng số biến thể</h2>
                    <div class="adm-kpi-chip gray" title="Tổng phân loại">
                        <i class="bi bi-layers"></i>
                    </div>
                </div>
                <div class="adm-kpi-number">
                    @countAll <span class="adm-kpi-unit">mã</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Các phân loại Size &amp; Màu</span>
                </div>
            </div>
        </a>
    </div>

    <!-- KPI 2: TỔNG TỒN KHO -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Tổng tồn kho khả dụng</h2>
                <div class="adm-kpi-chip blue" title="Tổng sản phẩm">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @totalStock <span class="adm-kpi-unit">sản phẩm</span>
            </div>
            <div class="adm-kpi-footer">
                <span>Kho sẵn sàng giao bán</span>
            </div>
        </div>
    </div>

    <!-- KPI 3: SẮP HẾT HÀNG (<= 5) -->
    <div class="col">
        <a asp-action="Index" asp-route-productId="@product?.Id" asp-route-stock="low" class="text-decoration-none">
            <div class="adm-kpi-card @(stockFilter == "low" ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Sắp hết hàng (≤ 5)</h2>
                    <div class="adm-kpi-chip amber" title="Cần nhập thêm hàng">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
                <div class="adm-kpi-number" style="color: #D97706;">
                    @countLow <span class="adm-kpi-unit">mã</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Mức tồn dưới an toàn</span>
                </div>
            </div>
        </a>
    </div>

    <!-- KPI 4: HẾT HÀNG (0) -->
    <div class="col">
        <a asp-action="Index" asp-route-productId="@product?.Id" asp-route-stock="out" class="text-decoration-none">
            <div class="adm-kpi-card @(stockFilter == "out" ? "border-dark shadow-sm" : "")">
                <div class="adm-kpi-top">
                    <h2 class="adm-kpi-label">Đã hết hàng (0)</h2>
                    <div class="adm-kpi-chip rose" title="Tồn kho bằng 0">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
                <div class="adm-kpi-number" style="color: #DC2626;">
                    @countOut <span class="adm-kpi-unit">mã</span>
                </div>
                <div class="adm-kpi-footer">
                    <span>Cần bổ sung kho gấp</span>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- 3. TIER 1: APPLE SEGMENTED CONTROL TABS -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="adm-segmented-control" role="group" aria-label="Lọc biến thể">
        <a asp-action="Index" asp-route-productId="@product?.Id"
           class="adm-segment @(stockFilter == null ? "active" : "")">
            Tất cả biến thể (@countAll)
        </a>
        <a asp-action="Index" asp-route-productId="@product?.Id" asp-route-stock="low"
           class="adm-segment @(stockFilter == "low" ? "active" : "")">
            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Sắp hết hàng (@countLow)
        </a>
        <a asp-action="Index" asp-route-productId="@product?.Id" asp-route-stock="out"
           class="adm-segment @(stockFilter == "out" ? "active" : "")">
            Hết hàng (@countOut)
        </a>
    </div>

    @if (countLow > 0 && stockFilter != "low")
    {
        <span class="adm-pill amber" style="font-size: 0.74rem;">
            <i class="bi bi-bell-fill me-1"></i> Có @countLow biến thể dưới mức an toàn (≤ 5)
        </span>
    }
</div>

<!-- 4. TABLE VIEW -->
@if (Model == null || !Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-layers fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">@(stockFilter != null ? "Không có biến thể khớp bộ lọc" : "Sản phẩm chưa có Size hay Màu sắc")</h5>
        <p class="text-muted small">Hãy thêm các biến thể để sản phẩm sẵn sàng mở bán trên website.</p>
        <div class="d-flex justify-content-center gap-2 mt-2">
            <a asp-action="Create" asp-route-productId="@product?.Id" class="adm-btn-action-primary" style="width: auto; padding: 0 16px;">
                <i class="bi bi-plus-lg me-1"></i> Thêm biến thể mới
            </a>
            @if (stockFilter != null)
            {
                <a asp-action="Index" asp-route-productId="@product?.Id" class="adm-btn-action-secondary">
                    Xem tất cả biến thể
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="border-color: var(--adm-border);">
                <thead>
                    <tr style="background: var(--adm-surface-hover); font-size: 0.72rem; color: var(--adm-ink-muted); letter-spacing: 0.05em; text-transform: uppercase;">
                        <th class="ps-4 py-2" style="font-weight: 700;">Mã SKU</th>
                        <th class="py-2 text-center" style="font-weight: 700;">Kích thước (Size)</th>
                        <th class="py-2" style="font-weight: 700;">Màu sắc</th>
                        <th class="py-2 text-end" style="font-weight: 700;">Giá biến thể</th>
                        <th class="py-2 text-center" style="font-weight: 700;">Tồn kho</th>
                        <th class="py-2 text-center" style="font-weight: 700;">Trạng thái</th>
                        <th class="py-2 pe-4 text-end" style="font-weight: 700;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var colorCss = ResolveColorCss(item.Color);
                        var isWhite = (item.Color ?? "").ToLower().Contains("trắng");

                        <tr style="border-bottom: 1px solid var(--adm-border); font-size: 0.84rem;">
                            <!-- SKU -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="font-monospace fw-bold" style="color: #0F172A; font-size: 0.84rem;">@item.SKU</span>
                                    <button type="button" class="btn btn-sm adm-btn-table-action" onclick="copyAdmText(this, '@item.SKU')" title="Sao chép SKU" style="height: 26px; padding: 0 8px;">
                                        <i class="bi bi-copy" style="font-size: 0.7rem;"></i>
                                    </button>
                                </div>
                            </td>

                            <!-- SIZE -->
                            <td class="text-center">
                                <span class="adm-pill gray" style="font-size: 0.76rem; font-weight: 700;">
                                    Size @item.Size
                                </span>
                            </td>

                            <!-- COLOR WITH SWATCH DOT -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="adm-swatch-dot" style="background: @colorCss; @(isWhite ? "border: 1px solid #CBD5E1;" : "")"></span>
                                    <span class="fw-medium" style="color: var(--adm-ink);">@item.Color</span>
                                </div>
                            </td>

                            <!-- PRICE -->
                            <td class="text-end fw-semibold" style="color: var(--adm-ink); font-size: 0.88rem;">
                                @item.Price.ToString("N0") ₫
                            </td>

                            <!-- STOCK -->
                            <td class="text-center">
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="adm-pill rose" style="font-size: 0.72rem;">
                                        <span class="adm-pill-dot rose"></span> Hết hàng (0)
                                    </span>
                                }
                                else if (item.StockQuantity <= 5)
                                {
                                    <span class="adm-pill amber" style="font-size: 0.72rem;" title="Mức tồn dưới an toàn">
                                        <span class="adm-pill-dot amber"></span> Còn @item.StockQuantity cái
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold font-monospace" style="color: var(--adm-ink);">@item.StockQuantity</span>
                                    <span class="text-muted small" style="font-size: 0.72rem;">cái</span>
                                }
                            </td>

                            <!-- STATUS -->
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="adm-pill green" style="font-size: 0.72rem;">
                                        <span class="adm-pill-dot green"></span> Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-pill gray" style="font-size: 0.72rem;">
                                        <span class="adm-pill-dot gray"></span> Đã ẩn
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="adm-btn-table-action" style="height: 30px; width: 30px; padding: 0; justify-content: center;" title="Sửa biến thể">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa biến thể @item.SKU?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="adm-btn-table-action" style="height: 30px; width: 30px; padding: 0; justify-content: center; color: #DC2626 !important;" title="Xóa biến thể">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        function copyAdmText(btn, text) {
            if (!navigator.clipboard) return;
            navigator.clipboard.writeText(text).then(() => {
                const icon = btn.querySelector('i');
                if (icon) {
                    const originalClass = icon.className;
                    icon.className = 'bi bi-check-lg text-success';
                    setTimeout(() => { icon.className = originalClass; }, 1500);
                }
            });
        }
    </script>
}
