@model FashionStore.Models.ViewModels.ProductVariantViewModel

@{
    ViewData["Title"] = "Chỉnh sửa biến thể";
}

<div class="mb-4">
    <a asp-action="Index" asp-route-productId="@Model.ProductId" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại Danh sách Biến thể</span>
    </a>

    <div class="d-flex align-items-center gap-2 mb-1">
        <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
            INVENTORY SPECS & SIZING
        </span>
        <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
        <span class="text-muted small">VARIANT EDITOR</span>
    </div>
    <h2 class="fw-bold mb-0 adm-heading" style="letter-spacing: -0.02em;">Chỉnh sửa SKU: @Model.SKU</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="adm-form-card">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProductId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SKU" class="adm-form-label">Mã SKU *</label>
                        <input asp-for="SKU" class="form-control adm-input-dark font-monospace" />
                        <span asp-validation-for="SKU" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="adm-form-label">Giá biến thể (VNĐ) *</label>
                        <div class="input-group">
                            <input asp-for="Price" type="number" min="1000" step="1000" class="form-control adm-input-dark" />
                            <span class="input-group-text border-start-0" style="background: var(--adm-surface); border-color: var(--adm-border); color: var(--adm-gold); font-weight: 600;">
                                ₫
                            </span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Size" class="adm-form-label">Kích thước (Size) *</label>
                        <select asp-for="Size" class="form-select adm-input-dark">
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                            <option value="Free Size">Free Size</option>
                        </select>
                        <span asp-validation-for="Size" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Color" class="adm-form-label">Màu sắc *</label>
                        <select asp-for="Color" class="form-select adm-input-dark">
                            <option value="Đen">Đen (Black)</option>
                            <option value="Trắng">Trắng (White)</option>
                            <option value="Xám">Xám (Grey/Charcoal)</option>
                            <option value="Be">Be (Beige/Sand)</option>
                            <option value="Nâu">Nâu (Brown)</option>
                            <option value="Xanh">Xanh (Blue/Navy)</option>
                            <option value="Đỏ">Đỏ (Red/Burgundy)</option>
                            <option value="Hồng">Hồng (Pink)</option>
                        </select>
                        <span asp-validation-for="Color" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="adm-form-label">Số lượng tồn kho *</label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-control adm-input-dark" />
                        <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch p-0 mb-2">
                            <label class="form-check-label fw-semibold adm-heading" for="IsActive" style="cursor: pointer;">
                                Mở bán
                                <div class="text-muted fw-normal" style="font-size: 0.75rem;">Cho phép khách đặt hàng size này</div>
                            </label>
                            <input asp-for="IsActive" class="form-check-input ms-3" type="checkbox" role="switch" id="IsActive" style="cursor: pointer; width: 2.5em; height: 1.3em;" />
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top border-secondary border-opacity-10 d-flex gap-2">
                    <button type="submit" class="btn adm-btn-atelier py-2 px-4">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn adm-btn-outline py-2 px-3">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
