@model FashionStore.Models.ViewModels.AdminUserDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết tài khoản - " + Model.User.FullName;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isSelf = Model.User.Id == currentUserId;
    var initial = !string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.FullName.Substring(0, 1).ToUpper() : "U";
}

<!-- EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · QUẢN TRỊ</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">TÀI KHOẢN #@Model.User.Id[..Math.Min(Model.User.Id.Length, 8)]...</span>
            </div>
            <h1 class="adm-title-main">@Model.User.FullName</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> <span>Quay lại danh sách</span>
            </a>
            @if (!isSelf)
            {
                <form asp-action="ToggleLock" asp-route-id="@Model.User.Id" method="post" class="d-inline"
                      onsubmit="return confirm('@(Model.User.IsActive ? "Khóa tài khoản này?" : "Mở khóa tài khoản này?")');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="adm-action-btn adm-btn-secondary @(Model.User.IsActive ? "text-danger" : "text-success")">
                        <i class="bi @(Model.User.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                        @(Model.User.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <!-- LEFT: PROFILE & METRICS -->
    <div class="col-lg-4">
        <div class="adm-card shadow-sm mb-4">
            <div class="text-center py-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 fw-bold" style="width: 72px; height: 72px; background: #0F172A; color: #F8FAFC; font-size: 1.8rem;">
                    @initial
                </div>
                <h5 class="fw-bold adm-heading mb-1">@Model.User.FullName</h5>
                <div class="text-muted small mb-2">@Model.User.Email</div>
                <div>
                    @if (Model.User.IsActive)
                    {
                        <span class="adm-pill adm-pill-emerald">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="adm-pill adm-pill-rose font-bold">Đã bị khóa</span>
                    }
                </div>
            </div>

            <hr class="border-secondary border-opacity-10 my-3" />

            <div class="d-flex flex-column gap-2 small">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Tên đăng nhập:</span>
                    <strong class="font-monospace">@Model.User.UserName</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Số điện thoại:</span>
                    <strong class="font-monospace">@(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Chưa có" : Model.User.PhoneNumber)</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Ngày tạo:</span>
                    <span>@Model.User.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Vai trò hiện tại:</span>
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                        @foreach (var r in Model.Roles)
                        {
                            <span class="badge" style="background: rgba(37, 99, 235, 0.15); color: #2563EB;">@r</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- STATS TILES -->
        <div class="row g-3">
            <div class="col-6">
                <div class="adm-card p-3 text-center shadow-sm">
                    <div class="text-muted small text-uppercase">Đơn hàng</div>
                    <div class="fs-3 fw-bold font-monospace adm-heading mt-1">@Model.OrderCount</div>
                </div>
            </div>
            <div class="col-6">
                <div class="adm-card p-3 text-center shadow-sm">
                    <div class="text-muted small text-uppercase">Tổng chi tiêu</div>
                    <div class="fs-4 fw-bold font-monospace mt-1" style="color: var(--adm-gold, #D97706);">@Model.TotalSpent.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: ROLE & SECURITY & ORDERS -->
    <div class="col-lg-8">
        <!-- ROLE MANAGEMENT -->
        <div class="adm-card shadow-sm mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-shield-lock fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Phân quyền tài khoản</h5>
            </div>

            <form asp-action="UpdateRole" method="post" class="d-flex flex-wrap align-items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <div class="flex-grow-1" style="min-width: 200px;">
                    <select name="newRole" class="form-select adm-input-dark">
                        @foreach (var r in new[] { "Admin", "Manager", "Staff", "Shipper", "Customer" })
                        {
                            <option value="@r" selected="@(Model.Roles.Contains(r))">@r</option>
                        }
                    </select>
                </div>
                <button type="submit" class="adm-action-btn adm-btn-primary py-2 px-3"
                        onclick="return confirm('Xác nhận cập nhật vai trò mới cho người dùng này?');">
                    <i class="bi bi-check2 me-1"></i> Lưu vai trò mới
                </button>
            </form>
            <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                * Admin: toàn quyền quản trị tối cao. Manager: quản lý nghiệp vụ bán hàng. Staff: nhân viên vận hành. Shipper: giao nhận hàng. Customer: khách hàng mua sắm.
            </div>
        </div>

        <!-- RESET PASSWORD -->
        <div class="adm-card shadow-sm mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                <i class="bi bi-key fs-5" style="color: var(--adm-gold, #D97706);"></i>
                <h5 class="fw-bold mb-0 adm-heading">Đặt lại mật khẩu</h5>
            </div>

            <form asp-action="ResetPassword" method="post" class="d-flex flex-wrap align-items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <div class="flex-grow-1" style="min-width: 200px;">
                    <input type="password" name="newPassword" class="form-control adm-input-dark font-monospace" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." required minlength="6" />
                </div>
                <button type="submit" class="adm-action-btn adm-btn-secondary py-2 px-3"
                        onclick="return confirm('Bạn có chắc chắn muốn đặt lại mật khẩu cho tài khoản này?');">
                    <i class="bi bi-arrow-repeat me-1"></i> Cập nhật mật khẩu
                </button>
            </form>
        </div>

        <!-- RECENT ORDERS -->
        <div class="adm-card p-0 overflow-hidden shadow-sm">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-bag-check fs-5" style="color: var(--adm-gold, #D97706);"></i>
                    <h5 class="fw-bold mb-0 adm-heading fs-6">Lịch sử đặt hàng gần đây</h5>
                </div>
                <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">@Model.RecentOrders.Count đơn hàng</span>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="adm-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">MÃ ĐƠN</th>
                                <th>NGÀY ĐẶT</th>
                                <th class="text-end">TỔNG TIỀN</th>
                                <th>TRẠNG THÁI</th>
                                <th>THANH TOÁN</th>
                                <th class="text-end pe-4">CHI TIẾT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@o.Id" class="font-monospace fw-bold text-decoration-none adm-heading" style="color: var(--adm-gold, #D97706);">
                                            #@o.OrderCode
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@o.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                                    </td>
                                    <td class="text-end font-monospace fw-bold adm-heading">
                                        @o.TotalAmount.ToString("N0") ₫
                                    </td>
                                    <td>
                                        <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">@o.Status</span>
                                    </td>
                                    <td>
                                        <span class="badge @(o.PaymentStatus == FashionStore.Models.Enums.PaymentStatus.Paid ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25")">
                                            @o.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@o.Id" class="adm-action-btn adm-btn-secondary py-1 px-2" style="font-size: 0.78rem;">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    Chưa có đơn hàng nào được đặt bởi tài khoản này.
                </div>
            }
        </div>
    </div>
</div>
