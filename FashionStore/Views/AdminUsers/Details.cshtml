@model FashionStore.Models.ViewModels.AdminUserDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết tài khoản - " + Model.User.FullName;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isSelf = Model.User.Id == currentUserId;
}

<div class="mb-4">
    <a asp-action="Index" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
                    USER PROFILE &amp; ROLES
                </span>
                <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
                <span class="text-muted small">ID: @Model.User.Id</span>
            </div>
            <h2 class="fw-bold mb-0 adm-heading">@Model.User.FullName</h2>
        </div>

        @if (!isSelf)
        {
            <form asp-action="ToggleLock" asp-route-id="@Model.User.Id" method="post"
                  onsubmit="return confirm('@(Model.User.IsActive ? "Khóa tài khoản này?" : "Mở khóa tài khoản này?")');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.User.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    <i class="bi @(Model.User.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                    @(Model.User.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <!-- LEFT: PROFILE & METRICS -->
    <div class="col-lg-4">
        <div class="adm-card mb-4">
            <div class="text-center py-3">
                <div style="width: 68px; height: 68px; border-radius: 50%; background: #1e293b; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.6rem; margin: 0 auto 12px;">
                    @(string.IsNullOrWhiteSpace(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
                </div>
                <h5 class="fw-bold adm-heading mb-1">@Model.User.FullName</h5>
                <div class="text-muted small mb-2">@Model.User.Email</div>
                <div>
                    @if (Model.User.IsActive)
                    {
                        <span class="adm-pill adm-pill-emerald">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="adm-pill adm-pill-faint text-danger fw-bold">Đã bị khóa</span>
                    }
                </div>
            </div>

            <hr class="border-secondary border-opacity-10 my-3" />

            <div class="d-flex flex-column gap-2 small">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Tên đăng nhập:</span>
                    <strong class="font-monospace">@Model.User.UserName</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Số điện thoại:</span>
                    <strong>@(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Chưa có" : Model.User.PhoneNumber)</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Ngày tạo:</span>
                    <span>@Model.User.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Vai trò hiện tại:</span>
                    <div>
                        @foreach (var r in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@r</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- STATS TILES -->
        <div class="row g-3">
            <div class="col-6">
                <div class="adm-card p-3 text-center">
                    <div class="text-muted small text-uppercase">Đơn hàng</div>
                    <div class="fs-4 fw-bold adm-heading mt-1">@Model.OrderCount</div>
                </div>
            </div>
            <div class="col-6">
                <div class="adm-card p-3 text-center">
                    <div class="text-muted small text-uppercase">Đã chi tiêu</div>
                    <div class="fs-5 fw-bold mt-1" style="color: var(--adm-gold);">@Model.TotalSpent.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: ROLE & SECURITY & ORDERS -->
    <div class="col-lg-8">
        <!-- ROLE MANAGEMENT -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold adm-heading mb-3"><i class="bi bi-shield-lock me-2" style="color: var(--adm-gold);"></i>Phân quyền tài khoản</h5>
            <form asp-action="UpdateRole" method="post" class="d-flex flex-wrap align-items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <div class="flex-grow-1" style="min-width: 200px;">
                    <select name="newRole" class="form-select">
                        @foreach (var r in new[] { "Admin", "Manager", "Staff", "Shipper", "Customer" })
                        {
                            <option value="@r" selected="@(Model.Roles.Contains(r))">@r</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn adm-btn-atelier"
                        onsubmit="return confirm('Xác nhận cập nhật vai trò cho người dùng?');">
                    <i class="bi bi-check-lg me-1"></i> Lưu vai trò mới
                </button>
            </form>
            <div class="text-muted small mt-2">
                * Quản trị viên (Admin) có đầy đủ quyền hạn tối cao. Manager: quản lý bán hàng &amp; danh mục. Staff: nhân viên vận hành. Shipper: giao nhận đơn hàng. Customer: khách hàng mua sắm.
            </div>
        </div>

        <!-- RESET PASSWORD -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold adm-heading mb-3"><i class="bi bi-key me-2" style="color: var(--adm-gold);"></i>Đặt lại mật khẩu</h5>
            <form asp-action="ResetPassword" method="post" class="d-flex flex-wrap align-items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <div class="flex-grow-1" style="min-width: 200px;">
                    <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." required minlength="6" />
                </div>
                <button type="submit" class="btn adm-btn-outline"
                        onclick="return confirm('Bạn có chắc chắn muốn đặt lại mật khẩu cho tài khoản này?');">
                    <i class="bi bi-arrow-repeat me-1"></i> Cập nhật mật khẩu
                </button>
            </form>
        </div>

        <!-- RECENT ORDERS -->
        <div class="adm-card p-0 overflow-hidden">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold adm-heading mb-0"><i class="bi bi-bag-check me-2" style="color: var(--adm-gold);"></i>Lịch sử đặt hàng gần đây</h5>
                <span class="text-muted small">@Model.RecentOrders.Count đơn hàng</span>
            </div>
            @if (Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="adm-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">MÃ ĐƠN</th>
                                <th>NGÀY ĐẶT</th>
                                <th>TỔNG TIỀN</th>
                                <th>TRẠNG THÁI</th>
                                <th>THANH TOÁN</th>
                                <th class="text-end pe-4">CHI TIẾT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="font-monospace fw-bold" style="color: var(--adm-cyan);">@o.OrderCode</span>
                                    </td>
                                    <td>@o.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold" style="color: var(--adm-gold);">@o.TotalAmount.ToString("N0") ₫</td>
                                    <td>
                                        <span class="badge bg-secondary">@o.Status</span>
                                    </td>
                                    <td>
                                        <span class="badge @(o.PaymentStatus == FashionStore.Models.Enums.PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">
                                            @o.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm adm-btn-outline py-1 px-2">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    Chưa có đơn hàng nào được đặt bởi tài khoản này.
                </div>
            }
        </div>
    </div>
</div>
