<script>
// =============================================================================
// BỘ LỌC ĐA NĂNG ĐƠN HÀNG (REAL-TIME FILTER ENGINE)
// Hỗ trợ: Select trạng thái + Ô tìm kiếm + Lọc theo khoảng ngày (Từ ngày -> Đến ngày)
// =============================================================================
document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.hnmt-order-card');
    const statusSelect = document.getElementById('hnmtOrderStatusSelect');
    const searchInput = document.getElementById('hnmtOrderSearchInput');
    const searchClearBtn = document.getElementById('hnmtSearchClearBtn');
    const dateFromInput = document.getElementById('hnmtOrderDateFrom');
    const dateToInput = document.getElementById('hnmtOrderDateTo');
    const resetBtn = document.getElementById('hnmtFilterResetBtn');
    const noResultsBox = document.getElementById('hnmtNoFilterResults');

    let currentStatus = 'all';
    let currentKeyword = '';
    let currentFromDate = '';
    let currentToDate = '';

    // Hàm áp dụng bộ lọc tổng hợp
    function applyOrderFilters() {
        let visibleCount = 0;

        cards.forEach(card => {
            const group = card.getAttribute('data-group');
            const searchData = (card.getAttribute('data-search') || '').toLowerCase();
            const orderDateStr = card.getAttribute('data-date') || ''; // 'yyyy-MM-dd'

            // 1. Kiểm tra Trạng thái
            let statusMatch = (currentStatus === 'all' || group === currentStatus);

            // 2. Kiểm tra Từ khóa (Mã đơn hoặc tên sản phẩm / size / màu)
            let keywordMatch = true;
            if (currentKeyword.trim() !== '') {
                const terms = currentKeyword.trim().toLowerCase().split(/\s+/);
                keywordMatch = terms.every(term => searchData.includes(term));
            }

            // 3. Kiểm tra Khoảng ngày (Từ ngày -> Đến ngày)
            let dateMatch = true;
            if (currentFromDate && orderDateStr < currentFromDate) {
                dateMatch = false;
            }
            if (currentToDate && orderDateStr > currentToDate) {
                dateMatch = false;
            }

            if (statusMatch && keywordMatch && dateMatch) {
                card.classList.remove('is-hidden');
                visibleCount++;
            } else {
                card.classList.add('is-hidden');
            }
        });

        // Hiển thị/ẩn Empty results box
        if (noResultsBox) {
            noResultsBox.style.display = (visibleCount === 0) ? 'block' : 'none';
        }

        // Hiện/ẩn nút xóa tìm kiếm
        if (searchClearBtn) {
            searchClearBtn.style.display = currentKeyword ? 'inline-flex' : 'none';
        }
    }

    // Sự kiện chọn Trạng thái (Select)
    if (statusSelect) {
        statusSelect.addEventListener('change', (e) => {
            currentStatus = e.target.value;
            applyOrderFilters();
        });
    }

    // Sự kiện gõ tìm kiếm từ khóa
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            currentKeyword = e.target.value;
            applyOrderFilters();
        });
    }

    // Nút xóa từ khóa
    if (searchClearBtn) {
        searchClearBtn.addEventListener('click', () => {
            if (searchInput) {
                searchInput.value = '';
                currentKeyword = '';
                searchInput.focus();
                applyOrderFilters();
            }
        });
    }

    // Sự kiện chọn Từ ngày
    if (dateFromInput) {
        dateFromInput.addEventListener('change', (e) => {
            currentFromDate = e.target.value;
            applyOrderFilters();
        });
    }

    // Sự kiện chọn Đến ngày
    if (dateToInput) {
        dateToInput.addEventListener('change', (e) => {
            currentToDate = e.target.value;
            applyOrderFilters();
        });
    }

    // Hàm reset toàn bộ bộ lọc
    window.resetAllOrderFilters = function() {
        currentStatus = 'all';
        currentKeyword = '';
        currentFromDate = '';
        currentToDate = '';

        if (statusSelect) statusSelect.value = 'all';
        if (searchInput) searchInput.value = '';
        if (dateFromInput) dateFromInput.value = '';
        if (dateToInput) dateToInput.value = '';

        applyOrderFilters();
    };

    if (resetBtn) {
        resetBtn.addEventListener('click', window.resetAllOrderFilters);
    }
});
</script>
