@model List<FashionStore.Models.Entities.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<section class="container py-5">
    <div class="mb-4">
        <div class="text-uppercase text-muted small mb-2">Tài khoản của tôi</div>
        <h1 class="display-6" style="font-family:'Playfair Display',serif;">
            Đơn hàng của tôi
        </h1>
        <p class="text-muted">Theo dõi và xem lại các đơn hàng bạn đã đặt.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border">
            <h4>Bạn chưa có đơn hàng nào</h4>
            <p class="text-muted">Hãy khám phá các sản phẩm mới nhất của chúng tôi.</p>
            <a asp-controller="Products" asp-action="Index"
               class="fs-btn fs-btn-dark">
                MUA SẮM NGAY
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@order.OrderCode</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">
                                @order.TotalAmount.ToString("N0") đ
                            </td>
                            <td>
                                @switch (order.Status)
                                {
                                    case FashionStore.Models.Enums.OrderStatus.PendingConfirmation:
                                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Confirmed:
                                        <span class="badge bg-info text-dark">Đã xác nhận</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Processing:
                                        <span class="badge bg-primary">Đang xử lý</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Shipping:
                                        <span class="badge bg-primary">Đang giao</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Delivered:
                                        <span class="badge bg-success">Đã giao</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.DeliveryFailed:
                                        <span class="badge bg-danger">Giao hàng thất bại</span>
                                        break;
                                    case FashionStore.Models.Enums.OrderStatus.Returned:
                                        <span class="badge bg-secondary">Đã trả hàng</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id"
                                   class="btn btn-outline-dark btn-sm">
                                    Chi tiết
                                </a>
                                @if (order.Status == FashionStore.Models.Enums.OrderStatus.PendingConfirmation)
                                {
                                    <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm ms-1">
                                            Hủy đơn
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
