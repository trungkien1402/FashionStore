@model CheckoutViewModel
@using System.Globalization
@{
    Layout = "_PaymentLayout";
    ViewData["Title"] = "Thông tin đặt hàng";
    string Money(decimal amount) => amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + " ₫";
}
<nav class="pay-steps" aria-label="Tiến trình đặt hàng"><span class="is-current" aria-current="step">01 <span>Thông tin</span></span><i></i><span>02 <span>Thanh toán</span></span><i></i><span>03 <span>Hoàn tất</span></span></nav>
<div class="pay-intro"><p class="pay-eyebrow">ĐƯỢC CHỌN BỞI BẠN</p><h1>Gửi một chút phong cách.<br /><em>Đến nơi bạn muốn.</em></h1><p>Kiểm tra thông tin để món đồ yêu thích đến đúng tay bạn.</p></div>
<form id="checkoutForm" asp-controller="Orders" asp-action="Checkout" method="post" class="pay-grid">
    @Html.AntiForgeryToken()
    <div class="pay-panel">
        <div asp-validation-summary="ModelOnly" class="pay-validation" role="alert"></div>
        <h2 class="pay-section-title"><span>01</span>Thông tin người nhận</h2>
        <div class="pay-field"><label asp-for="ReceiverName">Họ và tên</label><input asp-for="ReceiverName" autocomplete="shipping name" placeholder="Tên người nhận hàng" required maxlength="100" /><span asp-validation-for="ReceiverName"></span></div>
        <div class="pay-field"><label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" type="tel" autocomplete="shipping tel" placeholder="Số điện thoại liên hệ" required /><span asp-validation-for="Phone"></span></div>
        <div class="pay-field"><label asp-for="Address">Địa chỉ nhận hàng</label><textarea asp-for="Address" autocomplete="shipping street-address" rows="3" placeholder="Số nhà, tên đường, phường/xã, tỉnh/thành phố" required maxlength="300"></textarea><span asp-validation-for="Address"></span></div>
        <div class="pay-form-divider"></div>
        <fieldset class="pay-methods"><legend class="pay-section-title"><span>02</span>Cách bạn thanh toán</legend>
            <label class="pay-method" for="paymentCOD"><input type="radio" asp-for="PaymentMethod" value="COD" id="paymentCOD" /><span><strong>Thanh toán khi nhận hàng</strong><small>Thanh toán trực tiếp cho nhân viên giao hàng.</small></span></label>
            <label class="pay-method" for="paymentQR"><input type="radio" asp-for="PaymentMethod" value="VietQR" id="paymentQR" /><span><strong>Chuyển khoản VietQR</strong><small>Quét mã điền sẵn số tiền. Cửa hàng kiểm tra và xác nhận thanh toán.</small></span></label>
        </fieldset>
        <span asp-validation-for="PaymentMethod" class="pay-validation"></span>
        <button id="placeOrderButton" class="pay-button" type="submit">@(Model.PaymentMethod == "VietQR" ? "Đặt hàng và xem mã QR" : "Xác nhận đặt hàng")</button>
        <p class="pay-subnote">Vui lòng kiểm tra thông tin trước khi đặt hàng.</p>
    </div>
    <aside class="pay-sidebar is-sticky"><div class="pay-summary"><p class="pay-eyebrow">ĐƠN HÀNG CỦA BẠN</p><h2>Những điều bạn chọn.</h2>
        @foreach (var item in Model.CartItems)
        {
            <div class="pay-product"><div class="pay-product-visual"><img src="@item.ImageUrl" alt="@item.ProductName" loading="lazy" /></div><div class="pay-product-info"><strong>@item.ProductName</strong><small>@item.Size · @item.Color · Số lượng @item.Quantity</small><span>@Money(item.TotalPrice)</span></div></div>
        }
        <div class="pay-rule"></div><dl class="pay-totals"><div><dt>Tạm tính</dt><dd>@Money(Model.SubTotal)</dd></div><div><dt>Phí vận chuyển</dt><dd>@Money(Model.ShippingFee)</dd></div><div class="pay-total"><dt>Tổng cộng</dt><dd>@Money(Model.TotalAmount)</dd></div></dl>
        <a class="pay-detail-link" asp-controller="Cart" asp-action="Index">Chỉnh sửa giỏ hàng <span aria-hidden="true">↗</span></a>
    </div><p class="pay-sidebar-note">Mỗi lựa chọn đều xứng đáng được chăm chút. FashionStore sẽ tiếp nhận đơn sau khi bạn xác nhận.</p></aside>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}