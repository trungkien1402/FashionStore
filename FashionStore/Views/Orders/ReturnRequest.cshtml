@model CustomerReturnViewModel
@using FashionStore.Services.Implementations
@using FashionStore.Models.Enums
@using FashionStore.Models.Entities
@using Microsoft.EntityFrameworkCore
@inject FashionStore.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Trả hàng & Hoàn tiền — #" + Model.Order.OrderCode;

    var statusText = Model.Order.Status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang vận chuyển",
        OrderStatus.Delivered => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy đơn",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã hoàn trả",
        _ => "Đang cập nhật"
    };

    var statusTheme = Model.Order.Status switch
    {
        OrderStatus.PendingConfirmation => "theme-pending",
        OrderStatus.Confirmed => "theme-confirmed",
        OrderStatus.Processing => "theme-processing",
        OrderStatus.Shipping => "theme-shipping",
        OrderStatus.Delivered => "theme-delivered",
        OrderStatus.Cancelled => "theme-cancelled",
        OrderStatus.DeliveryFailed => "theme-failed",
        OrderStatus.Returned => "theme-failed",
        _ => "theme-pending"
    };
}

@functions {
    public class ItemPhotoDetail
    {
        public string MainImage { get; set; } = "/clothing-rail/assets/reach-shirt-front.webp";
        public string? ColorHex { get; set; }
        public int ProductId { get; set; }
    }

    public ItemPhotoDetail ResolveItemPhotos(OrderItem item, FashionStore.Data.ApplicationDbContext db)
    {
        var result = new ItemPhotoDetail();
        try
        {
            Product? product = item.ProductVariant?.Product;
            if (product == null && item.ProductVariantId > 0)
            {
                var variant = db.ProductVariants.Include(v => v.Product).FirstOrDefault(v => v.Id == item.ProductVariantId);
                product = variant?.Product;
            }

            if (product != null)
            {
                result.ProductId = product.Id;
                if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    result.MainImage = product.ImageUrl;
                }
            }
        }
        catch { }
        return result;
    }
}

<div class="hnmt-order-details-page">
    <div class="hnmt-details-shell">

        <!-- TOP NAV: NÚT QUAY LẠI DUY NHẤT (PILL BUTTON CHUẨN ĐỒNG BỘ) -->
        <nav class="hnmt-dossier-nav" aria-label="Điều hướng">
            <a asp-action="Details" asp-route-id="@Model.Order.Id" class="hnmt-back-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Quay lại đơn hàng</span>
            </a>
        </nav>

        <!-- HEADER ĐỒNG BỘ 100% VỚI DETAILS.CSHTML -->
        <header class="hnmt-dossier-header">
            <div class="hnmt-header-main">
                <div class="hnmt-title-action-row">
                    <h1 class="hnmt-order-heading">
                        Đơn hàng <span class="hnmt-code-display">#@Model.Order.OrderCode</span>
                    </h1>
                    <button type="button" class="hnmt-copy-pill" onclick="copyOrderCode('@Model.Order.OrderCode')" title="Sao chép mã đơn hàng">
                        <svg class="hnmt-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span id="copyBtnLabel">Sao chép</span>
                    </button>
                </div>

                <div class="hnmt-order-meta-bar">
                    <span class="hnmt-meta-unit">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>Khởi tạo: <strong>@Model.Order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                    </span>
                    <span class="hnmt-meta-dot">•</span>
                    <span class="hnmt-meta-unit">
                        <span>Tổng: <strong>@Model.Order.Items.Sum(i => i.Quantity) món</strong></span>
                    </span>
                    <span class="hnmt-meta-dot">•</span>
                    <span class="hnmt-meta-unit">
                        <span>Phương thức: <strong>@(Model.Order.PaymentMethod == PaymentMethod.VietQR ? "VietQR 24/7" : "COD")</strong></span>
                    </span>
                </div>
            </div>

            <div class="hnmt-header-status-col">
                <div class="hnmt-status-badge @statusTheme">
                    <span class="hnmt-status-dot"></span>
                    <span class="hnmt-status-name">@statusText</span>
                </div>
            </div>
        </header>

        <!-- FLASH NOTIFICATIONS -->
        @if (TempData["Success"] != null)
        {
            <div class="hnmt-alert-banner is-success">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="hnmt-alert-banner is-error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- 2-COLUMN STRUCTURED DOSSIER GRID (CHUẨN TỶ LỆ NHƯ DETAILS.CSHTML) -->
        <div class="hnmt-dossier-grid">

            <!-- CỘT CHÍNH (BÊN TRÁI): TIẾN TRÌNH HOÀN TRẢ HOẶC FORM GỬI YÊU CẦU -->
            <main class="hnmt-content-primary">
                
                <section class="hnmt-card" aria-label="Nội dung trả hàng">
                    <div class="hnmt-card-top">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">
                                @(Model.Request != null ? "Tiến trình hoàn trả đơn hàng" : "Gửi yêu cầu trả hàng & hoàn tiền")
                            </h2>
                        </div>
                    </div>

                    @if (Model.Request is { } request)
                    {
                        <!-- TRƯỜNG HỢP: ĐÃ CÓ YÊU CẦU HOÀN TRẢ -->
                        string stateClass = request.State switch
                        {
                            ReturnState.Requested => "theme-pending",
                            ReturnState.Approved => "theme-confirmed",
                            ReturnState.Received => "theme-shipping",
                            ReturnState.Refunded => "theme-delivered",
                            ReturnState.Rejected => "theme-cancelled",
                            _ => "theme-pending"
                        };

                        <div class="hnmt-simple-status-banner">
                            <div class="hnmt-status-notice">
                                <span class="hnmt-status-dot-indicator @stateClass"></span>
                                <span class="hnmt-status-lead">
                                    Trạng thái: <strong>@ReturnRequests.Label(request.State)</strong>
                                </span>
                            </div>
                            <div class="hnmt-simple-eta">
                                Gửi lúc: <strong>@AdminReportService.ToVietnamTime(request.CreatedAt).ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>

                        @if (request.State != ReturnState.Rejected)
                        {
                            var steps = new[] { ReturnState.Requested, ReturnState.Approved, ReturnState.Received, ReturnState.Refunded };
                            var labels = new[] { "Gửi yêu cầu", "Cửa hàng duyệt", "Nhận & kiểm định", "Hoàn tiền" };
                            var currentIdx = Array.IndexOf(steps, request.State);

                            <div class="hnmt-simple-stepper">
                                @for (int i = 0; i < steps.Length; i++)
                                {
                                    bool isDone = currentIdx > i;
                                    bool isActive = currentIdx == i;
                                    string nodeCls = isDone ? "is-done" : (isActive ? "is-active" : "is-pending");

                                    <div class="hnmt-step-node @nodeCls">
                                        <div class="hnmt-step-circle">
                                            @if (isDone)
                                            {
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            }
                                            else if (isActive)
                                            {
                                                <span class="hnmt-step-dot-core"></span>
                                            }
                                        </div>
                                        <span class="hnmt-step-label">@labels[i]</span>
                                    </div>

                                    @if (i < steps.Length - 1)
                                    {
                                        <div class="hnmt-step-bar @(currentIdx > i ? "is-filled" : "")"></div>
                                    }
                                }
                            </div>
                        }

                        <div class="hnmt-return-details-box">
                            <div class="hnmt-return-info-row">
                                <span class="hnmt-return-info-lbl">Lý do đã gửi:</span>
                                <strong class="hnmt-return-info-val">@request.Reason</strong>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(request.Evidence))
                            {
                                <div class="hnmt-return-info-row">
                                    <span class="hnmt-return-info-lbl">Bằng chứng / Mô tả:</span>
                                    <span class="hnmt-return-info-val">@request.Evidence</span>
                                </div>
                            }

                            @if (request.State == ReturnState.Approved)
                            {
                                <div class="hnmt-return-notice-card is-info">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12" y2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    <div>
                                        <strong>Cửa hàng đã phê duyệt yêu cầu trả hàng!</strong>
                                        <p>Vui lòng giữ sản phẩm còn nguyên tem mác, phụ kiện đi kèm và liên hệ bộ phận hỗ trợ để xác nhận cách gửi lại kiện hàng.</p>
                                        <a asp-controller="Home" asp-action="Contact" class="hnmt-contact-btn">
                                            <span>Liên hệ hỗ trợ gửi hàng &rarr;</span>
                                        </a>
                                    </div>
                                </div>
                            }
                            else if (request.State == ReturnState.Refunded)
                            {
                                <div class="hnmt-return-notice-card is-success">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <div>
                                        <strong>Đã hoàn tiền thành công!</strong>
                                        <p>Số tiền đã hoàn: <strong class="font-mono text-dark">@request.RefundAmount.ToString("N0") ₫</strong></p>
                                    </div>
                                </div>
                            }
                            else if (request.State == ReturnState.Rejected)
                            {
                                <div class="hnmt-return-notice-card is-danger">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="15" y1="9" x2="9" y2="15"></line>
                                        <line x1="9" y1="9" x2="15" y2="15"></line>
                                    </svg>
                                    <div>
                                        <strong>Yêu cầu trả hàng đã bị từ chối</strong>
                                        <p>Đơn hàng không đáp ứng điều kiện đổi trả theo quy định của cửa hàng.</p>
                                        <a asp-controller="Home" asp-action="Contact" class="hnmt-contact-btn">
                                            <span>Liên hệ để được giải đáp &rarr;</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- CHƯA GỬI YÊU CẦU: FORM NHẬP -->
                        if (Model.IneligibleReason != null)
                        {
                            <div class="hnmt-return-notice-card is-warning">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <div>
                                    <strong>Không đủ điều kiện yêu cầu trả hàng</strong>
                                    <p>@Model.IneligibleReason</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="hnmt-return-intro-banner">
                                <p>Cửa hàng hỗ trợ đổi trả hàng miễn phí trong vòng 7 ngày cho toàn bộ kiện hàng. Cửa hàng sẽ duyệt yêu cầu, tiếp nhận kiện hàng và kiểm định sản phẩm trước khi tiến hành hoàn tiền.</p>
                            </div>

                            <form asp-action="SubmitReturn" asp-route-id="@Model.Order.Id" method="post" class="hnmt-form-body">
                                @Html.AntiForgeryToken()

                                <div class="hnmt-form-group">
                                    <label for="reason" class="hnmt-form-label">
                                        <span>Lý do trả hàng</span>
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea id="reason" name="reason" class="hnmt-form-textarea" rows="3" placeholder="Ví dụ: Sản phẩm không đúng mẫu, sai kích thước hoặc phát hiện lỗi gia công..." required maxlength="500"></textarea>
                                    <span class="hnmt-form-hint">Tối đa 500 ký tự</span>
                                </div>

                                <div class="hnmt-form-group">
                                    <label for="evidence" class="hnmt-form-label">
                                        <span>Mô tả tình trạng hoặc dẫn chứng</span>
                                        <small class="text-muted">(tùy chọn)</small>
                                    </label>
                                    <textarea id="evidence" name="evidence" class="hnmt-form-textarea" rows="3" placeholder="Mô tả chi tiết tình trạng sản phẩm hoặc dán link ảnh/video mở hộp..." maxlength="500"></textarea>
                                    <span class="hnmt-form-hint">Tối đa 500 ký tự</span>
                                </div>

                                <div class="hnmt-form-action-row">
                                    <button type="submit" class="hnmt-btn-primary" style="max-width: 240px; height: 42px; border-radius: 8px;">
                                        <span>Gửi yêu cầu trả hàng</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                            <polyline points="12 5 19 12 12 19"></polyline>
                                        </svg>
                                    </button>
                                </div>
                            </form>
                        }
                    }
                </section>

            </main>

            <!-- CỘT PHỤ (BÊN PHẢI): SẢN PHẨM & QUY TRÌNH ĐỔI TRẢ HIỆN ĐẠI -->
            <aside class="hnmt-sidebar-sticky">
                
                <!-- CARD 1: SẢN PHẨM TRONG ĐƠN -->
                <div class="hnmt-card">
                    <div class="hnmt-card-top border-none pb-0">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">Sản phẩm trong đơn (@Model.Order.Items.Count)</h2>
                        </div>
                    </div>

                    <div class="hnmt-simple-items-list" style="margin-top: 14px;">
                        @foreach (var item in Model.Order.Items)
                        {
                            var photo = ResolveItemPhotos(item, DbContext);
                            <article class="hnmt-simple-item-row" style="padding: 12px 0;">
                                <div class="hnmt-simple-photo" style="width: 58px; height: 66px;">
                                    <img src="@photo.MainImage" alt="@item.ProductName" onerror="this.onerror=null;this.src='/clothing-rail/assets/reach-shirt-front.webp';" />
                                </div>
                                <div class="hnmt-simple-info">
                                    <div class="hnmt-simple-name-row">
                                        <span class="hnmt-simple-name" style="font-size: 14.5px;">@item.ProductName</span>
                                        <span class="hnmt-simple-price font-mono" style="font-size: 14px;">
                                            @((item.UnitPrice * item.Quantity).ToString("N0")) ₫
                                        </span>
                                    </div>
                                    <div class="hnmt-simple-variant" style="font-size: 12.5px;">
                                        @if (!string.IsNullOrEmpty(item.Size))
                                        {
                                            <span>Size: <strong>@item.Size</strong></span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Color))
                                        {
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="hnmt-dot-sep">·</span>
                                            }
                                            <span>Màu: <strong>@item.Color</strong></span>
                                        }
                                        <span class="hnmt-dot-sep">·</span>
                                        <span>Số lượng: <strong>@item.Quantity</strong></span>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="hnmt-card-divider" style="margin: 14px 0;"></div>

                    <div class="hnmt-ledger-total-row">
                        <span class="hnmt-total-lbl" style="font-size: 13.5px;">Tổng tiền đơn hàng</span>
                        <strong class="hnmt-total-number font-mono" style="font-size: 18px;">@Model.Order.TotalAmount.ToString("N0") ₫</strong>
                    </div>
                </div>

                <!-- CARD 2: QUY TRÌNH & HƯỚNG DẪN ĐỔI TRẢ (THIẾT KẾ MỚI TINH TẾ) -->
                <div class="hnmt-card hnmt-flow-card">
                    <div class="hnmt-card-top border-none pb-0">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">Quy trình đổi trả hàng</h2>
                        </div>
                    </div>

                    <!-- 4 BƯỚC ĐỔI TRẢ HIỆN ĐẠI DẠNG TIMELINE -->
                    <div class="hnmt-flow-timeline">
                        <div class="hnmt-flow-item">
                            <div class="hnmt-flow-badge">1</div>
                            <div class="hnmt-flow-text">
                                <strong>Gửi yêu cầu trực tuyến</strong>
                                <p>Điền lý do và hình ảnh thực tế của kiện hàng.</p>
                            </div>
                        </div>

                        <div class="hnmt-flow-item">
                            <div class="hnmt-flow-badge">2</div>
                            <div class="hnmt-flow-text">
                                <strong>Cửa hàng tiếp nhận &amp; duyệt</strong>
                                <p>Hệ thống xử lý và liên hệ phản hồi trong 24 giờ.</p>
                            </div>
                        </div>

                        <div class="hnmt-flow-item">
                            <div class="hnmt-flow-badge">3</div>
                            <div class="hnmt-flow-text">
                                <strong>Gửi kiện hàng về kho</strong>
                                <p>Đóng gói sản phẩm còn nguyên tem mác &amp; phụ kiện.</p>
                            </div>
                        </div>

                        <div class="hnmt-flow-item">
                            <div class="hnmt-flow-badge">4</div>
                            <div class="hnmt-flow-text">
                                <strong>Kiểm định &amp; Hoàn tiền</strong>
                                <p>Tiền hoàn tự động sau khi kho xác nhận kiện hàng.</p>
                            </div>
                        </div>
                    </div>

                    @if (Model.Deadline is DateTime deadline && Model.Request == null)
                    {
                        <div class="hnmt-deadline-box-clean">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>Hạn chót gửi: <strong>@AdminReportService.ToVietnamTime(deadline).ToString("dd/MM/yyyy HH:mm")</strong></span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Policy))
                    {
                        <div class="hnmt-policy-note-text">
                            @Model.Policy
                        </div>
                    }

                    <div class="hnmt-support-strip" style="margin-top: 18px;">
                        <span>Hỗ trợ: <strong>1900 8888</strong> (8h - 22h)</span>
                    </div>
                </div>

            </aside>

        </div>

    </div>
</div>

<script>
function copyOrderCode(code) {
    if (!navigator.clipboard) {
        const dummy = document.createElement('textarea');
        document.body.appendChild(dummy);
        dummy.value = code;
        dummy.select();
        document.execCommand('copy');
        document.body.removeChild(dummy);
        showCopyFeedback();
        return;
    }

    navigator.clipboard.writeText(code).then(() => {
        showCopyFeedback();
    }).catch(() => {
        showCopyFeedback();
    });
}

function showCopyFeedback() {
    const label = document.getElementById('copyBtnLabel');
    if (label) {
        const oldText = label.textContent;
        label.textContent = 'Đã chép!';
        setTimeout(() => {
            label.textContent = oldText;
        }, 1800);
    }
}
</script>

<style>
/* =============================================================================
   HNMT RETURN REQUEST - MATCHING DETAILS.CSHTML 100%
   ============================================================================= */
.hnmt-order-details-page {
    background: #FFFFFF;
    min-height: 100vh;
    padding: 32px 0 84px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0F172A;
    -webkit-font-smoothing: antialiased;
}

.hnmt-details-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* Back Link Pill */
.hnmt-dossier-nav {
    margin-bottom: 22px;
}

.hnmt-back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    text-decoration: none !important;
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: all 0.15s ease;
}

.hnmt-back-link:hover {
    color: #0F172A;
    background: #F8FAFC;
    border-color: #CBD5E1;
    transform: translateX(-2px);
}

/* Dossier Header */
.hnmt-dossier-header {
