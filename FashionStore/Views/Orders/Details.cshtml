<script>
// 1. Sao chép mã đơn hàng
function copyOrderCode(code) {
    if (!navigator.clipboard) {
        const ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
    } else {
        navigator.clipboard.writeText(code);
    }

    const label = document.getElementById('copyBtnLabel');
    if (label) {
        const orig = label.textContent;
        label.textContent = 'Đã chép!';
        setTimeout(() => { label.textContent = orig; }, 2000);
    }
}

// 2. Đếm ngược thời gian thực cho mã VietQR trong Chi tiết đơn hàng
(function() {
    const box = document.getElementById('detailVietQrBox');
    if (!box) return;

    let webSec = parseInt(box.getAttribute('data-web-sec'), 10) || 0;
    let actualSec = parseInt(box.getAttribute('data-actual-sec'), 10) || 0;
    const timer = document.getElementById('detailCountdownTimer');
    const label = document.getElementById('detailCountdownLabel');
    const desc = document.getElementById('detailCountdownDesc');
    const pill = document.getElementById('detailQrPill');
    const actionBtn = document.getElementById('detailQrActionBtn');
    const actionText = document.getElementById('detailQrActionText');

    function fmt(sec) {
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${m}:${s}`;
    }

    const interval = setInterval(() => {
        if (actualSec <= 0) {
            clearInterval(interval);
            window.location.reload();
            return;
        }

        if (webSec > 0) {
            webSec--;
            box.setAttribute('data-web-sec', webSec);
            if (timer) timer.textContent = fmt(webSec);
        } else {
            actualSec--;
            box.setAttribute('data-actual-sec', actualSec);
            if (!box.classList.contains('is-grace')) {
                box.classList.remove('is-active');
                box.classList.add('is-grace');
                if (pill) {
                    pill.className = 'hnmt-vqr-pill is-grace';
                    pill.innerHTML = '<span class="hnmt-status-dot"></span>Vùng đệm 5 phút';
                }
                if (label) label.textContent = 'Hạn chót vùng đệm nhận tiền:';
                if (desc) desc.textContent = 'Đã hết 10 phút quét mã QR. Nếu bạn vừa bấm chuyển khoản, hệ thống vẫn nhận được. Hãy vào báo chuyển khoản ngay!';
                if (actionBtn) actionBtn.classList.add('btn-grace');
                if (actionText) actionText.textContent = 'Vào xác nhận "Tôi đã chuyển khoản"';
            }
            if (timer) timer.textContent = fmt(actualSec);
        }
    }, 1000);
})();
</script>

