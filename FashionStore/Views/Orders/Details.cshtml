<script>
function switchDetailImage(targetId, newSrc, btnElement, angleName) {
    var imgEl = document.getElementById(targetId);
    if (!imgEl) return;

    // Smooth fade effect
    imgEl.style.opacity = '0.3';
    setTimeout(function() {
        imgEl.src = newSrc;
        imgEl.style.opacity = '1';
    }, 150);

    // Update active state in thumbnail row
    var parentRow = btnElement.closest('.hnmt-detail-photos-row');
    if (parentRow) {
        var buttons = parentRow.querySelectorAll('.hnmt-detail-thumb-btn');
        buttons.forEach(function(btn) {
            btn.classList.remove('active');
        });
        btnElement.classList.add('active');
    }

    // Update visual badge label if present
    var visualCol = btnElement.closest('.hnmt-item-visual-col');
    if (visualCol) {
        var badge = visualCol.querySelector('.hnmt-view-badge');
        if (badge && angleName) {
            badge.textContent = angleName;
        }
    }
}

function copyOrderCode(code) {
    if (!navigator.clipboard) {
        var dummy = document.createElement("input");
        document.body.appendChild(dummy);
        dummy.value = code;
        dummy.select();
        document.execCommand("copy");
        document.body.removeChild(dummy);
    } else {
        navigator.clipboard.writeText(code);
    }

    var copyIcon = document.getElementById("copyIcon");
    var copyText = document.getElementById("copyText");
    if (copyIcon && copyText) {
        copyIcon.className = "bi bi-check-lg text-success";
        copyText.textContent = "Đã chép!";
        setTimeout(function() {
            copyIcon.className = "bi bi-clipboard";
            copyText.textContent = "Sao chép";
        }, 2000);
    }
}
</script>

