@model FashionStore.Models.Entities.Order
@using System.Text.Json
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject FashionStore.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Hồ sơ đơn hàng #" + Model.OrderCode;

    var histories = ViewBag.StatusHistories as List<OrderStatusHistory> ?? new List<OrderStatusHistory>();
    histories = histories.OrderBy(h => h.CreatedAt).ThenBy(h => h.Id).ToList();

    var paymentMethodText = Model.PaymentMethod switch
    {
        PaymentMethod.COD => "Thanh toán khi nhận hàng (COD)",
        PaymentMethod.VietQR => "Chuyển khoản nhanh VietQR 24/7",
        _ => "Phương thức khác"
    };

    var statusText = Model.Status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang vận chuyển",
        OrderStatus.Delivered => "Đã giao thành công",
        OrderStatus.Cancelled => "Đã hủy đơn hàng",
        OrderStatus.DeliveryFailed => "Giao hàng thất bại",
        OrderStatus.Returned => "Đã hoàn trả kiện hàng",
        _ => "Đang cập nhật"
    };

    var statusTheme = Model.Status switch
    {
        OrderStatus.PendingConfirmation => "status-pending",
        OrderStatus.Confirmed => "status-confirmed",
        OrderStatus.Processing => "status-processing",
        OrderStatus.Shipping => "status-shipping",
        OrderStatus.Delivered => "status-delivered",
        OrderStatus.Cancelled => "status-cancelled",
        OrderStatus.DeliveryFailed => "status-failed",
        OrderStatus.Returned => "status-returned",
        _ => "status-pending"
    };

    var paymentText = Model.PaymentStatus switch
    {
        PaymentStatus.Pending => "Chờ thanh toán",
        PaymentStatus.Paid => "Đã thanh toán",
        PaymentStatus.Failed => "Thanh toán lỗi",
        PaymentStatus.Refunded => "Đã hoàn tiền",
        _ => "Chưa xác định"
    };

    bool isCancelled = Model.Status == OrderStatus.Cancelled;
    bool isFailed = Model.Status == OrderStatus.DeliveryFailed || Model.Status == OrderStatus.Returned;
    bool isExceptionalStatus = isCancelled || isFailed;

    int currentStep = Model.Status switch
    {
        OrderStatus.PendingConfirmation => 1,
        OrderStatus.Confirmed => 2,
        OrderStatus.Processing => 3,
        OrderStatus.Shipping => 4,
        OrderStatus.Delivered => 5,
        _ => 0
    };

    string GetStatusName(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang vận chuyển",
        OrderStatus.Delivered => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy đơn",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã trả hàng",
        _ => status.ToString()
    };

    string? GetHistoryNote(OrderStatusHistory history)
    {
        if (string.IsNullOrWhiteSpace(history.Note)) return null;
        var note = history.Note;
        if (note.StartsWith("Cập nhật trạng thái:", StringComparison.OrdinalIgnoreCase))
        {
            foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                note = note.Replace(s.ToString(), GetStatusName(s));
            }
        }
        return note;
    }
}

@functions {
    public class ItemPhotoDetail
    {
        public string MainImage { get; set; } = "/clothing-rail/assets/reach-shirt-front.webp";
        public string? FrontImage { get; set; }
        public string? BackImage { get; set; }
        public string? SideImage { get; set; }
        public string? ColorHex { get; set; }
        public int ProductId { get; set; }
        public string ProductSlug { get; set; } = "";
    }

    public ItemPhotoDetail ResolveItemPhotos(OrderItem item, FashionStore.Data.ApplicationDbContext db)
    {
        var result = new ItemPhotoDetail();

        Product? product = item.ProductVariant?.Product;
        if (product == null && item.ProductVariantId > 0)
        {
            try
            {
                var variant = db.ProductVariants.Include(v => v.Product).FirstOrDefault(v => v.Id == item.ProductVariantId);
                product = variant?.Product;
            }
            catch { }
        }
        if (product == null && !string.IsNullOrEmpty(item.ProductName))
        {
            try
            {
                product = db.Products.FirstOrDefault(p => p.Name == item.ProductName);
            }
            catch { }
        }

        if (product != null)
        {
            result.ProductId = product.Id;
            result.ProductSlug = product.Slug;
            result.MainImage = !string.IsNullOrEmpty(product.ImageUrl) ? product.ImageUrl : "/clothing-rail/assets/reach-shirt-front.webp";

            if (!string.IsNullOrEmpty(product.ShowroomMetadata))
            {
                try
                {
                    using var doc = JsonDocument.Parse(product.ShowroomMetadata);
                    var root = doc.RootElement;
                    if (root.TryGetProperty("colors", out var colorsElem) && root.TryGetProperty("photos", out var photosElem))
                    {
                        int matchedColorIdx = -1;
                        int colorCount = colorsElem.GetArrayLength();

                        for (int i = 0; i < colorCount; i++)
                        {
                            var colorArr = colorsElem[i];
                            if (colorArr.GetArrayLength() > 0)
                            {
                                var colorName = colorArr[0].GetString();
                                if (!string.IsNullOrEmpty(colorName) &&
                                    (colorName.Equals(item.Color, StringComparison.OrdinalIgnoreCase) ||
                                     item.Color.Contains(colorName, StringComparison.OrdinalIgnoreCase) ||
                                     colorName.Contains(item.Color, StringComparison.OrdinalIgnoreCase)))
                                {
                                    matchedColorIdx = i;
                                    if (colorArr.GetArrayLength() > 1)
                                    {
                                        result.ColorHex = colorArr[1].GetString();
                                    }
                                    break;
                                }
                            }
                        }

                        if (matchedColorIdx == -1 && !string.IsNullOrEmpty(item.SKU))
                        {
                            var parts = item.SKU.Split('-');
                            if (parts.Length >= 4 && int.TryParse(parts[parts.Length - 2], out int cNum) && cNum > 0 && cNum <= colorCount)
                            {
                                matchedColorIdx = cNum - 1;
                                var colorArr = colorsElem[matchedColorIdx];
                                if (colorArr.GetArrayLength() > 1)
                                {
                                    result.ColorHex = colorArr[1].GetString();
                                }
                            }
                        }

                        if (matchedColorIdx >= 0 && matchedColorIdx < photosElem.GetArrayLength())
                        {
                            var photoObj = photosElem[matchedColorIdx];
                            if (photoObj.TryGetProperty("front", out var f) && f.GetString() is string fStr && !string.IsNullOrEmpty(fStr))
                            {
                                result.FrontImage = fStr;
                                result.MainImage = fStr;
                            }
                            if (photoObj.TryGetProperty("back", out var b) && b.GetString() is string bStr && !string.IsNullOrEmpty(bStr))
                            {
                                result.BackImage = bStr;
                            }
                            if (photoObj.TryGetProperty("side", out var s) && s.GetString() is string sStr && !string.IsNullOrEmpty(sStr))
                            {
                                result.SideImage = sStr;
                            }
                        }
                    }
                }
                catch { }
            }
        }

        return result;
    }
}

<div class="hnmt-order-details-wrapper">
    <div class="hnmt-details-container">
        
        <!-- BREADCRUMB & BACK ACTION -->
        <div class="hnmt-top-nav">
            <a asp-action="Index" class="hnmt-back-btn">
                <i class="bi bi-arrow-left"></i>
                <span>Danh sách đơn hàng</span>
            </a>
            <div class="hnmt-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <span class="hnmt-sep">/</span>
                <a asp-action="Index">Đơn hàng của tôi</a>
                <span class="hnmt-sep">/</span>
                <span class="hnmt-current">#@Model.OrderCode</span>
            </div>
        </div>

        <!-- ORDER MAIN HEADER -->
        <div class="hnmt-header-card">
            <div class="hnmt-header-left">
                <div class="hnmt-eyebrow-tag">
                    <i class="bi bi-shield-check"></i> HỒ SƠ ĐƠN HÀNG CHÍNH THỨC
                </div>
                <div class="hnmt-title-row">
                    <h1 class="hnmt-page-title">Đơn hàng <span class="hnmt-code-text">#@Model.OrderCode</span></h1>
                    <button type="button" class="hnmt-copy-btn" onclick="copyOrderCode('@Model.OrderCode')" title="Sao chép mã đơn hàng">
                        <i class="bi bi-clipboard" id="copyIcon"></i>
                        <span id="copyText">Sao chép</span>
                    </button>
                </div>
                <div class="hnmt-meta-strip">
                    <span class="hnmt-meta-item">
                        <i class="bi bi-clock-history"></i>
                        Khởi tạo: <strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </span>
                    <span class="hnmt-meta-divider">•</span>
                    <span class="hnmt-meta-item">
                        <i class="bi bi-box-seam"></i>
                        Tổng sản phẩm: <strong>@Model.Items.Sum(i => i.Quantity) món</strong>
                    </span>
                    <span class="hnmt-meta-divider">•</span>
                    <span class="hnmt-meta-item">
                        <i class="bi bi-credit-card-2-front"></i>
                        PT Thanh toán: <strong>@(Model.PaymentMethod == PaymentMethod.VietQR ? "VietQR" : "COD")</strong>
                    </span>
                </div>
            </div>

            <div class="hnmt-header-right">
                <div class="hnmt-status-pill @statusTheme">
                    <span class="hnmt-status-dot"></span>
                    <span class="hnmt-status-text">@statusText</span>
                </div>
                <div class="hnmt-header-actions">
                    <button type="button" class="hnmt-action-btn" onclick="window.print()" title="In biên lai đơn hàng">
                        <i class="bi bi-printer"></i> In hồ sơ
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="hnmt-action-btn">
                        <i class="bi bi-shop"></i> Mua sắm tiếp
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="hnmt-notice-box success">
                <i class="bi bi-check-circle-fill"></i>
                <div class="hnmt-notice-content">
                    <strong>Thành công!</strong>
                    <span>@TempData["Success"]</span>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="hnmt-notice-box error">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <div class="hnmt-notice-content">
                    <strong>Thông báo lỗi:</strong>
                    <span>@TempData["Error"]</span>
                </div>
            </div>
        }

        <!-- 2-COLUMN LUXURY GRID -->
        <div class="hnmt-details-grid">

            <!-- LEFT COLUMN: PROGRESS STEPPER, ITEMS WITH DETAIL PHOTOS, SHIPPING INFO -->
            <div class="hnmt-main-col">
                
                <!-- PROGRESS STEPPER CARD -->
                <div class="hnmt-card hnmt-stepper-card">
                    <div class="hnmt-card-header">
                        <div class="hnmt-card-title-group">
                            <span class="hnmt-card-badge">TIẾN ĐỘ</span>
                            <h2 class="hnmt-card-title">Tiến trình vận đơn & xử lý</h2>
                        </div>
                        <span class="hnmt-card-hint">
                            Cập nhật thời gian thực
                        </span>
                    </div>

                    @if (!isExceptionalStatus)
                    {
                        <!-- 5-STEP HORIZONTAL STEPPER -->
                        <div class="hnmt-stepper-bar">
                            @{
                                var steps = new[]
                                {
                                    new { Step = 1, Name = "Đặt hàng", Desc = "Tiếp nhận đơn", Icon = "bi-bag-check" },
                                    new { Step = 2, Name = "Xác nhận", Desc = "Hệ thống duyệt", Icon = "bi-check2-circle" },
                                    new { Step = 3, Name = "Xử lý kho", Desc = "Đóng gói kiện", Icon = "bi-box-seam" },
                                    new { Step = 4, Name = "Đang giao", Desc = "Shipper vận chuyển", Icon = "bi-truck" },
                                    new { Step = 5, Name = "Thành công", Desc = "Đã nhận kiện hàng", Icon = "bi-house-check" }
                                };
                            }

                            @for (int i = 0; i < steps.Length; i++)
                            {
                                var s = steps[i];
                                bool isDone = currentStep > s.Step;
                                bool isActive = currentStep == s.Step;

                                <div class="hnmt-step-node @(isDone ? "is-done" : "") @(isActive ? "is-active" : "")">
                                    <div class="hnmt-step-circle">
                                        @if (isDone)
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                        else
                                        {
                                            <i class="bi @s.Icon"></i>
                                        }
                                    </div>
                                    <div class="hnmt-step-labels">
                                        <span class="hnmt-step-name">@s.Name</span>
                                        <span class="hnmt-step-desc">@s.Desc</span>
                                    </div>
                                </div>

                                @if (i < steps.Length - 1)
                                {
                                    <div class="hnmt-step-line @(currentStep > s.Step ? "is-done" : "")"></div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <!-- EXCEPTIONAL STATE BANNER -->
                        <div class="hnmt-exceptional-banner @(isCancelled ? "is-cancelled" : "is-failed")">
                            <i class="bi @(isCancelled ? "bi-x-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                            <div>
                                <strong>@(isCancelled ? "Đơn hàng đã được hủy" : "Kiện hàng không giao thành công / Đã hoàn trả")</strong>
                                <p>
                                    @(isCancelled
                                        ? "Đơn hàng này đã kết thúc. Tồn kho sản phẩm đã được tự động hoàn lại hệ thống."
                                        : "Vui lòng liên hệ bộ phận chăm sóc khách hàng nếu bạn cần hỗ trợ kiểm tra kiện hàng.")
                                </p>
                            </div>
                        </div>
                    }

                    <!-- TIMELINE EVENT LOG -->
                    <div class="hnmt-timeline-accordion">
                        <div class="hnmt-timeline-heading">
                            <i class="bi bi-journal-text"></i> Nhật ký trạng thái chi tiết (@histories.Count mốc)
                        </div>

                        <div class="hnmt-timeline-flow">
                            @if (histories.Any())
                            {
                                @foreach (var hist in histories)
                                {
                                    var isCurrent = hist == histories.Last() && hist.NewStatus == Model.Status;
                                    var note = GetHistoryNote(hist);

                                    <div class="hnmt-timeline-item @(isCurrent ? "is-head" : "")">
                                        <div class="hnmt-timeline-marker @(isCurrent ? "active-marker" : (hist.NewStatus == OrderStatus.Cancelled ? "danger-marker" : "done-marker"))">
                                            @if (hist.NewStatus == OrderStatus.Delivered)
                                            {
                                                <i class="bi bi-check2"></i>
                                            }
                                            else if (hist.NewStatus == OrderStatus.Cancelled)
                                            {
                                                <i class="bi bi-x"></i>
                                            }
                                            else
                                            {
                                                <span class="hnmt-marker-bullet"></span>
                                            }
                                        </div>

                                        <div class="hnmt-timeline-body">
                                            <div class="hnmt-timeline-row-top">
                                                <strong class="hnmt-timeline-state-title @(isCurrent ? "text-dark" : "text-muted")">
                                                    @GetStatusName(hist.NewStatus)
                                                </strong>
                                                <span class="hnmt-timeline-time">
                                                    @hist.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(note))
                                            {
                                                <div class="hnmt-timeline-note">@note</div>
                                            }

                                            @if (isCurrent)
                                            {
                                                <span class="hnmt-current-stage-tag">Mốc hiện tại</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="hnmt-timeline-empty">
                                    <i class="bi bi-info-circle"></i> Đơn hàng đang được hệ thống tiếp nhận và chuẩn bị hồ sơ xử lý.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- SELECTED PRODUCTS CARD WITH DETAIL GALLERY IMAGES -->
                <div class="hnmt-card hnmt-items-card">
                    <div class="hnmt-card-header">
                        <div class="hnmt-card-title-group">
                            <span class="hnmt-card-badge">BỘ SƯU TẬP</span>
                            <h2 class="hnmt-card-title">Sản phẩm đã chọn (@Model.Items.Count sản phẩm)</h2>
                        </div>
                        <span class="hnmt-card-hint">
                            Bao gồm hình ảnh chi tiết các góc chụp chính hãng
                        </span>
                    </div>

                    <div class="hnmt-items-list">
                        @{
                            int itemIndex = 0;
                        }
                        @foreach (var item in Model.Items)
                        {
                            itemIndex++;
                            var photoData = ResolveItemPhotos(item, DbContext);
                            var itemContainerId = $"orderItem_{item.Id}_{itemIndex}";
                            var mainImageId = $"mainImg_{item.Id}_{itemIndex}";

                            <div class="hnmt-product-item-card" id="@itemContainerId">
                                <!-- LEFT: PRODUCT MAIN THUMBNAIL + GALLERY DETAIL STRIP -->
                                <div class="hnmt-item-visual-col">
                                    <div class="hnmt-main-img-box">
                                        <img src="@photoData.MainImage"
                                             id="@mainImageId"
                                             alt="@item.ProductName"
                                             class="hnmt-product-main-photo"
                                             onerror="this.onerror=null;this.src='/clothing-rail/assets/reach-shirt-front.webp';" />
                                        <span class="hnmt-view-badge">Mặt trước</span>
                                    </div>

                                    <!-- DETAIL PHOTOS THUMBNAILS (HÌNH ẢNH CHI TIẾT CÁC GÓC) -->
                                    <div class="hnmt-detail-photos-row" title="Nhấp vào để đổi góc xem chi tiết">
                                        @if (!string.IsNullOrEmpty(photoData.FrontImage))
                                        {
                                            <button type="button"
                                                    class="hnmt-detail-thumb-btn active"
                                                    onclick="switchDetailImage('@mainImageId', '@photoData.FrontImage', this, 'Mặt trước')"
                                                    title="Xem mặt trước">
                                                <img src="@photoData.FrontImage" alt="Mặt trước" onerror="this.onerror=null;this.src='/clothing-rail/assets/reach-shirt-front.webp';" />
                                                <span>Trước</span>
                                            </button>
                                        }

                                        @if (!string.IsNullOrEmpty(photoData.BackImage))
                                        {
                                            <button type="button"
                                                    class="hnmt-detail-thumb-btn"
                                                    onclick="switchDetailImage('@mainImageId', '@photoData.BackImage', this, 'Mặt sau')"
                                                    title="Xem mặt sau">
                                                <img src="@photoData.BackImage" alt="Mặt sau" onerror="this.onerror=null;this.src='/clothing-rail/assets/reach-shirt-back.webp';" />
                                                <span>Sau</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- RIGHT: PRODUCT SPECIFICATIONS & PRICING -->
                                <div class="hnmt-item-info-col">
                                    <div class="hnmt-item-headline">
                                        <div>
                                            <span class="hnmt-brand-tag">HNMT ATELIER</span>
                                            <h3 class="hnmt-item-name">
                                                @if (photoData.ProductId > 0)
                                                {
                                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@photoData.ProductId" class="hnmt-item-link" title="Xem chi tiết sản phẩm">
                                                        @item.ProductName
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>@item.ProductName</span>
                                                }
                                            </h3>
                                        </div>

                                        <div class="hnmt-item-price-block">
                                            <div class="hnmt-item-total">@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</div>
                                            <div class="hnmt-item-unit">Đơn giá: @item.UnitPrice.ToString("N0") ₫</div>
                                        </div>
                                    </div>

                                    <!-- ATTRIBUTES ROW -->
                                    <div class="hnmt-attributes-cluster">
                                        <div class="hnmt-attr-pill">
                                            <span class="hnmt-attr-label">Size:</span>
                                            <strong class="hnmt-attr-val">@item.Size</strong>
                                        </div>

                                        <div class="hnmt-attr-pill">
                                            <span class="hnmt-attr-label">Màu sắc:</span>
                                            @if (!string.IsNullOrEmpty(photoData.ColorHex))
                                            {
                                                <span class="hnmt-color-dot" style="background-color: @photoData.ColorHex;"></span>
                                            }
                                            <strong class="hnmt-attr-val">@item.Color</strong>
                                        </div>

                                        <div class="hnmt-attr-pill quantity-pill">
                                            <span class="hnmt-attr-label">Số lượng:</span>
                                            <strong class="hnmt-attr-val">x@(item.Quantity)</strong>
                                        </div>

                                        <div class="hnmt-sku-pill">
                                            <i class="bi bi-upc-scan"></i>
                                            <span>SKU: @item.SKU</span>
                                        </div>
                                    </div>

                                    <!-- ITEM FOOTER ACTIONS -->
                                    <div class="hnmt-item-footer">
                                        <div class="hnmt-item-status-check">
                                            <i class="bi bi-patch-check-fill text-success"></i>
                                            <span>Sản phẩm chính hãng HNMT • Kiểm định chất lượng</span>
                                        </div>

                                        <div class="hnmt-item-links">
                                            @if (photoData.ProductId > 0)
                                            {
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@photoData.ProductId" class="hnmt-sub-link">
                                                    <i class="bi bi-box-arrow-up-right"></i> Xem trên Store
                                                </a>
                                            }
                                            <a asp-controller="Products" asp-action="Index" class="hnmt-sub-link">
                                                <i class="bi bi-arrow-repeat"></i> Đặt mua lại
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SHIPPING RECIPIENT INFORMATION CARD -->
                <div class="hnmt-card hnmt-shipping-card">
                    <div class="hnmt-card-header">
                        <div class="hnmt-card-title-group">
                            <span class="hnmt-card-badge">GIAO NHẬN</span>
                            <h2 class="hnmt-card-title">Thông tin người nhận & Địa chỉ giao kiện</h2>
                        </div>
                        <span class="hnmt-card-hint">
                            Vận chuyển bởi HNMT Express
                        </span>
                    </div>

                    <div class="hnmt-shipping-grid">
                        <div class="hnmt-shipping-cell">
                            <div class="hnmt-shipping-cell-header">
                                <i class="bi bi-person-circle"></i>
                                <span>Người nhận hàng</span>
                            </div>
                            <div class="hnmt-shipping-cell-body">
                                <strong>@Model.ReceiverName</strong>
                                <small>Khách hàng thành viên HNMT</small>
                            </div>
                        </div>

                        <div class="hnmt-shipping-cell">
                            <div class="hnmt-shipping-cell-header">
                                <i class="bi bi-telephone-inbound-fill"></i>
                                <span>Số điện thoại liên hệ</span>
                            </div>
                            <div class="hnmt-shipping-cell-body">
                                <strong class="font-mono">@Model.Phone</strong>
                                <small>Liên lạc trước khi giao hàng</small>
                            </div>
                        </div>

                        <div class="hnmt-shipping-cell full-width">
                            <div class="hnmt-shipping-cell-header">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                <span>Địa chỉ giao kiện cụ thể</span>
                            </div>
                            <div class="hnmt-address-display">
                                <div class="hnmt-address-text">
                                    @Model.Address
                                </div>
                                <span class="hnmt-deliver-badge">
                                    <i class="bi bi-truck"></i> Giao tận tay người nhận
                                </span>
                            </div>
                        </div>

                        @if (Model.Shipments != null && Model.Shipments.Any())
                        {
                            var latestShipment = Model.Shipments.OrderByDescending(s => s.CreatedAt).ThenByDescending(s => s.Id).First();
                            <div class="hnmt-shipping-cell full-width shipment-info-cell">
                                <div class="hnmt-shipping-cell-header">
                                    <i class="bi bi-mailbox2"></i>
                                    <span>Mã vận đơn vận chuyển (Tracking)</span>
                                </div>
                                <div class="hnmt-shipment-tracking-row">
                                    <div class="hnmt-tracking-code-pill font-mono">
                                        @latestShipment.TrackingCode
                                    </div>
                                    <span class="hnmt-shipment-state-badge">
                                        Trạng thái: <strong>@latestShipment.Status</strong>
                                    </span>
                                </div>
                                <div class="mt-3" data-order-tracking data-url="@Url.Action("TrackingLocation", "Orders", new { id = Model.Id })">
                                    <p data-tracking-status role="status">Đang kiểm tra vị trí giao hàng…</p>
                                    <a data-tracking-map hidden target="_blank" rel="noopener noreferrer">Mở vị trí trên bản đồ</a>
                                    <p><small data-tracking-time></small></p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: FINANCIAL BREAKDOWN, VIETQR SCAN, ORDER ACTIONS -->
            <div class="hnmt-side-col">
                <div class="hnmt-summary-panel">
                    <div class="hnmt-summary-head">
                        <span class="hnmt-summary-eyebrow">HÓA ĐƠN & THANH TOÁN</span>
                        <h3 class="hnmt-summary-title">Tổng kết thanh toán</h3>
                    </div>

                    <!-- PAYMENT STATUS BADGE BOX -->
                    <div class="hnmt-payment-method-box">
                        <div class="hnmt-pm-row">
                            <span class="hnmt-pm-label">Hình thức:</span>
                            <span class="hnmt-pm-val">@paymentMethodText</span>
                        </div>
                        <div class="hnmt-pm-row">
                            <span class="hnmt-pm-label">Tình trạng:</span>
                            <span class="hnmt-pay-status-pill @(Model.PaymentStatus == PaymentStatus.Paid ? "paid" : "pending")">
                                <i class="bi @(Model.PaymentStatus == PaymentStatus.Paid ? "bi-check-circle-fill" : "bi-clock-fill")"></i>
                                @paymentText
                            </span>
                        </div>
                    </div>

                    <!-- VIETQR INTERACTIVE BOX -->
                    @if (Model.PaymentMethod == PaymentMethod.VietQR && Model.PaymentStatus == PaymentStatus.Pending && !isExceptionalStatus)
                    {
                        <div class="hnmt-vietqr-callout">
                            <div class="hnmt-vqr-icon">
                                <i class="bi bi-qr-code"></i>
                            </div>
                            <div class="hnmt-vqr-content">
                                <h4>Thanh toán Chuyển khoản VietQR</h4>
                                <p>Quét mã VietQR bằng app ngân hàng để hoàn tất thanh toán nhanh chóng 24/7.</p>
                            </div>
                            <a asp-action="PaymentQR" asp-route-id="@Model.Id" class="hnmt-vqr-btn">
                                <i class="bi bi-qr-code-scan"></i>
                                <span>@(Model.TransferReportedAt.HasValue ? "Xem lại mã QR đã thanh toán" : "Mở mã VietQR thanh toán ngay")</span>
                            </a>
                            @if (Model.TransferReportedAt.HasValue)
                            {
                                <div class="hnmt-vqr-alert">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>Bạn đã xác nhận chuyển khoản. Kế toán đang đối soát tự động.</span>
                                </div>
                            }
                        </div>
                    }

                    <!-- PRICE LEDGER -->
                    <div class="hnmt-ledger-section">
                        <div class="hnmt-ledger-line">
                            <span class="hnmt-ledger-label">Tạm tính tiền hàng</span>
                            <span class="hnmt-ledger-val font-mono">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>

                        <div class="hnmt-ledger-line">
                            <span class="hnmt-ledger-label">Phí vận chuyển chuẩn</span>
                            <span class="hnmt-ledger-val font-mono">
                                @(Model.ShippingFee > 0 ? Model.ShippingFee.ToString("N0") + " ₫" : "Miễn phí")
                            </span>
                        </div>

                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="hnmt-ledger-line discount-line">
                                <span class="hnmt-ledger-label">
                                    <i class="bi bi-tag-fill me-1"></i> Ưu đãi / Voucher giảm
                                </span>
                                <span class="hnmt-ledger-val font-mono">-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }

                        <div class="hnmt-ledger-divider"></div>

                        <div class="hnmt-ledger-total">
                            <div>
                                <span class="hnmt-total-title">Tổng thanh toán</span>
                                <small class="hnmt-total-sub">Đã bao gồm VAT & mọi chi phí</small>
                            </div>
                            <div class="hnmt-total-figure font-mono">
                                @Model.TotalAmount.ToString("N0") ₫
                            </div>
                        </div>
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="hnmt-panel-actions">
                        @if (Model.Status == OrderStatus.PendingConfirmation)
                        {
                            <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn yêu cầu hủy đơn hàng này? Hệ thống sẽ tự động hoàn kho số lượng.');" class="w-100 m-0 mb-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="hnmt-cancel-order-btn">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Yêu cầu hủy đơn hàng này</span>
                                </button>
                            </form>
                        }

                        <a asp-controller="Products" asp-action="Index" class="hnmt-primary-pill-btn">
                            <span>Khám phá thêm sản phẩm</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <div class="hnmt-support-widget">
                            <div class="hnmt-support-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div>
                                <strong>Cần hỗ trợ về đơn hàng này?</strong>
                                <p>Hotline: 1900 8888 (8:00 - 22:00 hàng ngày)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<style>
/* ==========================================================================
   HNMT ORDER DETAILS DESIGN SYSTEM - LUXURY MONOCHROME WITH WARM ACCENTS
   Matches HNMT Shop / Atelier aesthetic: Clean, Bold, Minimal, High-End
   ========================================================================== */

.hnmt-order-details-wrapper {
    background-color: #FAFAFA;
    min-height: 100vh;
    padding: 32px 0 80px;
    font-family: var(--urbn-font, 'Plus Jakarta Sans', -apple-system, sans-serif);
    color: #111827;
}

.hnmt-details-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
}

/* TOP NAV & BREADCRUMB */
.hnmt-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
}

.hnmt-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: #4B5563;
    padding: 8px 16px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 999px;
    transition: all 0.2s ease;
}

.hnmt-back-btn:hover {
    color: #000000;
    border-color: #000000;
    background: #F9FAFB;
}

.hnmt-breadcrumb {
    font-size: 13px;
    color: #6B7280;
    display: flex;
    align-items: center;
    gap: 8px;
}

.hnmt-breadcrumb a {
    color: #6B7280;
}

.hnmt-breadcrumb a:hover {
    color: #000000;
}

.hnmt-sep {
    color: #D1D5DB;
}

.hnmt-current {
    color: #111827;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

/* HEADER CARD */
.hnmt-header-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 30px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
}

.hnmt-eyebrow-tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #6B7280;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.hnmt-title-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.hnmt-page-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    color: #000000;
    letter-spacing: -0.8px;
    margin: 0;
    line-height: 1.2;
}

.hnmt-code-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    color: #111827;
    background: #F3F4F6;
    padding: 3px 10px;
    border-radius: 8px;
    border: 1px solid #E5E7EB;
    font-size: 0.9em;
}

.hnmt-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    color: #374151;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
}

.hnmt-copy-btn:hover {
    background: #111827;
    color: #FFFFFF;
    border-color: #111827;
}

.hnmt-meta-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13.5px;
    color: #4B5563;
}

.hnmt-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.hnmt-meta-divider {
    color: #D1D5DB;
}

.hnmt-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
}

/* STATUS PILLS */
.hnmt-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

.hnmt-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: currentColor;
    position: relative;
}

.hnmt-status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.4;
    animation: hnmtPulse 2s infinite ease-out;
}

@@keyframes hnmtPulse {
    0% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(2); opacity: 0; }
    100% { transform: scale(2); opacity: 0; }
}

.hnmt-status-pill.status-pending {
    background-color: #FFFBEB;
    color: #B45309;
    border: 1px solid #FDE68A;
}

.hnmt-status-pill.status-confirmed {
    background-color: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
}

.hnmt-status-pill.status-processing {
    background-color: #EEF2FF;
    color: #4338CA;
    border: 1px solid #C7D2FE;
}

.hnmt-status-pill.status-shipping {
    background-color: #F5F3FF;
    color: #6D28D9;
    border: 1px solid #DDD6FE;
}

.hnmt-status-pill.status-delivered {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
}

.hnmt-status-pill.status-cancelled {
    background-color: #FEF2F2;
    color: #B91C1C;
    border: 1px solid #FECACA;
}

.hnmt-status-pill.status-failed,
.hnmt-status-pill.status-returned {
    background-color: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FFEDD5;
}

.hnmt-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.hnmt-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: #374151;
    background: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 7px 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.hnmt-action-btn:hover {
    background: #000000;
    color: #FFFFFF;
    border-color: #000000;
}

/* NOTICE BOXES */
.hnmt-notice-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 14px;
}

.hnmt-notice-box.success {
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    color: #065F46;
}

.hnmt-notice-box.error {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #991B1B;
}

.hnmt-notice-box i {
    font-size: 22px;
    flex-shrink: 0;
}

.hnmt-notice-content {
    display: flex;
    flex-direction: column;
}

/* 2-COLUMN GRID */
.hnmt-details-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 30px;
    align-items: start;
}

@@media (max-width: 1024px) {
    .hnmt-details-grid {
        grid-template-columns: 1fr;
    }
    .hnmt-header-right {
        align-items: flex-start;
    }
}

/* CARDS COMMON */
.hnmt-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 20px;
    padding: 28px;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
}

.hnmt-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid #F3F4F6;
    margin-bottom: 24px;
}

.hnmt-card-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.hnmt-card-badge {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #9CA3AF;
    text-transform: uppercase;
}

.hnmt-card-title {
    font-size: 20px;
    font-weight: 800;
    color: #000000;
    letter-spacing: -0.4px;
    margin: 0;
}

.hnmt-card-hint {
    font-size: 12px;
    color: #6B7280;
    background: #F9FAFB;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid #E5E7EB;
}

/* STEPPER */
.hnmt-stepper-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    padding: 10px 0;
    position: relative;
}

.hnmt-step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 2;
    min-width: 80px;
}

.hnmt-step-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #F3F4F6;
    border: 2px solid #E5E7EB;
    color: #9CA3AF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
    transition: all 0.3s;
}

.hnmt-step-node.is-done .hnmt-step-circle {
    background: #111827;
    border-color: #111827;
    color: #FFFFFF;
}

.hnmt-step-node.is-active .hnmt-step-circle {
    background: #FFFFFF;
    border-color: #111827;
    color: #111827;
    box-shadow: 0 0 0 4px rgba(17, 24, 39, 0.15);
}

.hnmt-step-labels {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.hnmt-step-name {
    font-size: 13px;
    font-weight: 700;
    color: #374151;
}

.hnmt-step-node.is-active .hnmt-step-name {
    color: #000000;
}

.hnmt-step-desc {
    font-size: 11px;
    color: #9CA3AF;
}

.hnmt-step-line {
    flex-grow: 1;
    height: 3px;
    background: #E5E7EB;
    margin: 0 10px;
    margin-bottom: 32px;
    transition: all 0.3s;
}

.hnmt-step-line.is-done {
    background: #111827;
}

.hnmt-exceptional-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    border-radius: 12px;
    margin-bottom: 24px;
}

.hnmt-exceptional-banner.is-cancelled {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #991B1B;
}

.hnmt-exceptional-banner.is-failed {
    background: #FFF7ED;
    border: 1px solid #FED7AA;
    color: #9A3412;
}

.hnmt-exceptional-banner i {
    font-size: 28px;
    flex-shrink: 0;
}

.hnmt-exceptional-banner strong {
    font-size: 15px;
    display: block;
    margin-bottom: 4px;
}

.hnmt-exceptional-banner p {
    font-size: 13px;
    margin: 0;
    opacity: 0.9;
}

/* TIMELINE ACCORDION */
.hnmt-timeline-accordion {
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 20px;
}

.hnmt-timeline-heading {
    font-size: 13px;
    font-weight: 700;
    color: #374151;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.hnmt-timeline-flow {
    display: flex;
    flex-direction: column;
    position: relative;
    padding-left: 12px;
}

.hnmt-timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    position: relative;
    padding-bottom: 20px;
}

.hnmt-timeline-item:last-child {
    padding-bottom: 0;
}

.hnmt-timeline-item::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 24px;
    bottom: -4px;
    width: 2px;
    background: #E5E7EB;
}

.hnmt-timeline-item:last-child::before {
    display: none;
}

.hnmt-timeline-marker {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #D1D5DB;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
    z-index: 2;
}

.hnmt-timeline-marker.active-marker {
    background: #000000;
    border-color: #000000;
    color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
}

.hnmt-timeline-marker.done-marker {
    background: #E5E7EB;
    border-color: #9CA3AF;
    color: #374151;
}

.hnmt-timeline-marker.danger-marker {
    background: #EF4444;
    border-color: #EF4444;
    color: #FFFFFF;
}

.hnmt-marker-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
}

.hnmt-timeline-body {
    flex-grow: 1;
}

.hnmt-timeline-row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
}

.hnmt-timeline-state-title {
    font-size: 14px;
}

.hnmt-timeline-time {
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #6B7280;
}

.hnmt-timeline-note {
    font-size: 12.5px;
    color: #6B7280;
    margin-top: 4px;
}

.hnmt-current-stage-tag {
    display: inline-block;
    background: #000000;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    margin-top: 6px;
}

.hnmt-timeline-empty {
    font-size: 13px;
    color: #6B7280;
    padding: 10px 0;
}

/* ==========================================================================
   PRODUCT ITEMS & DETAIL PHOTOS SECTION
   ========================================================================== */
.hnmt-items-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.hnmt-product-item-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 20px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
    transition: all 0.25s ease;
}

.hnmt-product-item-card:hover {
    border-color: #D1D5DB;
    box-shadow: 0 6px 20px -4px rgba(0, 0, 0, 0.06);
}

@@media (max-width: 640px) {
    .hnmt-product-item-card {
        grid-template-columns: 1fr;
    }
