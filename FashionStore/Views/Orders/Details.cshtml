@model FashionStore.Models.Entities.Order
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Chi tiết đơn hàng - " + Model.OrderCode;

    var paymentMethodText = Model.PaymentMethod switch
    {
        PaymentMethod.COD => "Thanh toán khi nhận hàng (COD)",
        PaymentMethod.VietQR => "Chuyển khoản VietQR",
        _ => "Không xác định"
    };

    var statusText = Model.Status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang giao hàng",
        OrderStatus.Delivered => "Đã giao hàng thành công",
        OrderStatus.Cancelled => "Đã hủy đơn hàng",
        OrderStatus.DeliveryFailed => "Giao hàng thất bại",
        OrderStatus.Returned => "Đã hoàn trả hàng",
        _ => "Không xác định"
    };

    var paymentText = Model.PaymentStatus switch
    {
        PaymentStatus.Pending => "Chờ thanh toán",
        PaymentStatus.Paid => "Đã thanh toán",
        PaymentStatus.Failed => "Thanh toán lỗi",
        PaymentStatus.Refunded => "Đã hoàn tiền",
        _ => "Không xác định"
    };

    var histories = ViewBag.StatusHistories as List<OrderStatusHistory> ?? new List<OrderStatusHistory>();
    histories = histories.OrderBy(h => h.CreatedAt).ThenBy(h => h.Id).ToList();

    string GetStatusName(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý",
        OrderStatus.Shipping => "Đang giao hàng",
        OrderStatus.Delivered => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã trả hàng",
        _ => status.ToString()
    };

    string GetBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "pending",
        OrderStatus.Confirmed => "confirmed",
        OrderStatus.Processing => "processing",
        OrderStatus.Shipping => "shipping",
        OrderStatus.Delivered => "delivered",
        OrderStatus.Cancelled => "cancelled",
        OrderStatus.DeliveryFailed => "failed",
        OrderStatus.Returned => "returned",
        _ => "pending"
    };

    bool isExceptionalStatus =
        Model.Status == OrderStatus.Cancelled ||
        Model.Status == OrderStatus.DeliveryFailed ||
        Model.Status == OrderStatus.Returned;

    string? GetHistoryNote(OrderStatusHistory history)
    {
        if (string.IsNullOrWhiteSpace(history.Note)) return null;
        var note = history.Note;
        if (note.StartsWith("Cập nhật trạng thái:", StringComparison.OrdinalIgnoreCase))
        {
            foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                note = note.Replace(s.ToString(), GetStatusName(s));
            }
        }
        return note;
    }
}

<div class="fs-page-wrap">
    <div class="container">
        
        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <a asp-action="Index" class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1 mb-2">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
                </a>
                <h1 class="fs-page-title mb-1">Hồ sơ đơn hàng <span class="font-monospace">#@Model.OrderCode</span></h1>
                <p class="fs-page-desc">Khởi tạo lúc: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div>
                <span class="fs-badge-status @GetBadgeClass(Model.Status)" style="font-size: 14px; padding: 8px 18px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: currentColor;"></span>
                    @statusText
                </span>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="fs-pill-alert success">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="fs-pill-alert error">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <div class="row g-4">
            <!-- MAIN COLUMN (ITEMS & TIMELINE) -->
            <div class="col-lg-8">
                
                <!-- TIMELINE STEPPER -->
                <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                    <h5 class="fw-bold mb-4" style="font-family:'Cormorant Garamond', Georgia, serif; font-size: 22px;">
                        Tiến trình đơn hàng
                    </h5>

                    @if (histories.Any())
                    {
                        <div class="fs-timeline-container">
                            @foreach (var history in histories)
                            {
                                var isCurrent = history == histories.Last() && history.NewStatus == Model.Status;
                                var note = GetHistoryNote(history);

                                <div class="fs-timeline-row">
                                    <div class="fs-timeline-dot @(isCurrent ? "current" : (history.NewStatus == OrderStatus.Cancelled ? "danger" : "passed"))">
                                        @if (history.NewStatus == OrderStatus.Delivered)
                                        {
                                            <span>✓</span>
                                        }
                                        else if (history.NewStatus == OrderStatus.Cancelled)
                                        {
                                            <span>✕</span>
                                        }
                                        else
                                        {
                                            <span>•</span>
                                        }
                                    </div>

                                    <div>
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <strong class="fs-6 @(isCurrent ? "text-dark fw-bold" : "text-muted")">
                                                @GetStatusName(history.NewStatus)
                                            </strong>
                                            <span class="text-muted small font-monospace">
                                                @history.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(note))
                                        {
                                            <p class="text-muted small mt-1 mb-0">@note</p>
                                        }

                                        @if (isCurrent)
                                        {
                                            <span class="badge bg-dark rounded-pill px-2 py-1 mt-2" style="font-size: 10px;">
                                                Giai đoạn hiện tại
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i> Đơn hàng đang được hệ thống tiếp nhận và chuẩn bị hồ sơ.
                        </div>
                    }
                </div>

                <!-- ORDER ITEMS -->
                <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                    <h5 class="fw-bold mb-4" style="font-family:'Cormorant Garamond', Georgia, serif; font-size: 22px;">
                        Sản phẩm đã chọn (@Model.Items.Count)
                    </h5>

                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom gap-3">
                            <div>
                                <h6 class="fw-bold mb-1">@item.ProductName</h6>
                                <div class="text-muted small">
                                    <span>Size: <strong>@item.Size</strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Màu: <strong>@item.Color</strong></span>
                                    <span class="mx-2">•</span>
                                    <span>SL: <strong>x@item.Quantity</strong></span>
                                </div>
                                <div class="text-muted small font-monospace">SKU: @item.SKU</div>
                            </div>

                            <div class="text-end font-monospace fw-bold fs-6">
                                @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                            </div>
                        </div>
                    }
                </div>

                <!-- SHIPPING INFO -->
                <div class="card border rounded-4 p-4 bg-white shadow-sm">
                    <h5 class="fw-bold mb-3" style="font-family:'Cormorant Garamond', Georgia, serif; font-size: 22px;">
                        Thông tin giao nhận
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Người nhận hàng</div>
                            <div class="fw-bold fs-6 text-dark mt-1">@Model.ReceiverName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Số điện thoại liên hệ</div>
                            <div class="fw-bold fs-6 text-dark mt-1 font-monospace">@Model.Phone</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small">Địa chỉ nhận kiện</div>
                            <div class="p-3 bg-light rounded-3 mt-1 fw-semibold text-dark">
                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>@Model.Address
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIDEBAR COLUMN (PAYMENT & TOTAL) -->
            <div class="col-lg-4">
                <div class="fs-summary-panel">
                    <h4 class="fs-summary-heading">Tổng kết thanh toán</h4>

                    <div class="fs-summary-line">
                        <span>Phương thức:</span>
                        <strong class="text-dark">@paymentMethodText</strong>
                    </div>

                    <div class="fs-summary-line">
                        <span>Trạng thái TT:</span>
                        <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1">
                            @paymentText
                        </span>
                    </div>

                    @if (Model.PaymentMethod == PaymentMethod.VietQR && Model.PaymentStatus == PaymentStatus.Pending && !isExceptionalStatus)
                    {
                        <div class="my-3">
                            <a asp-action="PaymentQR" asp-route-id="@Model.Id" class="fs-btn fs-btn-dark w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-qr-code-scan"></i>
                                <span>@(Model.TransferReportedAt.HasValue ? "Xem mã VietQR" : "Thanh toán ngay bằng QR")</span>
                            </a>
                            @if (Model.TransferReportedAt.HasValue)
                            {
                                <p class="text-muted small text-center mt-2 mb-0">Bạn đã xác nhận chuyển khoản. Hệ thống đang tiến hành đối soát.</p>
                            }
                        </div>
                    }

                    <div class="fs-summary-line pt-3 border-top">
                        <span>Tạm tính hàng</span>
                        <span>@Model.SubTotal.ToString("N0") đ</span>
                    </div>

                    <div class="fs-summary-line">
                        <span>Phí vận chuyển</span>
                        <span>@Model.ShippingFee.ToString("N0") đ</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="fs-summary-line text-danger">
                            <span>Giảm giá</span>
                            <span>-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                    }

                    <div class="fs-summary-line total">
                        <span>Tổng tiền</span>
                        <span>@Model.TotalAmount.ToString("N0") đ</span>
                    </div>

                    @if (Model.Status == OrderStatus.PendingConfirmation)
                    {
                        <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');" class="m-0 mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2 fw-semibold">
                                <i class="bi bi-x-circle me-1"></i> Yêu cầu hủy đơn
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
