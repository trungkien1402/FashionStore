@model FashionStore.Models.Entities.Order
@using System.Text.Json
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject FashionStore.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Hồ sơ đơn hàng #" + Model.OrderCode;

    var histories = ViewBag.StatusHistories as List<OrderStatusHistory> ?? new List<OrderStatusHistory>();
    histories = histories.OrderBy(h => h.CreatedAt).ThenBy(h => h.Id).ToList();

    var paymentMethodText = Model.PaymentMethod switch
    {
        PaymentMethod.COD => "Thanh toán khi nhận hàng (COD)",
        PaymentMethod.VietQR => "Chuyển khoản VietQR 24/7",
        _ => "Phương thức khác"
    };

    var statusText = Model.Status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang vận chuyển",
        OrderStatus.Delivered => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy đơn",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã hoàn trả",
        _ => "Đang cập nhật"
    };

    var statusTheme = Model.Status switch
    {
        OrderStatus.PendingConfirmation => "status-pending",
        OrderStatus.Confirmed => "status-confirmed",
        OrderStatus.Processing => "status-processing",
        OrderStatus.Shipping => "status-shipping",
        OrderStatus.Delivered => "status-delivered",
        OrderStatus.Cancelled => "status-cancelled",
        OrderStatus.DeliveryFailed => "status-failed",
        OrderStatus.Returned => "status-failed",
        _ => "status-pending"
    };

    var paymentText = Model.PaymentStatus switch
    {
        PaymentStatus.Pending => "Chờ thanh toán",
        PaymentStatus.Paid => "Đã thanh toán",
        PaymentStatus.Failed => "Thanh toán lỗi",
        PaymentStatus.Refunded => "Đã hoàn tiền",
        _ => "Chưa xác định"
    };

    bool isCancelled = Model.Status == OrderStatus.Cancelled;
    bool isFailed = Model.Status == OrderStatus.DeliveryFailed || Model.Status == OrderStatus.Returned;
    bool isExceptionalStatus = isCancelled || isFailed;

    int currentStep = Model.Status switch
    {
        OrderStatus.PendingConfirmation => 1,
        OrderStatus.Confirmed => 2,
        OrderStatus.Processing => 3,
        OrderStatus.Shipping => 4,
        OrderStatus.Delivered => 5,
        _ => 0
    };

    string GetStatusName(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang vận chuyển",
        OrderStatus.Delivered => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy đơn",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã hoàn trả",
        _ => status.ToString()
    };

    string? GetHistoryNote(OrderStatusHistory history)
    {
        if (string.IsNullOrWhiteSpace(history.Note)) return null;
        var note = history.Note;
        if (note.StartsWith("Cập nhật trạng thái:", StringComparison.OrdinalIgnoreCase))
        {
            foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                note = note.Replace(s.ToString(), GetStatusName(s));
            }
        }
        return note;
    }
}

@functions {
    public class ItemPhotoDetail
    {
        public string MainImage { get; set; } = "/clothing-rail/assets/reach-shirt-front.webp";
        public string? FrontImage { get; set; }
        public string? BackImage { get; set; }
        public string? SideImage { get; set; }
        public string? ColorHex { get; set; }
        public int ProductId { get; set; }
        public string ProductSlug { get; set; } = "";
    }

    public ItemPhotoDetail ResolveItemPhotos(OrderItem item, FashionStore.Data.ApplicationDbContext db)
    {
        var result = new ItemPhotoDetail();

        Product? product = item.ProductVariant?.Product;
        if (product == null && item.ProductVariantId > 0)
        {
            try
            {
                var variant = db.ProductVariants.Include(v => v.Product).FirstOrDefault(v => v.Id == item.ProductVariantId);
                product = variant?.Product;
            }
            catch { }
        }
        if (product == null && !string.IsNullOrEmpty(item.ProductName))
        {
            try
            {
                product = db.Products.FirstOrDefault(p => p.Name == item.ProductName);
            }
            catch { }
        }

        if (product != null)
        {
            result.ProductId = product.Id;
            result.ProductSlug = product.Slug;
            result.MainImage = !string.IsNullOrEmpty(product.ImageUrl) ? product.ImageUrl : "/clothing-rail/assets/reach-shirt-front.webp";

            if (!string.IsNullOrEmpty(product.ShowroomMetadata))
            {
                try
                {
                    using var doc = JsonDocument.Parse(product.ShowroomMetadata);
                    var root = doc.RootElement;
                    if (root.TryGetProperty("colors", out var colorsElem) && root.TryGetProperty("photos", out var photosElem))
                    {
                        int matchedColorIdx = -1;
                        int colorCount = colorsElem.GetArrayLength();

                        for (int i = 0; i < colorCount; i++)
                        {
                            var colorArr = colorsElem[i];
                            if (colorArr.GetArrayLength() > 0)
                            {
                                var colorName = colorArr[0].GetString();
                                if (!string.IsNullOrEmpty(colorName) &&
                                    (colorName.Equals(item.Color, StringComparison.OrdinalIgnoreCase) ||
                                     item.Color.Contains(colorName, StringComparison.OrdinalIgnoreCase) ||
                                     colorName.Contains(item.Color, StringComparison.OrdinalIgnoreCase)))
                                {
                                    matchedColorIdx = i;
                                    if (colorArr.GetArrayLength() > 1)
                                    {
                                        result.ColorHex = colorArr[1].GetString();
                                    }
                                    break;
                                }
                            }
                        }

                        if (matchedColorIdx == -1 && !string.IsNullOrEmpty(item.SKU))
                        {
                            var parts = item.SKU.Split('-');
                            if (parts.Length >= 4 && int.TryParse(parts[parts.Length - 2], out int cNum) && cNum > 0 && cNum <= colorCount)
                            {
                                matchedColorIdx = cNum - 1;
                                var colorArr = colorsElem[matchedColorIdx];
                                if (colorArr.GetArrayLength() > 1)
                                {
                                    result.ColorHex = colorArr[1].GetString();
                                }
                            }
                        }

                        if (matchedColorIdx >= 0 && matchedColorIdx < photosElem.GetArrayLength())
                        {
                            var photoObj = photosElem[matchedColorIdx];
                            if (photoObj.TryGetProperty("front", out var f) && f.GetString() is string fStr && !string.IsNullOrEmpty(fStr))
                            {
                                result.FrontImage = fStr;
                                result.MainImage = fStr;
                            }
                            if (photoObj.TryGetProperty("back", out var b) && b.GetString() is string bStr && !string.IsNullOrEmpty(bStr))
                            {
                                result.BackImage = bStr;
                            }
                            if (photoObj.TryGetProperty("side", out var s) && s.GetString() is string sStr && !string.IsNullOrEmpty(sStr))
                            {
                                result.SideImage = sStr;
                            }
                        }
                    }
                }
                catch { }
            }
        }

        return result;
    }
}

<div class="hnmt-order-details-page">
    <div class="hnmt-details-shell">
        
        <!-- TOP NAV: NÚT QUAY LẠI DUY NHẤT (LƯỢC BỎ BREADCRUMB VỤN VẶT) -->
        <nav class="hnmt-dossier-nav" aria-label="Điều hướng">
            <a asp-action="Index" class="hnmt-back-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Quay lại đơn hàng</span>
            </a>
        </nav>

        <!-- HEADER HỒ SƠ ĐƠN HÀNG (EDITORIAL LUXURY HEADER - UNBOXED) -->
        <header class="hnmt-dossier-header">
            <div class="hnmt-header-main">

                <div class="hnmt-title-action-row">
                    <h1 class="hnmt-order-heading">
                        Đơn hàng <span class="hnmt-code-display">#@Model.OrderCode</span>
                    </h1>
                    <button type="button" class="hnmt-copy-pill" onclick="copyOrderCode('@Model.OrderCode')" title="Sao chép mã đơn hàng">
                        <svg class="hnmt-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span id="copyBtnLabel">Sao chép</span>
                    </button>
                </div>

                <div class="hnmt-order-meta-bar">
                    <span class="hnmt-meta-unit">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>Khởi tạo: <strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                    </span>
                    <span class="hnmt-meta-dot">•</span>
                    <span class="hnmt-meta-unit">
                        <span>Tổng: <strong>@Model.Items.Sum(i => i.Quantity) món</strong></span>
                    </span>
                    <span class="hnmt-meta-dot">•</span>
                    <span class="hnmt-meta-unit">
                        <span>Phương thức: <strong>@(Model.PaymentMethod == PaymentMethod.VietQR ? "VietQR 24/7" : "COD")</strong></span>
                    </span>
                </div>
            </div>

            <div class="hnmt-header-status-col">
                <div class="hnmt-status-badge @statusTheme">
                    <span class="hnmt-status-dot"></span>
                    <span class="hnmt-status-name">@statusText</span>
                </div>
            </div>
        </header>

        <!-- FLASH NOTIFICATIONS -->
        @if (TempData["Success"] != null)
        {
            <div class="hnmt-alert-card is-success">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="9 12 12 15 16 10"></polyline>
                </svg>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="hnmt-alert-card is-error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- 2-COLUMN STRUCTURED DOSSIER GRID (BỐ CỤC 2 CỘT CHUẨN QUỐC TẾ KHOA HỌC) -->
        <div class="hnmt-dossier-grid">

            <!-- CỘT CHÍNH (BÊN TRÁI): KIỆN HÀNG SẢN PHẨM & TIẾN TRÌNH VẬN ĐƠN -->
            <main class="hnmt-content-primary">
                
                <!-- CARD 1: SẢN PHẨM ĐÃ ĐẶT (TINH GỌN, TRỰC QUAN, AI NHÌN CŨNG HIỂU) -->
                <section class="hnmt-card hnmt-items-section" aria-label="Sản phẩm đã đặt">
                    <div class="hnmt-card-top">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">Sản phẩm đã đặt (@Model.Items.Count)</h2>
                        </div>
                    </div>

                    <div class="hnmt-simple-items-list">
                        @foreach (var item in Model.Items)
                        {
                            var photoData = ResolveItemPhotos(item, DbContext);

                            <article class="hnmt-simple-item-row">
                                <div class="hnmt-simple-photo">
                                    <img src="@photoData.MainImage"
                                         alt="@item.ProductName"
                                         onerror="this.onerror=null;this.src='/clothing-rail/assets/reach-shirt-front.webp';" />
                                </div>

                                <div class="hnmt-simple-info">
                                    <div class="hnmt-simple-name-row">
                                        @if (photoData.ProductId > 0)
                                        {
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@photoData.ProductId" class="hnmt-simple-name">
                                                @item.ProductName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="hnmt-simple-name">@item.ProductName</span>
                                        }
                                        <div class="hnmt-simple-pricing">
                                            <span class="hnmt-simple-price font-mono">@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</span>
                                            @if (item.Quantity > 1)
                                            {
                                                <small class="hnmt-simple-math">@item.UnitPrice.ToString("N0") ₫ × @item.Quantity</small>
                                            }
                                        </div>
                                    </div>

                                    <div class="hnmt-simple-variant">
                                        @if (!string.IsNullOrEmpty(item.Size))
                                        {
                                            <span>Size: <strong>@item.Size</strong></span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Color))
                                        {
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="hnmt-dot-sep">·</span>
                                            }
                                            <span class="d-inline-flex align-items-center gap-1">
                                                @if (!string.IsNullOrEmpty(photoData.ColorHex))
                                                {
                                                    <span class="hnmt-color-swatch" style="background-color: @photoData.ColorHex;"></span>
                                                }
                                                Màu: <strong>@item.Color</strong>
                                            </span>
                                        }
                                        <span class="hnmt-dot-sep">·</span>
                                        <span>Số lượng: <strong>@item.Quantity</strong></span>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
                <!-- CARD 2: TIẾN TRÌNH ĐƠN HÀNG (4 BƯỚC ĐƠN GIẢN, AI NHÌN CŨNG HIỂU) -->
                <section class="hnmt-card hnmt-stepper-section" aria-label="Tiến trình đơn hàng">
                    <div class="hnmt-card-top">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">Trạng thái đơn hàng</h2>
                        </div>
                    </div>

                    @if (!isExceptionalStatus)
                    {
                        <!-- THÔNG BÁO TRẠNG THÁI & DỰ KIẾN GIAO GỌN GÀNG -->
                        <div class="hnmt-simple-status-banner">
                            <div class="hnmt-status-notice">
                                <span class="hnmt-status-dot-indicator @statusTheme"></span>
                                <span class="hnmt-status-lead">
                                    @(Model.Status switch {
                                        OrderStatus.PendingConfirmation => "Đơn hàng đã đặt thành công, đang chờ cửa hàng xác nhận",
                                        OrderStatus.Confirmed => "Cửa hàng đã xác nhận đơn hàng, đang chuẩn bị kiện hàng",
                                        OrderStatus.Processing => "Kho hàng đang đóng gói kiện sản phẩm",
                                        OrderStatus.Shipping => "Đơn hàng đang trên đường giao đến bạn",
                                        OrderStatus.Delivered => "Đơn hàng đã được giao thành công",
                                        _ => statusText
                                    })
                                </span>
                            </div>
                            <div class="hnmt-simple-eta">
                                Dự kiến nhận: <strong>@Model.CreatedAt.ToLocalTime().AddDays(2).ToString("dd/MM") - @Model.CreatedAt.ToLocalTime().AddDays(4).ToString("dd/MM/yyyy")</strong>
                            </div>
                        </div>

                            int trackStep = Model.Status switch
                            {
                                OrderStatus.PendingConfirmation => 1,
                                OrderStatus.Confirmed => 2,
                                OrderStatus.Processing => 2,
                                OrderStatus.Shipping => 3,
                                OrderStatus.Delivered => 4,
                                _ => 1
                            };
                            var simpleSteps = new[]
                            {
                                new { Id = 1, Label = "Đặt hàng" },
                                new { Id = 2, Label = "Đã xác nhận" },
                                new { Id = 3, Label = "Đang giao" },
                                new { Id = 4, Label = "Đã nhận" }
                            };

                        <!-- THANH TIẾN TRÌNH 4 BƯỚC TRỰC QUAN -->
                        <div class="hnmt-simple-stepper">
                            @for (int i = 0; i < simpleSteps.Length; i++)
                            {
                                var s = simpleSteps[i];
                                bool isDone = trackStep > s.Id;
                                bool isActive = trackStep == s.Id;
                                string stateClass = isDone ? "is-done" : (isActive ? "is-active" : "is-pending");

                                <div class="hnmt-step-node @stateClass">
                                    <div class="hnmt-step-circle">
                                        @if (isDone)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                        else if (isActive)
                                        {
                                            <span class="hnmt-step-dot-core"></span>
                                        }
                                    </div>
                                    <span class="hnmt-step-label">@s.Label</span>
                                </div>

                                @if (i < simpleSteps.Length - 1)
                                {
                                    <div class="hnmt-step-bar @(trackStep > s.Id ? "is-filled" : "")"></div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="hnmt-exceptional-alert @(isCancelled ? "is-cancelled" : "is-failed")">
                            <div class="hnmt-ex-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                            </div>
                            <div class="hnmt-ex-text">
                                <strong>@(isCancelled ? "Đơn hàng này đã được hủy" : "Giao hàng không thành công")</strong>
                                <p>@(isCancelled ? "Đơn hàng đã hủy hoàn tất và hoàn lại tồn kho." : "Vui lòng liên hệ bộ phận hỗ trợ khách hàng nếu cần trợ giúp.")</p>
                            </div>
                        </div>
                    }

                    @if (histories.Any())
                    {
                        <div class="hnmt-simple-history">
                            <div class="hnmt-history-title">Lịch sử cập nhật</div>
                            <div class="hnmt-history-list">
                                @foreach (var hist in histories)
                                {
                                    <div class="hnmt-history-row">
                                        <span class="hnmt-history-time font-mono">@hist.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                        <span class="hnmt-history-desc">
                                            <strong>@GetStatusName(hist.NewStatus)</strong>
                                            @if (!string.IsNullOrWhiteSpace(hist.Note))
                                            {
                                                <span class="hnmt-history-note">— @GetHistoryNote(hist)</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>

            

            </main>
            <!-- CỘT PHỤ (BÊN PHẢI): BỐ CỤC CHUẨN, THOÁNG ĐÃNG, CHUYÊN NGHIỆP -->
            <aside class="hnmt-sidebar-sticky">
                
                <!-- CARD 1: TỔNG KẾT THANH TOÁN -->
                <div class="hnmt-card hnmt-invoice-panel">
                    <div class="hnmt-card-top border-none pb-0">
                        <div class="hnmt-card-heading-group">
                            <h2 class="hnmt-card-title">Tổng kết thanh toán</h2>
                        </div>
                    </div>

                    <!-- DÒNG TÍNH TIỀN GỌN GÀNG -->
                    <div class="hnmt-simple-ledger">
                        <div class="hnmt-ledger-row">
                            <span class="hnmt-ledger-lbl">Tạm tính tiền hàng</span>
                            <span class="hnmt-ledger-price font-mono">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>

                        <div class="hnmt-ledger-row">
                            <span class="hnmt-ledger-lbl">Phí vận chuyển</span>
                            <span class="hnmt-ledger-price font-mono">
                                @(Model.ShippingFee > 0 ? Model.ShippingFee.ToString("N0") + " ₫" : "Miễn phí")
                            </span>
                        </div>

                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="hnmt-ledger-row is-discount">
                                <span class="hnmt-ledger-lbl">Giảm giá</span>
                                <span class="hnmt-ledger-price font-mono">-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }

                        <div class="hnmt-ledger-sep"></div>

                        <div class="hnmt-ledger-total-row">
                            <div class="hnmt-total-meta">
                                <span class="hnmt-total-lbl">Tổng thanh toán</span>
                                <small class="hnmt-total-sublbl">Đã bao gồm VAT</small>
                            </div>
                            <strong class="hnmt-total-number font-mono">@Model.TotalAmount.ToString("N0") ₫</strong>
                        </div>
                    </div>

                    <!-- THÔNG TIN PHƯƠNG THỨC & TÌNH TRẠNG THANH TOÁN -->
                    <div class="hnmt-simple-pay-meta">
                        <div class="hnmt-pay-meta-row">
                            <span class="hnmt-pay-lbl">Hình thức:</span>
                            <strong class="hnmt-pay-val">@paymentMethodText</strong>
                        </div>
                        <div class="hnmt-pay-meta-row">
                            <span class="hnmt-pay-lbl">Tình trạng:</span>
                            @if (Model.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="hnmt-pay-badge is-paid">
                                    <span class="hnmt-dot"></span>
                                    <span>Đã thanh toán</span>
                                </span>
                            }
                            else
                            {
                                <span class="hnmt-pay-badge is-pending">
                                    <span class="hnmt-dot"></span>
                                    <span>Chờ thanh toán</span>
                                </span>
                            }
                        </div>
                    </div>

                    <!-- VIETQR NẾU CHƯA THANH TOÁN -->
                    @if (Model.PaymentMethod == PaymentMethod.VietQR && Model.PaymentStatus == PaymentStatus.Pending && !isExceptionalStatus)
                    {
                        <div class="hnmt-vietqr-box">
                            <div class="hnmt-vqr-content">
                                <strong>Chuyển khoản VietQR 24/7</strong>
                                <p>Quét mã VietQR bằng app ngân hàng để thanh toán tự động không cần nhập số tài khoản.</p>
                            </div>
                            <a asp-action="PaymentQR" asp-route-id="@Model.Id" class="hnmt-vqr-action-btn">
                                <span>@(Model.TransferReportedAt.HasValue ? "Xem lại mã QR đã thanh toán" : "Mở mã QR thanh toán ngay")</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </a>
