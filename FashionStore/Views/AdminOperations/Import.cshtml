@model FashionStore.Controllers.ImportPreview
@{ ViewData["Title"] = "Nhập sản phẩm"; }
<header class="adm-dashboard-header mb-4"><h1>Nhập sản phẩm</h1><a asp-action="ImportTemplate" class="adm-btn-outline">Tải tệp mẫu</a></header>
<form asp-action="Import" method="post" enctype="multipart/form-data" class="adm-filter-bar d-flex flex-wrap gap-2 align-items-center mb-3">
    <input name="file" type="file" accept=".xlsx" required aria-label="Tệp sản phẩm Excel" class="form-control adm-input-dark w-auto" />
    <button name="apply" value="false" class="adm-btn-outline">Kiểm tra trước</button>
    <button name="apply" value="true" class="adm-btn-atelier">Nhập sản phẩm</button>
</form>
<p class="text-muted">Tối đa 500 dòng và 2 MB. Các dòng có cùng slug được nhập thành biến thể của một sản phẩm. Sản phẩm mới ở trạng thái ẩn.</p>
@if (Model.Applied) { <p class="alert alert-success" role="status">Đã nhập @Model.Rows.Count biến thể.</p> }
@if (Model.Errors.Count > 0)
{
    <ul class="alert alert-danger" role="alert">
    @foreach (var error in Model.Errors) { <li class="ms-3">@error</li> }
    </ul>
}
else if (!Model.Applied && Model.Rows.Count > 0)
{
    <p class="alert alert-success" role="status">@Model.Rows.Count dòng hợp lệ. Chọn lại tệp để nhập.</p>
}
@if (Model.Rows.Count > 0)
{
    <div class="adm-card table-responsive p-0"><table class="adm-table mb-0">
    <thead><tr><th>Dòng</th><th>Sản phẩm</th><th>SKU</th><th>Size</th><th>Màu</th><th>Giá (₫)</th><th>Tồn</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr><td>@row.Line</td><td>@row.Name</td><td>@row.Sku</td><td>@row.Size</td><td>@row.Color</td><td>@row.Price.ToString("N0")</td><td>@row.Stock</td></tr>
    }
    </tbody></table></div>
}
