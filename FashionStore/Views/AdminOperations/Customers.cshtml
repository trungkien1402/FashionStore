@model List<FashionStore.Controllers.CustomerSummary>
@using FashionStore.Services.Implementations
@{ ViewData["Title"] = "Khách hàng"; var current = (int)ViewBag.Page; }
<header class="adm-dashboard-header mb-4"><div><h1>Khách hàng</h1><p class="adm-dashboard-period">@ViewBag.Count kết quả</p></div></header>
<form asp-action="Customers" method="get" class="adm-filter-bar d-flex gap-2 mb-4">
    <input name="search" maxlength="100" value="@ViewBag.Search" aria-label="Tìm theo tên hoặc email" placeholder="Tên hoặc email" class="form-control adm-input-dark" />
    <button class="adm-btn-atelier">Tìm</button>
</form>
<div class="adm-card table-responsive p-0 mb-3">
<table class="adm-table mb-0">
<thead><tr><th>Khách hàng</th><th>Email</th><th>Số đơn</th><th>Đã thanh toán</th><th>Đặt gần nhất</th></tr></thead>
<tbody>
@foreach (var row in Model)
{
    <tr><td><a asp-action="Customer" asp-route-id="@row.Id">@row.Name</a></td><td>@row.Email</td><td>@row.Orders</td><td>@row.PaidAmount.ToString("N0") ₫</td><td>@(row.LastOrder is { } date ? AdminReportService.ToVietnamTime(date).ToString("dd/MM/yyyy") : "—")</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5">Không có khách hàng khớp bộ lọc.</td></tr> }
</tbody>
</table>
</div>
<nav class="d-flex align-items-center justify-content-center gap-3" aria-label="Phân trang khách hàng">
@if (current > 1) { <a asp-route-page="@(current - 1)" asp-route-search="@ViewBag.Search" class="adm-btn-outline">Trang trước</a> }
<span>Trang @current / @ViewBag.PageCount</span>
@if (current < ViewBag.PageCount) { <a asp-route-page="@(current + 1)" asp-route-search="@ViewBag.Search" class="adm-btn-outline">Trang sau</a> }
</nav>
