@{ ViewData["Title"] = "Thông báo vận hành"; }
<header class="adm-dashboard-header mb-4"><h1>Thông báo vận hành</h1><a asp-action="Alerts" class="adm-btn-outline">Làm mới</a></header>
<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col"><a asp-controller="AdminOrders" asp-action="Index" asp-route-status="PendingConfirmation" class="adm-card p-3 d-block">Đơn chờ xác nhận <strong>@ViewBag.NewOrders</strong></a></div>
    <div class="col"><a asp-action="Inventory" asp-route-low="true" class="adm-card p-3 d-block">Biến thể tồn thấp <strong>@ViewBag.LowStock</strong></a></div>
    <div class="col"><a asp-controller="AdminShipments" asp-action="Index" asp-route-status="Failed" class="adm-card p-3 d-block">Vận đơn giao thất bại <strong>@ViewBag.FailedShipments</strong></a></div>
    <div class="col"><a asp-action="Returns" class="adm-card p-3 d-block">Yêu cầu đổi trả chờ duyệt <strong>@ViewBag.PendingReturns</strong></a></div>
</div>
