@model List<FashionStore.Models.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Quản trị Nhân viên & Vận hành";
    var roles = (ILookup<string, string?>)ViewBag.Roles;
    var adminCount = Model.Count(u => roles[u.Id].Contains("Admin"));
    var shipperCount = Model.Count(u => roles[u.Id].Contains("Shipper"));
    var staffCount = Model.Count(u => roles[u.Id].Contains("Staff") || roles[u.Id].Contains("Manager"));
}

<!-- EXECUTIVE HEADER -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · QUẢN TRỊ</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@Model.Count NHÂN SỰ VẬN HÀNH</span>
            </div>
            <h1 class="adm-title-main">Đội ngũ Nhân viên & Phân quyền</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="AdminUsers" asp-action="Index" class="adm-btn-table-action text-decoration-none" style="height: 34px; padding: 0 14px; font-size: 0.8rem; font-weight: 500;" title="Quản lý toàn bộ danh sách tài khoản">
                <i class="bi bi-people me-1"></i> Tất cả tài khoản
            </a>
            <a asp-action="Staff" class="adm-btn-table-action text-decoration-none" style="height: 34px; padding: 0 14px; font-size: 0.8rem; font-weight: 500;" title="Làm mới danh sách">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </a>
        </div>
    </div>
</div>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- TOP METRIC CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="adm-card p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Tổng nhân sự</div>
                    <div class="fs-3 fw-bold font-monospace adm-heading mt-1">@Model.Count</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(15, 23, 42, 0.06); color: #0F172A; font-size: 1.3rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="adm-card p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Quản trị viên (Admin)</div>
                    <div class="fs-3 fw-bold font-monospace mt-1" style="color: #D97706;">@adminCount</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(217, 119, 6, 0.1); color: #D97706; font-size: 1.3rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="adm-card p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase">Đội ngũ Shipper</div>
                    <div class="fs-3 fw-bold font-monospace mt-1" style="color: #2563EB;">@shipperCount</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(37, 99, 235, 0.1); color: #2563EB; font-size: 1.3rem;">
                    <i class="bi bi-truck"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- STAFF TABLE -->
<div class="adm-card p-0 overflow-hidden mb-4 shadow-sm">
    <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-person-badge fs-5" style="color: var(--adm-gold, #D97706);"></i>
            <h5 class="fw-bold mb-0 adm-heading fs-6">Danh sách Nhân viên Vận hành Showroom</h5>
        </div>
        <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1);">Active Personnel</span>
    </div>

    <div class="table-responsive">
        <table class="adm-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">NHÂN SỰ</th>
                    <th>EMAIL &amp; SĐT</th>
                    <th>VAI TRÒ HIỆN TẠI</th>
                    <th class="text-end pe-4" style="min-width: 320px;">ĐIỀU CHỈNH VAI TRÒ &amp; THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var initial = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "S";
                    var isAdmin = roles[user.Id].Contains("Admin");
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 38px; height: 38px; background: #0F172A; color: #F8FAFC; font-size: 0.9rem;">
                                    @initial
                                </div>
                                <div>
                                    <div class="fw-bold adm-heading">@user.FullName</div>
                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">ID: @user.Id[..Math.Min(user.Id.Length, 8)]...</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small adm-heading">@user.Email</div>
                            <div class="text-muted font-monospace small" style="font-size: 0.75rem;">@(string.IsNullOrEmpty(user.PhoneNumber) ? "Chưa có SĐT" : user.PhoneNumber)</div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var r in roles[user.Id])
                                {
                                    @switch (r)
                                    {
                                        case "Admin":
                                            <span class="adm-pill adm-pill-amber fw-bold"><i class="bi bi-award-fill me-1"></i>Quản trị viên</span>
                                            break;
                                        case "Manager":
                                            <span class="adm-pill adm-pill-blue">Quản lý</span>
                                            break;
                                        case "Staff":
                                            <span class="adm-pill adm-pill-emerald">Nhân viên</span>
                                            break;
                                        case "Shipper":
                                            <span class="adm-pill adm-pill-faint"><i class="bi bi-truck me-1"></i>Giao hàng</span>
                                            break;
                                        default:
                                            <span class="adm-pill adm-pill-faint">@r</span>
                                            break;
                                    }
                                }
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2 justify-content-end align-items-center">
                                @if (!isAdmin)
                                {
                                    <form asp-action="SetStaffRole" asp-route-id="@user.Id" method="post" class="d-inline-flex gap-2 align-items-center m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <select name="role" aria-label="Vai trò mới" class="form-select"
                                                style="height: 30px !important; min-height: 30px !important; width: auto; min-width: 110px; font-size: 0.76rem !important; padding: 0 24px 0 8px !important; border-radius: 6px !important; background-color: var(--adm-surface, #FFFFFF) !important; color: var(--adm-ink, #0F172A) !important; border: 1px solid var(--adm-border, #CBD5E1) !important; line-height: 28px !important;">
                                            @foreach (var role in new[] { "Manager", "Staff", "Shipper" })
                                            {
                                                <option value="@role" selected="@roles[user.Id].Contains(role)">@role</option>
                                            }
                                        </select>
                                        <button type="submit" class="adm-btn-table-action"
                                                style="height: 30px !important; padding: 0 10px !important; font-size: 0.76rem !important;"
                                                title="Lưu vai trò mới">
                                            <i class="bi bi-check2 me-1"></i> Lưu
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill-amber fw-bold" style="font-size: 0.76rem;">
                                        <i class="bi bi-lock-fill me-1"></i>Cấp Admin Tối Cao
                                    </span>
                                }

                                <a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@user.Id"
                                   class="adm-btn-table-action text-decoration-none"
                                   style="height: 30px !important; width: 30px !important; padding: 0 !important; justify-content: center !important;"
                                   title="Xem hồ sơ chi tiết &amp; lịch sử">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
