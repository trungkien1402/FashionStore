@model List<FashionStore.Models.Entities.ProductVariant>
@{ ViewData["Title"] = "Kho hàng"; }
<header class="adm-dashboard-header mb-4"><h1>Kho hàng</h1></header>
<form asp-action="Inventory" method="get" class="adm-filter-bar d-flex flex-wrap align-items-center gap-3 mb-4">
    <input name="search" value="@ViewBag.Search" maxlength="100" aria-label="Tìm SKU hoặc sản phẩm" placeholder="SKU hoặc tên sản phẩm" class="form-control adm-input-dark w-auto" />
    <label class="d-flex align-items-center gap-2 fw-semibold text-danger cursor-pointer">
        <input type="checkbox" name="low" value="true" checked="@(ViewBag.Low == true)" class="form-check-input mt-0" /> 
        <span>&#9888; Các sản phẩm sắp hết hàng (Mức tồn an toàn &le; 5)</span>
    </label>
    <button class="adm-btn-atelier">Lọc</button>
</form>
<div class="adm-card table-responsive p-0">
<table class="adm-table mb-0">
    <thead><tr><th>Sản phẩm</th><th>SKU</th><th>Size</th><th>Màu</th><th>Tồn kho &amp; Cảnh báo</th><th></th></tr></thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr>
            <td><strong>@row.Product.Name</strong></td>
            <td><code>@row.SKU</code></td>
            <td>@row.Size</td>
            <td>@row.Color</td>
            <td>
                @if (row.StockQuantity <= 5)
                {
                    <span class="badge bg-danger text-white py-1 px-2 fw-bold shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>[&#9888; Cần nhập thêm hàng] (Còn @row.StockQuantity)
                    </span>
                }
                else
                {
                    <span class="fw-bold font-monospace">@row.StockQuantity</span>
                }
            </td>
            <td><a asp-action="Stock" asp-route-id="@row.Id" class="adm-btn-outline py-1 px-2" style="font-size: 0.75rem;">Xem &amp; điều chỉnh</a></td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center py-4 text-muted">Không có biến thể khớp bộ lọc.</td></tr> }
    </tbody>
</table>
</div>
<p class="text-muted small mt-2">Hiển thị tối đa 100 biến thể, ưu tiên tồn kho thấp.</p>
