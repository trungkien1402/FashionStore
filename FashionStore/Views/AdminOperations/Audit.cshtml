@model List<FashionStore.Models.Entities.AdminAuditEvent>
@using FashionStore.Services.Implementations
@{ ViewData["Title"] = "Nhật ký quản trị"; }
<header class="adm-dashboard-header mb-4"><h1>Nhật ký quản trị</h1></header>
<div class="adm-card table-responsive p-0">
<table class="adm-table mb-0">
<thead><tr><th>Thời điểm</th><th>Thao tác</th><th>Đối tượng</th><th>Mã người thao tác</th><th>Chi tiết</th></tr></thead>
<tbody>
@foreach (var row in Model)
{
    <tr><td>@AdminReportService.ToVietnamTime(row.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@row.Action</td><td>@row.Target</td><td>@row.ActorId</td><td>@row.Detail</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5">Chưa có thao tác được ghi nhận.</td></tr> }
</tbody>
</table>
</div>
