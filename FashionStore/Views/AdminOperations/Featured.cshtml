@model List<FashionStore.Models.Entities.FeaturedProduct>
@{ ViewData["Title"] = "Sản phẩm nổi bật"; }
<header class="adm-dashboard-header mb-4"><h1>Sản phẩm nổi bật</h1></header>
<form asp-action="SetFeatured" method="post" class="adm-filter-bar row g-3 mx-0 mb-4">
    <div class="col-md-4"><label for="productId">ID sản phẩm</label><input id="productId" name="productId" type="number" min="1" required class="form-control adm-input-dark" /></div>
    <div class="col-md-4"><label for="position">Thứ tự trong Admin</label><input id="position" name="position" type="number" min="1" max="100" required class="form-control adm-input-dark" /></div>
    <div class="col-md-auto align-self-end"><button class="adm-btn-atelier">Lưu</button></div>
</form>
<div class="adm-card table-responsive p-0"><table class="adm-table mb-0">
<thead><tr><th>Thứ tự</th><th>Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead>
<tbody>
@foreach (var row in Model)
{
    <tr><td>@row.Position</td><td><a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@row.ProductId">@row.Product.Name</a></td><td>@(row.Product.IsActive ? "Hiển thị" : "Đang ẩn")</td><td>
        <form asp-action="SetFeatured" method="post">
            <input type="hidden" name="productId" value="@row.ProductId" /><input type="hidden" name="position" value="@row.Position" />
            <button name="remove" value="true" class="adm-btn-outline">Gỡ</button>
        </form>
    </td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="4">Chưa có sản phẩm nổi bật trong Admin.</td></tr> }
</tbody>
</table></div>
