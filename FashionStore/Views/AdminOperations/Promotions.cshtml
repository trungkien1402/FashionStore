@model FashionStore.Controllers.VoucherPage
@using FashionStore.Services.Implementations
@{
    ViewData["Title"] = "Khuyến mãi";
    var categoryNames = Model.Categories.ToDictionary(c => c.Id, c => c.Label);
    var productNames = Model.Products.ToDictionary(p => p.Id, p => p.Label);
}
<header class="adm-dashboard-header mb-4"><div><h1>Khuyến mãi</h1><p class="adm-dashboard-period">Gắn mã giảm theo phần trăm với mốc 60, 75 hoặc 90 điểm trong Studio thiết kế.</p></div></header>
<form asp-action="CreateVoucher" method="post" class="adm-filter-bar row g-3 mx-0 mb-4">
    <div class="col-6 col-lg-3"><label for="code">Mã giảm giá</label><input id="code" name="code" type="text" maxlength="40" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="start">Từ ngày</label><input id="start" name="start" type="date" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="end">Đến hết ngày</label><input id="end" name="end" type="date" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="value">Mức giảm</label><input id="value" name="value" type="number" min="1" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="minimum">Tối thiểu (₫)</label><input id="minimum" name="minimum" type="number" min="0" value="0" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="maximum">Giảm tối đa (₫)</label><input id="maximum" name="maximum" type="number" min="1" class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="totalLimit">Tổng lượt</label><input id="totalLimit" name="totalLimit" type="number" min="1" required class="form-control adm-input-dark" /></div>
    <div class="col-6 col-lg-3"><label for="customerLimit">Lượt mỗi khách</label><input id="customerLimit" name="customerLimit" type="number" min="1" value="1" required class="form-control adm-input-dark" /></div>
    <div class="col-12 col-lg-3">
        <label for="voucherScope">Phạm vi áp dụng</label>
        <select id="voucherScope" name="scope" class="form-select adm-input-dark">
            <option value="all">Toàn bộ cửa hàng</option>
            <option value="category">Một danh mục</option>
            <option value="product">Một sản phẩm</option>
        </select>
    </div>
    <div class="col-12 col-lg-5" id="voucherCategoryFields" hidden>
        <label for="categoryId">Danh mục</label>
        <select id="categoryId" name="categoryId" class="form-select adm-input-dark" disabled>
            <option value="">Chọn danh mục</option>
            @foreach (var category in Model.Categories.Where(c => c.Active))
            {
                <option value="@category.Id">@category.Label</option>
            }
        </select>
    </div>
    <div class="col-12 col-lg-5" id="voucherProductFields" hidden>
        <label for="voucherProductSearch">Tìm sản phẩm</label>
        <input id="voucherProductSearch" type="search" maxlength="100" class="form-control adm-input-dark mb-2"
               placeholder="Nhập tên hoặc slug" />
        <label for="productId">Sản phẩm</label>
        <select id="productId" name="productId" class="form-select adm-input-dark" disabled>
            <option value="">Chọn sản phẩm</option>
            @foreach (var product in Model.Products.Where(p => p.Active))
            {
                <option value="@product.Id">@product.Label</option>
            }
        </select>
        <p id="voucherProductEmpty" class="small text-muted mt-1 mb-0" role="status" hidden>Không có sản phẩm khớp.</p>
    </div>
    <div class="col-md-auto align-self-end"><label><input name="percentage" type="checkbox" value="true" /> Mức giảm theo phần trăm</label></div>
    <div class="col-md-auto align-self-end"><button class="adm-btn-atelier">Tạo mã</button></div>
</form>
<div class="adm-card table-responsive p-0">
<table class="adm-table mb-0">
<thead><tr><th>Mã</th><th>Thời hạn</th><th>Mức giảm</th><th>Phạm vi</th><th>Giới hạn</th><th>Trạng thái</th><th>Phần thưởng thiết kế đồ</th><th></th></tr></thead>
<tbody>
@foreach (var row in Model.Vouchers)
{
    <tr><td>@row.Code</td><td>@AdminReportService.ToVietnamTime(row.StartsAt).ToString("dd/MM/yyyy") – @AdminReportService.ToVietnamTime(row.EndsAt).AddDays(-1).ToString("dd/MM/yyyy")</td>
        <td>@row.Value.ToString("N0") @(row.IsPercentage ? "%" : "₫")</td><td>
            @if (row.ProductId is int productId)
            {
                <span>@productNames.GetValueOrDefault(productId, "Sản phẩm đã bị gỡ")</span>
            }
            @if (row.CategoryId is int categoryId)
            {
                <div>@categoryNames.GetValueOrDefault(categoryId, "Danh mục đã bị gỡ")</div>
            }
            @if (row.ProductId == null && row.CategoryId == null)
            {
                <span>Toàn bộ cửa hàng</span>
            }
        </td><td>@row.TotalLimit lượt · @row.CustomerLimit mỗi khách</td><td>@(row.IsActive ? "Đang bật" : "Đang tắt")</td>
        <td>
            @if (row.IsPercentage)
            {
                <form asp-action="SetGameReward" asp-route-id="@row.Id" method="post" class="d-flex gap-2">
                    <select name="score" class="form-select adm-input-dark" aria-label="Mốc điểm cho mã @row.Code">
                        <option value="">Mã thông thường</option>
                        @foreach (var score in new[] { 60, 75, 90 })
                        {
                            <option value="@score" selected="@(row.GameMinimumScore == score)">Từ @score điểm</option>
                        }
                    </select>
                    <button class="adm-btn-outline">Lưu</button>
                </form>
            }
        </td>
        <td><form asp-action="SetVoucherActive" asp-route-id="@row.Id" method="post">
            <input type="hidden" name="active" value="@(!row.IsActive)" /><button class="adm-btn-outline">@(row.IsActive ? "Tắt" : "Bật")</button>
        </form></td></tr>
}
@if (Model.Vouchers.Count == 0) { <tr><td colspan="8">Chưa có mã giảm giá.</td></tr> }
</tbody>
</table>
</div>

@section Scripts {
    <script src="~/js/admin-voucher-scope.js" asp-append-version="true"></script>
}
