@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · HNMTSHOP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/payment.css" asp-append-version="true" />
</head>
<body class="hnmt-pay-shell">
    <a class="pay-skip" href="#main">Đến nội dung chính</a>

    @if (Configuration.GetValue<bool>("DesignPreview"))
    {
        <div class="pay-preview">BẢN XEM TRƯỚC · Dữ liệu thử nghiệm · Không chuyển tiền</div>
    }

    <!-- NAVBAR THANH TOÁN HIỆN ĐẠI CHUẨN HNMTSHOP -->
    <header class="hnmt-pay-header">
        <div class="hnmt-pay-header-inner">
            <a class="hnmt-pay-brand" asp-controller="Home" asp-action="Index" aria-label="HNMTSHOP — Trang chủ">
                HNMTSHOP
            </a>

            <div class="hnmt-pay-security-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Thanh toán an toàn 100%</span>
            </div>

            <a class="hnmt-pay-back" href="/?openCart=true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Quay lại giỏ hàng</span>
            </a>
        </div>
    </header>

    <main id="main" class="hnmt-pay-main">
        @RenderBody()
    </main>

    <footer class="hnmt-pay-footer">
        <div class="hnmt-pay-footer-inner">
            <span>© @DateTime.Now.Year HNMTSHOP. Tất cả quyền được bảo lưu.</span>
            <span>Hỗ trợ khách hàng: <strong>1900 8888</strong> (8h - 22h)</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
