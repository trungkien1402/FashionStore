@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · FashionStore</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/payment.css" asp-append-version="true" />
</head>
<body class="pay-shell">
    <a class="pay-skip" href="#main">Đến nội dung chính</a>
    @if (Configuration.GetValue<bool>("DesignPreview"))
    {
        <div class="pay-preview">BẢN XEM TRƯỚC · Dữ liệu thử riêng · Không chuyển tiền</div>
    }
    <header class="pay-header">
        <a class="pay-brand" asp-controller="Home" asp-action="Index" aria-label="FashionStore — Trang chủ">FASHIONSTORE<span>.</span></a>
        <span class="pay-header-label"><span aria-hidden="true">◇</span> MỘT CHÚT PHONG CÁCH, DÀNH RIÊNG CHO BẠN</span>
        <a class="pay-back" asp-controller="Orders" asp-action="Index"><span aria-hidden="true">←</span> Đơn hàng của tôi</a>
    </header>
    <main id="main" class="pay-main">@RenderBody()</main>
    <footer class="pay-footer"><span>© @DateTime.Now.Year FASHIONSTORE</span><span>Phong cách của bạn. Câu chuyện của bạn.</span></footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>