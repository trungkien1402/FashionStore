@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using FashionStore.Models.ViewModels

@{
    int cartCount = 0;
    var cartJson = Context.Session.GetString("FashionStore_Cart");
    if (!string.IsNullOrEmpty(cartJson))
    {
        try
        {
            var items = JsonSerializer.Deserialize<List<CartItemViewModel>>(cartJson);
            cartCount = items?.Sum(x => x.Quantity) ?? 0;
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fashionstore.css?v=signature_cats_v2" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/atelier.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/store3d.css?v=badge_perfect_v20" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clothing-rail.css?v=spotlight_v2" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sneaker-vault.css?v=uniform_font_v43" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

@{
    var isHome = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}

    <!-- ============================================================== -->
    <!-- NAVBAR (URBNMIND EXACT: LOGO, CENTER LINKS, ICONS, BUY NOW)    -->
    <!-- ============================================================== -->
    <header class="urbn-header @(isHome ? "urbn-header-hidden" : "")">
        <div class="urbn-container">
            <nav class="urbn-nav">

                <!-- Logo -->
                <a class="urbn-logo" asp-controller="Home" asp-action="Index">
                    HNMTSHOP
                </a>

                <!-- Nav Links -->
                <ul class="urbn-nav-links">
                    <li><a asp-controller="Home" asp-action="Index">TRANG CHỦ</a></li>
                    <li><a href="/Home/Index#categories">BẢNG GIÁ</a></li>
                    <li><a asp-controller="Products" asp-action="Index">CỬA HÀNG</a></li>
                    <li><a href="#contact">LIÊN HỆ</a></li>
                </ul>

                <!-- Nav Actions -->
                <div class="urbn-nav-actions">
                    <!-- Search Icon -->
                    <button type="button" class="urbn-nav-icon" title="Tìm kiếm nhanh (Phím tắt /)" onclick="if(window.HNMTSpotlightSearch) { window.HNMTSpotlightSearch.open(); } else { document.getElementById('keywordInput')?.focus(); }">
                        <i class="bi bi-search"></i>
                    </button>

                    <!-- Wishlist Heart Icon -->
                    <a href="/Products" class="urbn-nav-icon" title="Yêu thích">
                        <i class="bi bi-heart"></i>
                    </a>

                    <!-- Cart Trigger -->
                    <button type="button" id="fsCartDrawerTrigger" class="urbn-nav-icon position-relative" title="Giỏ hàng">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="20" height="20" style="display: block;">
                            <path d="M4 8h16l-1 13H5L4 8Z" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M9 9V6a3 3 0 0 1 6 0v3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="fs-cart-count" style="position: absolute; top: -6px; right: -8px; background: #000; color: #fff; font-size: 10px; font-weight: 700; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @cartCount
                        </span>
                    </button>

                    <!-- User Account Dropdown -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Orders" asp-action="Index" class="urbn-nav-icon" title="@User.Identity.Name">
                            <i class="bi bi-person"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="urbn-nav-icon" title="Tài khoản">
                            <i class="bi bi-person"></i>
                        </a>
                    }

                    <!-- Buy Now Pill Button -->
                    <a asp-controller="Products" asp-action="Index" class="urbn-nav-pill-btn">
                        Mua Ngay
                    </a>
                </div>

            </nav>
        </div>
    </header>

    <!-- 3D SHOWROOM PORTAL (CHILE 20 CAMPAIGN REPLICA) -->
    @await Html.PartialAsync("_ChilePortal")

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>



    <!-- ============================================================== -->
    <!-- FOOTER (EXACT VIDEO: BLACK 4-COLUMNS + NEWSLETTER JOIN NOW)   -->
    <!-- ============================================================== -->
    <footer class="urbn-footer-section" id="contact">
        <div class="urbn-container">
            <div class="urbn-footer-grid">

                <!-- Col 1: Brand & Newsletter -->
                <div>
                    <span class="urbn-footer-logo">HNMTSHOP</span>
                    <p class="urbn-footer-sub">Kết Nối Phong Cách. Dẫn Đầu Xu Hướng.</p>
                    <p class="urbn-footer-desc">
                        Gia nhập cộng đồng HNMTSHOP để không bao giờ bỏ lỡ các đợt phát hành mới, ưu đãi độc quyền và cảm hứng thời trang đường phố mỗi ngày.
                    </p>
                    <form class="urbn-newsletter-form" onsubmit="event.preventDefault(); showFsToast('Cảm ơn bạn đã gia nhập cộng đồng HNMTSHOP!', 'success'); this.reset();">
                        <input type="email" class="urbn-newsletter-input" placeholder="Nhập email của bạn..." required />
                        <button type="submit" class="urbn-btn-join">Tham Gia</button>
                    </form>
                </div>

                <!-- Col 2: Information -->
                <div class="urbn-footer-col">
                    <h5>Thông Tin</h5>
                    <ul>
                        <li><a href="#">Về HNMTSHOP</a></li>
                        <li><a href="#">Hệ Thống Cửa Hàng</a></li>
                        <li><a href="#">Nhà Đầu Tư</a></li>
                        <li><a href="/Products">Sản Phẩm Mới</a></li>
                    </ul>
                </div>

                <!-- Col 3: Help Center -->
                <div class="urbn-footer-col">
                    <h5>Trung Tâm Trợ Giúp</h5>
                    <ul>
                        <li><a href="#">Câu Hỏi Thường Gặp</a></li>
                        <li><a href="#">Điều Khoản Dịch Vụ</a></li>
                        <li><a href="#">Chính Sách Bảo Mật</a></li>
                        <li><a href="#">Chính Sách Đổi Trả</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact Us -->
                <div class="urbn-footer-col urbn-footer-contact">
                    <h5>Liên Hệ</h5>
                    <p>hotro@hnmtshop.vn</p>
                    <p>+84 988 776 655</p>
                    <p style="font-size: 13px; color: #9CA3AF; margin-top: 8px;">Hà Nội & TP. Hồ Chí Minh, Việt Nam</p>
                </div>

            </div>

            <!-- Bottom Copyright -->
            <div class="urbn-footer-bottom">
                &copy; 2026 HNMTSHOP. Tất cả các quyền được bảo lưu. Thiết kế dành riêng cho giới trẻ.
            </div>
        </div>
    </footer>

    <!-- 3D, WebGL & Motion Libraries (Three.js, GLTF, GSAP Draggable, Vanilla-Tilt, Lenis, Spline) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/Draggable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script type="module" src="https://unpkg.com/@@splinetool/viewer@1.9.72/build/spline-viewer.js"></script>

    <!-- HNMTSHOP Core Scripts -->
    <script src="~/js/hnmt3d-engine.js" asp-append-version="true"></script>
    <script src="~/js/atelier.js" asp-append-version="true"></script>
    <script src="~/js/site.js?v=cat_signatures_v1" asp-append-version="true"></script>
    <script src="~/js/store3d.js?v=pants_rail_v25" asp-append-version="true"></script>
    <script src="~/js/clothing-rail.js?v=pants_rail_v25" asp-append-version="true"></script>
    <script src="~/js/sneaker-vault.js?v=uniform_font_v43" asp-append-version="true"></script>
    <script src="~/js/hnmt-cart-drawer.js?v=cart_v1" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
