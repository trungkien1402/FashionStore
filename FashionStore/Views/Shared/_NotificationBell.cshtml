@using System.Security.Claims
@if (User.Identity?.IsAuthenticated == true)
{
    <details class="fs-notification" data-notification-user="@User.FindFirstValue(ClaimTypes.NameIdentifier)" data-notification-url="@Url.Action("Feed", "Notifications")">
        <summary class="@ViewData["BellButtonClass"] fs-notification-trigger" aria-label="Thông báo" title="Thông báo">
            <i class="bi bi-bell" aria-hidden="true"></i>
            <span class="fs-notification-count" hidden aria-hidden="true"></span>
        </summary>
        <section class="fs-notification-panel" aria-label="Thông báo">
            <h2><i class="bi bi-bell" aria-hidden="true"></i> Thông báo</h2>
            <p class="fs-notification-status" role="status">Đang tải…</p>
            <div class="fs-notification-list"></div>
        </section>
    </details>
}
