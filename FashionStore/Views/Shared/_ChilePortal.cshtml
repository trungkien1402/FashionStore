@* 
    ======================================================================
    HNMTSHOP - 3D SHOWROOM PORTAL + CLOTHING RAIL CATALOG
    1. Khi mở Showroom: Hiển thị không gian 3D Adidas Chile 20 (Mặt nước gợn sóng, 3 cột, Quần - Áo - Giày)
    2. Khi bấm vào Áo: Mở Sào Treo Đồ Thời Trang Độc Bản (clothing-rail-catalog từ GitHub)
    3. Khi bấm "Quay lại": Trở về không gian 3D Showroom
    ======================================================================
*@

<div id="hnmtChilePortal" class="hnmt-chile-portal" aria-hidden="true">

    <!-- 1. THREE.JS 3D WEBGL CANVAS (RENDER TOÀN BỘ KHÔNG GIAN 3D & MẶT NƯỚC GỢN SÓNG) -->
    <canvas id="hnmt3dCanvas" class="hnmt-3d-canvas"></canvas>

    <!-- 2. THANH HEADER TỐI GIẢN CỦA SHOWROOM -->
    <header class="hnmt-portal-header">
        <div class="hnmt-portal-brand">
            <span class="hnmt-brand-title">HnmtShop</span>
        </div>

        <div class="hnmt-portal-actions">
            <button type="button" class="hnmt-exit-btn" id="hnmtPortalExitBtn" title="Thoát không gian 3D">
                <i class="bi bi-arrow-left"></i>
                <span>Thoát</span>
            </button>
        </div>
    </header>

    <!-- 3. DÒNG CHỮ HƯỚNG DẪN DƯỚI ĐÁY -->
    <footer class="hnmt-portal-footer">
        <div class="hnmt-badge-prompt">CHỌN 1 MÓN ĐỒ ĐỂ BẮT ĐẦU</div>
        <div class="hnmt-badge-subnote">( Lưu ý: Nhấp vào món đồ bất kỳ để mở phòng trưng bày chi tiết )</div>
    </footer>

    <!-- HOVER TAG KHI RÊ CHUỘT LÊN ĐỒ VẬT 3D -->
    <div class="hnmt-hover-tag" id="hnmtHoverTag" style="display: none !important;">
        <span class="hnmt-hover-cat" id="hnmtHoverCat">02 // TOPS</span>
        <span class="hnmt-hover-name" id="hnmtHoverName">ÁO THUN HNMTSHOP</span>
    </div>

    <!-- 4. GIAO DIỆN SÀO TREO ĐỒ (CLOTHING-RAIL-CATALOG TỪ GITHUB - MỞ RA KHI BẤM VÀO ÁO) -->
    <div id="hnmtRackOverlay" class="hnmt-clothing-rail-wrap" aria-hidden="true">
        <div class="rail-app">
            <!-- Header của Sào đồ -->
            <header class="rail-header" id="header">
                <a href="/" class="rail-brand-signature" id="railBrandSignature" title="Về trang chủ">HnmtShop</a>
                <div class="rail-brand" aria-label="Sào Đồ Thời Trang">
                    <span>Sào Đồ</span>
                    <span>Thời Trang</span>
                </div>
                <div class="rail-head-right">
                    <button type="button" class="rail-bag-btn" id="bagBtn" aria-label="Giỏ hàng">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M4 8h16l-1 13H5L4 8Z"/>
                            <path d="M9 9V6a3 3 0 0 1 6 0v3"/>
                        </svg>
                        <span class="rail-bag-count" id="bagCount">0</span>
                    </button>
                    <!-- Nút Quay lại Showroom 3D -->
                    <button type="button" class="rail-portal-exit-btn" id="hnmtRackBackToLobbyBtn" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </button>
                </div>
            </header>

            <!-- Main Rail Scene -->
            <main class="rail-main">
                <div class="rail-intro">
                    <p class="rail-eyebrow">BỘ SƯU TẬP 01</p>
                    <div class="rail-title-row">
                        <button type="button" class="rail-rack-nav-btn prev" id="rackPrevBtn" title="Sào trước" aria-label="Sào trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h1 class="rail-hero-title">Thời Trang Độc Bản · Nâng Tầm Phong Cách</h1>
                        <button type="button" class="rail-rack-nav-btn next" id="rackNextBtn" title="Sào tiếp theo" aria-label="Sào tiếp theo">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <section class="rail-scene" aria-label="Sào treo đồ thời trang">
                    <div class="rail-scroll" id="railScroll">
                        <div class="rail-stage" id="railStage">
                            <div class="chrome-rail" aria-hidden="true"></div>
                        </div>
                    </div>
                </section>

                <section class="rail-caption-panel">
                    <div class="rail-caption-heading" id="captionTitle">Bộ sưu tập độc bản HNMTSHOP.</div>
                    <div class="rail-caption-detail" id="captionDetail">10 thiết kế giới hạn — Lướt sào hoặc chọn để xem chi tiết.</div>
                    <button type="button" class="rail-outline-pill" id="availabilityBtn">XEM CHI TIẾT ↗</button>
                </section>
            </main>
        </div>

        <!-- Product Detail Modal Overlay -->
        <section class="rail-product-overlay" id="productOverlay" role="dialog" aria-modal="true" aria-label="Chi tiết sản phẩm">
            <button type="button" class="rail-product-close" id="closeBtn">ĐÓNG <span>×</span></button>
            <div class="rail-detail-content">
                <div class="rail-detail-image-row">
                    <button type="button" class="rail-arrow-btn" id="prevBtn" aria-label="Sản phẩm trước">←</button>
                    <img class="rail-detail-img" id="detailImage" alt="">
                    <button type="button" class="rail-arrow-btn" id="nextBtn" aria-label="Sản phẩm sau">→</button>
                </div>
                <p class="rail-counter" id="counter"></p>
                <h2 class="rail-detail-name" id="detailName"></h2>
                <p class="rail-description" id="description"></p>
                <div class="rail-price-line">
                    <span id="detailPrice"></span>
                    <span class="rail-stock" id="stock"></span>
                </div>
                <span class="rail-options-label">MÀU SẮC</span>
                <div class="rail-color-options" id="colors"></div>
                <span class="rail-options-label">KÍCH CỠ</span>
                <div class="rail-size-options" id="sizes"></div>
                <p class="rail-size-hint" id="sizeHint"></p>
                <button type="button" class="rail-cart-cta" id="cartCta">CHỌN KÍCH CỠ</button>
                <p class="rail-delivery">Miễn phí giao hàng toàn quốc từ 500.000 ₫. Đổi trả trong 30 ngày.</p>
            </div>
        </section>

        <!-- Informational Modal -->
        <div class="rail-nav-modal" id="modal" role="dialog" aria-modal="true">
            <div class="rail-modal-body">
                <h2 id="modalTitle">Về HNMTSHOP</h2>
                <p id="modalText"></p>
                <button type="button" class="rail-modal-exit" id="modalExit">ĐÓNG [ESC]</button>
            </div>
        </div>

        <!-- Toast Notification -->
        <aside class="rail-toast" id="toast" role="status" aria-live="polite"></aside>
    </div>

    <!-- 5. GIAO DIỆN SNEAKER VAULT (1:1 THEO VIDEO FIGMA - MỞ RA KHI BẤM VÀO GIÀY TRONG SHOWROOM) -->
    <div id="hnmtSneakerOverlay" class="hnmt-sneaker-vault-wrap" aria-hidden="true">
        <div class="sv-app is-grid-mode" id="svApp">

            <!-- HEADER CỦA SNEAKER VAULT TRONG SHOWROOM -->
            <header class="sv-header">
                <div class="sv-header-left">
                    <button type="button" class="sv-icon-btn" id="svToggleViewBtn" title="Chuyển chế độ xem">
                        <i class="bi bi-view-stacked"></i>
                        <span>SLIDER 3D</span>
                    </button>
                    <div class="sv-vault-switcher" id="svVaultSwitcher">
                        <button type="button" class="sv-vault-arrow" id="svPrevCollectionBtn" aria-label="Bộ giày trước" title="Bộ sưu tập trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="sv-header-title" id="svCollectionTitle">FUTURIST SNEAKER VAULT</span>
                        <button type="button" class="sv-vault-arrow" id="svNextCollectionBtn" aria-label="Bộ giày tiếp theo" title="Bộ sưu tập kế tiếp">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <a href="/" class="sv-brand-signature" title="Về trang chủ HnmtShop">HnmtShop</a>

                <div class="sv-head-right">
                    <button type="button" class="sv-bag-btn" id="svBagBtn" aria-label="Giỏ hàng">
                        <svg fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                            <path d="M4 8h16l-1 13H5L4 8Z" />
                            <path d="M9 9V6a3 3 0 0 1 6 0v3" />
                        </svg>
                        <span class="sv-bag-badge" id="svBagBadge">0</span>
                    </button>
                    <!-- Nút Quay lại không gian 3D Showroom -->
                    <button type="button" class="sv-exit-btn" id="svExitShowroomBtn" onclick="window.closeSneakerShowcase()" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </button>
                </div>
            </header>

            <!-- VIEW 1: GRID OVERVIEW (3x2 FLOATING SNEAKER GRID) -->
            <section class="sv-grid-container" id="svGridContainer" aria-label="Bộ sưu tập sneaker dạng lưới">
                <div class="sv-grid" id="svGrid">
                    <!-- Render tự động bởi sneaker-vault.js -->
                </div>
            </section>

            <!-- VIEW 2: CINEMATIC SLIDER VIEW (FULLSCREEN 1:1 THEO VIDEO FIGMA) -->
            <section class="sv-slider-container" id="svSliderContainer" aria-label="Chi tiết Sneaker nổi khối 3D">

                <!-- CHỮ TYPOGRAPHY KHỔNG LỒ NẰM SAU CHIẾC GIÀY -->
                <div class="sv-giant-title-track" aria-hidden="true">
                    <h2 class="sv-giant-title" id="svGiantTitle">AIR FUTURE IV</h2>
                </div>

                <!-- KHÔNG GIAN GIÀY BAY LƠ LỬNG NỔI KHỐI 3D PARALLAX THEO CHUỘT -->
                <div class="sv-stage" id="svStage">
                    <div class="sv-hero-wrap" id="svHeroWrap">
                        <img src="/images/sneakers/air-future-iv.webp?v=center_h_v27" alt="AIR FUTURE IV" class="sv-hero-img" id="svHeroImg" />
                        <div class="sv-hero-shadow" id="svHeroShadow"></div>
                    </div>
                </div>

                <!-- THANH THÔNG SỐ VÀ ĐIỀU KHIỂN DƯỚI ĐÁY -->
                <footer class="sv-bottom-bar">

                    <!-- GÓC DƯỚI TRÁI: TECH SPECS -->
                    <div class="sv-specs-panel">
                        <h3 class="sv-colorway-name" id="svColorwayName">INFRARAY STORM</h3>
                        <dl class="sv-spec-grid">
                            <dt>MÃ GIÀY:</dt>
                            <dd id="svStyleCode">HFS-04-STORM</dd>

                            <dt>PHỐI MÀU:</dt>
                            <dd id="svColorName">STORM GREY / INFRARED</dd>

                            <dt>THIẾT KẾ:</dt>
                            <dd id="svDesigner">HNMTSHOP × FUTURE LAB</dd>

                            <dt>GIÁ BÁN:</dt>
                            <dd id="svPrice">5.200.000 ₫</dd>
                        </dl>
                    </div>

                    <!-- GÓC DƯỚI PHẢI: MŨI TÊN < > , SELECT COLOR VÀ NÚT ADD TO BAG -->
                    <div class="sv-controls-panel">
                        <div class="sv-arrow-group">
                            <button type="button" class="sv-nav-btn prev" id="svPrevBtn" aria-label="Mẫu trước">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" class="sv-nav-btn next" id="svNextBtn" aria-label="Mẫu tiếp theo">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <div class="sv-color-swatches">
                            <span class="sv-swatches-label">CHỌN MÀU</span>
                            <div class="sv-swatches-row" id="svSwatches">
                                <!-- Chấm màu swatches -->
                            </div>
                        </div>

                        <button type="button" class="sv-add-bag-btn" id="svAddBagBtn">
                            <span>THÊM VÀO GIỎ</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                </footer>

            </section>

        </div>
    </div>

    <!-- 6. GIAO DIỆN PANTS STUDIO (EDITORIAL LOOKBOOK 1:1 THEO VIDEO MẪU - MỞ RA KHI BẤM VÀO BỤC QUẦN TRONG SHOWROOM) -->
    <div id="hnmtPantsOverlay" class="hnmt-pants-studio-wrap" aria-hidden="true">
        <div class="ps-app" id="psApp">

            <!-- HEADER -->
            <header class="ps-header">
                <nav class="ps-nav-tabs" aria-label="Bộ lọc danh mục quần">
                    <button type="button" class="ps-tab-btn is-active" data-cat="all">Tất cả</button>
                    <button type="button" class="ps-tab-btn" data-cat="cargo">Cargo</button>
                    <button type="button" class="ps-tab-btn" data-cat="denim">Denim Jeans</button>
                    <button type="button" class="ps-tab-btn" data-cat="trousers">Trousers</button>
                </nav>

                <a href="/" class="ps-brand-logo" title="HnmtShop">
                    <span class="ps-brand-sig">HnmtShop</span>
                </a>

                <div class="ps-header-right">
                    <button type="button" class="ps-header-btn" id="psCartBtn" aria-label="Giỏ hàng">
                        <i class="bi bi-bag"></i>
                        <span class="ps-cart-badge" id="psCartBadge">0</span>
                    </button>
                    <button type="button" class="ps-exit-btn" id="psExitBtn" onclick="window.closePantsStudio()" title="Quay lại Showroom">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </button>
                </div>
            </header>

            <!-- MAIN STAGE (3 CỘT LOOKBOOK THỜI TRANG) -->
            <main class="ps-main-stage">

                <!-- CỘT TRÁI: EDITORIAL COPY & CTA -->
                <section class="ps-left-col">
                    <h1 class="ps-headline">
                        <span id="psHeadline1">Wear Confidence.</span>
                        <span id="psHeadline2">Define Your Style.</span>
                    </h1>
                    <p class="ps-desc" id="psDesc">
                        Khám phá thiết kế quần Cargo & Denim cao cấp — Phom dáng chuẩn mực, thoải mái vận động và nâng tầm phong thái hàng ngày.
                    </p>
                    <div class="ps-cta-wrap">
                        <button type="button" class="ps-cta-btn" id="psAddToCartBtn">
                            <span>THÊM VÀO GIỎ</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                    <div class="ps-social-row">
                        <a href="https://instagram.com" target="_blank" rel="noopener" class="ps-social-link" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://twitter.com" target="_blank" rel="noopener" class="ps-social-link" aria-label="X / Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://facebook.com" target="_blank" rel="noopener" class="ps-social-link" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://tiktok.com" target="_blank" rel="noopener" class="ps-social-link" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </section>

                <!-- CỘT GIỮA: SÂN KHẤU QUẦN NỔI KHỐI 3D & MŨI TÊN ĐIỀU HƯỚNG -->
                <section class="ps-center-col">
                    <button type="button" class="ps-nav-arrow prev" id="psPrevBtn" aria-label="Mẫu quần trước" title="Mẫu trước">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="ps-hero-stage">
                        <div class="ps-hero-img-wrap">
                            <img src="/images/pants/cargo-acid-wash.png?v=studio_v1" alt="Quần thời trang" class="ps-hero-img is-floating" id="psHeroImg" />
                            <div class="ps-hero-shadow" id="psHeroShadow"></div>
                        </div>
                    </div>

                    <button type="button" class="ps-nav-arrow next" id="psNextBtn" aria-label="Mẫu quần tiếp theo" title="Mẫu kế tiếp">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <div class="ps-bottom-slogan">
                        Dress Better. Feel Better.
                    </div>
                </section>

                <!-- CỘT PHẢI: GIÁ BÁN, SIZE PICKER & HÀNG ĐỢI XEM TRƯỚC -->
                <section class="ps-right-col">
                    <div class="ps-price-box">
                        <span class="ps-sale-price" id="psSalePrice">650.000 ₫</span>
                        <span class="ps-orig-price" id="psOrigPrice">890.000 ₫</span>
                    </div>

                    <div class="ps-size-box">
                        <span class="ps-size-label">CHỌN SIZE QUẦN</span>
                        <div class="ps-size-pills" id="psSizePills">
                            <!-- Render tự động bởi pants-studio.js -->
                        </div>
                    </div>

                    <div class="ps-queue-box">
                        <div class="ps-queue-list" id="psQueueList">
                            <!-- Render thumbnail hàng đợi mini bởi pants-studio.js -->
                        </div>
                    </div>
                </section>

            </main>

        </div>
    </div>

</div>
