@* 
    ======================================================================
    HNMTSHOP - 3D SHOWROOM PORTAL (BẢN SAO 1:1 CHIẾN DỊCH ADIDAS CHILE 20)
    Không gian 3D chân thực: Nền đen tuyền · Mặt nước đọng gợn sóng phản chiếu
    Cột Đen-Đỏ-Trắng · 3 Sản phẩm 3D (Trái: Quần | Giữa: Áo | Phải: Giày)
    ======================================================================
*@

<div id="hnmtChilePortal" class="hnmt-chile-portal" aria-hidden="true">

    <!-- 1. THREE.JS 3D WEBGL CANVAS (RENDER TOÀN BỘ KHÔNG GIAN 3D & MẶT NƯỚC GỢN SÓNG) -->
    <canvas id="hnmt3dCanvas" class="hnmt-3d-canvas"></canvas>

    <!-- 2. THANH HEADER TỐI GIẢN -->
    <header class="hnmt-portal-header">
        <!-- Góc trên bên trái: Logo HNMTSHOP -->
        <div class="hnmt-portal-brand">
            <span class="hnmt-brand-icon"><i class="bi bi-triangle-half"></i></span>
            <span class="hnmt-brand-title">HNMTSHOP</span>
        </div>

        <!-- Góc trên bên phải: Nút THOÁT bo góc nền trong suốt chỉ có viền -->
        <div class="hnmt-portal-actions">
            <button type="button" class="hnmt-exit-btn" id="hnmtPortalExitBtn" title="Thoát không gian 3D">
                <i class="bi bi-arrow-left"></i>
                <span>Thoát</span>
            </button>
        </div>
    </header>

    <!-- 3. DÒNG CHỮ HƯỚNG DẪN DƯỚI ĐÁY -->
    <footer class="hnmt-portal-footer">
        <div class="hnmt-badge-prompt">CHỌN 1 MÓN ĐỒ ĐỂ BẮT ĐẦU</div>
    </footer>

    <!-- 4. GIAO DIỆN SÀO TREO ĐỒ 3D (CHÍNH XÁC NHƯ VIDEO FRAXBIT KHI BẤM CHỌN ÁO) -->
    <div id="hnmtRackOverlay" class="hnmt-rack-overlay" aria-hidden="true">
        <!-- Top Bar: Logo + Timeline Tabs [RACK | STORY | LOOKBOOK | PROCESS | SHOP] + Subtitle + Action Buttons -->
        <div class="hnmt-rack-top-bar">
            <div class="hnmt-rack-brand">
                <span class="hnmt-rack-brand-mark"><i class="bi bi-triangle-half"></i></span>
                <span class="hnmt-rack-brand-text">HNMTSHOP</span>
            </div>

            <div class="hnmt-rack-center-nav">
                <div class="hnmt-rack-timeline">
                    <button type="button" class="hnmt-rack-tab is-active" data-tab="rack">RACK</button>
                    <button type="button" class="hnmt-rack-tab" data-tab="story">STORY</button>
                    <button type="button" class="hnmt-rack-tab" data-tab="lookbook">LOOKBOOK</button>
                    <button type="button" class="hnmt-rack-tab" data-tab="process">PROCESS</button>
                    <button type="button" class="hnmt-rack-tab" data-tab="shop">SHOP</button>
                </div>
                <div class="hnmt-rack-subline">NEW COLLECTION &nbsp;//&nbsp; PREMIUM STREETWEAR</div>
            </div>

            <div class="hnmt-rack-top-actions">
                <button type="button" class="hnmt-rack-drop-btn" id="hnmtRackGetDropBtn">GET THE DROP</button>
                <button type="button" class="hnmt-rack-back-btn" id="hnmtRackBackToLobbyBtn" title="Quay lại showroom 3 món">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại Showroom</span>
                </button>
            </div>
        </div>

        <!-- Hướng dẫn lướt sào đồ -->
        <div class="hnmt-rack-drag-hint" id="hnmtRackDragHint">
            <i class="bi bi-arrows-expand"></i>
            <span>KÉO HOẶC LĂN CHUỘT ĐỂ LƯỚT SÀO TREO ĐỒ</span>
        </div>

        <!-- Bottom Panel: Thông tin sản phẩm của chiếc áo tiêu điểm (Title, Price, Sizes, Add to Cart) -->
        <div class="hnmt-rack-bottom-panel" id="hnmtRackBottomPanel">
            <div class="hnmt-rack-info-col">
                <div class="hnmt-rack-cat-badge" id="rackItemCategory">02 // TOPS & HOODIES</div>
                <h2 class="hnmt-rack-title" id="rackItemTitle">FRAXBIT Heavyweight Boxy Hoodie Forest Green</h2>
                <div class="hnmt-rack-price-row">
                    <span class="hnmt-rack-price" id="rackItemPrice">550.000 ₫</span>
                    <span class="hnmt-rack-stock" id="rackItemStock"><i class="bi bi-check-circle-fill"></i> Còn hàng (S, M, L, XL)</span>
                </div>
            </div>

            <div class="hnmt-rack-controls-col">
                <div class="hnmt-rack-sizes-group">
                    <span class="hnmt-rack-size-label">KÍCH CỠ:</span>
                    <div class="hnmt-rack-size-pills" id="rackSizePills">
                        <button type="button" class="rack-size-pill">S</button>
                        <button type="button" class="rack-size-pill is-active">M</button>
                        <button type="button" class="rack-size-pill">L</button>
                        <button type="button" class="rack-size-pill">XL</button>
                    </div>
                </div>

                <div class="hnmt-rack-buttons-row">
                    <button type="button" class="hnmt-rack-btn-cart" id="rackAddToCartBtn">
                        <i class="bi bi-bag-plus"></i>
                        <span>THÊM VÀO GIỎ</span>
                    </button>
                    <button type="button" class="hnmt-rack-btn-buy" id="rackBuyNowBtn">
                        <span>MUA NGAY (GET THE DROP)</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast thông báo thêm giỏ hàng thành công -->
        <div class="hnmt-rack-toast" id="hnmtRackToast">
            <i class="bi bi-bag-check-fill"></i>
            <span id="hnmtRackToastMsg">Đã thêm vào giỏ hàng thành công!</span>
        </div>
    </div>

    <!-- 5. HIỆU ỨNG CHUYỂN CẢNH KHI NHẤP CHỌN MÓN ĐỒ -->
    <div class="hnmt-portal-flash" id="hnmtPortalFlash"></div>

</div>
