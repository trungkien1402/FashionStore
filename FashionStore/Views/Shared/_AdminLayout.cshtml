
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FashionStore Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f5f6fa;
            font-family: "Segoe UI", sans-serif;
        }

        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 250px;
            background: #171717;
            color: white;
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1000;
        }

        .admin-brand {
            display: block;
            color: white;
            text-decoration: none;
            font-size: 23px;
            font-weight: 700;
            padding: 0 12px 28px;
        }

        .admin-menu-label {
            color: #929292;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 15px 12px 8px;
        }

        .admin-sidebar a.menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #c9c9c9;
            text-decoration: none;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: .2s;
        }

            .admin-sidebar a.menu-link:hover,
            .admin-sidebar a.menu-link.active {
                color: white;
                background: #343434;
            }

            .admin-sidebar a.menu-link i {
                font-size: 18px;
                width: 22px;
            }

        .admin-main {
            margin-left: 250px;
            min-height: 100vh;
        }

        .admin-topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
        }

        .admin-content {
            padding: 30px;
        }

        .admin-card {
            background: white;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 22px;
            height: 100%;
        }

        .admin-stat-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 21px;
        }

        .admin-table th {
            color: #777;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .admin-table td {
            vertical-align: middle;
        }

        @@media (max-width: 768px) {
            .admin-sidebar {
                width: 70px;
                padding: 20px 8px;
            }

            .admin-brand {
                font-size: 0;
                padding: 10px;
            }

                .admin-brand::first-letter {
                    font-size: 23px;
                }

            .admin-sidebar .menu-text,
            .admin-menu-label {
                display: none;
            }

            .admin-sidebar a.menu-link {
                justify-content: center;
            }

                .admin-sidebar a.menu-link i {
                    width: auto;
                }

            .admin-main {
                margin-left: 70px;
            }

            .admin-content {
                padding: 15px;
            }

            .admin-topbar {
                padding: 0 15px;
            }
        }
    </style>
</head>

<body>

    <aside class="admin-sidebar">

        <a asp-controller="Admin"
           asp-action="Index"
           class="admin-brand">
            <i class="bi bi-shop"></i>
            <span class="menu-text">FASHIONSTORE</span>
        </a>

        <div class="admin-menu-label">TỔNG QUAN</div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="menu-link">
            <i class="bi bi-grid"></i>
            <span class="menu-text">Dashboard</span>
        </a>

        <div class="admin-menu-label">QUẢN LÝ CỬA HÀNG</div>

        <a asp-controller="AdminProducts"
           asp-action="Index"
           class="menu-link">
            <i class="bi bi-box-seam"></i>
            <span class="menu-text">Sản phẩm</span>
        </a>

        <a asp-controller="AdminCategories"
           asp-action="Index"
           class="menu-link">
            <i class="bi bi-tags"></i>
            <span class="menu-text">Danh mục</span>
        </a>


        <a asp-controller="AdminOrders"
           asp-action="Index"
           class="menu-link">
            <i class="bi bi-receipt"></i>
            <span class="menu-text">Đơn hàng</span>
        </a>

        <div class="admin-menu-label">HỆ THỐNG</div>

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-link">
            <i class="bi bi-house"></i>
            <span class="menu-text">Xem cửa hàng</span>
        </a>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="mt-3">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="menu-link w-100 border-0 text-start"
                    style="background:transparent;">
                <i class="bi bi-box-arrow-right"></i>
                <span class="menu-text">Đăng xuất</span>
            </button>
        </form>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <div class="fw-semibold">
                Hệ thống quản trị
            </div>

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle fs-5"></i>
                <span>@User.Identity?.Name</span>
            </div>
        </header>

        <div class="admin-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>
                </div>
            }

            @RenderBody()

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
