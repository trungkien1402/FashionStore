@model List<CartItemViewModel>

@{
    ViewData["Title"] = "Giỏ hàng";
    var grandTotal = Model.Sum(x => x.TotalPrice);
}

<div class="container py-5">
    <div class="mb-5">
        <p class="text-muted text-uppercase small">FashionStore</p>
        <h1>Giỏ hàng của bạn</h1>
        <p class="text-muted">
            Kiểm tra sản phẩm trước khi tiến hành thanh toán.
        </p>
    </div>

    @if (TempData["CartSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["CartSuccess"]
        </div>
    }

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["CartError"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3>Giỏ hàng đang trống</h3>
            <p class="text-muted">
                Hãy khám phá những sản phẩm mới nhất của chúng tôi.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="fs-btn fs-btn-dark">
                TIẾP TỤC MUA SẮM
            </a>
        </div>
    }
    else
    {
        <div class="row g-5">
            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    <div class="cart-item-row d-flex gap-4 py-4 border-bottom">

                        <img src="@item.ImageUrl"
                             alt="@item.ProductName"
                             style="width:120px;height:145px;object-fit:cover;"
                             onerror="this.src='https://placehold.co/120x145?text=Product'" />

                        <div class="flex-grow-1">
                            <h5>@item.ProductName</h5>

                            <p class="text-muted mb-1">
                                Size: @item.Size
                            </p>

                            <p class="text-muted mb-2">
                                Màu: @item.Color
                            </p>

                            <p class="fw-semibold">
                                @item.UnitPrice.ToString("N0") ₫
                            </p>

                            <div class="d-flex flex-wrap align-items-center gap-3">

                                <form asp-controller="Cart"
                                      asp-action="Update"
                                      method="post"
                                      class="d-flex gap-2 align-items-center">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="variantId"
                                           value="@item.ProductVariantId" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           max="20"
                                           class="form-control"
                                           style="width:85px;" />

                                    <button type="submit"
                                            class="btn btn-outline-dark btn-sm">
                                        Cập nhật
                                    </button>
                                </form>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="variantId"
                                           value="@item.ProductVariantId" />

                                    <button type="submit"
                                            class="btn btn-link text-danger p-0"
                                            onclick="return confirm('Bạn muốn xóa sản phẩm này?')">
                                        Xóa
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="text-end">
                            <strong>
                                @item.TotalPrice.ToString("N0") ₫
                            </strong>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="text-dark">
                        ← Tiếp tục mua sắm
                    </a>

                    <form asp-controller="Cart"
                          asp-action="Clear"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-link text-danger"
                                onclick="return confirm('Bạn muốn xóa toàn bộ giỏ hàng?')">
                            Xóa toàn bộ
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="p-4 border">
                    <h4 class="mb-4">Tóm tắt đơn hàng</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Tạm tính</span>
                        <span>@grandTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Phí vận chuyển</span>
                        <span>Tính khi thanh toán</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <strong>Tổng tiền</strong>
                        <strong class="fs-5">
                            @grandTotal.ToString("N0") ₫
                        </strong>
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Checkout"
                       class="fs-btn fs-btn-dark w-100 text-center">
                        TIẾN HÀNH THANH TOÁN
                    </a>

                    <p class="small text-muted mt-3 mb-0">
                        Chức năng thanh toán sẽ được triển khai ở bước tiếp theo.
                    </p>
                </div>
            </div>
        </div>
    }
</div>