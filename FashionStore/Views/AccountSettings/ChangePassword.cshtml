@model FashionStore.Models.ViewModels.ChangeAccountPasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu · HNMTSHOP"; }
@section Styles { <link rel="stylesheet" href="~/css/account-settings.css" asp-append-version="true" /> }
<main class="account-settings"><header class="settings-heading"><span>BẢO MẬT TÀI KHOẢN</span><h1>Đổi mật khẩu</h1><p>Giữ tài khoản an toàn với mật khẩu riêng của bạn.</p></header>
    <div class="settings-grid"><aside class="settings-panel settings-nav"><strong>Tài khoản của tôi</strong><a asp-action="Index"><i class="bi bi-person-circle"></i> Hồ sơ cá nhân</a><a asp-action="ChangePassword" class="active"><i class="bi bi-shield-lock"></i> Đổi mật khẩu</a><a asp-action="Display"><i class="bi bi-sliders"></i> Cài đặt hiển thị</a><a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Về trang chủ</a></aside>
        <section class="settings-panel"><div class="settings-section-title"><i class="bi bi-shield-check"></i><div><h2>Thiết lập mật khẩu mới</h2><p>8–100 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p></div></div>
            <form asp-action="ChangePassword" method="post" class="settings-form"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" autocomplete="current-password" required /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
                <div class="settings-fields"><div><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" autocomplete="new-password" maxlength="100" required /><span asp-validation-for="NewPassword" class="text-danger"></span></div><div><label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" autocomplete="new-password" maxlength="100" required /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div></div>
                <a asp-controller="PasswordRecovery" asp-action="ForgotPassword">Không nhớ mật khẩu hiện tại? Xác nhận bằng email</a>
                <p class="settings-hint"><i class="bi bi-info-circle"></i> Bạn vẫn đăng nhập trên thiết bị này. Các phiên khác sẽ được kiểm tra và yêu cầu đăng nhập lại.</p>
                <div class="settings-actions"><a asp-action="Index">Quay lại hồ sơ</a><button type="submit" class="settings-primary">Đổi mật khẩu <i class="bi bi-arrow-right"></i></button></div>
            </form>
        </section>
    </div>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
