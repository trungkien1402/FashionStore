@model FashionStore.Models.Entities.Order
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.OrderCode;

    var nextStatuses = new List<OrderStatus>();
    switch (Model.Status)
    {
        case OrderStatus.PendingConfirmation:
            nextStatuses.Add(OrderStatus.Confirmed);
            nextStatuses.Add(OrderStatus.Cancelled);
            break;
        case OrderStatus.Confirmed:
            nextStatuses.Add(OrderStatus.Processing);
            nextStatuses.Add(OrderStatus.Cancelled);
            break;
        case OrderStatus.Processing:
            nextStatuses.Add(OrderStatus.Shipping);
            nextStatuses.Add(OrderStatus.Cancelled);
            break;
        case OrderStatus.Shipping:
            nextStatuses.Add(OrderStatus.Delivered);
            nextStatuses.Add(OrderStatus.DeliveryFailed);
            break;
        case OrderStatus.DeliveryFailed:
            nextStatuses.Add(OrderStatus.Shipping);
            nextStatuses.Add(OrderStatus.Returned);
            break;
    }

    string GetStatusName(OrderStatus status) => status switch
    {
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý kho",
        OrderStatus.Shipping => "Đang giao hàng",
        OrderStatus.Delivered => "Đã giao thành công",
        OrderStatus.Cancelled => "Đã hủy",
        OrderStatus.DeliveryFailed => "Giao thất bại",
        OrderStatus.Returned => "Đã hoàn hàng",
        _ => status.ToString()
    };

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };

    var shipments = ViewBag.Shipments as List<Shipment> ?? new List<Shipment>();
    var histories = ViewBag.StatusHistories as List<OrderStatusHistory> ?? new List<OrderStatusHistory>();
}

<!-- HEADER -->
<div class="mb-4">
    <a asp-action="Index" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại Hàng đợi Đơn hàng</span>
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
                    ORDER FULFILLMENT FILE
                </span>
                <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
                <span class="text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0 adm-heading font-monospace" style="letter-spacing: -0.01em;">@Model.OrderCode</h2>
                <button type="button" class="btn btn-sm adm-btn-outline p-1 px-2" onclick="copyAdmText(this, '@Model.OrderCode')" title="Sao chép mã đơn">
                    <i class="bi bi-copy"></i>
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (Model.Status == OrderStatus.Confirmed || Model.Status == OrderStatus.Processing || Model.Status == OrderStatus.Shipping)
            {
                <a asp-controller="AdminShipments" asp-action="Create" asp-route-orderId="@Model.Id" class="adm-btn-atelier py-2 px-3">
                    <i class="bi bi-truck"></i>
                    <span>Tạo lượt giao hàng</span>
                </a>
            }

            <button type="button" onclick="window.print()" class="btn adm-btn-outline py-2 px-3">
                <i class="bi bi-printer"></i>
                <span>In đơn</span>
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT MAIN COLUMN: ORDER ITEMS, PAYMENT & SHIPMENTS -->
    <div class="col-lg-8">

        <!-- ORDER ITEMS TABLE -->
        <div class="adm-card mb-4 p-0 overflow-hidden">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 adm-heading">
                    <i class="bi bi-bag me-2" style="color: var(--adm-gold);"></i>Sản phẩm đã đặt (@Model.Items.Count)
                </h5>
                <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                    TỔNG SỐ LƯỢNG: @Model.Items.Sum(i => i.Quantity)
                </span>
            </div>

            <div class="table-responsive">
                <table class="adm-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">SẢN PHẨM</th>
                            <th>MÃ SKU</th>
                            <th>PHÂN LOẠI</th>
                            <th>ĐƠN GIÁ</th>
                            <th>SỐ LƯỢNG</th>
                            <th class="text-end pe-4">THÀNH TIỀN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold adm-heading">@item.ProductName</div>
                                </td>
                                <td>
                                    <span class="font-monospace text-muted small">@item.SKU</span>
                                </td>
                                <td>
                                    <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                                        Size: @item.Size | @item.Color
                                    </span>
                                </td>
                                <td>@item.UnitPrice.ToString("N0") ₫</td>
                                <td class="fw-bold adm-heading">@item.Quantity</td>
                                <td class="text-end pe-4 fw-bold" style="color: var(--adm-gold);">
                                    @((item.UnitPrice * item.Quantity).ToString("N0")) ₫
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PRICE BREAKDOWN FOOTER -->
            <div class="p-4 border-top border-secondary border-opacity-10 bg-opacity-10" style="background: var(--adm-surface-hover);">
                <div class="row justify-content-end">
                    <div class="col-md-6 col-lg-5">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tạm tính hàng hóa:</span>
                            <span class="adm-heading fw-semibold">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="adm-heading fw-semibold">@Model.ShippingFee.ToString("N0") ₫</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small text-danger">
                                <span>Khuyến mại giảm giá:</span>
                                <span class="fw-semibold">-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }
                        <hr class="my-2" style="border-color: var(--adm-border);" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold adm-heading">TỔNG THANH TOÁN:</span>
                            <span class="fs-4 fw-bold" style="color: var(--adm-gold);">
                                @Model.TotalAmount.ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAYMENT MANAGEMENT CARD -->
        <div class="adm-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 adm-heading">
                    <i class="bi bi-credit-card me-2" style="color: var(--adm-gold);"></i>Quản lý Thanh toán
                </h5>
                @if (Model.PaymentMethod == PaymentMethod.VietQR)
                {
                    <span class="badge" style="background: rgba(2, 132, 199, 0.12); color: var(--adm-cyan); border: 1px solid rgba(2, 132, 199, 0.3);">
                        <i class="bi bi-qr-code me-1"></i> VietQR Chuyển khoản
                    </span>
                }
                else
                {
                    <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink-muted); border: 1px solid var(--adm-border);">
                        <i class="bi bi-cash me-1"></i> Tiền mặt khi nhận (COD)
                    </span>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                        <div class="text-muted small">Trạng thái thanh toán hiện tại</div>
                        <div class="fs-5 fw-bold mt-1">
                            @if (Model.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán thành công</span>
                            }
                            else if (Model.PaymentStatus == PaymentStatus.Pending)
                            {
                                <span class="text-warning"><i class="bi bi-clock-history me-1"></i>Chờ xác nhận tiền</span>
                            }
                            else if (Model.PaymentStatus == PaymentStatus.Failed)
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>Thanh toán thất bại</span>
                            }
                            else
                            {
                                <span class="text-info"><i class="bi bi-arrow-counterclockwise me-1"></i>Đã hoàn tiền</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <!-- PAYMENT ACTION BUTTONS -->
                    @if (Model.PaymentStatus == PaymentStatus.Pending)
                    {
                        <div class="d-flex flex-wrap gap-2 w-100">
                            <form asp-action="UpdatePaymentStatus" asp-route-id="@Model.Id" method="post" class="flex-grow-1"
                                  onsubmit="return confirm('Bạn đã đối soát tài khoản ngân hàng và xác nhận ĐÃ NHẬN TIỀN?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="@((int)PaymentStatus.Paid)" />
                                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> Xác nhận ĐÃ NHẬN TIỀN
                                </button>
                            </form>

                            <form asp-action="UpdatePaymentStatus" asp-route-id="@Model.Id" method="post"
                                  onsubmit="return confirm('Ghi nhận thanh toán thất bại?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatus" value="@((int)PaymentStatus.Failed)" />
                                <button type="submit" class="btn btn-outline-danger py-2 px-3" title="Báo lỗi">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>
                    }
                    else if (Model.PaymentStatus == PaymentStatus.Paid && 
                            (Model.Status == OrderStatus.Cancelled || Model.Status == OrderStatus.DeliveryFailed || Model.Status == OrderStatus.Returned))
                    {
                        <form asp-action="UpdatePaymentStatus" asp-route-id="@Model.Id" method="post" class="w-100"
                              onsubmit="return confirm('Bạn đã thực hiện hoàn tiền thực tế cho khách hàng chưa?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="newStatus" value="@((int)PaymentStatus.Refunded)" />
                            <button type="submit" class="btn btn-warning w-100 py-2 fw-bold">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Xác nhận ĐÃ HOÀN TIỀN
                            </button>
                        </form>
                    }
                    else if (Model.PaymentStatus == PaymentStatus.Paid)
                    {
                        <div class="text-muted small">
                            <i class="bi bi-shield-check text-success fs-5 me-1 align-middle"></i>
                            Giao dịch thanh toán hợp lệ và đã hoàn tất.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SHIPMENTS CARD -->
        <div class="adm-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 adm-heading">
                    <i class="bi bi-truck me-2" style="color: var(--adm-gold);"></i>Lượt Giao hàng Liên kết (@shipments.Count)
                </h5>
                @if (Model.Status == OrderStatus.Confirmed || Model.Status == OrderStatus.Processing || Model.Status == OrderStatus.Shipping)
                {
                    <a asp-controller="AdminShipments" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm adm-btn-outline">
                        <i class="bi bi-plus-circle me-1"></i> Phân công Shipper
                    </a>
                }
            </div>

            @if (shipments.Any())
            {
                <div class="table-responsive">
                    <table class="adm-table mb-0">
                        <thead>
                            <tr>
                                <th>MÃ VẬN ĐƠN</th>
                                <th>SHIPPER PHỤ TRÁCH</th>
                                <th>TIỀN THU COD</th>
                                <th>TRẠNG THÁI</th>
                                <th class="text-end">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sh in shipments)
                            {
                                <tr>
                                    <td>
                                        <span class="font-monospace fw-bold" style="color: var(--adm-cyan);">@sh.TrackingCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold adm-heading">@(sh.Shipper?.FullName ?? "Chưa rõ")</div>
                                        <div class="text-muted small">@(sh.Shipper?.PhoneNumber ?? "")</div>
                                    </td>
                                    <td class="fw-bold" style="color: var(--adm-gold);">
                                        @(sh.CODAmount > 0 ? sh.CODAmount.ToString("N0") + " ₫" : "0 ₫")
                                    </td>
                                    <td>
                                        <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                                            @GetShipmentStatusName(sh.Status)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="AdminShipments" asp-action="Details" asp-route-id="@sh.Id" class="btn btn-sm adm-btn-outline py-1 px-2">
                                            Xem vận đơn <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted small py-2">
                    <i class="bi bi-info-circle me-1"></i> Chưa có lượt vận chuyển nào được tạo cho đơn hàng này.
                </div>
            }
        </div>

    </div>

    <!-- RIGHT SIDEBAR: RECIPIENT INFO, STATUS TRANSITION & TIMELINE -->
    <div class="col-lg-4">

        <!-- STATUS TRANSITION CARD -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-arrow-repeat me-2" style="color: var(--adm-gold);"></i>Điều phối Trạng thái
            </h5>

            <div class="p-3 rounded-3 mb-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                <div class="text-muted small">Trạng thái hiện tại:</div>
                <div class="fs-5 fw-bold adm-heading mt-1">@GetStatusName(Model.Status)</div>
            </div>

            @if (nextStatuses.Any())
            {
                <form asp-action="UpdateStatus" method="post"
                      onsubmit="return confirm('Bạn có chắc muốn chuyển trạng thái đơn hàng này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="adm-form-label">Chuyển sang trạng thái tiếp theo:</label>
                        <select name="newStatus" class="form-select adm-input-dark" required>
                            @foreach (var st in nextStatuses)
                            {
                                <option value="@((int)st)">@GetStatusName(st)</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn adm-btn-atelier w-100 py-2 justify-content-center">
                        <i class="bi bi-check2-circle"></i>
                        <span>Cập nhật trạng thái</span>
                    </button>
                </form>
            }
            else
            {
                <div class="text-muted small">
                    <i class="bi bi-lock me-1"></i> Đơn hàng đã ở trạng thái kết thúc, không thể chuyển đổi thêm.
                </div>
            }
        </div>

        <!-- RECIPIENT CARD -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-person me-2" style="color: var(--adm-gold);"></i>Thông tin Nhận hàng
            </h5>

            <div class="mb-2">
                <div class="text-muted small">Người nhận:</div>
                <div class="fw-bold adm-heading">@Model.ReceiverName</div>
            </div>

            <div class="mb-2">
                <div class="text-muted small">Số điện thoại:</div>
                <div class="font-monospace fw-semibold adm-heading">@Model.Phone</div>
            </div>

            <div class="mb-0">
                <div class="text-muted small">Địa chỉ nhận hàng:</div>
                <div class="adm-text-contrast small">@Model.Address</div>
            </div>
        </div>

        <!-- ORDER STATUS TIMELINE -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-clock-history me-2" style="color: var(--adm-gold);"></i>Lịch sử Xử lý (Timeline)
            </h5>

            @if (histories.Any())
            {
                <div class="adm-timeline">
                    @for (int i = 0; i < histories.Count; i++)
                    {
                        var h = histories[i];
                        var isLatest = i == histories.Count - 1;

                        <div class="adm-timeline-item">
                            <div class="adm-timeline-dot @(isLatest ? "active" : "")"></div>
                            <div class="adm-timeline-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold adm-heading small">@GetStatusName(h.NewStatus)</span>
                                    <span class="text-muted font-monospace" style="font-size: 0.7rem;">
                                        @h.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                    </span>
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    Bởi: <strong class="adm-text-contrast">@(h.ChangedByUser?.FullName ?? "Hệ thống")</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(h.Note))
                                {
                                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">@h.Note</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small py-2">
                    Chưa có lịch sử chuyển đổi trạng thái nào.
                </div>
            }
        </div>

    </div>
</div>
