@model List<FashionStore.Models.Entities.Order>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var selectedStatus = ViewBag.SelectedStatus as OrderStatus?;
}

<section class="container py-5">
    <div class="mb-4">
        <div class="text-muted small text-uppercase mb-2">Administration</div>
        <h1 style="font-family:'Playfair Display',serif;">Quản lý đơn hàng</h1>
        <p class="text-muted">Theo dõi và xử lý đơn hàng của cửa hàng.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    if (selectedStatus == status)
                    {
                        <option value="@((int)status)" selected>
                            @status
                        </option>
                    }
                    else
                    {
                        <option value="@((int)status)">
                            @status
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Lọc đơn hàng</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="border text-center p-5">
            <h5>Chưa có đơn hàng</h5>
            <p class="text-muted mb-0">Đơn hàng sẽ xuất hiện tại đây khi khách đặt hàng.</p>
        </div>
    }
    else
    {
        <div class="table-responsive border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Người nhận</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@order.OrderCode</td>
                            <td>
                                <div>@order.ReceiverName</div>
                                <small class="text-muted">@order.Phone</small>
                            </td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                            <td>@order.Status</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-dark">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>