@model List<FashionStore.Models.Entities.Order>
@using FashionStore.Models.Enums
@using FashionStore.Services.Implementations

@{
    ViewData["Title"] = "Hàng đợi Đơn hàng";
}

<header class="adm-dashboard-header mb-4">
    <div>
        <h1>Đơn hàng</h1>
        <p class="adm-dashboard-period">@ViewBag.Count kết quả</p>
    </div>
</header>

<form asp-action="Index" method="get" class="adm-filter-bar row g-2 mx-0 mb-4">
    <div class="col-12 col-md-4">
        <label for="search">Tìm đơn hàng</label>
        <input id="search" name="search" maxlength="100" value="@ViewBag.Search" placeholder="Mã đơn, người nhận hoặc số điện thoại" class="form-control adm-input-dark" />
    </div>
    <div class="col-6 col-md-2">
        <label for="status">Trạng thái đơn</label>
        <select id="status" name="status" class="form-select adm-input-dark">
            <option value="">Tất cả</option>
            @foreach (var value in Enum.GetValues<OrderStatus>())
            {
                <option value="@value" selected="@(ViewBag.SelectedStatus is OrderStatus current && current == value)">@AdminReportService.GetStatusName(value)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="paymentStatus">Thanh toán</label>
        <select id="paymentStatus" name="paymentStatus" class="form-select adm-input-dark">
            <option value="">Tất cả</option>
            @foreach (var value in Enum.GetValues<PaymentStatus>())
            {
                <option value="@value" selected="@(ViewBag.PaymentStatus is PaymentStatus current && current == value)">@value</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="paymentMethod">Phương thức</label>
        <select id="paymentMethod" name="paymentMethod" class="form-select adm-input-dark">
            <option value="">Tất cả</option>
            @foreach (var value in Enum.GetValues<PaymentMethod>())
            {
                <option value="@value" selected="@(ViewBag.PaymentMethod is PaymentMethod current && current == value)">@value</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="shipmentStatus">Vận chuyển</label>
        <select id="shipmentStatus" name="shipmentStatus" class="form-select adm-input-dark">
            <option value="">Tất cả</option>
            @foreach (var value in Enum.GetValues<ShipmentStatus>())
            {
                <option value="@value" selected="@(ViewBag.ShipmentStatus is ShipmentStatus current && current == value)">@value</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="from">Từ ngày</label>
        <input id="from" name="from" type="date" value="@ViewBag.From" class="form-control adm-input-dark" />
    </div>
    <div class="col-6 col-md-2">
        <label for="to">Đến ngày</label>
        <input id="to" name="to" type="date" value="@ViewBag.To" class="form-control adm-input-dark" />
    </div>
    <div class="col-6 col-md-2">
        <label for="sort">Sắp xếp</label>
        <select id="sort" name="sort" class="form-select adm-input-dark">
            <option value="">Mới nhất</option>
            <option value="oldest" selected="@(ViewBag.Sort == "oldest")">Cũ nhất</option>
            <option value="amount" selected="@(ViewBag.Sort == "amount")">Tổng tiền giảm dần</option>
        </select>
    </div>
    <div class="col-12 col-md-auto align-self-end d-flex gap-2">
        <button type="submit" class="adm-btn-atelier">Lọc</button>
        <a asp-action="Index" class="adm-btn-outline">Đặt lại</a>
    </div>
</form>

<!-- ORDERS TABLE -->
@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Không có đơn hàng nào trong mục này</h5>
        <p class="text-muted small">Tất cả các đơn đã được điều phối hoặc chưa có giao dịch phát sinh.</p>
        <a asp-action="Index" class="btn adm-btn-outline mt-2">
            Xem toàn bộ đơn hàng
        </a>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">MÃ ĐƠN HÀNG</th>
                        <th>NGÀY ĐẶT</th>
                        <th>KHÁCH HÀNG</th>
                        <th>PHƯƠNG THỨC & TT</th>
                        <th>TỔNG TIỀN</th>
                        <th>TRẠNG THÁI ĐƠN</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var isPending = order.Status == OrderStatus.PendingConfirmation;

                        <tr style="@(isPending ? "background: rgba(217, 119, 6, 0.04);" : "")">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="font-monospace fw-bold adm-heading" style="font-size: 0.88rem;">@order.OrderCode</span>
                                    <button type="button" class="btn btn-sm p-0 text-muted" onclick="copyAdmText(this, '@order.OrderCode')" title="Sao chép mã đơn">
                                        <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <div class="adm-text-contrast small fw-medium">@AdminReportService.ToVietnamTime(order.CreatedAt).ToString("dd/MM/yyyy")</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@AdminReportService.ToVietnamTime(order.CreatedAt).ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                <div class="fw-bold adm-heading">@order.ReceiverName</div>
                                <div class="text-muted font-monospace" style="font-size: 0.75rem;">
                                    <i class="bi bi-telephone me-1"></i>@order.Phone
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    @if (order.PaymentMethod == PaymentMethod.VietQR)
                                    {
                                        <span class="badge" style="background: rgba(2, 132, 199, 0.12); color: var(--adm-cyan); border: 1px solid rgba(2, 132, 199, 0.3); width: fit-content;">
                                            <i class="bi bi-qr-code me-1"></i> VietQR
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink-muted); border: 1px solid var(--adm-border); width: fit-content;">
                                            <i class="bi bi-cash me-1"></i> COD
                                        </span>
                                    }

                                    <div style="font-size: 0.72rem;">
                                        @if (order.PaymentStatus == PaymentStatus.Paid)
                                        {
                                            <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-clock me-1"></i>Chưa thanh toán</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold" style="color: var(--adm-gold); font-size: 1.05rem;">
                                    @order.TotalAmount.ToString("N0") ₫
                                </div>
                            </td>
                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.PendingConfirmation:
                                        <span class="adm-pill adm-pill-amber">Chờ duyệt</span>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <span class="adm-pill adm-pill-blue">Đã duyệt</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="adm-pill adm-pill-blue">Xử lý kho</span>
                                        break;
                                    case OrderStatus.Shipping:
                                        <span class="adm-pill adm-pill-blue">Đang giao</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="adm-pill adm-pill-emerald">Đã giao</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="adm-pill adm-pill-rose">Đã hủy</span>
                                        break;
                                    case OrderStatus.DeliveryFailed:
                                        <span class="adm-pill adm-pill-rose">Giao thất bại</span>
                                        break;
                                    default:
                                        <span class="adm-pill adm-pill-faint">@order.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    @if (isPending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <input type="hidden" name="newStatus" value="@OrderStatus.Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-warning fw-bold py-1 px-2" style="font-size: 0.75rem;" title="Duyệt đơn nhanh">
                                                <i class="bi bi-check-lg"></i> Duyệt
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-sm adm-btn-outline py-1 px-2" style="font-size: 0.75rem;" title="Chi tiết đơn hàng">
                                        <i class="bi bi-eye me-1"></i> Xem
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


@if (ViewBag.PageCount > 1)
{
    var routes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var entry in ViewContext.HttpContext.Request.Query)
    {
        if (!entry.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
            routes[entry.Key] = entry.Value.ToString();
    }

    var page = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3 mb-4" aria-label="Phân trang đơn hàng">
        @if (page > 1)
        {
            <a asp-action="Index" asp-all-route-data="routes" asp-route-page="@(page - 1)" class="adm-btn-outline">Trang trước</a>
        }
        <span>Trang @(page) / @ViewBag.PageCount</span>
        @if (page < ViewBag.PageCount)
        {
            <a asp-action="Index" asp-all-route-data="routes" asp-route-page="@(page + 1)" class="adm-btn-outline">Trang sau</a>
        }
    </nav>
}
