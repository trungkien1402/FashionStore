@model LookbookDisplay
@{
    ViewData["Title"] = $"Xem trước đợt sale · {Model.Collection.Name}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/lookbook.css" asp-append-version="true" />
}

<div class="urbn-container py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span>Xem trước đợt sale</span>
    <a asp-controller="AdminCollections" asp-action="Edit" asp-route-id="@Model.Collection.Id">Quay lại chỉnh đợt sale</a>
</div>
<partial name="_SaleOffer" model="@(((LookbookDisplay?)Model, true))" />

@section Scripts {
    <script src="~/js/offer-model-gallery.js" asp-append-version="true"></script>
}
