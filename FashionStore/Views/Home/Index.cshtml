@model List<FashionStore.Models.Entities.Product>
@inject FashionStore.Services.Implementations.IntroPreference IntroPreference
@{
    ViewData["Title"] = "HNMTSHOP – Khẳng Định Phong Cách | Thời Trang Giới Trẻ";
}

<!-- ============================================================== -->
<!-- 1:1 REPLICA: HNMTSHOP ATELIER — THE ANATOMY OF STYLE           -->
<!-- ============================================================== -->
@if (!await IntroPreference.IsHiddenAsync())
{
<div class="at-loader" id="atLoader" aria-hidden="true">
    <div class="at-loader__mark">HNMTSHOP</div>
    <div class="at-loader__bar"><span id="atLoaderFill"></span></div>
    <div class="at-loader__pct"><span id="atLoaderPct">0</span><i>%</i></div>
    <div class="at-loader__label">Khởi tạo không gian thời trang đương đại</div>
</div>

<header class="at-site-header" id="atHeader">
    <a class="at-brand" href="#atTop">
        <span class="at-brand__mark">&#9670;</span>
        <span class="at-brand__word">HNMTSHOP</span>
    </a>
    <nav class="at-nav">
        <a class="at-nav__cta" href="#mainContent">Vào Shop</a>
    </nav>
</header>

<div id="atTop"></div>

<section class="at-scene" id="atScene" aria-label="The Anatomy of Style">
    <div class="at-sticky" id="atSticky">

        <canvas id="atFrames" class="at-frames-canvas"></canvas>

        <!-- Cinematic Overlays -->
        <div class="at-grade at-grade--vignette"></div>
        <div class="at-grade at-grade--top"></div>
        <div class="at-grade at-grade--bottom"></div>
        <div class="at-grain"></div>
        <form asp-controller="DisplayPreferences" asp-action="HideIntro" method="post" class="at-hide-intro-form">
            <button type="submit" class="at-hide-intro" aria-label="Ẩn phần giới thiệu" title="Ẩn lần sau. Bật lại trong Cài đặt tài khoản.">
                <i class="bi bi-eye-slash" aria-hidden="true"></i>
            </button>
        </form>

        <!-- Movement 00: Hero Title -->
        <div class="at-panel at-panel--hero" data-panel="hero">
            <p class="at-eyebrow at-eyebrow--center">HNMTSHOP · STREETWEAR EDITIONS</p>
            <h1 class="at-hero-title">Tự Do Nguyên Bản<br><em>Phóng Khoáng Đường Phố</em></h1>
            <div class="at-scroll-cue"><span></span>Cuộn để khám phá bộ phối</div>
        </div>

        <!-- Movement 01: Boxy Cropped Sweater -->
        <article class="at-panel at-panel--left" data-panel="1">
            <span class="at-panel__index">01</span>
            <p class="at-panel__kicker">Bản Phối Thượng Tầng</p>
            <h2 class="at-panel__title">Boxy Cropped Sweater<br>Xanh Rêu Đậm Chất Retro</h2>
            <p class="at-panel__body">Dệt từ sợi cotton chân cua 380 GSM dày dặn, giữ ấm êm ái trên da. Phom áo lửng bo gấu tự nhiên, kết hợp typo <em>Worst Behavior</em> độc bản tôn trọn tỷ lệ cơ thể và tạo điểm nhấn ấn tượng.</p>
            <p class="at-panel__spec"><i class="bi bi-tag-fill"></i> 100% Cotton 380 GSM · Phom Boxy Crop Trend</p>
        </article>

        <!-- Movement 02: Layer Cut & Drawstring Waist -->
        <article class="at-panel at-panel--right" data-panel="2">
            <span class="at-panel__index">02</span>
            <p class="at-panel__kicker">Chi Tiết Cắt May Layer</p>
            <h2 class="at-panel__title">Khoảng Hở Tự Nhiên<br>Phóng Khoáng & Bụi Bặm</h2>
            <p class="at-panel__body">Khoảng hở layer tự nhiên giữa gấu áo lửng và cạp quần denim mang đến năng lượng trẻ trung đặc trưng của văn hóa đường phố. Cạp co giãn kèm dây rút bản to tiện dụng suốt ngày dài năng động.</p>
            <p class="at-panel__spec"><i class="bi bi-rulers"></i> Tỷ Lệ Hack Dáng 1/3 · Dây Rút Cotton Bản Dày</p>
        </article>

        <!-- Movement 03: Curved Seam Baggy Denim -->
        <article class="at-panel at-panel--left" data-panel="3">
            <span class="at-panel__index">03</span>
            <p class="at-panel__kicker">Hạ Tầng Trang Phục</p>
            <h2 class="at-panel__title">Curved Seam Baggy Denim<br>Đường May Lượn Sóng 3D</h2>
            <p class="at-panel__body">Quần jean ống suông rộng với kỹ thuật may cut-and-sew tạo hiệu ứng đường chỉ cong 3D độc quyền. Vải denim 13oz đứng phom, xử lý wash sờn cổ điển che trọn mọi khuyết điểm dáng chân.</p>
            <p class="at-panel__spec"><i class="bi bi-water"></i> Heavyweight Denim 13oz · Wash Màu Cổ Điển</p>
        </article>

        <!-- Movement 04: Street Ready & Enter Shop -->
        <article class="at-panel at-panel--left" data-panel="4">
            <span class="at-panel__index">04</span>
            <p class="at-panel__kicker">Trọn Bộ Hoàn Hảo</p>
            <h2 class="at-panel__title">Sẵn Sàng Xuống Phố<br>Khẳng Định Bản Thân</h2>
            <p class="at-panel__body">Sự kết hợp ăn ý giữa tông rêu retro và sắc xanh denim kinh điển. Hoàn thiện cùng sneaker đế êm và nón lưỡi trai đội ngược là bạn đã sẵn sàng cho mọi buổi hẹn cà phê hay dạo phố cuối tuần.</p>
            <p class="at-panel__spec"><i class="bi bi-bag-check-fill"></i> Đủ Size S · M · L · XL · Đổi Trả Tận Nhà 30 Ngày</p>
        </article>

        <!-- Progress Bar & Movement Counter -->
        <div class="at-progress"><span id="atProgressFill"></span></div>
        <div class="at-scene-count"><span id="atMovementNo">00</span><i>/ 04</i></div>

    </div>
</section>
}


<!-- Mốc cuộn vào shop -->
<div id="mainContent"></div>

<!-- ============================================================== -->
<!-- SECTION 1: HERO SECTION (KHẲNG ĐỊNH PHONG CÁCH + KHUNG VÒM 3 MẪU)-->
<!-- ============================================================== -->
<section class="urbn-hero-section">
    <div class="urbn-container">
        <div class="urbn-hero-grid">

            <!-- Bên trái: Tiêu đề & Nút bấm -->
            <div>
                <h1 class="urbn-hero-title">
                    Khẳng Định<br />Phong Cách
                </h1>
                <p class="urbn-hero-subtitle">
                    Thời trang đường phố thời thượng bắt nguồn từ văn hóa trẻ – Thiết kế cho sự thoải mái, tự do vận động và tự tin mỗi ngày.
                </p>

                <div class="urbn-hero-btn-row">
                    <a asp-controller="Products" asp-action="Index" class="urbn-btn-drop">
                        Khám Phá Drop Mới
                    </a>
                    <a href="#categories" class="urbn-btn-styles">
                        Xem Tất Cả Mẫu
                    </a>
                </div>

                <!-- 3 Chỉ số uy tín chân Hero -->
                <div class="urbn-hero-metrics-row">
                    <div class="urbn-metric-box">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Đổi Trả Dễ Dàng</span>
                        <small>Trong 30 ngày</small>
                    </div>

                    <div class="urbn-metric-box">
                        <i class="bi bi-hand-thumbs-up"></i>
                        <span>100% Cotton</span>
                        <small>Sản Xuất Tại VN</small>
                    </div>

                    <div class="urbn-metric-box">
                        <i class="bi bi-truck"></i>
                        <span>Miễn Phí</span>
                        <small>Vận Chuyển 500k</small>
                    </div>
                </div>
            </div>

            <!-- Bên phải: Khung vòm nghệ thuật 3 người mẫu + Huy hiệu bay -->
            <div>
                <div class="urbn-collage-container">

                    <!-- Vòm 1: Trái (Tone be / Nón lưỡi trai) -->
                    <div class="urbn-arch-item urbn-arch-left">
                        <img src="https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=600&q=80"
                             alt="Người mẫu HNMTSHOP" />
                    </div>

                    <!-- Vòm 2: Giữa đè lên (Mũ len vàng & Áo nỉ Casablanca) -->
                    <div class="urbn-arch-item urbn-arch-center">
                        <img src="https://images.unsplash.com/photo-1509967419530-da38b4704bc6?auto=format&fit=crop&w=600&q=80"
                             alt="Streetwear HNMTSHOP" />
                    </div>

                    <!-- Vòm 3: Phải (Tone hồng / Nón xanh) -->
                    <div class="urbn-arch-item urbn-arch-right">
                        <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=600&q=80"
                             alt="Người mẫu HNMTSHOP" />
                    </div>

                    <!-- Huy hiệu bay 1: Góc trên phải -->
                    <div class="urbn-float-pill urbn-float-top-right">
                        <span>100% Đảm Bảo Hài Lòng</span>
                    </div>

                    <!-- Huy hiệu bay 2: Góc dưới trái -->
                    <div class="urbn-float-pill urbn-float-bottom-left">
                        <span>&ldquo; Phiên Bản Giới Hạn</span>
                    </div>

                    <!-- Huy hiệu bay 3: Góc dưới phải -->
                    <div class="urbn-float-pill urbn-float-bottom-right">
                        <span>&ldquo; Tự Do Thể Hiện Bản Thân</span>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- ============================================================== -->
<!-- SECTION 2: 4 CAM KẾT THƯƠNG HIỆU (NỀN XÁM NHẠT)               -->
<!-- ============================================================== -->
<section class="urbn-feature-strip">
    <div class="urbn-container">
        <div class="urbn-feature-grid">

            <div class="urbn-feature-col">
                <i class="bi bi-shield-check"></i>
                <h4>Thanh Toán An Toàn</h4>
                <p>Yên tâm mua sắm — giao dịch và thông tin được bảo vệ tuyệt đối.</p>
            </div>

            <div class="urbn-feature-col">
                <i class="bi bi-truck"></i>
                <h4>Giao Hàng Siêu Tốc</h4>
                <p>Nhận đồ streetwear yêu thích tận tay nhanh chóng, đúng hẹn.</p>
            </div>

            <div class="urbn-feature-col">
                <i class="bi bi-headphones"></i>
                <h4>Hỗ Trợ 24/7</h4>
                <p>Có thắc mắc? Đội ngũ HNMTSHOP luôn sẵn sàng hỗ trợ 24/7.</p>
            </div>

            <div class="urbn-feature-col">
                <i class="bi bi-arrow-counterclockwise"></i>
                <h4>Đổi Trả Dễ Dàng</h4>
                <p>Nếu mặc không vừa vặn, đổi trả siêu tốc chỉ trong vài bước.</p>
            </div>

        </div>
    </div>
</section>

<!-- ============================================================== -->
<!-- SECTION: NEW DROPS (SẢN PHẨM MỚI RA MẮT TỪ HNMTSHOP)          -->
<!-- ============================================================== -->
<section class="hnmt-drops-section" id="newDrops">
    <div class="urbn-container">

        <div class="hnmt-drops-header">
            <div>
                <span class="hnmt-drops-eyebrow">DROP 2026 · EXCLUSIVE RELEASES</span>
                <h2 class="hnmt-drops-title">Sản Phẩm Mới Ra Mắt</h2>
                <p class="hnmt-drops-desc">Những thiết kế streetwear nguyên bản vừa cập bến — Form dáng Oversize & Boxy chuẩn gu giới trẻ</p>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="hnmt-drops-grid">
                @foreach (var p in Model)
                {
                    var productUrl = Url.Action("Details", "Products", new { id = p.Id, from = "newDrops" });
                    if (p.ShowroomAudience is "men" or "women" or "boy" or "girls"
                        && FashionStore.Data.ShowroomCatalog.HasRailListing(p))
                    {
                        productUrl = p.ShowroomKind switch
                        {
                            "giay" => Url.Action("Sneakers", "Products", new { audience = p.ShowroomAudience, searchProduct = p.Id, from = "newDrops" }),
                            "ao" or "quan" => Url.Action("Rail", "Products", new { type = p.ShowroomKind, audience = p.ShowroomAudience, searchProduct = p.Id, from = "newDrops" }),
                            _ => productUrl
                        };
                    }
                    <div class="hnmt-drop-card" data-product-id="@p.Id">
                        <a href="@productUrl" class="hnmt-drop-card-link" title="@p.Name">
                            <div class="hnmt-drop-card-media">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder.jpg" : p.ImageUrl)"
                                     alt="@p.Name"
                                     loading="lazy"
                                     decoding="async" />
                            </div>
                            <div class="hnmt-drop-card-info">
                                <h3 class="hnmt-drop-name">@p.Name</h3>
                                <span class="hnmt-drop-price">@p.Price.ToString("N0")&nbsp;₫</span>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <div class="hnmt-drops-footer">
                <a asp-controller="Products" asp-action="Index" class="hnmt-drops-btn-more">
                    Xem Tất Cả Sản Phẩm &#x2197;
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">Các mẫu Drop mới đang được cập nhật. Vui lòng quay lại sau.</p>
            </div>
        }

    </div>
</section>

<!-- ============================================================== -->
<!-- SECTION 3: DANH MỤC (4 MẪU ĐỨNG + NÚT VIÊN THUỐC TRẮNG)       -->
<!-- ============================================================== -->
<section class="urbn-cat-section" id="categories">
    <div class="urbn-container">

        <div class="urbn-center-heading">
            <h2>Danh Mục Nổi Bật</h2>
            <p>Từ trang phục thiết yếu hằng ngày đến những món đồ tạo điểm nhấn — Tìm phong cách của bạn.</p>
        </div>

        <div class="urbn-cat-grid">

            <!-- Card 1: WOMEN -->
            <a asp-controller="Products" asp-action="Index" asp-route-keyword="Women" class="urbn-cat-card" data-open-chile-portal data-category-title="Women">
                <img src="/images/categories/cat-women.jpg"
                     alt="Women" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Women</span>
                </div>
            </a>

            <!-- Card 2: GIRLS -->
            <a asp-controller="Products" asp-action="Index" asp-route-keyword="Girls" class="urbn-cat-card" data-open-chile-portal data-category-title="Girls">
                <img src="/images/categories/cat-girls.jpg"
                     alt="Girls" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Girls</span>
                </div>
            </a>

            <!-- Card 3: MEN -->
            <a asp-controller="Products" asp-action="Index" asp-route-keyword="Men" class="urbn-cat-card" data-open-chile-portal data-category-title="Men">
                <img src="/images/categories/cat-men.jpg"
                     alt="Men" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Men</span>
                </div>
            </a>

            <!-- Card 4: BOY -->
            <a asp-controller="Products" asp-action="Index" asp-route-keyword="Boy" class="urbn-cat-card" data-open-chile-portal data-category-title="Boy">
                <img src="/images/categories/cat-boy.jpg"
                     alt="Boy" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Boy</span>
                </div>
            </a>

        </div>

    </div>
</section>

<!-- ============================================================== -->
<!-- SECTION 4: ĐỢT DROP ĐẶC BIỆT & ĐỒNG HỒ ĐẾM NGƯỢC               -->
<!-- ============================================================== -->
<partial name="_SaleOffer" model="@((ViewBag.SaleCampaign as LookbookDisplay, false))" />

<!-- ============================================================== -->
<!-- SECTION 5: DẢI BĂNG CHỮ CHẠY VÔ TẬN (MARQUEE)                  -->
<!-- ============================================================== -->
<div class="urbn-ticker-band">
    <div class="urbn-ticker-inner">
        <div class="urbn-ticker-item">
            <span class="urbn-ticker-badge"><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100" /></span>
            THIẾT KẾ CHO PHONG CÁCH HIỆN ĐẠI
        </div>
        <div class="urbn-ticker-item">
            <span class="urbn-ticker-badge"><img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100" /></span>
            HNMTSHOP STREETWEAR
        </div>
        <div class="urbn-ticker-item">
            <span class="urbn-ticker-badge"><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100" /></span>
            PHIÊN BẢN GIỚI HẠN DROP 2026
        </div>
        <div class="urbn-ticker-item">
            <span class="urbn-ticker-badge"><img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100" /></span>
            THIẾT KẾ CHO PHONG CÁCH HIỆN ĐẠI
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- SECTION 6: BỘ SƯU TẬP THEO MÙA (2 SÀO QUẦN ÁO)                -->
<!-- ============================================================== -->
<section class="urbn-seasonal-section">
    <div class="urbn-container">

        <div class="urbn-center-heading">
            <h2>Bộ Sưu Tập Theo Mùa</h2>
            <p>Trải nghiệm phối đồ Head-to-Toe trong không gian Studio độc bản — Đậm chất avant-garde và tinh thần đường phố</p>
        </div>

        <div class="urbn-racks-grid">

            <!-- Sào 1: NOIR UNIT -->
            @foreach (var collection in (IEnumerable<LookbookCollection>)ViewBag.PublishedCollections)
            {
                <a asp-controller="Home" asp-action="ManagedLookbook" asp-route-id="@collection.Id" class="urbn-rack-card hnmt-lookbook-card">
                    <img src="@collection.CoverUrl" loading="lazy" decoding="async" alt="" />
                    <div class="urbn-cat-pill-wrap"><span class="urbn-cat-pill">@collection.Name</span></div>
                </a>
            }
            @if (!((IEnumerable<string?>)ViewBag.ImportedLookbookKeys).Contains("noir"))
            {
            <a href="/lookbook?theme=noir" class="urbn-rack-card hnmt-lookbook-card" data-open-lookbook="noir" style="background:#e4e5e7">
                <img src="~/images/lookbook/noir-unit-poster.webp" asp-append-version="true" loading="lazy" decoding="async" alt="" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Noir Unit</span>
                </div>
            </a>
            }

            <!-- Sào 2: SUN-WASHED -->
            @if (!((IEnumerable<string?>)ViewBag.ImportedLookbookKeys).Contains("sunwash"))
            {
            <a href="/lookbook?theme=sunwash" class="urbn-rack-card hnmt-lookbook-card" data-open-lookbook="sunwash" style="background:#ebe5d8">
                <img src="~/images/lookbook/sun-washed-poster.webp" asp-append-version="true" loading="lazy" decoding="async" alt="" />
                <div class="urbn-cat-pill-wrap">
                    <span class="urbn-cat-pill">Sun-Washed</span>
                </div>
            </a>
            }

        </div>

    </div>
</section>


<!-- MARQUEE 2: MẶC ĐẸP HƠN, TỰ TIN HƠN -->
<div class="urbn-ticker-band" style="padding: 14px 0; font-size: 14px;">
    <div class="urbn-ticker-inner" style="animation-duration: 18s;">
        <div class="urbn-ticker-item" style="font-size: 14px;">
            MẶC ĐẸP HƠN, THOẢI MÁI HƠN, TỰ TIN TRONG MỌI CHUYỂN ĐỘNG &nbsp;&bull;&nbsp; MẶC ĐẸP HƠN, THOẢI MÁI HƠN, TỰ TIN TRONG MỌI CHUYỂN ĐỘNG &nbsp;&bull;&nbsp; HNMTSHOP 2026
        </div>
        <div class="urbn-ticker-item" style="font-size: 14px;">
            MẶC ĐẸP HƠN, THOẢI MÁI HƠN, TỰ TIN TRONG MỌI CHUYỂN ĐỘNG &nbsp;&bull;&nbsp; MẶC ĐẸP HƠN, THOẢI MÁI HƠN, TỰ TIN TRONG MỌI CHUYỂN ĐỘNG &nbsp;&bull;&nbsp; HNMTSHOP 2026
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- SECTION 7: ĐÁNH GIÁ (THỜI TRANG TỰ NÓI LÊN TẤT CẢ)             -->
<!-- ============================================================== -->
<section class="urbn-reviews-section" id="customer-reviews">
    <div class="urbn-container">

        @{
            var customerReviews = ViewBag.CustomerReviews as List<FashionStore.Models.ViewModels.HomeReviewViewModel> ?? [];
        }

        <div class="urbn-reviews-top">
            <div>
                <h2 style="font-size: 38px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 8px;">
                    Thời Trang Tự Nói Lên Tất Cả
                </h2>
                <p style="font-size: 14.5px; color: #4B5563; max-width: 600px;">
                    Khám phá phong cách vượt lên trên mọi xu hướng — Những thiết kế giúp bạn bộc lộ cá tính, nâng tầm phong cách và tạo dấu ấn ở mọi nơi bạn đến.
                </p>
            </div>
            @{
                int reviewPage = ViewBag.ReviewPage;
                int reviewPages = ViewBag.ReviewPages;
            }
            @if (reviewPages > 1)
            {
                <nav class="review-pagination" aria-label="Phân trang đánh giá">
                    @if (reviewPage > 1)
                    {
                        <a asp-action="Index" asp-route-reviewPage="@(reviewPage - 1)" asp-fragment="customer-reviews" aria-label="Trang trước"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><polyline points="14 6 8 12 14 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    }
                    else
                    {
                        <button type="button" disabled aria-label="Trang trước"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><polyline points="14 6 8 12 14 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                    }
                    @if (reviewPage < reviewPages)
                    {
                        <a asp-action="Index" asp-route-reviewPage="@(reviewPage + 1)" asp-fragment="customer-reviews" aria-label="Trang sau"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><polyline points="10 6 16 12 10 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    }
                    else
                    {
                        <button type="button" disabled aria-label="Trang sau"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><polyline points="10 6 16 12 10 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                    }
                </nav>
            }
        </div>

        @if (customerReviews.Count > 0)
        {
            <div class="urbn-reviews-grid">
                @foreach (var review in customerReviews)
                {
                    <partial name="_ReviewCard" model="review" />
                }
            </div>
        }
        else
        {
            <div class="urbn-reviews-empty">
                <p>Chưa có đánh giá nào từ khách hàng. Hãy trải nghiệm sản phẩm và chia sẻ cảm nhận thực tế của bạn cùng HNMTSHOP!</p>
                <a asp-controller="Products" asp-action="Index" class="urbn-btn-see-all">
                    Khám Phá Sản Phẩm &#x2197;
                </a>
            </div>
        }

    </div>
</section>
<script>
(() => {
    const section = document.getElementById('customer-reviews');
    let loading = false;
    section.addEventListener('click', async event => {
        const link = event.target.closest('.review-pagination a');
        if (!link || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (loading) return;
        loading = true;
        try {
            const response = await fetch(link.href);
            if (!response.ok) throw new Error('Review page unavailable');
            const next = new DOMParser().parseFromString(await response.text(), 'text/html').getElementById(section.id);
            if (!next) throw new Error('Reviews unavailable');
            section.replaceChildren(...next.children);
            history.replaceState(history.state, '', link.href);
            const grid = section.querySelector('.urbn-reviews-grid');
            if (grid && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
                grid.animate([{ opacity: 0, transform: 'translateX(' + (link.getAttribute('aria-label') === 'Trang sau' ? 24 : -24) + 'px)' }, { opacity: 1, transform: 'translateX(0)' }], { duration: 240, easing: 'ease-out' });
            }
        } catch {
            location.assign(link.href);
        } finally {
            loading = false;
        }
    });
})();
</script>


