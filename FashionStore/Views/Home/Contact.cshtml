@model FashionStore.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Liên Hệ & Hỗ Trợ Khách Hàng";
}

<div class="contact-page-wrapper">
    <!-- HERO HEADER -->
    <section class="contact-hero">
        <div class="contact-container">
            <span class="contact-eyebrow">FASHIONSTORE · CUSTOMER CARE</span>
            <h1 class="contact-title">CHÚNG TÔI LUÔN Ở ĐÂY<br /><em>ĐỂ LẮNG NGHE BẠN</em></h1>
            <p class="contact-subtitle">
                Mọi thắc mắc về sản phẩm, tư vấn size, đơn hàng hoặc ý kiến đóng góp, xin vui lòng gửi tin nhắn. Đội ngũ FashionStore sẽ hỗ trợ bạn sớm nhất!
            </p>
        </div>
    </section>

    <div class="contact-container">
        <!-- SUCCESS ALERT -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-alert success">
                <i class="bi bi-check-circle-fill"></i>
                <div>
                    <strong>Thành công!</strong> @TempData["SuccessMessage"]
                </div>
            </div>
        }

        <div class="contact-grid">
            <!-- LEFT: FORM -->
            <div class="contact-card contact-form-card">
                <div class="contact-card-header">
                    <span class="badge-tag">GỬI YÊU CẦU</span>
                    <h2>Liên hệ trực tuyến</h2>
                    <p>Điền đầy đủ thông tin bên dưới để chúng tôi có thể liên hệ lại nhanh nhất.</p>
                </div>

                <form asp-action="Contact" method="post" id="contactForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger contact-val-summary"></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="FullName">Họ và tên <span class="required">*</span></label>
                            <input asp-for="FullName" class="form-control-custom" placeholder="Ví dụ: Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PhoneNumber">Số điện thoại <span class="required">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control-custom" placeholder="0988776655" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Địa chỉ Email <span class="required">*</span></label>
                        <input asp-for="Email" class="form-control-custom" placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Subject">Chủ đề hỗ trợ <span class="required">*</span></label>
                            <select asp-for="Subject" class="form-control-custom">
                                <option value="">-- Chọn chủ đề liên hệ --</option>
                                <option value="Tư vấn sản phẩm & Chọn size">Tư vấn sản phẩm & Chọn size</option>
                                <option value="Hỏi về tiến độ đơn hàng">Hỏi về tiến độ đơn hàng</option>
                                <option value="Yêu cầu đổi size / Đổi trả hàng">Yêu cầu đổi size / Đổi trả hàng</option>
                                <option value="Thắc mắc thanh toán & Hoàn tiền">Thắc mắc thanh toán & Hoàn tiền</option>
                                <option value="Khiếu nại dịch vụ">Khiếu nại dịch vụ</option>
                                <option value="Hợp tác kinh doanh">Hợp tác kinh doanh</option>
                                <option value="Chủ đề khác">Chủ đề khác</option>
                            </select>
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrderCode">Mã đơn hàng <em>(nếu có)</em></label>
                            <input asp-for="OrderCode" class="form-control-custom" placeholder="Ví dụ: FS-84920" />
                            <span asp-validation-for="OrderCode" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message">Nội dung tin nhắn <span class="required">*</span></label>
                        <textarea asp-for="Message" rows="5" class="form-control-custom" placeholder="Mô tả chi tiết câu hỏi hoặc yêu cầu cần hỗ trợ..."></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <button type="submit" class="contact-submit-btn">
                        <span>GỬI YÊU CẦU NGAY</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- RIGHT: INFO & MAP -->
            <div class="contact-info-col" id="stores">
                <div class="contact-card contact-info-card">
                    <div class="contact-card-header">
                        <span class="badge-tag">HỆ THỐNG CỬA HÀNG</span>
                        <h2>Thông tin hỗ trợ</h2>
                        <p>Bạn cũng có thể ghé thăm trực tiếp hoặc liên hệ trực tiếp qua hotline.</p>
                    </div>

                    <div class="info-list">
                        <div class="info-item">
                            <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div class="info-text">
                                <h6>Địa chỉ Showroom</h6>
                                <p>123 Đường Thời Trang, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon"><i class="bi bi-telephone-fill"></i></div>
                            <div class="info-text">
                                <h6>Hotline CSKH & Mua hàng</h6>
                                <p><strong>+84 988 776 655</strong> (8:30 - 21:30 hàng ngày)</p>
                                <small class="text-muted">Hotline khiếu nại: +84 901 234 567</small>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                            <div class="info-text">
                                <h6>Hộp thư điện tử</h6>
                                <p>hotro@fashionstore.vn</p>
                                <p>cskh@hnmtshop.vn</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon"><i class="bi bi-clock-fill"></i></div>
                            <div class="info-text">
                                <h6>Thời gian làm việc</h6>
                                <p>Thứ Hai – Chủ Nhật: 08:30 – 21:30</p>
                                <small class="text-muted">(Phục vụ cả ngày lễ & Tết)</small>
                            </div>
                        </div>
                    </div>

                    <!-- MAP EMBED -->
                    <div class="contact-map">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.460233486392!2d106.70248881471842!3d10.776019392321852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f447781b491%3A0x7d6a52140bbd0c88!2zQuG6v24gTmdow6ksIFF14bqtbiAxLCBUaMOgbmggcGjhu5EgSOG7kyBDaMOtIE1pbmgsIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1680000000000!5m2!1svi!2s" 
                            width="100%" 
                            height="220" 
                            style="border:0; border-radius: 8px;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAQ SECTION -->
        <section class="contact-faq-section" id="faq">
            <div class="faq-header">
                <span class="badge-tag">HỎI ĐÁP & CHÍNH SÁCH</span>
                <h2>Câu hỏi thường gặp & Quy định (FAQ)</h2>
                <p>Một số thông tin hữu ích giúp bạn giải đáp nhanh các thắc mắc về đơn hàng, đổi trả và bảo mật.</p>
            </div>

            <div class="faq-accordion">
                <details class="faq-item" id="faq-shipping">
                    <summary>
                        <span>1. Thời gian & chi phí giao hàng là bao lâu?</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>Đơn hàng nội thành TP.HCM và Hà Nội thường được giao từ 1 - 2 ngày làm việc. Đối với các tỉnh thành khác, thời gian từ 2 - 4 ngày. Phí vận chuyển tiêu chuẩn toàn quốc là 30.000đ, miễn phí giao hàng cho các đơn hàng đạt điều kiện ưu đãi.</p>
                    </div>
                </details>

                <details class="faq-item" id="faq-returns">
                    <summary>
                        <span>2. Chính sách đổi size và đổi trả hàng như thế nào?</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>FashionStore hỗ trợ đổi size miễn phí trong vòng <strong>7 ngày</strong> kể từ khi bạn nhận được hàng. Sản phẩm đổi trả phải còn nguyên tem mác, hộp đựng (nếu có giày/phụ kiện), chưa qua giặt ủi hay sử dụng. Nếu sản phẩm giao lỗi do nhà sản xuất, cửa hàng chịu 100% phí ship 2 chiều.</p>
                    </div>
                </details>

                <details class="faq-item" id="faq-size">
                    <summary>
                        <span>3. Làm thế nào để kiểm tra size phù hợp trước khi đặt?</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>Bạn có thể sử dụng công cụ tính size tự động tại trang <a asp-controller="Home" asp-action="SizeGuide" class="text-decoration-underline text-dark fw-bold">Hướng Dẫn Chọn Size</a> hoặc gửi tin nhắn trực tiếp ở form trên để nhân viên tư vấn cụ thể theo chiều cao & cân nặng của bạn.</p>
                    </div>
                </details>

                <details class="faq-item" id="faq-cod">
                    <summary>
                        <span>4. Tôi có được kiểm tra hàng trước khi thanh toán không?</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>Khách hàng được quyền đồng kiểm ngoại quan (kiểm tra đúng mẫu, đúng size, màu sắc và số lượng) trước khi thanh toán COD cho nhân viên giao hàng (Shipper).</p>
                    </div>
                </details>

                <details class="faq-item" id="faq-terms">
                    <summary>
                        <span>5. Điều khoản dịch vụ & quy định mua hàng</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>Khi đặt hàng tại FashionStore, quý khách cam kết cung cấp đúng thông tin liên hệ và địa chỉ nhận hàng. Cửa hàng có quyền từ chối hoặc hủy các đơn hàng có dấu hiệu gian lận hoặc không liên hệ xác nhận được với người mua. Giá sản phẩm niêm yết trên website đã bao gồm thuế GTGT.</p>
                    </div>
                </details>

                <details class="faq-item" id="faq-privacy">
                    <summary>
                        <span>6. Chính sách bảo mật thông tin khách hàng</span>
                        <i class="bi bi-chevron-down"></i>
                    </summary>
                    <div class="faq-answer">
                        <p>FashionStore cam kết bảo mật tuyệt đối dữ liệu cá nhân của quý khách (họ tên, số điện thoại, địa chỉ nhận hàng, lịch sử giao dịch). Dữ liệu chỉ được sử dụng cho việc xử lý đơn hàng, chăm sóc khách hàng và không chia sẻ cho bên thứ ba vì mục đích thương mại.</p>
                    </div>
                </details>
            </div>
        </section>
    </div>
</div>

<style>
.contact-page-wrapper {
    background-color: #fafafa;
    padding-bottom: 80px;
    font-family: inherit;
    color: #111;
}

.contact-hero {
    background: #0f0f11;
    color: #fff;
    padding: 70px 20px 60px;
    text-align: center;
    margin-bottom: 50px;
}

.contact-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

    .contact-eyebrow {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: #a0a0a0;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .contact-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.5px;
        margin-bottom: 16px;
    }

.contact-title em {
    font-style: normal;
    font-weight: 400;
    color: #d1d5db;
}

    .contact-subtitle {
        font-family: 'Montserrat', sans-serif;
        max-width: 650px;
        margin: 0 auto;
        color: #9ca3af;
        font-size: 1rem;
        line-height: 1.6;
    }

.contact-alert.success {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ecfdf5;
    border: 1px solid #10b981;
    color: #065f46;
    padding: 16px 20px;
    border-radius: 8px;
    margin-bottom: 35px;
    font-size: 0.95rem;
}

.contact-alert.success i {
    font-size: 1.4rem;
    color: #10b981;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 32px;
    align-items: start;
}

.contact-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 36px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
}

.badge-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #4b5563;
    background: #f3f4f6;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
}

.contact-card-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
}

.contact-card-header p {
    color: #6b7280;
    font-size: 0.92rem;
    margin-bottom: 24px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: #1f2937;
}

.form-group .required {
    color: #ef4444;
}

.form-control-custom {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.95rem;
    background: #fafafa;
    transition: all 0.2s ease;
    color: #111;
}

.form-control-custom:focus {
    outline: none;
    border-color: #111;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
}

.contact-submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: #111827;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.contact-submit-btn:hover {
    background: #000;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 28px;
}

.info-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
}

.info-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    background: #f3f4f6;
    color: #111;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
}

.info-text h6 {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: #111;
}

.info-text p {
    font-size: 0.9rem;
    color: #4b5563;
    margin-bottom: 2px;
    line-height: 1.45;
}

.contact-map {
    margin-top: 10px;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
}

/* FAQ SECTION */
.contact-faq-section {
    margin-top: 60px;
    padding-top: 50px;
    border-top: 1px solid #e5e7eb;
}

.faq-header {
    text-align: center;
    margin-bottom: 35px;
}

.faq-header h2 {
    font-size: 1.7rem;
    font-weight: 800;
    margin-bottom: 8px;
}

.faq-header p {
    color: #6b7280;
    font-size: 0.95rem;
}

.faq-accordion {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.faq-item {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px 20px;
    cursor: pointer;
    transition: border-color 0.2s;
}

.faq-item[open] {
    border-color: #111;
}

.faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 0.98rem;
    list-style: none;
    user-select: none;
}

.faq-item summary::-webkit-details-marker {
    display: none;
}

.faq-item[open] summary i {
    transform: rotate(180deg);
}

.faq-answer {
    padding-top: 12px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #4b5563;
    border-top: 1px solid #f3f4f6;
    margin-top: 12px;
}

.faq-item.highlight-target,
.contact-card.highlight-target {
    border-color: #d97706 !important;
    box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.25) !important;
    animation: highlightPulse 2s ease-in-out;
}

@@keyframes highlightPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.015); }
    100% { transform: scale(1); }
}

@@media (max-width: 900px) {
    .contact-grid {
        grid-template-columns: 1fr;
    }
    .form-row {
        grid-template-columns: 1fr;
    }
    .contact-hero {
        padding: 50px 15px 40px;
    }
    .contact-title {
        font-size: 1.8rem;
    }
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Tự động điền chủ đề nếu có query string ?subject=...
            const urlParams = new URLSearchParams(window.location.search);
            const subjectParam = urlParams.get('subject');
            if (subjectParam) {
                const subjectSelect = document.querySelector('select[name="Subject"]');
                if (subjectSelect) {
                    for (let opt of subjectSelect.options) {
                        if (opt.value.toLowerCase().includes(subjectParam.toLowerCase()) || subjectParam.toLowerCase().includes(opt.value.toLowerCase())) {
                            opt.selected = true;
                            break;
                        }
                    }
                }
            }

            // Tự động điền nội dung nếu có query string ?message=...
            const messageParam = urlParams.get('message');
            if (messageParam) {
                const messageTextarea = document.querySelector('textarea[name="Message"]');
                if (messageTextarea && !messageTextarea.value.trim()) {
                    messageTextarea.value = messageParam;
                }
            }

            // 2. Xử lý hash nhảy tới đúng mục và mở accordion
            function handleHash() {
                const hash = window.location.hash;
                if (!hash) return;

                const targetEl = document.querySelector(hash);
                if (targetEl) {
                    // Nếu là thẻ details hoặc con của details -> mở ra
                    if (targetEl.tagName === 'DETAILS') {
                        targetEl.open = true;
                    } else {
                        const parentDetails = targetEl.closest('details');
                        if (parentDetails) parentDetails.open = true;
                    }

                    // Thêm hiệu ứng highlight
                    targetEl.classList.add('highlight-target');
                    setTimeout(() => {
                        targetEl.classList.remove('highlight-target');
                    }, 3500);

                    // Cuộn mượt tới vị trí
                    setTimeout(() => {
                        targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }, 100);
                }
            }

            // Chạy khi tải trang và khi hash thay đổi
            handleHash();
            window.addEventListener('hashchange', handleHash);
        });
    </script>
}
