@{
    ViewData["Title"] = "Bảng size";
}

<section class="sg-page">

    <!-- HERO -->
    <section class="sg-hero">
        <div class="sg-container sg-hero-row">
            <div>
                <h1>Bảng size</h1>
                <p>Nhập số đo để tìm size quần áo hoặc giày phù hợp.</p>
            </div>
            <div class="sg-hero-actions">
                <a href="#sg-clothing-chart" class="sg-reference-link">Bảng áo</a>
                <a href="#sg-pants-chart" class="sg-reference-link">Bảng quần</a>
                <a href="#sg-shoe-chart" class="sg-reference-link">Bảng giày</a>
            </div>
        </div>
    </section>

    <!-- CATEGORY TABS -->
    <section class="sg-container sg-main" id="sg-calculator" aria-labelledby="sg-calculator-title">

        <div class="sg-calculator-toolbar">
        <h2 id="sg-calculator-title">Tìm size theo số đo</h2>

        <div class="sg-tabs">
            <button type="button" class="sg-tab active"
                    data-target="clothing">
                <i class="bi bi-person-standing"></i>
                ÁO
            </button>

            <button type="button" class="sg-tab" data-target="pants">
                <i class="bi bi-rulers" aria-hidden="true"></i>
                QUẦN
            </button>

            <button type="button" class="sg-tab"
                    data-target="shoes">
                <i class="bi bi-bag"></i>
                GIÀY DÉP
            </button>
        </div>
        </div>

        <!-- CLOTHING CALCULATOR -->
        <div class="sg-panel active" id="clothing">

            <div class="sg-form-card">
                <div class="sg-form-intro">
                    <h3>Thông số cơ thể</h3>
                    <p>Nhập chiều cao và cân nặng để nhận gợi ý size áo.</p>
                </div>

                <form id="clothingForm">

                    <div class="sg-fields">
                        <div class="sg-field">
                            <label for="sgHeight">Chiều cao (cm)</label>
                            <input type="number" id="sgHeight"
                                   min="130" max="220"
                                   placeholder="Ví dụ: 170" required />
                        </div>

                        <div class="sg-field">
                            <label for="sgWeight">Cân nặng (kg)</label>
                            <input type="number" id="sgWeight"
                                   min="30" max="180"
                                   placeholder="Ví dụ: 62" required />
                        </div>
                    </div>

                    <div class="sg-field">
                        <label for="sgFit">Phong cách mặc</label>
                        <select id="sgFit">
                            <option value="regular">Regular Fit - Vừa vặn</option>
                            <option value="oversize">Oversize - Rộng thoải mái</option>
                            <option value="slim">Slim Fit - Ôm gọn</option>
                        </select>
                    </div>

                    <button type="submit" class="sg-submit">
                        <i class="bi bi-magic"></i>
                        PHÂN TÍCH SIZE CỦA TÔI
                    </button>
                </form>

                <div id="clothingResult" class="sg-result" hidden
                     aria-live="polite">
                    <span id="clothingEyebrow">YOUR RECOMMENDED SIZE</span>
                    <div class="sg-result-size" id="clothingSize">M</div>
                    <h4 id="clothingTitle">Size phù hợp với bạn</h4>
                    <p id="clothingDescription"></p>

                    <!-- CSKH SUPPORT BOX KHI SỐ ĐO KHÔNG PHÙ HỢP -->
                    <div id="clothingSupportBox" class="sg-support-box" hidden>
                        <div class="sg-support-header">
                            <div class="sg-support-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div>
                                <h5>Cần hỗ trợ riêng từ chuyên viên CSKH</h5>
                                <p>Số đo của bạn cần được tư vấn kỹ lưỡng để chọn trang phục có form dáng vừa vặn và thoải mái nhất.</p>
                            </div>
                        </div>
                        <div class="sg-support-actions">
                            <a id="clothingContactBtn" href="/contact" class="sg-support-btn sg-support-btn-primary">
                                <i class="bi bi-chat-dots-fill"></i>
                                Gửi yêu cầu tư vấn size
                            </a>
                            <a href="tel:+84988776655" class="sg-support-btn sg-support-btn-outline">
                                <i class="bi bi-telephone-fill"></i>
                                Hotline: 0988 776 655
                            </a>
                        </div>
                    </div>

                    <div class="sg-result-note" id="clothingNote">
                        <i class="bi bi-info-circle"></i>
                        Đây là kích cỡ tham khảo. Hãy đối chiếu bảng số đo
                        riêng của sản phẩm trước khi đặt hàng.
                    </div>
                </div>
            </div>

            <div class="sg-side-note">
                <div class="sg-note-icon">
                    <i class="bi bi-rulers"></i>
                </div>
                <h3>Mẹo chọn size</h3>
                <p>
                    Nếu bạn nằm giữa hai size, hãy cân nhắc chọn size lớn hơn
                    nếu thích mặc rộng hoặc size nhỏ hơn nếu thích mặc gọn.
                </p>
                <div class="sg-note-divider"></div>
                <p><strong>01.</strong> Đo chiều cao khi đứng thẳng.</p>
                <p><strong>02.</strong> Cân vào cùng một thời điểm trong ngày.</p>
                <p><strong>03.</strong> Kiểm tra số đo riêng của từng sản phẩm.</p>
            </div>

        </div>

        <div class="sg-panel" id="pants">
            <div class="sg-form-card">
                <div class="sg-form-intro">
                    <h3>Vòng eo quần</h3>
                    <p>Nhập số đo và đo vòng eo tại vị trí bạn thường mặc cạp quần.</p>
                </div>
                <form id="pantsForm">
                    <div class="sg-fields">
                        <div class="sg-field">
                            <label for="sgPantsHeight">Chiều cao (cm)</label>
                            <input type="number" id="sgPantsHeight" min="130" max="220" inputmode="numeric" placeholder="Ví dụ: 170" required />
                        </div>
                        <div class="sg-field">
                            <label for="sgPantsWeight">Cân nặng (kg)</label>
                            <input type="number" id="sgPantsWeight" min="30" max="180" step="0.1" inputmode="decimal" placeholder="Ví dụ: 62" required />
                        </div>
                    </div>
                    <div class="sg-field">
                        <label for="sgWaist">Vòng eo (inch)</label>
                        <input type="number" id="sgWaist" inputmode="decimal" min="20" max="65" step="0.1" placeholder="Ví dụ: 30.5" required />
                    </div>
                    <button type="submit" class="sg-submit">Gợi ý size quần</button>
                </form>
                <div id="pantsResult" class="sg-result" hidden aria-live="polite">
                    <div class="sg-result-size" id="pantsSize"></div>
                    <p id="pantsDescription"></p>
                </div>
            </div>
            <aside class="sg-side-note">
                <h3>Cách đọc size W</h3>
                <p>W là vòng eo danh nghĩa theo inch. Ví dụ, W30 tương ứng khoảng 30 inch (76,2 cm). Nếu đo bằng cm, chia số đo cho 2,54.</p>
                <p>Với nhãn W30/L32, L32 là chiều dài ống trong 32 inch.</p>
                <a href="#sg-pants-chart" class="sg-reference-link">Xem bảng quần</a>
            </aside>
        </div>

        <!-- SHOES CALCULATOR -->
        <div class="sg-panel" id="shoes">

            <div class="sg-form-card">
                <div class="sg-form-intro">
                    <h3>Đo chiều dài bàn chân</h3>
                    <p>Đo từ gót chân đến đầu ngón chân dài nhất.</p>
                </div>

                <form id="shoeForm">
                    <div class="sg-field">
                        <label for="sgFootLength">
                            Chiều dài bàn chân (cm)
                        </label>
                        <input type="number" id="sgFootLength"
                               min="20" max="32" step="0.1"
                               placeholder="Ví dụ: 25.5" required />
                    </div>

                    <div class="sg-measure-tip">
                        <i class="bi bi-lightbulb"></i>
                        Đo cả hai chân và sử dụng số đo của bàn chân dài hơn.
                    </div>

                    <button type="submit" class="sg-submit">
                        <i class="bi bi-magic"></i>
                        TÌM SIZE GIÀY CỦA TÔI
                    </button>
                </form>

                <div id="shoeResult" class="sg-result" hidden
                     aria-live="polite">
                    <span id="shoeEyebrow">YOUR RECOMMENDED SHOE SIZE</span>
                    <div class="sg-result-size" id="shoeSize">40</div>
                    <h4 id="shoeTitle">Size giày EU tham khảo</h4>
                    <p id="shoeDescription"></p>

                    <!-- CSKH SUPPORT BOX KHI SỐ ĐO GIÀY KHÔNG PHÙ HỢP -->
                    <div id="shoeSupportBox" class="sg-support-box" hidden>
                        <div class="sg-support-header">
                            <div class="sg-support-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div>
                                <h5>Cần hỗ trợ tư vấn size giày đặc biệt</h5>
                                <p>Số đo bàn chân của bạn nằm ngoài dải size thông thường. Hãy liên hệ CSKH để nhân viên gợi ý mẫu giày form rộng hoặc ngoại cỡ.</p>
                            </div>
                        </div>
                        <div class="sg-support-actions">
                            <a id="shoeContactBtn" href="/contact" class="sg-support-btn sg-support-btn-primary">
                                <i class="bi bi-chat-dots-fill"></i>
                                Gửi yêu cầu tư vấn size giày
                            </a>
                            <a href="tel:+84988776655" class="sg-support-btn sg-support-btn-outline">
                                <i class="bi bi-telephone-fill"></i>
                                Hotline: 0988 776 655
                            </a>
                        </div>
                    </div>

                    <div class="sg-result-note" id="shoeNote">
                        <i class="bi bi-info-circle"></i>
                        Kết quả phụ thuộc vào form giày và bảng size
                        của từng thương hiệu.
                    </div>
                </div>
            </div>

            <div class="sg-side-note">
                <div class="sg-note-icon">
                    <i class="bi bi-rulers"></i>
                </div>
                <h3>Cách đo bàn chân</h3>
                <ol>
                    <li>Đặt một tờ giấy sát tường.</li>
                    <li>Đứng lên giấy, gót chân chạm tường.</li>
                    <li>Đánh dấu đầu ngón chân dài nhất.</li>
                    <li>Đo khoảng cách từ tường đến điểm đánh dấu.</li>
                </ol>
                <div class="sg-note-divider"></div>
                <p>Thực hiện khi đứng để có số đo sát thực tế hơn.</p>
            </div>

        </div>

    </section>

    <!-- CLOTHING SIZE TABLE -->
    <section class="sg-chart-section" id="sg-clothing-chart">
        <div class="sg-container">
            <div class="sg-heading">
                <h2>Bảng size áo</h2>
                <p>Bảng tham khảo dành cho áo form phổ thông.</p>
            </div>

            <div class="sg-table-wrap" tabindex="0" role="region" aria-label="Bảng size áo">
                <table class="sg-table">
                    <thead>
                        <tr>
                            <th>SIZE</th>
                            <th>CHIỀU CAO (CM)</th>
                            <th>CÂN NẶNG (KG)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><th scope="row">XS</th><td>145 – 160</td><td>35 – 45</td></tr>
                        <tr><th scope="row">S</th><td>150 – 165</td><td>40 – 52</td></tr>
                        <tr><th scope="row">M</th><td>160 – 170</td><td>50 – 62</td></tr>
                        <tr><th scope="row">L</th><td>165 – 175</td><td>60 – 72</td></tr>
                        <tr><th scope="row">XL</th><td>170 – 185</td><td>70 – 85</td></tr>
                        <tr><th scope="row">XXL</th><td>175 – 195</td><td>80 – 100</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="sg-footnote">
                * Các khoảng số đo có thể chồng lấn. Bảng trên chỉ mang tính
                tham khảo, không thay thế số đo thực tế của từng sản phẩm.
            </p>
        </div>
    </section>

    <section class="sg-chart-section" id="sg-pants-chart">
        <div class="sg-container">
            <div class="sg-heading"><h2>Bảng size quần theo inch</h2><p>Quy đổi vòng eo danh nghĩa. Ưu tiên bảng size của mẫu quần bạn chọn.</p></div>
            <div class="sg-table-wrap" tabindex="0" role="region" aria-label="Bảng size quần theo inch">
                <table class="sg-table">
                    <thead><tr><th scope="col">Size quần</th><th scope="col">Vòng eo (inch)</th><th scope="col">Vòng eo (cm)</th></tr></thead>
                    <tbody>
                    @for (var waist = 24; waist <= 44; waist += 2)
                    {
                        <tr><th scope="row">W@waist</th><td>@waist</td><td>@((waist * 2.54m).ToString("N1", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- SHOE SIZE TABLE -->
    <section class="sg-chart-section sg-shoe-chart" id="sg-shoe-chart">
        <div class="sg-container">
            <div class="sg-heading">
                <h2>Bảng quy đổi size giày</h2>
                <p>Chiều dài bàn chân và size EU tham khảo.</p>
            </div>

            <div class="sg-table-wrap" tabindex="0" role="region" aria-label="Bảng quy đổi size giày">
                <table class="sg-table">
                    <thead>
                        <tr>
                            <th>EU SIZE</th>
                            <th>CHIỀU DÀI BÀN CHÂN (CM)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><th scope="row">36</th><td>22.5 – 23.0</td></tr>
                        <tr><th scope="row">37</th><td>23.1 – 23.5</td></tr>
                        <tr><th scope="row">38</th><td>23.6 – 24.0</td></tr>
                        <tr><th scope="row">39</th><td>24.1 – 24.5</td></tr>
                        <tr><th scope="row">40</th><td>24.6 – 25.0</td></tr>
                        <tr><th scope="row">41</th><td>25.1 – 26.0</td></tr>
                        <tr><th scope="row">42</th><td>26.1 – 26.5</td></tr>
                        <tr><th scope="row">43</th><td>26.6 – 27.0</td></tr>
                        <tr><th scope="row">44</th><td>27.1 – 28.0</td></tr>
                        <tr><th scope="row">45</th><td>28.1 – 28.5</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="sg-footnote">
                * Bảng quy đổi minh họa. Cần ưu tiên bảng size do nhà sản xuất
                từng mẫu giày cung cấp.
            </p>
        </div>
    </section>

</section>
@section Styles {
    <link rel="stylesheet"
          href="~/css/size-guide.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/size-guide.js"
            asp-append-version="true"></script>
}
