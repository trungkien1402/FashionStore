@{
    ViewData["Title"] = "Hướng Dẫn Chọn Size";
}

<section class="sg-page">

    <!-- HERO -->
    <section class="sg-hero">
        <div class="sg-container">
            <div class="sg-eyebrow">HNMTSHOP · SIZE GUIDE 2026</div>
            <h1>
                THE PERFECT FIT.<br />
                <em>YOUR OWN STYLE.</em>
            </h1>
            <p>
                Tìm kích cỡ phù hợp với cơ thể bạn.
                Mặc đẹp hơn, thoải mái hơn và tự tin trong mọi chuyển động.
            </p>

            <a href="#sg-calculator" class="sg-primary-btn">
                TÌM SIZE CỦA BẠN
                <i class="bi bi-arrow-down-right"></i>
            </a>
        </div>
    </section>

    <!-- CATEGORY TABS -->
    <section class="sg-container sg-main" id="sg-calculator">

        <div class="sg-heading">
            <span>PERSONAL SIZE ASSISTANT</span>
            <h2>Tìm kích cỡ hoàn hảo</h2>
            <p>Chọn loại sản phẩm bạn muốn được tư vấn.</p>
        </div>

        <div class="sg-tabs">
            <button type="button" class="sg-tab active"
                    data-target="clothing">
                <i class="bi bi-person-standing"></i>
                QUẦN ÁO
            </button>

            <button type="button" class="sg-tab"
                    data-target="shoes">
                <i class="bi bi-bag"></i>
                GIÀY DÉP
            </button>
        </div>

        <!-- CLOTHING CALCULATOR -->
        <div class="sg-panel active" id="clothing">

            <div class="sg-form-card">
                <div class="sg-form-intro">
                    <span>01 / APPAREL</span>
                    <h3>Thông số cơ thể</h3>
                    <p>Nhập chiều cao và cân nặng để nhận gợi ý size quần áo.</p>
                </div>

                <form id="clothingForm">

                    <div class="sg-fields">
                        <div class="sg-field">
                            <label for="sgHeight">Chiều cao (cm)</label>
                            <input type="number" id="sgHeight"
                                   min="130" max="220"
                                   placeholder="Ví dụ: 170" required />
                        </div>

                        <div class="sg-field">
                            <label for="sgWeight">Cân nặng (kg)</label>
                            <input type="number" id="sgWeight"
                                   min="30" max="180"
                                   placeholder="Ví dụ: 62" required />
                        </div>
                    </div>

                    <div class="sg-field">
                        <label for="sgFit">Phong cách mặc</label>
                        <select id="sgFit">
                            <option value="regular">Regular Fit - Vừa vặn</option>
                            <option value="oversize">Oversize - Rộng thoải mái</option>
                            <option value="slim">Slim Fit - Ôm gọn</option>
                        </select>
                    </div>

                    <button type="submit" class="sg-submit">
                        <i class="bi bi-magic"></i>
                        PHÂN TÍCH SIZE CỦA TÔI
                    </button>
                </form>

                <div id="clothingResult" class="sg-result" hidden
                     aria-live="polite">
                    <span id="clothingEyebrow">YOUR RECOMMENDED SIZE</span>
                    <div class="sg-result-size" id="clothingSize">M</div>
                    <h4 id="clothingTitle">Size phù hợp với bạn</h4>
                    <p id="clothingDescription"></p>

                    <!-- CSKH SUPPORT BOX KHI SỐ ĐO KHÔNG PHÙ HỢP -->
                    <div id="clothingSupportBox" class="sg-support-box" hidden>
                        <div class="sg-support-header">
                            <div class="sg-support-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div>
                                <h5>Cần hỗ trợ riêng từ chuyên viên CSKH</h5>
                                <p>Số đo của bạn cần được tư vấn kỹ lưỡng để chọn trang phục có form dáng vừa vặn và thoải mái nhất.</p>
                            </div>
                        </div>
                        <div class="sg-support-actions">
                            <a id="clothingContactBtn" href="/contact" class="sg-support-btn sg-support-btn-primary">
                                <i class="bi bi-chat-dots-fill"></i>
                                Gửi yêu cầu tư vấn size
                            </a>
                            <a href="tel:+84988776655" class="sg-support-btn sg-support-btn-outline">
                                <i class="bi bi-telephone-fill"></i>
                                Hotline: 0988 776 655
                            </a>
                        </div>
                    </div>

                    <div class="sg-result-note" id="clothingNote">
                        <i class="bi bi-info-circle"></i>
                        Đây là kích cỡ tham khảo. Hãy đối chiếu bảng số đo
                        riêng của sản phẩm trước khi đặt hàng.
                    </div>
                </div>
            </div>

            <div class="sg-side-note">
                <div class="sg-note-icon">
                    <i class="bi bi-rulers"></i>
                </div>
                <h3>Mẹo chọn size</h3>
                <p>
                    Nếu bạn nằm giữa hai size, hãy cân nhắc chọn size lớn hơn
                    nếu thích mặc rộng hoặc size nhỏ hơn nếu thích mặc gọn.
                </p>
                <div class="sg-note-divider"></div>
                <p><strong>01.</strong> Đo chiều cao khi đứng thẳng.</p>
                <p><strong>02.</strong> Cân vào cùng một thời điểm trong ngày.</p>
                <p><strong>03.</strong> Kiểm tra số đo riêng của từng sản phẩm.</p>
            </div>

        </div>

        <!-- SHOES CALCULATOR -->
        <div class="sg-panel" id="shoes">

            <div class="sg-form-card">
                <div class="sg-form-intro">
                    <span>02 / FOOTWEAR</span>
                    <h3>Đo chiều dài bàn chân</h3>
                    <p>Đo từ gót chân đến đầu ngón chân dài nhất.</p>
                </div>

                <form id="shoeForm">
                    <div class="sg-field">
                        <label for="sgFootLength">
                            Chiều dài bàn chân (cm)
                        </label>
                        <input type="number" id="sgFootLength"
                               min="20" max="32" step="0.1"
                               placeholder="Ví dụ: 25.5" required />
                    </div>

                    <div class="sg-measure-tip">
                        <i class="bi bi-lightbulb"></i>
                        Đo cả hai chân và sử dụng số đo của bàn chân dài hơn.
                    </div>

                    <button type="submit" class="sg-submit">
                        <i class="bi bi-magic"></i>
                        TÌM SIZE GIÀY CỦA TÔI
                    </button>
                </form>

                <div id="shoeResult" class="sg-result" hidden
                     aria-live="polite">
                    <span id="shoeEyebrow">YOUR RECOMMENDED SHOE SIZE</span>
                    <div class="sg-result-size" id="shoeSize">40</div>
                    <h4 id="shoeTitle">Size giày EU tham khảo</h4>
                    <p id="shoeDescription"></p>

                    <!-- CSKH SUPPORT BOX KHI SỐ ĐO GIÀY KHÔNG PHÙ HỢP -->
                    <div id="shoeSupportBox" class="sg-support-box" hidden>
                        <div class="sg-support-header">
                            <div class="sg-support-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div>
                                <h5>Cần hỗ trợ tư vấn size giày đặc biệt</h5>
                                <p>Số đo bàn chân của bạn nằm ngoài dải size thông thường. Hãy liên hệ CSKH để nhân viên gợi ý mẫu giày form rộng hoặc ngoại cỡ.</p>
                            </div>
                        </div>
                        <div class="sg-support-actions">
                            <a id="shoeContactBtn" href="/contact" class="sg-support-btn sg-support-btn-primary">
                                <i class="bi bi-chat-dots-fill"></i>
                                Gửi yêu cầu tư vấn size giày
                            </a>
                            <a href="tel:+84988776655" class="sg-support-btn sg-support-btn-outline">
                                <i class="bi bi-telephone-fill"></i>
                                Hotline: 0988 776 655
                            </a>
                        </div>
                    </div>

                    <div class="sg-result-note" id="shoeNote">
                        <i class="bi bi-info-circle"></i>
                        Kết quả phụ thuộc vào form giày và bảng size
                        của từng thương hiệu.
                    </div>
                </div>
            </div>

            <div class="sg-side-note">
                <div class="sg-note-icon">
                    <i class="bi bi-rulers"></i>
                </div>
                <h3>Cách đo bàn chân</h3>
                <ol>
                    <li>Đặt một tờ giấy sát tường.</li>
                    <li>Đứng lên giấy, gót chân chạm tường.</li>
                    <li>Đánh dấu đầu ngón chân dài nhất.</li>
                    <li>Đo khoảng cách từ tường đến điểm đánh dấu.</li>
                </ol>
                <div class="sg-note-divider"></div>
                <p>Thực hiện khi đứng để có số đo sát thực tế hơn.</p>
            </div>

        </div>

    </section>

    <!-- CLOTHING SIZE TABLE -->
    <section class="sg-chart-section">
        <div class="sg-container">
            <div class="sg-heading">
                <span>SIZE REFERENCE</span>
                <h2>Bảng size quần áo</h2>
                <p>Bảng tham khảo dành cho trang phục form phổ thông.</p>
            </div>

            <div class="sg-table-wrap">
                <table class="sg-table">
                    <thead>
                        <tr>
                            <th>SIZE</th>
                            <th>CHIỀU CAO (CM)</th>
                            <th>CÂN NẶNG (KG)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>XS</td><td>145 – 160</td><td>35 – 45</td></tr>
                        <tr><td>S</td><td>150 – 165</td><td>40 – 52</td></tr>
                        <tr><td>M</td><td>160 – 170</td><td>50 – 62</td></tr>
                        <tr><td>L</td><td>165 – 175</td><td>60 – 72</td></tr>
                        <tr><td>XL</td><td>170 – 185</td><td>70 – 85</td></tr>
                        <tr><td>XXL</td><td>175 – 195</td><td>80 – 100</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="sg-footnote">
                * Các khoảng số đo có thể chồng lấn. Bảng trên chỉ mang tính
                tham khảo, không thay thế số đo thực tế của từng sản phẩm.
            </p>
        </div>
    </section>

    <!-- SHOE SIZE TABLE -->
    <section class="sg-chart-section sg-shoe-chart">
        <div class="sg-container">
            <div class="sg-heading">
                <span>FOOTWEAR REFERENCE</span>
                <h2>Bảng quy đổi size giày</h2>
                <p>Chiều dài bàn chân và size EU tham khảo.</p>
            </div>

            <div class="sg-table-wrap">
                <table class="sg-table">
                    <thead>
                        <tr>
                            <th>EU SIZE</th>
                            <th>CHIỀU DÀI BÀN CHÂN (CM)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>36</td><td>22.5 – 23.0</td></tr>
                        <tr><td>37</td><td>23.1 – 23.5</td></tr>
                        <tr><td>38</td><td>23.6 – 24.0</td></tr>
                        <tr><td>39</td><td>24.1 – 24.5</td></tr>
                        <tr><td>40</td><td>24.6 – 25.0</td></tr>
                        <tr><td>41</td><td>25.1 – 26.0</td></tr>
                        <tr><td>42</td><td>26.1 – 26.5</td></tr>
                        <tr><td>43</td><td>26.6 – 27.0</td></tr>
                        <tr><td>44</td><td>27.1 – 28.0</td></tr>
                        <tr><td>45</td><td>28.1 – 28.5</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="sg-footnote">
                * Bảng quy đổi minh họa. Cần ưu tiên bảng size do nhà sản xuất
                từng mẫu giày cung cấp.
            </p>
        </div>
    </section>

</section>
@section Styles {
    <link rel="stylesheet"
          href="~/css/size-guide.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/size-guide.js"
            asp-append-version="true"></script>
}