@model List<FashionStore.Models.Entities.Shipment>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Điều phối Vận chuyển";
    var selectedStatus = ViewBag.SelectedStatus as ShipmentStatus?;
    var search = ViewBag.Search as string;

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };
}

<header class="adm-dashboard-header mb-4">
    <div><h1>Vận chuyển</h1><p class="adm-dashboard-period">@ViewBag.Count vận đơn</p></div>
    <a asp-controller="AdminOrders" asp-action="Index" class="adm-btn-outline">Xem đơn hàng</a>
</header>

<!-- STATUS TABS -->
<div class="adm-tabs">
    <a asp-action="Index" class="adm-tab-item @(selectedStatus == null ? "active" : "")">
        Tất cả vận đơn (@ViewBag.Count)
    </a>
    <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Assigned)" 
       class="adm-tab-item @(selectedStatus == ShipmentStatus.Assigned ? "active" : "")">
        Chờ lấy hàng
    </a>
    <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.InTransit)" 
       class="adm-tab-item @(selectedStatus == ShipmentStatus.InTransit ? "active" : "")">
        <i class="bi bi-truck me-1" style="color: var(--adm-cyan);"></i> Đang giao
    </a>
    <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Delivered)" 
       class="adm-tab-item @(selectedStatus == ShipmentStatus.Delivered ? "active" : "")">
        <i class="bi bi-check-circle me-1" style="color: var(--adm-emerald);"></i> Giao thành công
    </a>
    <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Failed)" 
       class="adm-tab-item @(selectedStatus == ShipmentStatus.Failed ? "active" : "")">
        <i class="bi bi-x-circle me-1" style="color: var(--adm-crimson);"></i> Giao thất bại
    </a>
    <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Returned)" 
       class="adm-tab-item @(selectedStatus == ShipmentStatus.Returned ? "active" : "")">
        <i class="bi bi-arrow-return-left me-1" style="color: var(--adm-ink-muted);"></i> Đã hoàn kho
    </a>
</div>

<!-- FILTER BAR -->
<div class="adm-filter-bar mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" maxlength="100" aria-label="Tìm vận đơn" value="@search"
                       class="form-control" 
                       placeholder="Tìm mã vận đơn, mã đơn, tên shipper, SĐT..." />
            </div>
        </div>

        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái vận chuyển</option>
                @foreach (ShipmentStatus st in Enum.GetValues(typeof(ShipmentStatus)))
                {
                    <option value="@((int)st)" selected="@(selectedStatus == st)">@GetShipmentStatusName(st)</option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn adm-btn-atelier flex-grow-1 justify-content-center">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            <a asp-action="Index" class="btn adm-btn-outline" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- SHIPMENTS TABLE -->
@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-truck fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Chưa có vận đơn nào phù hợp</h5>
        <p class="text-muted small">Hãy chuyển sang danh sách Đơn hàng để tạo lượt phân công giao hàng cho Shipper.</p>
        <a asp-controller="AdminOrders" asp-action="Index" class="btn adm-btn-atelier mt-2">
            <i class="bi bi-receipt me-1"></i> Xem danh sách đơn cần giao
        </a>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">MÃ VẬN ĐƠN</th>
                        <th>ĐƠN HÀNG</th>
                        <th>SHIPPER PHỤ TRÁCH</th>
                        <th>TIỀN THU (COD)</th>
                        <th>TRẠNG THÁI</th>
                        <th>NGÀY TẠO</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sh in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="font-monospace fw-bold" style="color: var(--adm-cyan); font-size: 0.88rem;">@sh.TrackingCode</span>
                                    <button type="button" class="btn btn-sm p-0 text-muted" onclick="copyAdmText(this, '@sh.TrackingCode')" title="Sao chép mã vận đơn">
                                        <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@sh.OrderId" 
                                   class="font-monospace fw-semibold text-decoration-none adm-heading" title="Xem chi tiết đơn hàng">
                                    @sh.Order?.OrderCode
                                </a>
                                <div class="text-muted small">@sh.Order?.ReceiverName</div>
                            </td>
                            <td>
                                <div class="fw-bold adm-heading">@(sh.Shipper?.FullName ?? "Chưa phân công")</div>
                                <div class="text-muted small font-monospace">@(sh.Shipper?.PhoneNumber ?? "")</div>
                            </td>
                            <td>
                                @if (sh.CODAmount > 0)
                                {
                                    <div class="fw-bold text-danger">@sh.CODAmount.ToString("N0") ₫</div>
                                    <span class="badge" style="background: rgba(225, 29, 72, 0.1); color: #be123c; font-size: 0.68rem;">Thu tiền mặt</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-success">0 ₫</span>
                                    <div class="text-muted" style="font-size: 0.72rem;">Đã thanh toán trước</div>
                                }
                            </td>
                            <td>
                                @switch (sh.Status)
                                {
                                    case ShipmentStatus.Assigned:
                                        <span class="adm-pill adm-pill-faint">Đã giao Shipper</span>
                                        break;
                                    case ShipmentStatus.PickedUp:
                                    case ShipmentStatus.InTransit:
                                        <span class="adm-pill adm-pill-blue">Đang giao hàng</span>
                                        break;
                                    case ShipmentStatus.Delivered:
                                        <span class="adm-pill adm-pill-emerald">Giao thành công</span>
                                        break;
                                    case ShipmentStatus.Failed:
                                    case ShipmentStatus.Returned:
                                        <span class="adm-pill adm-pill-rose">Thất bại / Hoàn</span>
                                        break;
                                    default:
                                        <span class="adm-pill adm-pill-faint">@sh.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="adm-text-contrast small">@sh.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@sh.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@sh.Id"
                                   class="btn btn-sm adm-btn-outline py-1 px-3" style="font-size: 0.78rem;" title="Xem chi tiết vận đơn">
                                    Chi tiết <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


@if (ViewBag.PageCount > 1)
{
    var current = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3" aria-label="Phân trang vận đơn">
        @if (current > 1) { <a asp-action="Index" asp-route-page="@(current - 1)" asp-route-search="@search" asp-route-status="@selectedStatus" class="adm-btn-outline">Trang trước</a> }
        <span>Trang @current / @ViewBag.PageCount</span>
        @if (current < ViewBag.PageCount) { <a asp-action="Index" asp-route-page="@(current + 1)" asp-route-search="@search" asp-route-status="@selectedStatus" class="adm-btn-outline">Trang sau</a> }
    </nav>
}
