@model List<FashionStore.Models.Entities.Shipment>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Điều phối Vận chuyển";
    var selectedStatus = ViewBag.SelectedStatus as ShipmentStatus?;
    var search = ViewBag.Search as string;

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };
}

<!-- 1. EXECUTIVE HEADER (ATELIER STANDARD) -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@ViewBag.Count vận đơn</span>
            </div>
            <h1 class="adm-title-main">Điều phối Vận chuyển</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="AdminOrders" asp-action="Index" class="adm-action-btn adm-btn-secondary" title="Xem danh sách đơn hàng">
                <i class="bi bi-receipt"></i> <span>Xem đơn hàng</span>
            </a>
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" title="Làm mới danh sách">
                <i class="bi bi-arrow-clockwise"></i> <span>Làm mới</span>
            </a>
        </div>
    </div>

    <!-- TIER 1: SEGMENTED CONTROLS -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="adm-segmented-control" role="group" aria-label="Lọc trạng thái vận đơn">
            <a asp-action="Index" asp-route-search="@search"
               class="adm-segment @(selectedStatus == null ? "active" : "")">Tất cả</a>
            <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Assigned)" asp-route-search="@search"
               class="adm-segment @(selectedStatus == ShipmentStatus.Assigned ? "active" : "")">Chờ lấy hàng</a>
            <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.InTransit)" asp-route-search="@search"
               class="adm-segment @(selectedStatus == ShipmentStatus.InTransit ? "active" : "")">Đang giao</a>
            <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Delivered)" asp-route-search="@search"
               class="adm-segment @(selectedStatus == ShipmentStatus.Delivered ? "active" : "")">Giao thành công</a>
            <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Failed)" asp-route-search="@search"
               class="adm-segment @(selectedStatus == ShipmentStatus.Failed ? "active" : "")">Giao thất bại</a>
            <a asp-action="Index" asp-route-status="@((int)ShipmentStatus.Returned)" asp-route-search="@search"
               class="adm-segment @(selectedStatus == ShipmentStatus.Returned ? "active" : "")">Đã hoàn kho</a>
        </div>
    </div>

    <!-- TIER 2: SEARCH INPUT & CONTROLS -->
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2">
        @if (selectedStatus.HasValue)
        {
            <input type="hidden" name="status" value="@((int)selectedStatus.Value)" />
        }

        <div class="adm-search-input-group-v2 flex-grow-1" style="min-width: 260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="search" maxlength="100" value="@search"
                   placeholder="Tìm kiếm theo mã vận đơn, mã đơn, tên Shipper, SĐT..."
                   class="adm-search-input-v2"
                   style="padding-left: 42px !important; padding-right: 14px !important;" />
        </div>

        <select name="status" class="form-select adm-input-dark" style="height: 38px; font-size: 0.85rem; width: auto; min-width: 200px; border-radius: 8px;" onchange="this.form.submit()">
            <option value="">Tất cả trạng thái</option>
            @foreach (ShipmentStatus st in Enum.GetValues(typeof(ShipmentStatus)))
            {
                <option value="@((int)st)" selected="@(selectedStatus == st)">@GetShipmentStatusName(st)</option>
            }
        </select>

        @if (!string.IsNullOrWhiteSpace(search) || selectedStatus.HasValue)
        {
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" style="height: 38px;" title="Xóa bộ lọc">
                <i class="bi bi-x-lg"></i> <span>Đặt lại</span>
            </a>
        }
    </form>
</div>

<!-- SHIPMENTS TABLE -->
@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-truck fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Chưa có vận đơn nào phù hợp</h5>
        <p class="text-muted small">Hãy chuyển sang danh sách Đơn hàng để tạo lượt phân công giao hàng cho Shipper.</p>
        <a asp-controller="AdminOrders" asp-action="Index" class="adm-action-btn adm-btn-primary d-inline-flex mx-auto mt-2">
            <i class="bi bi-receipt me-1"></i> Xem danh sách đơn cần giao
        </a>
    </div>
}
else
{
    <div class="adm-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">MÃ VẬN ĐƠN</th>
                        <th>ĐƠN HÀNG</th>
                        <th>SHIPPER PHỤ TRÁCH</th>
                        <th>TIỀN THU (COD)</th>
                        <th>TRẠNG THÁI</th>
                        <th>NGÀY TẠO</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sh in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="font-monospace fw-bold" style="color: var(--adm-gold, #D97706); font-size: 0.88rem;">@sh.TrackingCode</span>
                                    <button type="button" class="btn btn-sm p-0 text-muted" onclick="copyAdmText(this, '@sh.TrackingCode')" title="Sao chép mã vận đơn">
                                        <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@sh.OrderId" 
                                   class="font-monospace fw-semibold text-decoration-none adm-heading" title="Xem chi tiết đơn hàng">
                                    #@sh.Order?.OrderCode
                                </a>
                                <div class="text-muted small">@sh.Order?.ReceiverName</div>
                            </td>
                            <td>
                                <div class="fw-bold adm-heading">@(sh.Shipper?.FullName ?? "Chưa phân công")</div>
                                <div class="text-muted small font-monospace">@(sh.Shipper?.PhoneNumber ?? "")</div>
                            </td>
                            <td>
                                @if (sh.CODAmount > 0)
                                {
                                    <div class="fw-bold text-danger font-monospace">@sh.CODAmount.ToString("N0") ₫</div>
                                    <span class="badge" style="background: rgba(225, 29, 72, 0.1); color: #be123c; font-size: 0.68rem; font-weight: 600;">Thu tiền mặt</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-success font-monospace">0 ₫</span>
                                    <div class="text-muted" style="font-size: 0.72rem;">Đã thanh toán trước</div>
                                }
                            </td>
                            <td>
                                @switch (sh.Status)
                                {
                                    case ShipmentStatus.Assigned:
                                        <span class="adm-pill adm-pill-faint">Đã giao Shipper</span>
                                        break;
                                    case ShipmentStatus.PickedUp:
                                    case ShipmentStatus.InTransit:
                                        <span class="adm-pill adm-pill-blue">Đang giao hàng</span>
                                        break;
                                    case ShipmentStatus.Delivered:
                                        <span class="adm-pill adm-pill-emerald">Giao thành công</span>
                                        break;
                                    case ShipmentStatus.Failed:
                                    case ShipmentStatus.Returned:
                                        <span class="adm-pill adm-pill-rose">Thất bại / Hoàn</span>
                                        break;
                                    default:
                                        <span class="adm-pill adm-pill-faint">@sh.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="adm-text-contrast small">@sh.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@sh.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@sh.Id"
                                       class="adm-btn-table-action" title="Chi tiết vận đơn">
                                        <i class="bi bi-eye"></i> <span>Chi tiết</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (ViewBag.PageCount > 1)
{
    var current = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3 my-4" aria-label="Phân trang vận đơn">
        @if (current > 1) { 
            <a asp-action="Index" asp-route-page="@(current - 1)" asp-route-search="@search" asp-route-status="@selectedStatus" class="adm-action-btn adm-btn-secondary">
                <i class="bi bi-chevron-left me-1"></i> Trang trước
            </a> 
        }
        <span class="text-muted small fw-semibold">Trang @current / @ViewBag.PageCount</span>
        @if (current < ViewBag.PageCount) { 
            <a asp-action="Index" asp-route-page="@(current + 1)" asp-route-search="@search" asp-route-status="@selectedStatus" class="adm-action-btn adm-btn-secondary">
                Trang sau <i class="bi bi-chevron-right ms-1"></i>
            </a> 
        }
    </nav>
}
