@model FashionStore.Models.Entities.Shipment
@using FashionStore.Models.Entities
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Vận đơn " + Model.TrackingCode;
    var activeShippers = ViewBag.Shippers as List<ApplicationUser> ?? new List<ApplicationUser>();

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Đã phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };
}

<!-- HEADER -->
<div class="mb-4">
    <a asp-action="Index" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại Bảng Điều phối Giao hàng</span>
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
                    WAYBILL & TRACKING DETAILS
                </span>
                <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
                <span class="text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0 adm-heading font-monospace" style="color: var(--adm-cyan); letter-spacing: -0.01em;">@Model.TrackingCode</h2>
                <button type="button" class="btn btn-sm adm-btn-outline p-1 px-2" onclick="copyAdmText(this, '@Model.TrackingCode')" title="Sao chép mã vận đơn">
                    <i class="bi bi-copy"></i>
                </button>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="adm-btn-outline py-2 px-3">
                <i class="bi bi-receipt me-1"></i> Xem đơn hàng #@Model.Order?.OrderCode
            </a>

            <button type="button" onclick="window.print()" class="btn adm-btn-outline py-2 px-3">
                <i class="bi bi-printer"></i> In vận đơn
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN: SHIPMENT DETAILS, TIMELINE & PACKAGE -->
    <div class="col-lg-8">

        <!-- SHIPMENT SPECS -->
        <div class="adm-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 adm-heading">
                    <i class="bi bi-truck me-2" style="color: var(--adm-gold);"></i>Thông tin Giao nhận
                </h5>
                @switch (Model.Status)
                {
                    case ShipmentStatus.Assigned:
                        <span class="adm-pill adm-pill-faint">Đã phân công</span>
                        break;
                    case ShipmentStatus.PickedUp:
                    case ShipmentStatus.InTransit:
                        <span class="adm-pill adm-pill-blue">Đang giao hàng</span>
                        break;
                    case ShipmentStatus.Delivered:
                        <span class="adm-pill adm-pill-emerald">Giao thành công</span>
                        break;
                    case ShipmentStatus.Failed:
                    case ShipmentStatus.Returned:
                        <span class="adm-pill adm-pill-rose">Thất bại / Hoàn</span>
                        break;
                    default:
                        <span class="adm-pill adm-pill-faint">@Model.Status</span>
                        break;
                }
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                        <div class="text-muted small">Shipper phụ trách</div>
                        <div class="fw-bold adm-heading fs-5 mt-1">@(Model.Shipper?.FullName ?? "Chưa rõ")</div>
                        <div class="text-muted font-monospace small"><i class="bi bi-telephone me-1"></i>@(Model.Shipper?.PhoneNumber ?? "Chưa cập nhật")</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                        <div class="text-muted small">Tiền COD Shipper cần thu</div>
                        <div class="fs-4 fw-bold mt-1 @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                            @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫ (Đã thanh toán)")
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem;">Phải nộp lại quỹ sau ca giao</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="col-12">
                        <div class="p-2 px-3 rounded-2" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border); font-size: 0.85rem;">
                            <span class="text-muted">Ghi chú giao nhận ban đầu:</span>
                            <div class="adm-heading fw-medium mt-1">@Model.Note</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ITEMS IN PACKAGE -->
        @if (Model.Order?.Items != null && Model.Order.Items.Any())
        {
            <div class="adm-card mb-4 p-0 overflow-hidden">
                <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 adm-heading">
                        <i class="bi bi-box-seam me-2" style="color: var(--adm-gold);"></i>Kiện hàng (@Model.Order.Items.Count sản phẩm)
                    </h5>
                    <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                        TỔNG TRỌNG LƯỢNG / SỐ LƯỢNG: @Model.Order.Items.Sum(i => i.Quantity)
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="adm-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">SẢN PHẨM</th>
                                <th>PHÂN LOẠI</th>
                                <th>SỐ LƯỢNG</th>
                                <th class="text-end pe-4">ĐƠN GIÁ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Order.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold adm-heading">@item.ProductName</td>
                                    <td>
                                        <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                                            Size: @item.Size | @item.Color
                                        </span>
                                    </td>
                                    <td class="fw-bold adm-heading">x @item.Quantity</td>
                                    <td class="text-end pe-4 fw-bold" style="color: var(--adm-gold);">@item.UnitPrice.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- SHIPMENT HISTORY TIMELINE -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-clock-history me-2" style="color: var(--adm-gold);"></i>Nhật ký Di chuyển Vận đơn (Timeline)
            </h5>

            @{
                var historyList = Model.Histories?.ToList() ?? new List<FashionStore.Models.Entities.ShipmentHistory>();
            }

            @if (historyList.Any())
            {
                <div class="adm-timeline">
                    @for (int i = 0; i < historyList.Count; i++)
                    {
                        var h = historyList[i];
                        var isLatest = i == historyList.Count - 1;

                        <div class="adm-timeline-item">
                            <div class="adm-timeline-dot @(isLatest ? "active" : "")"></div>
                            <div class="adm-timeline-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold adm-heading small">@GetShipmentStatusName(h.NewStatus)</span>
                                    <span class="text-muted font-monospace" style="font-size: 0.72rem;">
                                        @h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="text-muted small">
                                    Ghi nhận bởi: <strong class="adm-text-contrast">@(h.ChangedByUser?.FullName ?? "Hệ thống")</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(h.Note))
                                {
                                    <div class="p-2 rounded mt-2" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border); font-size: 0.78rem;">
                                        @h.Note
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small py-3">
                    Chưa có nhật ký ghi nhận hành trình cho vận đơn này.
                </div>
            }
        </div>

    </div>

    <!-- RIGHT COLUMN: RECIPIENT & REASSIGN SHIPPER -->
    <div class="col-lg-4">

        <!-- RECIPIENT & ADDRESS -->
        <div class="adm-card mb-4">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-geo-alt me-2" style="color: var(--adm-gold);"></i>Địa chỉ Giao Hàng
            </h5>

            <div class="mb-2">
                <div class="text-muted small">Người nhận:</div>
                <div class="fw-bold adm-heading">@Model.Order?.ReceiverName</div>
            </div>

            <div class="mb-2">
                <div class="text-muted small">Số điện thoại:</div>
                <div class="font-monospace fw-semibold adm-heading">@Model.Order?.Phone</div>
            </div>

            <div class="mb-0">
                <div class="text-muted small">Địa chỉ điểm đến:</div>
                <div class="adm-text-contrast small">@Model.Order?.Address</div>
            </div>
        </div>

        <!-- REASSIGN SHIPPER FORM -->
        @if (Model.Status != ShipmentStatus.Delivered && Model.Status != ShipmentStatus.Returned)
        {
            <div class="adm-card mb-4">
                <h5 class="fw-bold mb-3 adm-heading">
                    <i class="bi bi-arrow-repeat me-2" style="color: var(--adm-gold);"></i>Điều phối lại Shipper
                </h5>

                <form asp-action="Reassign" method="post"
                      onsubmit="return confirm('Bạn có chắc muốn chuyển giao vận đơn này cho Shipper khác?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="adm-form-label">Chọn Shipper mới</label>
                        <select name="newShipperId" class="form-select adm-input-dark" required>
                            <option value="">-- Chọn nhân viên giao --</option>
                            @foreach (var s in activeShippers)
                            {
                                if (s.Id != Model.ShipperId)
                                {
                                    <option value="@s.Id">@s.FullName (@(s.PhoneNumber ?? s.UserName))</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="adm-form-label">Lý do điều phối lại</label>
                        <textarea name="note" class="form-control adm-input-dark" rows="2"
                                  placeholder="VD: Shipper cũ bận việc gấp, đổi khu vực tuyến đường..."></textarea>
                    </div>

                    <button type="submit" class="btn adm-btn-atelier w-100 py-2 justify-content-center">
                        <i class="bi bi-person-check me-1"></i> Lưu thay đổi Shipper
                    </button>
                </form>
            </div>
        }

        <!-- ORDER FINANCIAL SUMMARY -->
        <div class="adm-card">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-calculator me-2" style="color: var(--adm-gold);"></i>Tài chính Vận đơn
            </h5>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Tổng giá trị đơn:</span>
                <span class="fw-bold adm-heading">@Model.Order?.TotalAmount.ToString("N0") ₫</span>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Hình thức thanh toán:</span>
                <span class="adm-heading">@Model.Order?.PaymentMethod</span>
            </div>

            <div class="d-flex justify-content-between mb-3 small">
                <span class="text-muted">Trạng thái thanh toán:</span>
                <span class="fw-semibold @(Model.Order?.PaymentStatus == PaymentStatus.Paid ? "text-success" : "text-warning")">
                    @Model.Order?.PaymentStatus
                </span>
            </div>

            <hr class="my-2" style="border-color: var(--adm-border);" />

            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold adm-heading">TIỀN COD CẦN THU:</span>
                <span class="fs-5 fw-bold @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                    @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫")
                </span>
            </div>
        </div>

    </div>
</div>
