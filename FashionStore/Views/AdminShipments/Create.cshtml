@model FashionStore.Models.ViewModels.CreateShipmentViewModel

@{
    ViewData["Title"] = "Tạo lượt giao hàng";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase">Vận chuyển</div>
            <h2 class="fw-bold mb-0">Tạo lượt giao hàng & Phân công Shipper</h2>
            <p class="text-muted mb-0">Đơn hàng: <strong>@Model.OrderCode</strong></p>
        </div>

        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại đơn hàng
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-badge me-2"></i>Phân công Shipper
                    </h5>
                </div>

                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />
                        <input type="hidden" asp-for="OrderCode" />
                        <input type="hidden" asp-for="ReceiverName" />
                        <input type="hidden" asp-for="Phone" />
                        <input type="hidden" asp-for="Address" />
                        <input type="hidden" asp-for="CODAmount" />
                        <input type="hidden" asp-for="PaymentMethod" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ShipperId" class="form-label fw-semibold"></label>
                            @if (Model.AvailableShippers.Any())
                            {
                                <select asp-for="ShipperId" asp-items="Model.AvailableShippers" class="form-select" required>
                                    <option value="">-- Chọn nhân viên giao hàng --</option>
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-2">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Hiện chưa có tài khoản nào thuộc vai trò Shipper. Vui lòng tạo hoặc gán quyền Shipper cho nhân viên.
                                </div>
                            }
                            <span asp-validation-for="ShipperId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Note" class="form-label fw-semibold"></label>
                            <textarea asp-for="Note" class="form-control" rows="3"
                                      placeholder="Ghi chú thêm cho shipper (thời gian giao, lưu ý địa chỉ, gọi trước khi đến...)"></textarea>
                            <span asp-validation-for="Note" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold" @(!Model.AvailableShippers.Any() ? "disabled" : "")>
                            <i class="bi bi-truck me-1"></i> XÁC NHẬN PHÂN CÔNG & XUẤT VẬN ĐƠN
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle me-2"></i>Thông tin đơn hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Mã đơn hàng</small>
                        <div class="fw-bold">@Model.OrderCode</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Người nhận</small>
                        <div class="fw-semibold">@Model.ReceiverName</div>
                        <div class="text-muted small">ĐT: @Model.Phone</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Địa chỉ nhận hàng</small>
                        <div>@Model.Address</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Phương thức thanh toán</small>
                        <div>@Model.PaymentMethod</div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Tiền COD Shipper cần thu:</span>
                        <span class="fs-5 fw-bold text-danger">
                            @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " đ" : "0 đ (Đã thanh toán)")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
