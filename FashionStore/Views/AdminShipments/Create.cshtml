@model FashionStore.Models.ViewModels.CreateShipmentViewModel

@{
    ViewData["Title"] = "Tạo lượt giao hàng & Phân công Shipper";
}

<div class="mb-4">
    <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại Đơn hàng #@Model.OrderCode</span>
    </a>

    <div class="d-flex align-items-center gap-2 mb-1">
        <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
            LOGISTICS DISPATCH
        </span>
        <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
        <span class="text-muted small">NEW SHIPMENT WAYBILL</span>
    </div>
    <h2 class="fw-bold mb-0 adm-heading" style="letter-spacing: -0.02em;">Tạo Lượt Giao hàng & Xuất Vận đơn</h2>
</div>

<div class="row g-4">
    <!-- LEFT: FORM ASSIGN SHIPPER -->
    <div class="col-lg-7">
        <div class="adm-form-card">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-person-badge me-2" style="color: var(--adm-gold);"></i>Phân công Shipper Giao hàng
            </h5>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderId" />
                <input type="hidden" asp-for="OrderCode" />
                <input type="hidden" asp-for="ReceiverName" />
                <input type="hidden" asp-for="Phone" />
                <input type="hidden" asp-for="Address" />
                <input type="hidden" asp-for="CODAmount" />
                <input type="hidden" asp-for="PaymentMethod" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="ShipperId" class="adm-form-label">Chọn Nhân viên Giao hàng (Shipper) *</label>
                    @if (Model.AvailableShippers.Any())
                    {
                        <select asp-for="ShipperId" asp-items="Model.AvailableShippers" class="form-select adm-input-dark" required>
                            <option value="">-- Chọn nhân viên giao hàng phụ trách tuyến này --</option>
                        </select>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-2" style="background: rgba(217, 119, 6, 0.1); border-color: rgba(217, 119, 6, 0.3); color: #d97706;">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Hiện chưa có nhân viên nào được cấp vai trò Shipper trong hệ thống.
                        </div>
                    }
                    <span asp-validation-for="ShipperId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Note" class="adm-form-label">Ghi chú & Dặn dò Shipper</label>
                    <textarea asp-for="Note" class="form-control adm-input-dark" rows="3"
                              placeholder="Lưu ý giao hàng (ví dụ: Gọi trước khi đến 15 phút, khách nhận buổi chiều, hàng dễ vỡ...)"></textarea>
                    <span asp-validation-for="Note" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn adm-btn-atelier w-100 py-2 justify-content-center fw-bold" @(!Model.AvailableShippers.Any() ? "disabled" : "")>
                    <i class="bi bi-truck me-1"></i> XÁC NHẬN PHÂN CÔNG & XUẤT VẬN ĐƠN
                </button>
            </form>
        </div>
    </div>

    <!-- RIGHT: ORDER SUMMARY -->
    <div class="col-lg-5">
        <div class="adm-card">
            <h5 class="fw-bold mb-3 adm-heading">
                <i class="bi bi-info-circle me-2" style="color: var(--adm-gold);"></i>Tóm tắt Đơn hàng Liên kết
            </h5>

            <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <div class="text-muted small">Mã đơn hàng:</div>
                <div class="fw-bold font-monospace adm-heading fs-5">@Model.OrderCode</div>
            </div>

            <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <div class="text-muted small">Khách hàng nhận:</div>
                <div class="fw-bold adm-heading">@Model.ReceiverName</div>
                <div class="text-muted small font-monospace"><i class="bi bi-telephone me-1"></i>@Model.Phone</div>
            </div>

            <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <div class="text-muted small">Địa chỉ điểm đến:</div>
                <div class="adm-text-contrast small">@Model.Address</div>
            </div>

            <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <div class="text-muted small">Hình thức thanh toán:</div>
                <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                    @Model.PaymentMethod
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <span class="fw-bold adm-heading">TIỀN COD CẦN THU:</span>
                <span class="fs-4 fw-bold @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                    @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫ (Đã trả trước)")
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
