@{ ViewData["Title"] = "Đổi mật khẩu thành công"; }
@section Styles { <link rel="stylesheet" href="~/css/atelier-login.css" asp-append-version="true" /> }
<div class="at-login-page"><main class="at-form-container"><div class="at-login-card">
    <div class="at-card-kicker"><i class="bi bi-shield-check" aria-hidden="true"></i> HOÀN TẤT</div>
    <h1 class="at-card-title">Đã đổi mật khẩu</h1>
    <p class="at-card-desc" role="status">Mật khẩu mới đã được lưu. Bạn có thể đăng nhập lại để tiếp tục mua sắm.</p>
    <a asp-controller="Account" asp-action="Login" class="hnmt-pure-submit-btn">Đăng nhập ngay</a>
</div></main></div>
