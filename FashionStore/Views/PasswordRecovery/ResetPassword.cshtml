@model FashionStore.Models.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt mật khẩu mới"; }
@section Styles { <link rel="stylesheet" href="~/css/atelier-login.css" asp-append-version="true" /><meta name="referrer" content="no-referrer" /> }
<div class="at-login-page">
    <header class="at-topbar"><a asp-controller="Home" asp-action="Index" class="at-brand-link"><span class="at-brand-text">HNMTSHOP</span></a><a asp-controller="Account" asp-action="Login" class="at-top-back">← Đăng nhập</a></header>
    <main class="at-form-container"><div class="at-login-card at-recovery-card">
        <div class="at-card-kicker"><i class="bi bi-shield-lock" aria-hidden="true"></i> BẢO VỆ TÀI KHOẢN</div>
        <h1 class="at-card-title">Mật khẩu mới</h1>
        <p class="at-card-desc">Email đã được xác nhận bằng OTP. Đặt mật khẩu mới gồm 8–100 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
        <form asp-controller="PasswordRecovery" asp-action="ResetPassword" method="post" class="at-form">
            <div asp-validation-summary="All" class="at-alert-danger" role="alert"></div>
            <label asp-for="Password">Mật khẩu mới</label>
            <div class="hnmt-pure-input-wrap"><input asp-for="Password" class="hnmt-pure-input" autocomplete="new-password" placeholder="Nhập mật khẩu mới" maxlength="100" required /></div>
            <span asp-validation-for="Password" class="at-input-error"></span>
            <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
            <div class="hnmt-pure-input-wrap"><input asp-for="ConfirmPassword" class="hnmt-pure-input" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" maxlength="100" required /></div>
            <span asp-validation-for="ConfirmPassword" class="at-input-error"></span>
            <button type="submit" class="hnmt-pure-submit-btn">Lưu mật khẩu mới</button>
        </form>
        <div class="at-card-footer"><a asp-action="ForgotPassword" class="at-footer-link">Yêu cầu OTP mới</a></div>
    </div></main>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
