@model FashionStore.Models.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
@section Styles { <link rel="stylesheet" href="~/css/atelier-login.css" asp-append-version="true" /> }
<div class="at-login-page">
    <header class="at-topbar"><a asp-controller="Home" asp-action="Index" class="at-brand-link"><span class="at-brand-text">HNMTSHOP</span></a></header>
    <main class="at-form-container"><div class="at-login-card at-recovery-card">
        <h1 class="at-card-title">Quên mật khẩu?</h1>
        <p class="at-card-desc">Nhập email đã đăng ký để nhận mã OTP.</p>
        @if (TempData["RecoveryError"] is string error) { <div class="at-alert-danger" role="alert">@error</div> }
        <form asp-controller="PasswordRecovery" asp-action="ForgotPassword" method="post" class="at-form" data-otp-request>
            <div asp-validation-summary="ModelOnly" class="at-alert-danger" role="alert"></div>
            <label asp-for="Email">Email đăng ký</label>
            <div class="hnmt-pure-input-wrap"><input asp-for="Email" type="email" class="hnmt-pure-input" placeholder="ban@example.com" autocomplete="email" maxlength="256" required /></div>
            <span asp-validation-for="Email" class="at-input-error"></span>
            <button type="submit" class="hnmt-pure-submit-btn">Gửi mã OTP</button>
        </form>
        <div class="at-card-footer"><a asp-controller="Account" asp-action="Login" class="at-footer-link">← Quay lại đăng nhập</a></div>
    </div></main>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/password-recovery.js" asp-append-version="true"></script> }
