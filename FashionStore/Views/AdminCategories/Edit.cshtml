@model AdminCategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="mb-4">
    <a asp-action="Index" class="adm-btn-outline py-1 px-3 mb-3 d-inline-flex" style="font-size: 0.8rem;">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại Danh sách Bộ sưu tập</span>
    </a>

    <div class="d-flex align-items-center gap-2 mb-1">
        <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
            ATELIER COLLECTIONS ARCHIVE
        </span>
        <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
        <span class="text-muted small">CATEGORY EDITOR</span>
    </div>
    <h2 class="fw-bold mb-0 adm-heading" style="letter-spacing: -0.02em;">Chỉnh sửa: @Model.Name</h2>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="adm-form-card">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="adm-form-label">Tên danh mục *</label>
                    <input asp-for="Name" class="form-control adm-input-dark" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Slug" class="adm-form-label">Đường dẫn tĩnh (Slug) *</label>
                    <input asp-for="Slug" class="form-control adm-input-dark font-monospace" />
                    <span asp-validation-for="Slug" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4 pt-3 border-top border-secondary border-opacity-10">
                    <div class="form-check form-switch p-0 mb-0">
                        <label class="form-check-label fw-semibold adm-heading" for="IsActive" style="cursor: pointer;">
                            Hiển thị trên Menu & Shop
                            <div class="text-muted fw-normal" style="font-size: 0.75rem;">Cho phép khách hàng duyệt xem sản phẩm thuộc danh mục này</div>
                        </label>
                        <input asp-for="IsActive" class="form-check-input ms-3" type="checkbox" role="switch" id="IsActive" style="cursor: pointer; width: 2.5em; height: 1.3em;" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn adm-btn-atelier py-2 px-4">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn adm-btn-outline py-2 px-3">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
