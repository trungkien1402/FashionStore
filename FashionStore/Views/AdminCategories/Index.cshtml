@model List<AdminCategoryListItemViewModel>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<header class="adm-dashboard-header mb-4">
    <div><h1>Danh mục</h1><p class="adm-dashboard-period">@ViewBag.TotalCategories danh mục · @ViewBag.ActiveCategories đang bật · @ViewBag.InactiveCategories đang tắt</p></div>

    <div class="d-flex align-items-center gap-3">
        <!-- VIEW SWITCHER -->
        <div class="adm-view-switcher">
            <button type="button" class="adm-view-btn active" id="admBtnCatGrid" onclick="toggleCatView('grid')" aria-pressed="true">
                <i class="bi bi-grid-fill"></i>
                <span class="d-none d-sm-inline">Lưới ảnh</span>
            </button>
            <button type="button" class="adm-view-btn" id="admBtnCatTable" onclick="toggleCatView('table')" aria-pressed="false">
                <i class="bi bi-list-ul"></i>
                <span class="d-none d-sm-inline">Bảng chi tiết</span>
            </button>
        </div>

        <a asp-action="Create" class="adm-btn-atelier">
            <i class="bi bi-plus-lg"></i>
            <span>Thêm danh mục</span>
        </a>
    </div>
</header>

<!-- FILTER BAR -->
<div class="adm-filter-bar mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background: var(--adm-surface); border-color: var(--adm-border); color: var(--adm-ink-muted);">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="keyword" maxlength="100" aria-label="Tên hoặc slug danh mục" value="@ViewBag.Keyword"
                       class="form-control adm-input-dark border-start-0" 
                       placeholder="Tìm kiếm danh mục, slug..." />
            </div>
        </div>

        <div class="col-md-3">
            <select name="status" aria-label="Trạng thái danh mục" class="form-select adm-input-dark">
                <option value="">Tất cả trạng thái hiển thị</option>
                <option value="active" selected="@(ViewBag.Status == "active")">Đang bật</option>
                <option value="inactive" selected="@(ViewBag.Status == "inactive")">Đang tắt</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="sort" class="form-select adm-input-dark" aria-label="Sắp xếp danh mục">
                <option value="">Tên A–Z</option>
                <option value="name-desc" selected="@(ViewBag.Sort == "name-desc")">Tên Z–A</option>
                <option value="products" selected="@(ViewBag.Sort == "products")">Nhiều sản phẩm nhất</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn adm-btn-atelier py-2 px-3">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            <a asp-action="Index" class="btn adm-btn-outline py-2 px-3" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<p class="small text-muted">@ViewBag.ResultCount danh mục khớp bộ lọc</p>

@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-tags fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">@(ViewBag.TotalCategories == 0 ? "Chưa có danh mục" : "Không có danh mục khớp bộ lọc")</h5>
        <p class="text-muted small">Thử thay đổi điều kiện lọc hoặc tạo một danh mục mới.</p>
        <a asp-action="Create" class="btn adm-btn-atelier mt-2">
            <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
        </a>
    </div>
}
else
{
    <!-- 1. LOOKBOOK CARDS VIEW -->
    <div id="admCatGrid" class="adm-lookbook-grid mb-4">
        @foreach (var item in Model)
        {
            var hasImage = !string.IsNullOrWhiteSpace(item.RepresentativeImageUrl);

            <div class="adm-lookbook-card">
                <div class="adm-lookbook-banner" style="position: relative; overflow: hidden; height: 140px; @(hasImage ? "background: #121216;" : "background: linear-gradient(135deg, rgba(179, 136, 47, 0.12) 0%, rgba(2, 132, 199, 0.08) 100%);")">
                    @if (hasImage)
                    {
                        <img src="@item.RepresentativeImageUrl" alt="" loading="lazy"
                             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.82; transition: transform 0.4s ease;" 
                             onerror="this.style.display='none'" />
                        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.65) 100%);"></div>
                    }
                    else
                    {
                        <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--adm-surface); border: 1px solid var(--adm-border); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: var(--adm-gold); box-shadow: 0 4px 15px rgba(0,0,0,0.06);">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                    }

                    <div class="position-absolute top-0 end-0 m-2" style="z-index: 2;">
                        @if (item.Category.IsActive)
                        {
                            <span class="adm-pill adm-pill-emerald shadow-sm">Đang bật</span>
                        }
                        else
                        {
                            <span class="adm-pill adm-pill-faint shadow-sm">Đang tắt</span>
                        }
                    </div>

                    @if (hasImage)
                    {
                        <div class="position-absolute bottom-0 start-0 m-2 text-white" style="z-index: 2;">
                            <span class="badge" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); font-size: 0.7rem; border: 1px solid rgba(255,255,255,0.2);">
                                <i class="bi bi-image me-1"></i> Ảnh đại diện
                            </span>
                        </div>
                    }
                </div>

                <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                    <div>
                        <h5 class="fw-bold adm-heading mb-1" style="font-size: 1.05rem;">@item.Category.Name</h5>
                        <div class="font-monospace text-muted small mb-3" style="font-size: 0.75rem;">
                            @item.Category.Slug
                        </div>
                    </div>

                    <div>
                        <div class="p-2 rounded-2 mb-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                            <partial name="_ProductCounts" model="item" />
                        </div>

                        <div class="pt-2 border-top border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                            <!-- FIXED: Pass categoryId to filter by Category ID -->
                            <a asp-controller="AdminProducts" asp-action="Index" asp-route-categoryId="@item.Category.Id"
                               class="text-decoration-none small fw-semibold" style="color: var(--adm-gold);">
                                Xem sản phẩm &rarr;
                            </a>

                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Category.Id"
                                   class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem;" title="Sửa danh mục">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="ToggleActive" asp-route-id="@item.Category.Id"
                                      asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status"
                                      asp-route-sort="@ViewBag.Sort" asp-route-page="@ViewBag.Page" method="post">
                                    <input type="hidden" name="isActive" value="@((!item.Category.IsActive).ToString())" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            aria-label="@(item.Category.IsActive ? $"Tắt danh mục {item.Category.Name}" : $"Bật danh mục {item.Category.Name}")">
                                        @(item.Category.IsActive ? "Tắt" : "Bật")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 2. TABLE VIEW -->
    <div id="admCatTable" class="adm-card d-none mb-4 p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">TÊN DANH MỤC</th>
                        <th>ĐƯỜNG DẪN (SLUG)</th>
                        <th>SỐ LƯỢNG SẢN PHẨM</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 32px; height: 32px; border-radius: 6px; background: var(--adm-surface-hover); border: 1px solid var(--adm-border); display: flex; align-items: center; justify-content: center; color: var(--adm-gold);">
                                        <i class="bi bi-tag"></i>
                                    </div>
                                    <span class="fw-bold adm-heading">@item.Category.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="font-monospace text-muted small">@item.Category.Slug</span>
                            </td>
                            <td>
                                <partial name="_ProductCounts" model="item" />
                            </td>
                            <td>
                                @if (item.Category.IsActive)
                                {
                                    <span class="adm-pill adm-pill-emerald">Đang bật</span>
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill-faint">Đang tắt</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="AdminProducts" asp-action="Index" asp-route-categoryId="@item.Category.Id"
                                       class="btn btn-sm adm-btn-outline py-1 px-2" style="font-size: 0.75rem;" title="Xem sản phẩm trong danh mục">
                                        <i class="bi bi-box-seam me-1"></i> Xem SP
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Category.Id"
                                       class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.75rem;" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="ToggleActive" asp-route-id="@item.Category.Id"
                                          asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status"
                                          asp-route-sort="@ViewBag.Sort" asp-route-page="@ViewBag.Page" method="post">
                                        <input type="hidden" name="isActive" value="@((!item.Category.IsActive).ToString())" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                aria-label="@(item.Category.IsActive ? $"Tắt danh mục {item.Category.Name}" : $"Bật danh mục {item.Category.Name}")">
                                            @(item.Category.IsActive ? "Tắt" : "Bật")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (ViewBag.PageCount > 1)
{
    var currentPage = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3 mb-4" aria-label="Phân trang danh mục">
        @if (currentPage > 1)
        {
            <a asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status"
               asp-route-sort="@ViewBag.Sort" asp-route-page="@(currentPage - 1)" class="adm-btn-outline">Trang trước</a>
        }
        <span>Trang @currentPage / @ViewBag.PageCount</span>
        @if (currentPage < ViewBag.PageCount)
        {
            <a asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status"
               asp-route-sort="@ViewBag.Sort" asp-route-page="@(currentPage + 1)" class="adm-btn-outline">Trang sau</a>
        }
    </nav>
}

@section Scripts {
    <script>
        function toggleCatView(mode) {
            const grid = document.getElementById('admCatGrid');
            const table = document.getElementById('admCatTable');
            const btnG = document.getElementById('admBtnCatGrid');
            const btnT = document.getElementById('admBtnCatTable');

            if (mode === 'table') {
                if (grid) grid.classList.add('d-none');
                if (table) table.classList.remove('d-none');
                if (btnT) {
                    btnT.classList.add('active');
                    btnT.setAttribute('aria-pressed', 'true');
                }
                if (btnG) {
                    btnG.classList.remove('active');
                    btnG.setAttribute('aria-pressed', 'false');
                }
            } else {
                if (grid) grid.classList.remove('d-none');
                if (table) table.classList.add('d-none');
                if (btnG) {
                    btnG.classList.add('active');
                    btnG.setAttribute('aria-pressed', 'true');
                }
                if (btnT) {
                    btnT.classList.remove('active');
                    btnT.setAttribute('aria-pressed', 'false');
                }
            }
            localStorage.setItem('hnmt_adm_cat_view', mode);
        }

        const savedCatMode = localStorage.getItem('hnmt_adm_cat_view') || 'table';
        toggleCatView(savedCatMode);
    </script>
}
