@model List<AdminCategoryListItemViewModel>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý danh mục</h2>
            <p class="text-muted mb-0">
                Quản lý các danh mục sản phẩm của cửa hàng.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-plus-lg"></i>
            Thêm danh mục
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control"
                           placeholder="Nhập tên danh mục..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="active"
                                selected="@(ViewBag.Status == "active")">
                            Đang hiển thị
                        </option>
                        <option value="inactive"
                                selected="@(ViewBag.Status == "inactive")">
                            Đang ẩn
                        </option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px">ID</th>
                            <th>Tên danh mục</th>
                            <th>Slug</th>
                            <th class="text-center">Số sản phẩm</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    Không tìm thấy danh mục nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Category.Id</td>

                                    <td class="fw-semibold">
                                        @item.Category.Name
                                    </td>

                                    <td>
                                        <code>@item.Category.Slug</code>
                                    </td>

                                    <td class="text-center">
                                        @item.ProductCount
                                    </td>

                                    <td class="text-center">
                                        @if (item.Category.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Đang hiển thị
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Đang ẩn
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Category.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <form asp-action="ToggleActive"
                                              asp-route-id="@item.Category.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(item.Category.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    onclick="return confirm('Bạn có chắc muốn thay đổi trạng thái danh mục này?')">

                                                @(item.Category.IsActive ? "Ẩn" : "Hiện")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>