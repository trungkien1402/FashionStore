@model List<AdminCategoryListItemViewModel>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment

@{
    ViewData["Title"] = "Quản lý Danh mục";
    var currentStatus = ViewBag.Status as string;
    var currentSort = ViewBag.Sort as string;
    var currentKeyword = ViewBag.Keyword as string;
}

<style>
    .adm-cat-avatar-stack {
        display: inline-flex;
        align-items: center;
        flex-direction: row;
    }
    .adm-cat-avatar-stack img {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: 2px solid #FFFFFF;
        object-fit: cover;
        margin-left: -10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        background: #F8FAFC;
        transition: transform 0.2s ease, z-index 0.2s ease;
    }
    .adm-cat-avatar-stack img:first-child {
        margin-left: 0;
    }
    .adm-cat-avatar-stack img:hover {
        transform: translateY(-3px) scale(1.1);
        z-index: 10;
    }
    .adm-cat-card-modern {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
    }
    .adm-cat-card-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
    }
    .adm-cat-card-banner {
        height: 140px;
        position: relative;
        overflow: hidden;
        background: #0F172A;
    }
    .adm-cat-card-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .adm-cat-card-modern:hover .adm-cat-card-banner img {
        transform: scale(1.05);
    }
</style>

<!-- 1. EXECUTIVE HEADER (ATELIER STANDARD) -->
<div class="adm-header-block mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 adm-meta-crumb">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER · VẬN HÀNH</span>
                <span class="adm-meta-divider">/</span>
                <span class="adm-order-count-badge">@ViewBag.TotalCategories danh mục</span>
            </div>
            <h1 class="adm-title-main">Danh mục Sản phẩm</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- VIEW SWITCHER -->
            <div class="adm-segmented-control me-2" role="group">
                <button type="button" class="adm-segment" id="admBtnCatGrid" onclick="toggleCatView('grid')" aria-pressed="false">
                    <i class="bi bi-grid-fill me-1"></i> Lưới ảnh
                </button>
                <button type="button" class="adm-segment active" id="admBtnCatTable" onclick="toggleCatView('table')" aria-pressed="true">
                    <i class="bi bi-list-ul me-1"></i> Bảng chi tiết
                </button>
            </div>

            <a asp-action="Create" class="adm-action-btn adm-btn-primary">
                <i class="bi bi-plus-lg"></i> <span>Thêm danh mục</span>
            </a>
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" title="Làm mới">
                <i class="bi bi-arrow-clockwise"></i> <span>Làm mới</span>
            </a>
        </div>
    </div>

    <!-- TIER 1: SEGMENTED CONTROLS -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="adm-segmented-control" role="group" aria-label="Lọc trạng thái danh mục">
            <a asp-action="Index" asp-route-keyword="@currentKeyword" asp-route-sort="@currentSort"
               class="adm-segment @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">
               Tất cả (@ViewBag.TotalCategories)
            </a>
            <a asp-action="Index" asp-route-status="active" asp-route-keyword="@currentKeyword" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == "active" ? "active" : "")">
               Đang bật (@ViewBag.ActiveCategories)
            </a>
            <a asp-action="Index" asp-route-status="inactive" asp-route-keyword="@currentKeyword" asp-route-sort="@currentSort"
               class="adm-segment @(currentStatus == "inactive" ? "active" : "")">
               Đang tắt (@ViewBag.InactiveCategories)
            </a>
        </div>
    </div>

    <!-- TIER 2: SEARCH INPUT & SORTS -->
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2">
        @if (!string.IsNullOrEmpty(currentStatus))
        {
            <input type="hidden" name="status" value="@currentStatus" />
        }

        <div class="adm-search-input-group-v2 flex-grow-1" style="min-width: 260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="keyword" maxlength="100" value="@currentKeyword"
                   placeholder="Tìm kiếm danh mục theo tên hoặc đường dẫn slug..."
                   class="adm-search-input-v2"
                   style="padding-left: 42px !important; padding-right: 14px !important;" />
        </div>

        <select name="sort" class="form-select adm-input-dark" style="height: 38px; font-size: 0.85rem; width: auto; min-width: 180px; border-radius: 8px;" onchange="this.form.submit()">
            <option value="">Sắp xếp: Tên A–Z</option>
            <option value="name-desc" selected="@(currentSort == "name-desc")">Tên Z–A</option>
            <option value="products" selected="@(currentSort == "products")">Nhiều sản phẩm nhất</option>
        </select>

        @if (!string.IsNullOrWhiteSpace(currentKeyword) || !string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentSort))
        {
            <a asp-action="Index" class="adm-action-btn adm-btn-secondary" style="height: 38px;" title="Đặt lại bộ lọc">
                <i class="bi bi-x-lg"></i> <span>Đặt lại</span>
            </a>
        }
    </form>
</div>

@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-tags fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">@(ViewBag.TotalCategories == 0 ? "Chưa có danh mục nào" : "Không tìm thấy danh mục phù hợp")</h5>
        <p class="text-muted small">Thử thay đổi điều kiện lọc hoặc tạo một danh mục thời trang mới.</p>
        <a asp-action="Create" class="adm-action-btn adm-btn-primary d-inline-flex mx-auto mt-2">
            <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
        </a>
    </div>
}
else
{
    <!-- 1. TABLE VIEW (LUXURY ATELIER DIRECTORY) -->
    <div id="admCatTable" class="adm-card mb-4 p-0 overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">DANH MỤC THỜI TRANG</th>
                        <th>SLUG</th>
                        <th>MẪU TIÊU BIỂU</th>
                        <th>SỐ LƯỢNG SẢN PHẨM</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var coverPath = $"images/category-covers/{item.Category.Slug}.png";
                        if (!HostingEnvironment.WebRootFileProvider.GetFileInfo(coverPath).Exists)
                        {
                            coverPath = $"images/category-covers/{item.Category.Slug}.webp";
                        }
                        var imageUrl = HostingEnvironment.WebRootFileProvider.GetFileInfo(coverPath).Exists
                            ? Url.Content($"~/{coverPath}")
                            : item.RepresentativeImageUrl;

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 overflow-hidden flex-shrink-0" style="width: 44px; height: 44px; background: #0F172A; border: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: center;">
                                        @if (!string.IsNullOrEmpty(imageUrl))
                                        {
                                            <img src="@imageUrl" alt="" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-tag text-white fs-5"></i>
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="AdminProducts" asp-action="Index" asp-route-categoryId="@item.Category.Id" class="fw-bold adm-heading text-decoration-none fs-6">
                                            @item.Category.Name
                                        </a>
                                        <div class="text-muted small" style="font-size: 0.75rem;">ID: #@item.Category.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code class="font-monospace small px-2 py-1 rounded" style="background: var(--adm-surface-hover, #F8FAFC); border: 1px solid var(--adm-border, #E2E8F0); color: #475569;">
                                    /@item.Category.Slug
                                </code>
                            </td>
                            <td>
                                @if (item.ProductImageUrls.Any())
                                {
                                    <div class="adm-cat-avatar-stack">
                                        @foreach (var pImg in item.ProductImageUrls)
                                        {
                                            <img src="@pImg" alt="Product" onerror="this.src='/images/placeholder.svg'" title="Mẫu trong danh mục" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div>
                                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1); font-weight: 600; font-size: 0.78rem;">
                                        @item.ProductCount sản phẩm
                                    </span>
                                </div>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    <span class="text-success"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> @item.ActiveProductCount hiển thị</span>
                                    @if (item.InactiveProductCount > 0)
                                    {
                                        <span class="text-muted ms-1">· @item.InactiveProductCount đang ẩn</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.Category.IsActive)
                                {
                                    <span class="adm-pill adm-pill-emerald">Đang bật</span>
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill-faint">Đang tắt</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <a asp-controller="AdminProducts" asp-action="Index" asp-route-categoryId="@item.Category.Id"
                                       class="adm-action-btn adm-btn-secondary py-1 px-3" style="font-size: 0.78rem;" title="Xem sản phẩm trong danh mục">
                                        <i class="bi bi-box-seam me-1"></i> Xem SP (@item.ProductCount)
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Category.Id"
                                       class="adm-action-btn adm-btn-secondary py-1 px-2" style="font-size: 0.78rem;" title="Sửa danh mục">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="ToggleActive" asp-route-id="@item.Category.Id"
                                          asp-route-keyword="@currentKeyword" asp-route-status="@currentStatus"
                                          asp-route-sort="@currentSort" asp-route-page="@ViewBag.Page" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@((!item.Category.IsActive).ToString())" />
                                        <button type="submit" class="adm-action-btn adm-btn-secondary py-1 px-2 @(item.Category.IsActive ? "" : "text-success")" style="font-size: 0.78rem;"
                                                title="@(item.Category.IsActive ? "Tắt danh mục" : "Bật danh mục")">
                                            <i class="bi @(item.Category.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. GRID VIEW (REFINED LOOKBOOK CARDS) -->
    <div id="admCatGrid" class="d-none mb-4">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                var coverPath = $"images/category-covers/{item.Category.Slug}.png";
                if (!HostingEnvironment.WebRootFileProvider.GetFileInfo(coverPath).Exists)
                {
                    coverPath = $"images/category-covers/{item.Category.Slug}.webp";
                }
                var imageUrl = HostingEnvironment.WebRootFileProvider.GetFileInfo(coverPath).Exists
                    ? Url.Content($"~/{coverPath}")
                    : item.RepresentativeImageUrl;
                var hasImage = !string.IsNullOrWhiteSpace(imageUrl);

                <div class="col">
                    <div class="adm-cat-card-modern h-100">
                        <div class="adm-cat-card-banner">
                            @if (hasImage)
                            {
                                <img src="@imageUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(15,23,42,0.85) 100%);"></div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100" style="background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);">
                                    <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: #F59E0B;">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>
                                </div>
                            }

                            <div class="position-absolute top-0 end-0 m-2" style="z-index: 2;">
                                @if (item.Category.IsActive)
                                {
                                    <span class="adm-pill adm-pill-emerald shadow-sm">Đang bật</span>
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill-faint shadow-sm">Đang tắt</span>
                                }
                            </div>
                        </div>

                        <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <h5 class="fw-bold adm-heading mb-1" style="font-size: 1rem;">@item.Category.Name</h5>
                                <div class="font-monospace text-muted small mb-3" style="font-size: 0.75rem;">
                                    /@item.Category.Slug
                                </div>

                                <div class="d-flex align-items-center justify-content-between mb-3 pt-2 border-top border-secondary border-opacity-10">
                                    <span class="badge" style="background: var(--adm-surface-hover, #F8FAFC); color: var(--adm-ink, #0F172A); border: 1px solid var(--adm-border, #CBD5E1); font-weight: 600;">
                                        @item.ProductCount sản phẩm
                                    </span>

                                    @if (item.ProductImageUrls.Any())
                                    {
                                        <div class="adm-cat-avatar-stack">
                                            @foreach (var pImg in item.ProductImageUrls.Take(3))
                                            {
                                                <img src="@pImg" alt="" onerror="this.src='/images/placeholder.svg'" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="pt-2 border-top border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                                <a asp-controller="AdminProducts" asp-action="Index" asp-route-categoryId="@item.Category.Id"
                                   class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1" style="color: var(--adm-gold, #D97706);">
                                    <span>Xem sản phẩm</span> <i class="bi bi-arrow-right"></i>
                                </a>

                                <div class="d-flex align-items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Category.Id"
                                       class="adm-action-btn adm-btn-secondary py-1 px-2" style="font-size: 0.78rem;" title="Sửa danh mục">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="ToggleActive" asp-route-id="@item.Category.Id"
                                          asp-route-keyword="@currentKeyword" asp-route-status="@currentStatus"
                                          asp-route-sort="@currentSort" asp-route-page="@ViewBag.Page" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@((!item.Category.IsActive).ToString())" />
                                        <button type="submit" class="adm-action-btn adm-btn-secondary py-1 px-2" style="font-size: 0.78rem;"
                                                title="@(item.Category.IsActive ? "Tắt danh mục" : "Bật danh mục")">
                                            <i class="bi @(item.Category.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (ViewBag.PageCount > 1)
{
    var currentPage = (int)ViewBag.Page;
    <nav class="d-flex align-items-center justify-content-center gap-3 my-4" aria-label="Phân trang danh mục">
        @if (currentPage > 1)
        {
            <a asp-action="Index" asp-route-keyword="@currentKeyword" asp-route-status="@currentStatus"
               asp-route-sort="@currentSort" asp-route-page="@(currentPage - 1)" class="adm-action-btn adm-btn-secondary">
               <i class="bi bi-chevron-left me-1"></i> Trang trước
            </a>
        }
        <span class="text-muted small fw-semibold">Trang @currentPage / @ViewBag.PageCount</span>
        @if (currentPage < ViewBag.PageCount)
        {
            <a asp-action="Index" asp-route-keyword="@currentKeyword" asp-route-status="@currentStatus"
               asp-route-sort="@currentSort" asp-route-page="@(currentPage + 1)" class="adm-action-btn adm-btn-secondary">
               Trang sau <i class="bi bi-chevron-right ms-1"></i>
            </a>
        }
    </nav>
}

@section Scripts {
    <script>
        function toggleCatView(mode) {
            const grid = document.getElementById('admCatGrid');
            const table = document.getElementById('admCatTable');
            const btnG = document.getElementById('admBtnCatGrid');
            const btnT = document.getElementById('admBtnCatTable');

            if (mode === 'grid') {
                if (grid) grid.classList.remove('d-none');
                if (table) table.classList.add('d-none');
                if (btnG) {
                    btnG.classList.add('active');
                    btnG.setAttribute('aria-pressed', 'true');
                }
                if (btnT) {
                    btnT.classList.remove('active');
                    btnT.setAttribute('aria-pressed', 'false');
                }
            } else {
                if (grid) grid.classList.add('d-none');
                if (table) table.classList.remove('d-none');
                if (btnT) {
                    btnT.classList.add('active');
                    btnT.setAttribute('aria-pressed', 'true');
                }
                if (btnG) {
                    btnG.classList.remove('active');
                    btnG.setAttribute('aria-pressed', 'false');
                }
            }
            localStorage.setItem('hnmt_adm_cat_view', mode);
        }

        const savedCatMode = localStorage.getItem('hnmt_adm_cat_view') || 'table';
        toggleCatView(savedCatMode);
    </script>
}
