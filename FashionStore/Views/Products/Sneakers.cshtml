@{
    Layout = null;
    ViewData["Title"] = "HnmtShop — Futurist Sneaker Vault";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HNMTSHOP — FUTURIST SNEAKER VAULT</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,800;1,900&family=Pacifico&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Futurist Sneaker Vault CSS -->
    <link rel="stylesheet" href="~/css/sneaker-vault.css?v=uniform_font_v43" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clothing-rail.css?v=spotlight_v2" asp-append-version="true" />
</head>
<body class="is-sneaker-standalone">

    <div class="hnmt-sneaker-vault-wrap is-standalone" id="hnmtSneakerOverlay">
        <div class="sv-app is-grid-mode" id="svApp">

            <!-- HEADER -->
            <header class="sv-header">
                <div class="sv-header-left">
                    <button type="button" class="sv-icon-btn" id="svToggleViewBtn" title="Chuyển chế độ xem">
                        <i class="bi bi-view-stacked"></i>
                        <span>SLIDER 3D</span>
                    </button>
                    <div class="sv-vault-switcher" id="svVaultSwitcher">
                        <button type="button" class="sv-vault-arrow" id="svPrevCollectionBtn" aria-label="Bộ giày trước" title="Bộ sưu tập trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="sv-header-title" id="svCollectionTitle">FUTURIST SNEAKER VAULT</span>
                        <button type="button" class="sv-vault-arrow" id="svNextCollectionBtn" aria-label="Bộ giày tiếp theo" title="Bộ sưu tập kế tiếp">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <a href="/" class="sv-brand-signature" title="Về trang chủ HnmtShop">HnmtShop</a>

                <div class="sv-head-right">
                    <button type="button" class="sv-search-btn" id="svSearchBtn" aria-label="Tìm kiếm giày" title="Tìm đồ nhanh (Phím tắt /)">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="m20 20-4.35-4.35"/>
                        </svg>
                    </button>
                    <button type="button" class="sv-bag-btn" id="svBagBtn" aria-label="Giỏ hàng">
                        <svg fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                            <path d="M4 8h16l-1 13H5L4 8Z" />
                            <path d="M9 9V6a3 3 0 0 1 6 0v3" />
                        </svg>
                        <span class="sv-bag-badge" id="svBagBadge">0</span>
                    </button>
                    <a href="/Products" class="sv-exit-btn" id="svExitBtn" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </a>
                </div>
            </header>

            <!-- VIEW 1: GRID OVERVIEW (3x2 GRID BAN ĐẦU) -->
            <section class="sv-grid-container" id="svGridContainer" aria-label="Bộ sưu tập sneaker dạng lưới">
                <div class="sv-grid" id="svGrid">
                    <!-- Render tự động bởi sneaker-vault.js -->
                </div>
            </section>

            <!-- VIEW 2: CINEMATIC SLIDER VIEW (1:1 THEO VIDEO FIGMA) -->
            <section class="sv-slider-container" id="svSliderContainer" aria-label="Chi tiết Sneaker nổi khối 3D">

                <!-- 1. CHỮ TYPOGRAPHY KHỔNG LỒ NẰM SAU CHIẾC GIÀY -->
                <div class="sv-giant-title-track" aria-hidden="true">
                    <h2 class="sv-giant-title" id="svGiantTitle">AIR FUTURE IV</h2>
                </div>

                <!-- 2. KHÔNG GIAN GIÀY BAY LƠ LỬNG NỔI KHỐI 3D PARALLAX THEO CHUỘT -->
                <div class="sv-stage" id="svStage">
                    <div class="sv-hero-wrap" id="svHeroWrap">
                        <img src="/images/sneakers/air-future-iv.webp?v=center_h_v27" alt="AIR FUTURE IV" class="sv-hero-img" id="svHeroImg" />
                        <div class="sv-hero-shadow" id="svHeroShadow"></div>
                    </div>
                </div>

                <!-- 3. THANH THÔNG SỐ VÀ ĐIỀU KHIỂN DƯỚI ĐÁY CHUẨN VIDEO -->
                <footer class="sv-bottom-bar">

                    <!-- GÓC DƯỚI TRÁI: THÔNG SỐ KỸ THUẬT TECH SPECS -->
                    <div class="sv-specs-panel">
                        <h3 class="sv-colorway-name" id="svColorwayName">INFRARAY STORM</h3>
                        <dl class="sv-spec-grid">
                            <dt>MÃ GIÀY:</dt>
                            <dd id="svStyleCode">HFS-04-STORM</dd>

                            <dt>PHỐI MÀU:</dt>
                            <dd id="svColorName">STORM GREY / INFRARED</dd>

                            <dt>THIẾT KẾ:</dt>
                            <dd id="svDesigner">HNMTSHOP × FUTURE LAB</dd>

                            <dt>GIÁ BÁN:</dt>
                            <dd id="svPrice">5.200.000 ₫</dd>
                        </dl>
                    </div>

                    <!-- GÓC DƯỚI PHẢI: MŨI TÊN < > , SELECT COLOR VÀ NÚT ADD TO BAG -->
                    <div class="sv-controls-panel">
                        <div class="sv-arrow-group">
                            <button type="button" class="sv-nav-btn prev" id="svPrevBtn" aria-label="Mẫu trước">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" class="sv-nav-btn next" id="svNextBtn" aria-label="Mẫu tiếp theo">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <div class="sv-color-swatches">
                            <span class="sv-swatches-label">CHỌN MÀU</span>
                            <div class="sv-swatches-row" id="svSwatches">
                                <!-- Chấm màu swatches -->
                            </div>
                        </div>

                        <button type="button" class="sv-add-bag-btn" id="svAddBagBtn">
                            <span>THÊM VÀO GIỎ</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                </footer>

            </section>

        </div>
    </div>

    <!-- Sneaker Vault Logic -->
    <script src="~/js/sneaker-vault.js?v=uniform_font_v43" asp-append-version="true"></script>

    <!-- SPOTLIGHT QUICK SEARCH MODAL -->
    <div id="hnmtSpotlightSearchModal" class="hnmt-spotlight-modal" aria-hidden="true">
        <div class="hnmt-spotlight-backdrop" id="spotlightBackdrop"></div>
        <div class="hnmt-spotlight-dialog" role="dialog" aria-modal="true" aria-label="Tìm kiếm sản phẩm nhanh">
            <div class="hnmt-spotlight-search-header">
                <div class="hnmt-spotlight-input-wrap">
                    <svg class="hnmt-spotlight-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m20 20-4.35-4.35"/>
                    </svg>
                    <input type="text" id="hnmtSpotlightInput" class="hnmt-spotlight-input" placeholder="Tìm quần, áo, sneaker hoặc kiểu dáng... (ví dụ: cargo, jeans, hoodie, runner)" autocomplete="off" spellcheck="false">
                    <button type="button" id="hnmtSpotlightClearBtn" class="hnmt-spotlight-clear-btn" aria-label="Xóa tìm kiếm" style="display: none;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="hnmt-spotlight-meta">
                    <span class="hnmt-spotlight-esc-pill">ESC để đóng</span>
                </div>
            </div>
            <div class="hnmt-spotlight-tabs" id="spotlightTabs">
                <button type="button" class="hnmt-spotlight-tab is-active" data-cat="all">Tất Cả <span class="tab-count" id="tabCountAll">0</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="quan">Sào Quần <span class="tab-count" id="tabCountQuan">5</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="ao">Sào Áo <span class="tab-count" id="tabCountAo">20</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="giay">Tủ Giày <span class="tab-count" id="tabCountGiay">6</span></button>
            </div>
            <div class="hnmt-spotlight-quick-tags" id="spotlightQuickTags">
                <span class="quick-tags-label">Gợi ý nhanh:</span>
                <div class="quick-tags-scroll" id="quickTagsContainer"></div>
            </div>
            <div class="hnmt-spotlight-results" id="spotlightResults"></div>
            <div class="hnmt-spotlight-empty" id="spotlightEmpty" style="display: none;">
                <div class="empty-icon">🔍</div>
                <p class="empty-title">Không tìm thấy sản phẩm phù hợp</p>
                <p class="empty-desc">Thử tìm với từ khóa khác như "jeans", "cargo", "hoodie", "runner", hoặc bấm các gợi ý nhanh bên trên.</p>
            </div>
            <div class="hnmt-spotlight-footer">
                <div class="spotlight-hint">
                    <span><kbd>↑</kbd><kbd>↓</kbd> Chọn</span>
                    <span><kbd>ENTER</kbd> Xem đồ</span>
                    <span><kbd>ESC</kbd> Đóng</span>
                </div>
                <div class="spotlight-brand">HNMTSHOP // FAST FIND</div>
            </div>
        </div>
    </div>

    <script src="~/js/clothing-rail.js" asp-append-version="true"></script>
    <script src="~/js/spotlight-search.js" asp-append-version="true"></script>
</body>
</html>
