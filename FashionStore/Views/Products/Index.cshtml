@model FashionStore.Models.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = "Cửa Hàng 3D HNMTSHOP – Quần Áo & Sneaker Streetwear";

    var sourceCatalog = Model.AllCatalogProducts.Any() ? Model.AllCatalogProducts : Model.Products;

    // Phân loại Giày Sneaker và Quần Áo
    var shoeList = sourceCatalog
        .Where(p => (p.Category != null && p.Category.Slug.Contains("giay")) 
                 || p.Name.ToLower().Contains("runner") 
                 || p.Name.ToLower().Contains("sneaker") 
                 || p.Name.ToLower().Contains("giày")
                 || p.Name.ToLower().Contains("platform"))
        .ToList();

    var clothesList = sourceCatalog
        .Where(p => !shoeList.Contains(p))
        .ToList();

    // Fallbacks if one collection is filtered
    var displayClothes = clothesList.Any() ? clothesList : sourceCatalog;
    var displayShoes = shoeList.Any() ? shoeList : sourceCatalog;
}

@section Styles {
    <link rel="stylesheet" href="~/css/store3d.css" asp-append-version="true" />
}

<!-- ============================================================== -->
<!-- HNMTSHOP ATELIER FILTER & NAVIGATION BAR (HOMEPAGE 1:1 HARMONY) -->
<!-- ============================================================== -->
<nav class="hnmt-atelier-filter-bar" id="hnmtAtelierFilterBar">
    <div class="hnmt-filter-main-row">
        <!-- 1. Mode Switcher Segmented Control -->
        <div class="hnmt-mode-switcher">
            <button type="button" class="hnmt-mode-btn active" id="btnModeRack" title="Trải nghiệm sào đồ 3D tương tác">
                <i class="bi bi-tag-fill"></i>
                <span>Sào Treo 3D</span>
            </button>
            <button type="button" class="hnmt-mode-btn" id="btnModeShoe" title="Showroom trưng bày giày kệ kính">
                <i class="bi bi-boxes"></i>
                <span>Showroom Giày</span>
            </button>
            <button type="button" class="hnmt-mode-btn" id="btnModeGrid" title="Danh sách toàn bộ sản phẩm">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>Catalogue Lưới</span>
            </button>
        </div>

        <!-- 2. Search Box with Instant Submit -->
        <form class="hnmt-filter-search-wrap" method="get" asp-controller="Products" asp-action="Index" id="hnmtSearchForm">
            <i class="bi bi-search"></i>
            <input type="text"
                   name="keyword"
                   id="hnmtSearchInput"
                   value="@Model.Keyword"
                   placeholder="Tìm kiếm mẫu áo, giày, mã SKU..."
                   class="hnmt-filter-search-input"
                   autocomplete="off" />
            @if (Model.CategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@Model.CategoryId.Value" />
            }
            @if (Model.MinPrice.HasValue)
            {
                <input type="hidden" name="minPrice" value="@Model.MinPrice.Value" />
            }
            @if (Model.MaxPrice.HasValue)
            {
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice.Value" />
            }
            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
        </form>

        <!-- 3. Actions: Filter Drawer Toggle & Badge Counter -->
        <div class="hnmt-filter-actions">
            <button type="button" class="hnmt-btn-toggle-drawer" id="btnToggleFilterDrawer">
                <i class="bi bi-sliders2"></i>
                <span>Bộ Lọc Nâng Cao</span>
                <i class="bi bi-chevron-down ms-1" id="filterChevron"></i>
            </button>

            <span class="hnmt-catalog-badge">
                BST 2026 // @(sourceCatalog.Count) Tác Phẩm
            </span>
        </div>
    </div>

    <!-- Category Pills Quick Row -->
    <div class="hnmt-filter-cats-row">
        <a href="/Products" class="hnmt-cat-chip @(!Model.CategoryId.HasValue && string.IsNullOrEmpty(Model.Keyword) ? "active" : "")">
            <i class="bi bi-stars text-warning"></i>
            <span>Tất Cả</span>
        </a>

        @foreach (var cat in Model.Categories)
        {
            var isShoeCat = cat.Slug.Contains("giay") || cat.Slug.Contains("sneaker");
            var isActiveCat = Model.CategoryId == cat.Id;
            <a href="/Products?categoryId=@cat.Id@(isShoeCat ? "&view=shoe" : "")"
               class="hnmt-cat-chip @(isShoeCat ? "hnmt-cat-chip--sneaker" : "") @(isActiveCat ? "active" : "")"
               data-cat-id="@cat.Id"
               data-is-shoe="@(isShoeCat ? "true" : "false")">
                @if (isShoeCat)
                {
                    <i class="bi bi-fire"></i>
                }
                <span>@cat.Name</span>
            </a>
        }
    </div>

    <!-- Expandable Luxury Drawer (Trượt xuống khi bấm Bộ Lọc) -->
    <div class="hnmt-filter-drawer" id="hnmtFilterDrawer">
        <form method="get" asp-controller="Products" asp-action="Index" id="hnmtDrawerForm" class="hnmt-drawer-inner">
            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="categoryId" id="drawerCategoryId" value="@Model.CategoryId" />

            <!-- Col 1: Khoảng Giá -->
            <div class="hnmt-drawer-col">
                <h4><i class="bi bi-cash-stack"></i> Khoảng Giá (VNĐ)</h4>
                <div class="hnmt-price-presets">
                    <button type="button" class="hnmt-price-btn" data-min="" data-max="500000">&lt; 500k</button>
                    <button type="button" class="hnmt-price-btn" data-min="500000" data-max="1000000">500k - 1Tr</button>
                    <button type="button" class="hnmt-price-btn" data-min="1000000" data-max="5000000">1Tr - 5Tr</button>
                    <button type="button" class="hnmt-price-btn" data-min="5000000" data-max="">&gt; 5Tr</button>
                </div>
                <div class="hnmt-price-inputs-row">
                    <input type="number" name="minPrice" id="inputMinPrice" value="@Model.MinPrice" placeholder="Từ (đ)" class="hnmt-drawer-input" />
                    <span class="text-white-50">&ndash;</span>
                    <input type="number" name="maxPrice" id="inputMaxPrice" value="@Model.MaxPrice" placeholder="Đến (đ)" class="hnmt-drawer-input" />
                </div>
            </div>

            <!-- Col 2: Size Quần Áo -->
            <div class="hnmt-drawer-col">
                <h4><i class="bi bi-rulers"></i> Size Quần Áo</h4>
                <div class="hnmt-size-chips-grid">
                    <span class="hnmt-size-chip">S</span>
                    <span class="hnmt-size-chip">M</span>
                    <span class="hnmt-size-chip active">L</span>
                    <span class="hnmt-size-chip">XL</span>
                    <span class="hnmt-size-chip">XXL</span>
                </div>
            </div>

            <!-- Col 3: Size Sneaker & Sắp Xếp -->
            <div class="hnmt-drawer-col">
                <h4><i class="bi bi-sort-down"></i> Sắp Xếp Mẫu</h4>
                <select name="sortOrder" id="drawerSortOrder" class="hnmt-drawer-select mb-3">
                    <option value="newest" selected="@(Model.SortOrder == "newest")">Mới Nhất (Drop 2026)</option>
                    <option value="price-asc" selected="@(Model.SortOrder == "price-asc")">Giá Tăng Dần (Thấp &rarr; Cao)</option>
                    <option value="price-desc" selected="@(Model.SortOrder == "price-desc")">Giá Giảm Dần (Cao &rarr; Thấp)</option>
                    <option value="name-asc" selected="@(Model.SortOrder == "name-asc")">Tên A &rarr; Z</option>
                </select>

                <h4 class="mt-2"><i class="bi bi-boxes"></i> Size Sneaker (EU)</h4>
                <div class="hnmt-size-chips-grid">
                    <span class="hnmt-size-chip">38</span>
                    <span class="hnmt-size-chip">39</span>
                    <span class="hnmt-size-chip">40</span>
                    <span class="hnmt-size-chip active">41</span>
                    <span class="hnmt-size-chip">42</span>
                    <span class="hnmt-size-chip">43</span>
                    <span class="hnmt-size-chip">44</span>
                </div>
            </div>

            <!-- Col 4: Thao Tác Áp Dụng -->
            <div class="hnmt-drawer-col hnmt-drawer-actions">
                <button type="submit" class="hnmt-btn-apply-filters">
                    <i class="bi bi-check2-circle me-1"></i> Áp Dụng Bộ Lọc
                </button>
                <a href="/Products" class="hnmt-btn-reset-filters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt Lại Mặc Định
                </a>
            </div>
        </form>
    </div>
</nav>




<!-- ============================================================== -->
<!-- 1. GIAO DIỆN QUẦN ÁO: INTERACTIVE CLOTHING RACK (FRAXBIT 1:1)   -->
<!-- ============================================================== -->
<section id="hnmtClothingRack" class="hnmt-rack-container" style="display: block;">
    <!-- Rack Header -->
    <div class="hnmt-rack-header">
        <span class="hnmt-rack-tag">HNMTSHOP · STREETWEAR RACK · BỘ SƯU TẬP QUẦN ÁO 3D</span>
        <div class="hnmt-rack-tip-badge">
            <i class="bi bi-arrows-expand me-1"></i> Kéo hoặc lướt chuột ngang trên thanh ray để duyệt qua từng mẫu
        </div>
    </div>

    <!-- The 3D Metal Clothes Rail -->
    <div class="hnmt-rail-structure">
        <div class="hnmt-rail-bar"></div>

        <!-- Left / Right Glide Arrows -->
        <button type="button" class="hnmt-rack-arrow hnmt-rack-arrow--prev" id="rackPrevBtn" title="Mẫu trước">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button type="button" class="hnmt-rack-arrow hnmt-rack-arrow--next" id="rackNextBtn" title="Mẫu tiếp theo">
            <i class="bi bi-chevron-right"></i>
        </button>

        <!-- Clothes Track (Sliding garments on hangers) -->
        <div class="hnmt-clothes-track" id="clothesTrack">
            @for (int i = 0; i < displayClothes.Count; i++)
            {
                var item = displayClothes[i];
                <div class="hnmt-garment-item" 
                     data-id="@item.Id"
                     data-name="@item.Name"
                     data-price="@item.Price"
                     data-category="@(item.Category?.Name ?? "Streetwear")"
                     data-slug="@item.Slug"
                     data-img="@item.ImageUrl">

                    <!-- Hanger Hook & Frame -->
                    <div class="hnmt-hanger-hook"></div>
                    <div class="hnmt-hanger-shoulders"></div>

                    <!-- Garment Body -->
                    <div class="hnmt-garment-body">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/products/clothes/heavyweight-boxy-hoodie.png" : item.ImageUrl)"
                             alt="@item.Name"
                             loading="lazy"
                             onerror="this.src='/images/products/clothes/heavyweight-boxy-hoodie.png'" />
                    </div>

                    <!-- Ground Drop Shadow -->
                    <div class="hnmt-garment-shadow"></div>
                </div>
            }
        </div>
    </div>

    <!-- Active Garment Details Dock (Dock Dưới Cùng) -->
    <div class="hnmt-rack-details-dock">
        <h3 class="hnmt-rack-title" id="rackActiveTitle">Áo Thun Streetwear</h3>
        <div class="hnmt-rack-price-row">
            <span class="hnmt-rack-price" id="rackActivePrice">0 ₫</span>
            <span class="hnmt-rack-category-badge" id="rackActiveCat">Streetwear</span>
        </div>

        <!-- Quick Size Selector -->
        <div class="hnmt-rack-sizes">
            <button type="button" class="hnmt-rack-size-btn" data-size="S">S</button>
            <button type="button" class="hnmt-rack-size-btn" data-size="M">M</button>
            <button type="button" class="hnmt-rack-size-btn is-selected" data-size="L">L</button>
            <button type="button" class="hnmt-rack-size-btn" data-size="XL">XL</button>
        </div>

        <!-- Action CTAs -->
        <div class="hnmt-rack-actions">
            <button type="button" class="hnmt-btn-rack-cart" id="rackBtnCart">
                <i class="bi bi-bag-plus me-1"></i> Thêm Vào Giỏ Hàng
            </button>
            <a href="#" class="hnmt-btn-rack-detail" id="rackBtnDetail">
                Xem Chi Tiết &rarr;
            </a>
        </div>
    </div>
</section>

<!-- ============================================================== -->
<!-- 2. GIAO DIỆN GIÀY: 3D SNEAKER SHOWROOM (LAST DEPT / MOVENTO 1:1) -->
<!-- ============================================================== -->
<section id="hnmtSneakerShowroom" class="hnmt-showroom-container" style="display: none;">
    <!-- Topbar -->
    <div class="hnmt-showroom-topbar">
        <div>
            <span class="hnmt-hangar-code">HANGAR 03 · SNEAKER ARCHIVES</span>
            <h2 class="hnmt-hangar-title">HNMTSHOP EXHIBITION</h2>
        </div>

        <div class="hnmt-showroom-view-toggle">
            <button type="button" class="hnmt-btn-view-mode active" id="btnWallMode">
                <i class="bi bi-grid-fill me-1"></i> Tường Kệ Kính
            </button>
            <button type="button" class="hnmt-btn-view-mode" id="btnStageMode">
                <i class="bi bi-eye-fill me-1"></i> Bục Tiêu Điểm
            </button>
        </div>
    </div>

    <!-- VIEW 1: TƯỜNG KỆ KÍNH PHÁT SÁNG (WALL VIEW) -->
    <div class="hnmt-shelves-wall" id="sneakerWallView">
        @foreach (var shoe in displayShoes)
        {
            <div class="hnmt-shelf-card"
                 data-id="@shoe.Id"
                 data-name="@shoe.Name"
                 data-desc="@shoe.Description"
                 data-price="@shoe.Price"
                 data-img="@(string.IsNullOrEmpty(shoe.ImageUrl) ? "/images/products/shoes/air-jordan-1-retro-high.png" : shoe.ImageUrl)">

                <!-- Floating Sneaker with Glow -->
                <div class="hnmt-shelf-shoe-wrap">
                    <img src="@(string.IsNullOrEmpty(shoe.ImageUrl) ? "/images/products/shoes/air-jordan-1-retro-high.png" : shoe.ImageUrl)"
                         alt="@shoe.Name"
                         loading="lazy"
                         onerror="this.src='/images/products/shoes/air-jordan-1-retro-high.png'" />
                </div>

                <!-- Tempered Glass Shelf -->
                <div class="hnmt-glass-shelf">
                    <div class="hnmt-shelf-led"></div>
                </div>

                <!-- Shelf Info Bar -->
                <div class="hnmt-shelf-info">
                    <span class="hnmt-shelf-name" title="@shoe.Name">@shoe.Name</span>
                    <span class="hnmt-shelf-price">@shoe.Price.ToString("N0") ₫</span>
                </div>
            </div>
        }
    </div>

    <!-- VIEW 2: TIÊU ĐIỂM BỤC TRƯNG BÀY (PEDESTAL STAGE VIEW) -->
    <div class="hnmt-pedestal-stage" id="sneakerStageView">
        <!-- Left: Glowing Stage & Flying Shoe -->
        <div class="hnmt-stage-left">
            <span class="hnmt-pedestal-series-badge">HANGAR 03 · GRADE 10 EDITION</span>

            <div class="hnmt-stage-shoe-center">
                <img id="stageShoeImg" src="/images/products/shoes/air-jordan-1-retro-high.png" alt="Sneaker Showcase" />
            </div>

            <!-- Glowing Acrylic / Glass Pedestal Slab -->
            <div class="hnmt-stage-glass-slab">
                <div class="hnmt-stage-neon-beam"></div>
            </div>
        </div>

        <!-- Right: Purchase Control Deck (1:1 Video 2 Panel) -->
        <div class="hnmt-stage-right-panel">
            <button type="button" class="hnmt-stage-back-btn" id="stageBackToWallBtn">
                <i class="bi bi-arrow-left"></i> Quay Lại Tường Kệ
            </button>

            <h3 class="hnmt-stage-shoe-title" id="stageShoeTitle">Chunky Bubble Air Runner</h3>
            <p class="hnmt-stage-shoe-desc" id="stageShoeDesc">
                Đế đệm khí Air Bubble đa khoang êm ái, phối màu Cyber Blue bắt mắt, thân giày vải lưới thoáng khí dệt đa lớp.
            </p>

            <div class="hnmt-stage-price-tag" id="stageShoePrice">950.000 ₫</div>

            <!-- Color Swatches -->
            <span class="hnmt-stage-option-label">Chọn Màu Sắc</span>
            <div class="hnmt-stage-colors">
                <button type="button" class="hnmt-stage-color-pill is-active" data-color="Đen">Đen Cyber</button>
                <button type="button" class="hnmt-stage-color-pill" data-color="Trắng">Trắng Tuyết</button>
                <button type="button" class="hnmt-stage-color-pill" data-color="Xanh Neon">Xanh Neon</button>
                <button type="button" class="hnmt-stage-color-pill" data-color="Be">Kem Be</button>
            </div>

            <!-- Size Selector (38-44) -->
            <span class="hnmt-stage-option-label">Chọn Size Giày (Chuẩn EU)</span>
            <div class="hnmt-stage-sizes">
                <button type="button" class="hnmt-stage-size-btn" data-size="38">38</button>
                <button type="button" class="hnmt-stage-size-btn" data-size="39">39</button>
                <button type="button" class="hnmt-stage-size-btn" data-size="40">40</button>
                <button type="button" class="hnmt-stage-size-btn is-selected" data-size="41">41</button>
                <button type="button" class="hnmt-stage-size-btn" data-size="42">42</button>
                <button type="button" class="hnmt-stage-size-btn" data-size="43">43</button>
                <button type="button" class="hnmt-stage-size-btn" data-size="44">44</button>
            </div>

            <!-- Big Add to Cart CTA -->
            <button type="button" class="hnmt-btn-stage-add" id="stageAddToCartBtn">
                <i class="bi bi-bag-check-fill me-1"></i> Thêm Vào Giỏ Hàng
            </button>
        </div>
    </div>
</section>

<!-- ============================================================== -->
<!-- 3. GIAO DIỆN DANH SÁCH LƯỚI TRUYỀN THỐNG (CLASSIC FILTER & GRID) -->
<!-- ============================================================== -->
<section id="hnmtClassicGrid" style="display: none;">
    <!-- PAGE BANNER -->
    <section class="fs-shop-banner">
        <div>
            <p class="fs-eyebrow">HNMTSHOP / CATALOG</p>
            <h1>Tất Cả Sản Phẩm</h1>
            <p>Khám phá toàn bộ thiết kế quần áo & giày sneaker dành riêng cho giới trẻ.</p>
        </div>
    </section>

    <div class="fs-shop-container">
        <!-- BREADCRUMB -->
        <div class="fs-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <span>Cửa hàng</span>
        </div>

        <div class="fs-shop-heading">
            <div>
                <p class="fs-eyebrow">EXPLORE OUR COLLECTION</p>
                <h2>Danh sách sản phẩm</h2>
                <p class="fs-shop-count">
                    Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm
                </p>
            </div>
        </div>

        <div class="fs-shop-layout">
            <!-- FILTER SIDEBAR -->
            <aside class="fs-filter-sidebar">
                <form asp-controller="Products" asp-action="Index" method="get">
                    <input type="hidden" name="view" value="grid" />

                    <div class="fs-filter-heading">
                        <h3>Bộ lọc</h3>
                        <a asp-controller="Products" asp-action="Index" asp-route-view="grid">Xóa tất cả</a>
                    </div>

                    <div class="fs-filter-group">
                        <label for="keyword">Tìm kiếm</label>
                        <input id="keyword"
                               name="keyword"
                               value="@Model.Keyword"
                               class="fs-form-control"
                               placeholder="Tên sản phẩm, giày, áo..." />
                    </div>

                    <div class="fs-filter-group">
                        <label for="categoryId">Danh mục</label>
                        <select id="categoryId" name="categoryId" class="fs-form-control">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (Model.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="fs-filter-group">
                        <label>Khoảng giá (VNĐ)</label>
                        <div class="fs-price-inputs">
                            <input type="number" name="minPrice" value="@Model.MinPrice" min="0" placeholder="Từ" class="fs-form-control" />
                            <input type="number" name="maxPrice" value="@Model.MaxPrice" min="0" placeholder="Đến" class="fs-form-control" />
                        </div>
                    </div>

                    <div class="fs-filter-group">
                        <label for="sortOrder">Sắp xếp</label>
                        <select id="sortOrder" name="sortOrder" class="fs-form-control">
                            <option value="newest" selected="@(Model.SortOrder == "newest")">Mới nhất</option>
                            <option value="price-asc" selected="@(Model.SortOrder == "price-asc")">Giá thấp đến cao</option>
                            <option value="price-desc" selected="@(Model.SortOrder == "price-desc")">Giá cao đến thấp</option>
                            <option value="name-asc" selected="@(Model.SortOrder == "name-asc")">Tên A - Z</option>
                        </select>
                    </div>

                    <button type="submit" class="fs-btn w-100">
                        Áp dụng bộ lọc
                    </button>
                </form>
            </aside>

            <!-- PRODUCT GRID -->
            <div class="fs-shop-products">
                @if (Model.Products.Any())
                {
                    <div class="row g-4">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-6 col-lg-4">
                                <div class="fs-product-card">
                                    <div class="fs-product-image">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/products/clothes/heavyweight-boxy-hoodie.png" : product.ImageUrl)"
                                                 alt="@product.Name"
                                                 loading="lazy"
                                                 onerror="this.src='/images/products/clothes/heavyweight-boxy-hoodie.png'" />
                                        </a>

                                        <div class="fs-card-badges">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                               class="fs-badge fs-badge-ai text-decoration-none">
                                                <i class="bi bi-stars"></i> THỬ ĐỒ AI
                                            </a>
                                        </div>

                                        <div class="fs-card-hover-actions">
                                            <div class="fs-size-pills mb-2">
                                                @if (product.Category != null && product.Category.Slug.Contains("giay"))
                                                {
                                                    <span class="fs-size-pill" data-size="39">39</span>
                                                    <span class="fs-size-pill active" data-size="41">41</span>
                                                    <span class="fs-size-pill" data-size="42">42</span>
                                                }
                                                else
                                                {
                                                    <span class="fs-size-pill" data-size="S">S</span>
                                                    <span class="fs-size-pill active" data-size="M">M</span>
                                                    <span class="fs-size-pill" data-size="L">L</span>
                                                    <span class="fs-size-pill" data-size="XL">XL</span>
                                                }
                                            </div>
                                            <button type="button"
                                                    class="fs-btn-quick-add fs-add-cart w-100"
                                                    data-product-id="@product.Id">
                                                <i class="bi bi-bag-plus"></i> Thêm vào giỏ
                                            </button>
                                        </div>
                                    </div>

                                    <div class="fs-product-info">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fs-product-category">@(product.Category?.Name ?? "HNMTSHOP")</span>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-warning small fw-bold text-decoration-none">
                                                <i class="bi bi-magic me-1"></i>Thử ngay
                                            </a>
                                        </div>

                                        <h4 class="fs-product-name">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                                @product.Name
                                            </a>
                                        </h4>

                                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                            <span class="fs-product-price">
                                                @product.Price.ToString("N0") ₫
                                            </span>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-dark rounded-circle p-2 fs-add-cart d-lg-none"
                                                    data-product-id="@product.Id"
                                                    title="Thêm giỏ hàng">
                                                <i class="bi bi-bag-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- PAGINATION -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="fs-pagination" aria-label="Phân trang">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-action="Index"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-view="grid">
                                    ←
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <a asp-action="Index"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@i"
                                   asp-route-view="grid"
                                   class="@(i == Model.CurrentPage ? "active" : "")">
                                    @i
                                </a>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-action="Index"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-view="grid">
                                    →
                                </a>
                            }
                        </nav>
                    }
                }
                else
                {
                    <div class="fs-no-products">
                        <div class="fs-no-products-icon">⌕</div>
                        <h3>Không tìm thấy sản phẩm</h3>
                        <p>
                            Không có sản phẩm phù hợp với điều kiện tìm kiếm.
                            Hãy thử thay đổi bộ lọc của bạn.
                        </p>
                        <a asp-controller="Products" asp-action="Index" class="fs-btn">
                            Xem tất cả sản phẩm
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/store3d.js" asp-append-version="true"></script>
}
