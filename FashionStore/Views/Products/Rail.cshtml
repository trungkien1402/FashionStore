@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E7E7E4" />
    <title>HNMTSHOP — Sào Treo Đồ Thời Trang Độc Bản</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/clothing-rail.css?v=spotlight_v2" asp-append-version="true" />
</head>
<body>
    <div class="hnmt-clothing-rail-wrap is-standalone">
        <div class="rail-app">
            <!-- Header -->
            <header class="rail-header" id="header">
                <a href="/" class="rail-brand-signature" id="railBrandSignature" title="Về trang chủ">HnmtShop</a>
                <div class="rail-brand" aria-label="Sào Đồ Thời Trang">
                    <span>Sào Đồ</span>
                    <span>Thời Trang</span>
                </div>
                <div class="rail-head-right">
                    <button type="button" class="rail-search-btn" id="railSearchBtn" aria-label="Tìm kiếm đồ" title="Tìm đồ nhanh (Phím tắt /)">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="m20 20-4.35-4.35"/>
                        </svg>
                    </button>
                    <button type="button" class="rail-bag-btn" id="bagBtn" aria-label="Giỏ hàng">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M4 8h16l-1 13H5L4 8Z"/>
                            <path d="M9 9V6a3 3 0 0 1 6 0v3"/>
                        </svg>
                        <span class="rail-bag-count" id="bagCount">0</span>
                    </button>
                    <a href="/" class="rail-portal-exit-btn" title="Về trang chủ">
                        <i class="bi bi-arrow-left"></i>
                        <span>Quay lại</span>
                    </a>
                </div>
            </header>

            <!-- Main Rail Scene -->
            <main class="rail-main">
                <div class="rail-intro">
                    <p class="rail-eyebrow">BỘ SƯU TẬP ÁO</p>
                    <div class="rail-title-row">
                        <button type="button" class="rail-rack-nav-btn prev" id="rackPrevBtn" title="Sào trước" aria-label="Sào trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h1 class="rail-hero-title">Thời Trang Độc Bản · Nâng Tầm Phong Cách</h1>
                        <button type="button" class="rail-rack-nav-btn next" id="rackNextBtn" title="Sào tiếp theo" aria-label="Sào tiếp theo">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <section class="rail-scene" aria-label="Sào treo đồ thời trang">
                    <div class="rail-scroll" id="railScroll">
                        <div class="rail-stage" id="railStage">
                            <div class="chrome-rail" aria-hidden="true"></div>
                        </div>
                    </div>
                </section>

                <section class="rail-caption-panel">
                    <div class="rail-caption-heading" id="captionTitle">Bộ sưu tập độc bản HNMTSHOP.</div>
                    <div class="rail-caption-detail" id="captionDetail">10 thiết kế giới hạn — Lướt sào hoặc chọn để xem chi tiết.</div>
                    <button type="button" class="rail-outline-pill" id="availabilityBtn">XEM CHI TIẾT ↗</button>
                </section>
            </main>
        </div>

        <!-- Product Detail Modal Overlay -->
        <section class="rail-product-overlay" id="productOverlay" role="dialog" aria-modal="true" aria-label="Chi tiết sản phẩm">
            <button type="button" class="rail-product-close" id="closeBtn">ĐÓNG <span>×</span></button>
            <div class="rail-detail-content">
                <div class="rail-detail-image-row">
                    <button type="button" class="rail-arrow-btn" id="prevBtn" aria-label="Sản phẩm trước">←</button>
                    <img class="rail-detail-img" id="detailImage" alt="">
                    <button type="button" class="rail-arrow-btn" id="nextBtn" aria-label="Sản phẩm sau">→</button>
                </div>
                <p class="rail-counter" id="counter"></p>
                <h2 class="rail-detail-name" id="detailName"></h2>
                <div class="rail-view-switch" id="viewSwitch" role="tablist" aria-label="Góc nhìn sản phẩm (Side A / Side B)">
                    <button type="button" class="rail-view-opt is-active" data-view="front" role="tab" aria-selected="true">Side A</button>
                    <span class="rail-view-sep">|</span>
                    <button type="button" class="rail-view-opt is-dimmed" data-view="back" role="tab" aria-selected="false">Side B</button>
                </div>
                <p class="rail-description" id="description"></p>
                <div class="rail-price-line">
                    <span id="detailPrice"></span>
                    <span class="rail-stock" id="stock"></span>
                </div>
                <span class="rail-options-label">MÀU SẮC</span>
                <div class="rail-color-options" id="colors"></div>
                <span class="rail-options-label">KÍCH CỠ</span>
                <div class="rail-size-options" id="sizes"></div>
                <p class="rail-size-hint" id="sizeHint"></p>
                <button type="button" class="rail-cart-cta" id="cartCta">CHỌN KÍCH CỠ</button>
                <p class="rail-delivery">Miễn phí giao hàng toàn quốc từ 500.000 ₫. Đổi trả trong 30 ngày.</p>
            </div>
        </section>

        <!-- Informational Modal -->
        <div class="rail-nav-modal" id="modal" role="dialog" aria-modal="true">
            <div class="rail-modal-body">
                <h2 id="modalTitle">Về HNMTSHOP</h2>
                <p id="modalText"></p>
                <button type="button" class="rail-modal-exit" id="modalExit">ĐÓNG [ESC]</button>
            </div>
        </div>

        <!-- Toast Notification -->
        <aside class="rail-toast" id="toast" role="status" aria-live="polite"></aside>
    </div>

    <script src="~/js/clothing-rail.js" asp-append-version="true"></script>

        <!-- SPOTLIGHT MULTI-CRITERIA QUICK SEARCH MODAL -->
    <div id="hnmtSpotlightSearchModal" class="hnmt-spotlight-modal" aria-hidden="true">
        <div class="hnmt-spotlight-backdrop" id="spotlightBackdrop"></div>
        <div class="hnmt-spotlight-dialog" role="dialog" aria-modal="true" aria-label="Tìm kiếm sản phẩm nhanh">
            <!-- Search Input Header -->
            <div class="hnmt-spotlight-search-header">
                <div class="hnmt-spotlight-input-wrap">
                    <svg class="hnmt-spotlight-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m20 20-4.35-4.35"/>
                    </svg>
                    <input type="text" id="hnmtSpotlightInput" class="hnmt-spotlight-input" placeholder="Tìm kiếm theo tên đồ hoặc từ khóa... (Enter để đẩy lên sào)" autocomplete="off" spellcheck="false">
                    <button type="button" id="hnmtSpotlightClearBtn" class="hnmt-spotlight-clear-btn" aria-label="Xóa từ khóa" style="display: none;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <button type="button" id="hnmtSpotlightSubmitBtn" class="hnmt-spotlight-submit-btn" title="Tìm kiếm và đưa ra sào (Enter)">
                        <i class="bi bi-search"></i>
                        <span>TÌM KIẾM</span>
                    </button>
                </div>
                <div class="hnmt-spotlight-meta">
                    <button type="button" class="hnmt-spotlight-esc-pill" id="spotlightClosePillBtn">ESC ĐÓNG</button>
                </div>
            </div>

            <!-- Category Tabs -->
            <div class="hnmt-spotlight-tabs" id="spotlightTabs">
                <button type="button" class="hnmt-spotlight-tab is-active" data-cat="all">Tất Cả <span class="tab-count" id="tabCountAll">0</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="quan">Sào Quần <span class="tab-count" id="tabCountQuan">12</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="ao">Sào Áo <span class="tab-count" id="tabCountAo">15</span></button>
                <button type="button" class="hnmt-spotlight-tab" data-cat="giay">Tủ Giày <span class="tab-count" id="tabCountGiay">18</span></button>
            </div>

            <!-- Multi-criteria Filter Section -->
            <div class="hnmt-spotlight-filter-panel" id="spotlightFilterPanel">
                <!-- Row 1: Khoảng Giá -->
                <div class="spotlight-filter-row">
                    <span class="filter-row-label">Khoảng Giá:</span>
                    <div class="filter-pills-wrap" id="pricePillsContainer"></div>
                </div>

                <!-- Row 2: Kiểu Cách / Loại Đồ -->
                <div class="spotlight-filter-row">
                    <span class="filter-row-label">Kiểu Dáng:</span>
                    <div class="filter-pills-wrap" id="stylePillsContainer"></div>
                </div>

                <!-- Row 3: Màu Sắc -->
                <div class="spotlight-filter-row">
                    <span class="filter-row-label">Màu Sắc:</span>
                    <div class="filter-pills-wrap" id="colorPillsContainer"></div>
                </div>

                <!-- Action Bar: Đếm số lượng, Reset & Đẩy lên sào -->
                <div class="spotlight-filter-action-bar">
                    <div class="filter-match-stat">
                        <span class="stat-dot"></span>
                        <span>Phù hợp: <strong id="spotlightMatchCount">0</strong> sản phẩm</span>
                    </div>
                    <div class="filter-action-btns">
                        <button type="button" id="spotlightResetFilterBtn" class="spotlight-reset-btn" title="Đặt lại bộ lọc về mặc định">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Đặt lại</span>
                        </button>
                        <button type="button" id="spotlightApplyToRailBtn" class="spotlight-apply-rail-cta" title="Đẩy các sản phẩm phù hợp ra trên sào đồ (Enter)">
                            <i class="bi bi-funnel-fill"></i>
                            <span>ÁP DỤNG LÊN SÀO (<strong id="spotlightRailCount">0</strong>)</span>
                            <kbd>↵ ENTER</kbd>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Results Preview List -->
            <div class="hnmt-spotlight-results" id="spotlightResults"></div>

            <!-- Empty State Notice -->
            <div class="hnmt-spotlight-empty" id="spotlightEmpty" style="display: none;">
                <div class="empty-icon">🔍</div>
                <p class="empty-title">Không tìm thấy sản phẩm phù hợp</p>
                <p class="empty-desc">Thử chọn "Tất cả giá", "Tất cả màu" hoặc bấm "Đặt lại" để xem toàn bộ bộ sưu tập trên sào.</p>
            </div>

            <!-- Footer Hint -->
            <div class="hnmt-spotlight-footer">
                <div class="spotlight-hint">
                    <span><kbd>ENTER</kbd> Đẩy đồ lên sào</span>
                    <span><kbd>↑</kbd><kbd>↓</kbd> Chọn nhanh</span>
                    <span><kbd>ESC</kbd> Đóng</span>
                </div>
                <div class="spotlight-brand">HNMTSHOP // FAST FIND & RAIL FILTER</div>
            </div>
        </div>
    </div>
    </div>

    <script src="~/js/sneaker-vault.js" asp-append-version="true"></script>
    <script src="~/js/shirt-filter.js" asp-append-version="true"></script>
    <script src="~/js/pants-filter.js" asp-append-version="true"></script>
    <script src="~/js/spotlight-search.js" asp-append-version="true"></script>
    <script src="~/js/hnmt-cart-drawer.js" asp-append-version="true"></script>
</body>
</html>
