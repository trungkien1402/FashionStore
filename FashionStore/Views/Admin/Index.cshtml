@model FashionStore.Models.ViewModels.AdminDashboardViewModel

@using System.Text.Json
@using FashionStore.Models.Enums
@using FashionStore.Services.Implementations

@{
    ViewData["Title"] = "Tổng quan";

    var today = AdminReportService.Today;
    var maxQuantity = Model.TopSellingProducts.Any()
        ? Model.TopSellingProducts.Max(p => p.TotalQuantity)
        : 1;

    var revenueLabels = JsonSerializer.Serialize(Model.RevenueChartLabels);
    var revenueData = JsonSerializer.Serialize(Model.RevenueChartData);

    var statusLabels = JsonSerializer.Serialize(Model.OrderStatusLabels);
    var statusData = JsonSerializer.Serialize(Model.OrderStatusData);

    var paymentLabels = JsonSerializer.Serialize(Model.PaymentMethodLabels);
    var paymentData = JsonSerializer.Serialize(Model.PaymentMethodData);
}

<!-- 1. EXECUTIVE ACTION HEADER & APPLE/VERCEL SEGMENTED CONTROL -->
<div class="adm-header-block mb-4">
    <!-- Top Row: Page Title + Live Meta + Primary Actions -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <div class="adm-meta-crumb d-flex align-items-center gap-2 mb-1">
                <span class="adm-pulse-dot"></span>
                <span class="adm-kicker-text">HNMT ATELIER OPERATING SYSTEM</span>
                <span class="adm-meta-divider">•</span>
                <span class="adm-order-count-badge">@Model.TotalOrders đơn trong kỳ</span>
            </div>
            <h1 class="adm-title-main">Tổng quan Doanh thu &amp; Dòng tiền</h1>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Admin"
               asp-action="ExportReport"
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
               class="adm-action-btn adm-btn-primary"
               title="Xuất file báo cáo dạng PDF">
                <i class="bi bi-file-earmark-pdf"></i>
                <span>Xuất PDF</span>
            </a>

            <a asp-action="PrintReport"
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
               class="adm-action-btn adm-btn-secondary"
               title="In nhanh trang báo cáo">
                <i class="bi bi-printer"></i>
                <span>In báo cáo</span>
            </a>
        </div>
    </div>

    <!-- Bottom Row: Unified Filter Strip (Apple macOS Segmented Control + Cohesive Date Compound) -->
    <form asp-controller="Admin" asp-action="Index" method="get" id="admFilterForm" class="adm-filter-toolbar">
        @{
            var curStart = Model.StartDate.ToString("yyyy-MM-dd");
            var curEnd = Model.EndDate.ToString("yyyy-MM-dd");
            var todayStr = today.ToString("yyyy-MM-dd");
            var d7Str = today.AddDays(-6).ToString("yyyy-MM-dd");
            var monthStr = today.AddDays(1 - today.Day).ToString("yyyy-MM-dd");
            var d30Str = today.AddDays(-29).ToString("yyyy-MM-dd");
        }

        <!-- 1. Apple macOS Style Segmented Control for Presets -->
        <div class="adm-segmented-control" role="group" aria-label="Khoảng ngày nhanh">
            <a asp-action="Index" asp-route-startDate="@todayStr" asp-route-endDate="@todayStr" 
               class="adm-segment @(curStart == todayStr && curEnd == todayStr ? "active" : "")">Hôm nay</a>
            <a asp-action="Index" asp-route-startDate="@d7Str" asp-route-endDate="@todayStr" 
               class="adm-segment @(curStart == d7Str && curEnd == todayStr ? "active" : "")">7 ngày</a>
            <a asp-action="Index" asp-route-startDate="@monthStr" asp-route-endDate="@todayStr" 
               class="adm-segment @(curStart == monthStr && curEnd == todayStr ? "active" : "")">Tháng này</a>
            <a asp-action="Index" asp-route-startDate="@d30Str" asp-route-endDate="@todayStr" 
               class="adm-segment @(curStart == d30Str && curEnd == todayStr ? "active" : "")">30 ngày</a>
        </div>

        <!-- 2. Cohesive Date Range Input Compound -->
        <div class="adm-date-compound">
            <i class="bi bi-calendar3 adm-date-icon"></i>
            <input type="date" id="admStartDate" name="startDate" class="adm-date-native" 
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" aria-label="Ngày bắt đầu" />
            <span class="adm-date-arrow"><i class="bi bi-arrow-right"></i></span>
            <input type="date" id="admEndDate" name="endDate" class="adm-date-native" 
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" aria-label="Ngày kết thúc" />
            
            <button type="submit" class="adm-date-apply-btn" title="Áp dụng khoảng ngày đã chọn">
                <i class="bi bi-check-lg"></i>
            </button>
        </div>

        @if (curStart != d7Str || curEnd != todayStr)
        {
            <a asp-controller="Admin" asp-action="Index" class="adm-reset-ghost-btn" title="Đặt lại về mặc định (7 ngày qua)">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Đặt lại</span>
            </a>
        }
    </form>
</div>

<!-- 2. HERO KPI METRICS (4 TILES - STRIPE STYLE) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">

    <!-- KPI 1: DOANH THU THỰC NHẬN -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Doanh thu thực nhận</h2>
                <div class="adm-kpi-chip emerald" title="Đã đối soát">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @Model.RevenueInRange.ToString("N0") <span class="adm-kpi-unit">₫</span>
            </div>
            <div class="adm-kpi-footer">
                <span>Đã giao: <strong class="text-success">@Model.DeliveredOrders</strong></span>
                <span class="text-muted">•</span>
                <span>Đã hủy: <strong class="text-danger">@Model.CancelledOrders</strong></span>
            </div>
        </div>
    </div>

    <!-- KPI 2: ĐƠN CHỜ DUYỆT -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Đơn hàng chờ duyệt</h2>
                <div class="adm-kpi-chip amber" title="Cần duyệt ngay">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @Model.PendingOrders <span class="adm-kpi-unit">đơn</span>
            </div>
            <div class="adm-kpi-footer">
                <span>Tổng tiền đặt:</span>
                <a asp-controller="AdminOrders" asp-action="Index" class="adm-accent-link fw-semibold">
                    @Model.OrderedAmount.ToString("N0") ₫ &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- KPI 3: GIÁ TRỊ ĐÃ THANH TOÁN -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Dòng tiền đã thanh toán</h2>
                <div class="adm-kpi-chip blue" title="Thanh toán thành công">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @Model.PaidAmount.ToString("N0") <span class="adm-kpi-unit">₫</span>
            </div>
            <div class="adm-kpi-footer">
                <span>TB mỗi đơn:</span>
                <span class="adm-text-contrast fw-bold">@Model.AveragePaidOrderValue.ToString("N0") ₫</span>
            </div>
        </div>
    </div>

    <!-- KPI 4: SẢN PHẨM & KHÁCH HÀNG -->
    <div class="col">
        <div class="adm-kpi-card">
            <div class="adm-kpi-top">
                <h2 class="adm-kpi-label">Sản phẩm hoạt động</h2>
                <div class="adm-kpi-chip purple" title="Danh mục & Biến thể">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="adm-kpi-number">
                @Model.TotalProducts <span class="adm-kpi-unit">mặt hàng</span>
            </div>
            <div class="adm-kpi-footer">
                <span>Khách hoạt động:</span>
                <span class="adm-text-contrast fw-bold">@Model.TotalCustomers khách</span>
            </div>
        </div>
    </div>

</div>

<!-- 3. CHARTS SECTION: BENTO GRID 8 : 4 -->
<div class="row g-3 mb-4">

    <!-- REVENUE SPLINE CHART (8 COLS) -->
    <div class="col-xl-8">
        <div class="adm-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 1.05rem;">Giá trị đơn đã giao theo ngày đặt</h5>
                    <p class="text-muted small mb-0">Biểu đồ thể hiện dòng tiền đã giao nhận thành công</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #2563EB; display: inline-block;"></span>
                    <span class="small text-muted fw-semibold" style="font-size: 0.76rem;">Doanh thu thực nhận</span>
                </div>
            </div>

            <div style="height: 290px; position: relative;">
                @if (Model.RevenueChartData.Any(value => value != 0))
                {
                    <canvas id="admRevenueChart" aria-label="Giá trị đơn đã giao theo ngày đặt" role="img"></canvas>
                }
                else
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="bi bi-graph-up fs-2 mb-2 opacity-50"></i>
                        <p class="mb-0 small">Chưa có giao dịch hoàn tất trong kỳ được chọn.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- PAYMENT & ORDER BREAKDOWN (4 COLS) -->
    <div class="col-xl-4">
        <div class="adm-card h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold mb-1 adm-heading" style="font-size: 1.05rem;">Cơ cấu Thanh toán &amp; Đơn hàng</h5>
                <p class="text-muted small mb-3">Tỷ lệ thanh toán VietQR chuyển khoản và tiền mặt khi nhận hàng</p>
            </div>

            <div style="height: 210px; position: relative;">
                <canvas id="admPaymentChart"></canvas>
            </div>

            <div class="pt-3 border-top border-secondary border-opacity-25 mt-3 d-flex justify-content-around text-center">
                <div>
                    <div class="text-muted small" style="font-size: 0.74rem;">Tổng đơn đặt</div>
                    <div class="fw-bold adm-heading fs-5">@Model.OrderStatusData.Sum()</div>
                </div>
                <div class="border-end border-secondary border-opacity-25"></div>
                <div>
                    <div class="text-muted small" style="font-size: 0.74rem;">Cần duyệt gấp</div>
                    <div class="fw-bold text-warning fs-5">@Model.PendingOrders</div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- 4. OPERATIONS TABLE: FULL WIDTH 12 COLS (NO TRUNCATION, AIRY & PROFESSIONAL) -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="adm-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 1.05rem;">Đơn hàng Mới nhất</h5>
                    <p class="text-muted small mb-0">Luồng giao dịch trực tiếp theo thời gian thực</p>
                </div>
                <a asp-controller="AdminOrders" asp-action="Index" class="btn adm-btn-outline py-1 px-3" style="font-size: 0.78rem;">
                    Xem tất cả đơn hàng <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th style="width: 220px;">MÃ ĐƠN HÀNG</th>
                                <th style="width: 200px;">KHÁCH HÀNG</th>
                                <th style="width: 140px;">PHƯƠNG THỨC</th>
                                <th style="width: 160px;">TỔNG TIỀN</th>
                                <th style="width: 150px;">TRẠNG THÁI</th>
                                <th class="text-end" style="width: 110px;">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                var shortCode = order.OrderCode.Length > 12 
                                    ? "#" + order.OrderCode.Substring(order.OrderCode.Length - 10) 
                                    : "#" + order.OrderCode;

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold adm-heading font-monospace" style="font-size: 0.85rem;" title="@order.OrderCode">@shortCode</span>
                                            <button type="button" class="btn btn-sm p-0 text-muted" onclick="copyAdmText(this, '@order.OrderCode')" title="Sao chép toàn bộ mã đơn: @order.OrderCode">
                                                <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@AdminReportService.ToVietnamTime(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="adm-avatar-sm">
                                                @(string.IsNullOrWhiteSpace(order.ReceiverName) ? "K" : order.ReceiverName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-semibold adm-heading" style="font-size: 0.84rem;">@order.ReceiverName</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">@order.Phone</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (order.PaymentMethod == PaymentMethod.VietQR)
                                        {
                                            <span class="badge" style="background: rgba(2, 132, 199, 0.1); color: #0284C7; border: 1px solid rgba(2, 132, 199, 0.25);">
                                                <i class="bi bi-qr-code me-1"></i> VietQR
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: var(--adm-bg-soft); color: var(--adm-ink-muted); border: 1px solid var(--adm-border);">
                                                <i class="bi bi-cash me-1"></i> Tiền mặt COD
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold adm-heading text-nowrap" style="font-size: 0.9rem;">
                                            @order.TotalAmount.ToString("N0") ₫
                                        </span>
                                    </td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.PendingConfirmation:
                                                <span class="adm-pill adm-pill-amber">Chờ duyệt</span>
                                                break;
                                            case OrderStatus.Confirmed:
                                                <span class="adm-pill adm-pill-blue">Đã duyệt</span>
                                                break;
                                            case OrderStatus.Processing:
                                                <span class="adm-pill adm-pill-blue">Xử lý kho</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="adm-pill adm-pill-blue">Đang giao</span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span class="adm-pill adm-pill-emerald">Đã giao</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="adm-pill adm-pill-rose">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="adm-pill adm-pill-faint">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@order.Id"
                                           class="adm-btn-table-action" title="Chi tiết đơn hàng">
                                            <i class="bi bi-eye"></i> <span>Chi tiết</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-2 mb-2 d-block opacity-50"></i>
                    Không có đơn hàng nào trong khoảng thời gian này.
                </div>
            }
        </div>
    </div>
</div>

<!-- 5. BALANCED PRODUCT LEADERBOARD & INVENTORY RADAR (6 COLS + 6 COLS) -->
<div class="row g-3 mb-4">

    <!-- TOP SELLING LEADERBOARD (6 COLS) -->
    <div class="col-lg-6">
        <div class="adm-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 1.05rem;">Top Sản phẩm Bán chạy</h5>
                    <p class="text-muted small mb-0">Xếp hạng theo sản lượng và doanh số</p>
                </div>
                <span class="badge" style="background: rgba(37, 99, 235, 0.1); color: var(--adm-cyan); border: 1px solid rgba(37, 99, 235, 0.2);">
                    LEADERBOARD
                </span>
            </div>

            @if (Model.TopSellingProducts.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @for (int i = 0; i < Model.TopSellingProducts.Count && i < 5; i++)
                    {
                        var item = Model.TopSellingProducts[i];
                        var rankClass = i == 0 ? "adm-rank-1" : i == 1 ? "adm-rank-2" : i == 2 ? "adm-rank-3" : "adm-rank-n";
                        var pct = Math.Min(100, Math.Max(15, (int)((double)item.TotalQuantity / maxQuantity * 100)));

                        <div class="adm-leaderboard-item">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="adm-rank-badge @rankClass">@(i + 1)</span>
                                    <span class="adm-heading fw-semibold" style="font-size: 0.86rem;" title="@item.ProductName">
                                        @item.ProductName
                                    </span>
                                </div>
                                <div class="text-end">
                                    <span class="adm-heading fw-bold" style="font-size: 0.86rem;">@item.TotalQuantity</span>
                                    <span class="text-muted" style="font-size: 0.72rem;">chiếc</span>
                                    @if (item.TotalRevenue > 0)
                                    {
                                        <span class="text-muted mx-1">•</span>
                                        <span class="adm-text-contrast fw-semibold" style="font-size: 0.82rem;">@item.TotalRevenue.ToString("N0") ₫</span>
                                    }
                                </div>
                            </div>
                            <div class="progress" style="height: 4px; background: var(--adm-border); border-radius: 2px;">
                                <div class="progress-bar" style="width: @pct%; background: #2563EB; border-radius: 2px;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-bar-chart fs-3 d-block mb-1 opacity-50"></i>
                    Chưa có số liệu sản phẩm bán ra trong kỳ này.
                </div>
            }
        </div>
    </div>

    <!-- LOW STOCK RADAR (6 COLS) -->
    <div class="col-lg-6">
        <div class="adm-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 adm-heading" style="font-size: 1.05rem;">
                        <i class="bi bi-bell-fill text-danger me-1"></i>Radar Cảnh báo Kho Hàng
                    </h5>
                    <div class="text-muted small">Mức tồn kho an toàn &le; 5 sản phẩm</div>
                </div>
                <a asp-controller="AdminProducts" asp-action="Index" asp-route-stock="low" class="btn adm-btn-outline py-1 px-3" style="font-size: 0.76rem;">
                    Quản lý kho <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            @if (Model.LowStockProducts.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var stock in Model.LowStockProducts.Take(5))
                    {
                        <div class="adm-radar-item">
                            <div>
                                <div class="adm-heading fw-semibold mb-1" style="font-size: 0.86rem;">
                                    @stock.ProductName
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    <span class="adm-variant-tag">Size: @stock.Size</span>
                                    <span class="adm-variant-tag">Màu: @(stock.Color?.Contains("(") == true ? stock.Color.Substring(0, stock.Color.IndexOf('(')).Trim() : stock.Color)</span>
                                    <span class="adm-sku-tag">SKU: @stock.SKU</span>
                                </div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                @if (stock.StockQuantity == 0)
                                {
                                    <span class="adm-stock-pill out-of-stock">
                                        <i class="bi bi-x-circle-fill"></i> Hết hàng (0)
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-stock-pill low-stock">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Còn @stock.StockQuantity chiếc
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-shield-check text-success fs-3 d-block mb-1"></i>
                    Tất cả các mặt hàng hiện đều có mức tồn kho an toàn.
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <script>
        const revenueLabels = @Html.Raw(revenueLabels);
        const revenueData = @Html.Raw(revenueData);

        const statusLabels = @Html.Raw(statusLabels);
        const statusData = @Html.Raw(statusData);

        const paymentLabels = @Html.Raw(paymentLabels);
        const paymentData = @Html.Raw(paymentData);

        let revenueChartInstance = null;
        let paymentChartInstance = null;

        function getChartColors(theme) {
            const isDark = theme === 'dark';
            return {
                textColor: isDark ? '#94A3B8' : '#64748B',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)',
                tooltipBg: isDark ? '#1E293B' : '#FFFFFF',
                tooltipText: isDark ? '#F8FAFC' : '#0F172A',
                tooltipBorder: isDark ? '#334155' : '#E2E8F0',
                borderColor: isDark ? '#38BDF8' : '#2563EB',
                gradientStart: isDark ? 'rgba(56, 189, 248, 0.28)' : 'rgba(37, 99, 235, 0.20)',
                gradientEnd: isDark ? 'rgba(56, 189, 248, 0.0)' : 'rgba(37, 99, 235, 0.0)',
                donutBorder: isDark ? '#111827' : '#FFFFFF'
            };
        }

        function initCharts(theme) {
            const colors = getChartColors(theme);
            Chart.defaults.color = colors.textColor;
            Chart.defaults.font.family = '"Plus Jakarta Sans", system-ui, -apple-system, sans-serif';

            // 1. REVENUE SPLINE
            const revCtx = document.getElementById('admRevenueChart');
            if (revCtx) {
                if (revenueChartInstance) revenueChartInstance.destroy();

                const ctx = revCtx.getContext('2d');
                const gradient = ctx.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, colors.gradientStart);
                gradient.addColorStop(1, colors.gradientEnd);

                revenueChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: revenueLabels,
                        datasets: [{
                            label: 'Giá trị đơn đã giao',
                            data: revenueData,
                            borderColor: colors.borderColor,
                            borderWidth: 2.5,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: colors.borderColor,
                            pointBorderColor: theme === 'dark' ? '#111827' : '#FFFFFF',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: colors.tooltipBg,
                                titleColor: colors.tooltipText,
                                bodyColor: colors.borderColor,
                                borderColor: colors.tooltipBorder,
                                borderWidth: 1,
                                padding: 12,
                                displayColors: false,
                                callbacks: {
                                    label: function(context) {
                                        return 'Giá trị đơn đã giao: ' + Number(context.parsed.y).toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: colors.gridColor },
                                ticks: { color: colors.textColor }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: colors.gridColor },
                                ticks: {
                                    color: colors.textColor,
                                    callback: function(value) {
                                        if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                        if (value >= 1000) return (value / 1000).toFixed(0) + 'k';
                                        return value;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. PAYMENT DONUT
            const payCtx = document.getElementById('admPaymentChart');
            if (payCtx) {
                if (paymentChartInstance) paymentChartInstance.destroy();

                paymentChartInstance = new Chart(payCtx, {
                    type: 'doughnut',
                    data: {
                        labels: paymentLabels,
                        datasets: [{
                            data: paymentData,
                            backgroundColor: [
                                theme === 'dark' ? 'rgba(255, 255, 255, 0.15)' : '#E2E8F0', // COD
                                '#0284C7'                                                  // VietQR
                            ],
                            borderColor: colors.donutBorder,
                            borderWidth: 3,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: colors.textColor,
                                    padding: 16,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: colors.tooltipBg,
                                titleColor: colors.tooltipText,
                                borderColor: colors.tooltipBorder,
                                borderWidth: 1,
                                padding: 10
                            }
                        }
                    }
                });
            }
        }

        // Global callback for admin-atelier.js theme toggle
        window.updateAdmChartsTheme = function(theme) {
            initCharts(theme);
        };

        // Initialize with active theme (default: light)
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        initCharts(currentTheme);
    </script>
}
