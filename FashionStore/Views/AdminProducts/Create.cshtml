@model FashionStore.Models.ViewModels.AdminProductViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<!-- 1. BREADCRUMB & HEADER -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <a asp-action="Index" class="adm-btn-action-secondary" style="height: 32px; padding: 0 12px; font-size: 0.78rem;">
            <i class="bi bi-arrow-left"></i>
            <span>Quay lại Showroom</span>
        </a>
        <span class="text-muted" style="font-size: 0.75rem;">/</span>
        <span class="text-muted" style="font-size: 0.75rem;">HNMT ATELIER · SHOWROOM STUDIO</span>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="adm-title-main mb-1" style="font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em;">
                Thêm Sản phẩm &amp; Khởi tạo Kho
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.78rem;">
                Nhập thông tin sản phẩm và thiết lập ma trận biến thể (Size, Màu, Tồn kho) trên cùng một trang.
            </p>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="createProductForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2 px-3 border-0" style="font-size: 0.82rem; border-radius: 8px;"></div>

    <div class="row g-4">
        <!-- LEFT COLUMN: MAIN SPECS & VARIANT MATRIX -->
        <div class="col-lg-8">

            <!-- CARD 1: THÔNG TIN CƠ BẢN -->
            <div class="adm-card mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-info-circle text-primary" style="font-size: 1rem;"></i>
                    <h2 class="fw-bold mb-0" style="font-size: 0.92rem; color: var(--adm-ink);">Thông tin Cơ bản</h2>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-muted small mb-1" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 600;">
                        Tên sản phẩm *
                    </label>
                    <input asp-for="Name" class="form-control adm-input-dark" id="productName"
                           placeholder="Ví dụ: Áo Thun Oversize Heavyweight, Áo Khoác Denim Atelier..."
                           style="height: 38px; font-size: 0.85rem;" required />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block" style="font-size: 0.74rem;"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label text-muted small mb-1" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 600;">
                            Giá bán niêm yết (₫) *
                        </label>
                        <div class="input-group">
                            <input asp-for="Price" type="number" min="1000" step="1000" id="productPrice"
                                   class="form-control adm-input-dark" placeholder="350000"
                                   style="height: 38px; font-size: 0.85rem;" required />
                            <span class="input-group-text border-start-0 text-muted" style="background: var(--adm-surface); border-color: var(--adm-border); font-size: 0.82rem;">
                                ₫
                            </span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block" style="font-size: 0.74rem;"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label text-muted small mb-1" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 600;">
                            Bộ sưu tập / Danh mục *
                        </label>
                        <select asp-for="CategoryId" class="form-select adm-input-dark" id="productCategory"
                                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))"
                                style="height: 38px; font-size: 0.85rem;" required>
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block" style="font-size: 0.74rem;"></span>
                    </div>
                </div>

                <div class="mb-0">
                    <label asp-for="Description" class="form-label text-muted small mb-1" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 600;">
                        Mô tả &amp; Chi tiết chất liệu
                    </label>
                    <textarea asp-for="Description" class="form-control adm-input-dark" rows="4"
                              placeholder="Chi tiết chất liệu (Cotton 100%, GSM 320), kiểu phom (Boxy Fit), thông số giặt ủi..."
                              style="font-size: 0.84rem;"></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block" style="font-size: 0.74rem;"></span>
                </div>
            </div>

            <!-- CARD 2: CẤU HÌNH SIZE, MÀU & MA TRẬN KHO (GAME CHANGER!) -->
            <div class="adm-card mb-4" style="border: 2px solid #0F172A !important;">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-layers-half text-warning" style="font-size: 1.1rem;"></i>
                        <div>
                            <h2 class="fw-bold mb-0" style="font-size: 0.95rem; color: var(--adm-ink);">
                                Phân loại Biến thể &amp; Khởi tạo Kho hàng
                            </h2>
                            <div class="text-muted" style="font-size: 0.74rem;">
                                Tạo size, màu sắc và số lượng tồn kho để sản phẩm mở bán được ngay.
                            </div>
                        </div>
                    </div>

                    <!-- PRODUCT TYPE TOGGLE -->
                    <div class="adm-segmented-control" role="group" aria-label="Loại sản phẩm" style="padding: 3px;">
                        <label class="adm-segment active" id="btnTypeVariants" style="cursor: pointer; font-size: 0.76rem;">
                            <input type="radio" name="ProductType" value="variants" checked class="d-none" id="radioVariants" />
                            <i class="bi bi-grid-3x3-gap me-1"></i> Có nhiều Size / Màu
                        </label>
                        <label class="adm-segment" id="btnTypeSimple" style="cursor: pointer; font-size: 0.76rem;">
                            <input type="radio" name="ProductType" value="simple" class="d-none" id="radioSimple" />
                            <i class="bi bi-tag me-1"></i> FreeSize / 1 cỡ
                        </label>
                    </div>
                </div>

                <!-- 2A. PANEL SIMPLE PRODUCT (FREESIZE) -->
                <div id="panelSimpleProduct" class="d-none p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                    <div class="row align-items-center g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 600;">
                                Số lượng tồn kho ban đầu (cái) *
                            </label>
                            <input type="number" min="0" name="SimpleStock" value="20" class="form-control adm-input-dark" style="height: 38px; font-size: 0.88rem; font-weight: 600;" />
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted" style="font-size: 0.76rem; line-height: 1.45;">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                Hệ thống sẽ tự động tạo một phân loại <strong>FreeSize / Tiêu chuẩn</strong> với số tồn kho này. Khách hàng có thể đặt mua ngay lập tức.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2B. PANEL MATRIX VARIANTS (SIZE & COLOR CHIPS GENERATOR) -->
                <div id="panelMatrixVariants">
                    <!-- 1. QUICK SIZE CHIPS -->
                    <div class="mb-3 p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="text-muted small mb-0" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                                1. Chọn các kích cỡ (Sizes)
                            </label>
                            <span class="text-muted" style="font-size: 0.7rem;">Click để chọn nhanh</span>
                        </div>

                        <!-- CLOTHING SIZES -->
                        <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                            <span class="text-muted small me-2" style="font-size: 0.7rem;">Quần áo:</span>
                            @foreach (var s in new[] { "XS", "S", "M", "L", "XL", "2XL", "3XL", "FreeSize" })
                            {
                                <button type="button" class="adm-chip-btn size-chip @(s == "S" || s == "M" || s == "L" ? "active" : "")" data-size="@s">
                                    <span>@s</span>
                                </button>
                            }
                        </div>

                        <!-- SHOE SIZES -->
                        <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                            <span class="text-muted small me-2" style="font-size: 0.7rem;">Giày dép:</span>
                            @foreach (var s in new[] { "38", "39", "40", "41", "42", "43", "44" })
                            {
                                <button type="button" class="adm-chip-btn size-chip" data-size="@s">
                                    <span>@s</span>
                                </button>
                            }
                        </div>

                        <!-- CUSTOM SIZE INPUT -->
                        <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top" style="border-color: var(--adm-border) !important;">
                            <input type="text" id="customSizeInput" placeholder="Thêm size khác (VD: 29, 30, Oversized...)" class="form-control adm-input-dark" style="height: 32px; font-size: 0.78rem; max-width: 280px;" />
                            <button type="button" id="btnAddCustomSize" class="adm-btn-action-secondary" style="height: 32px; padding: 0 12px; font-size: 0.76rem;">
                                <i class="bi bi-plus-lg"></i> Thêm size
                            </button>
                        </div>
                    </div>

                    <!-- 2. QUICK COLOR CHIPS -->
                    <div class="mb-3 p-3 rounded-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="text-muted small mb-0" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                                2. Chọn các màu sắc (Colors / Phối màu giày)
                            </label>
                            <span class="text-muted" style="font-size: 0.7rem;">Click để chọn nhanh</span>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                            <button type="button" class="adm-chip-btn color-chip active" data-color="Đen">
                                <span class="adm-swatch-dot" style="background: #18181B;"></span>
                                <span>Đen</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Trắng">
                                <span class="adm-swatch-dot" style="background: #FFFFFF; border: 1px solid #CBD5E1;"></span>
                                <span>Trắng</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Xám">
                                <span class="adm-swatch-dot" style="background: #71717A;"></span>
                                <span>Xám</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Be">
                                <span class="adm-swatch-dot" style="background: #E5D9C5;"></span>
                                <span>Be</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Xanh Navy">
                                <span class="adm-swatch-dot" style="background: #1E3A8A;"></span>
                                <span>Xanh Navy</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Nâu">
                                <span class="adm-swatch-dot" style="background: #78350F;"></span>
                                <span>Nâu</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Xanh Rêu">
                                <span class="adm-swatch-dot" style="background: #4D7C0F;"></span>
                                <span>Xanh Rêu</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Đen / Cam">
                                <span class="adm-swatch-dot" style="background: linear-gradient(135deg, #18181B 50%, #EA580C 50%);"></span>
                                <span>Đen / Cam</span>
                            </button>
                            <button type="button" class="adm-chip-btn color-chip" data-color="Trắng / Xanh">
                                <span class="adm-swatch-dot" style="background: linear-gradient(135deg, #FFFFFF 50%, #2563EB 50%); border: 1px solid #CBD5E1;"></span>
                                <span>Trắng / Xanh</span>
                            </button>
                        </div>

                        <!-- CUSTOM COLOR INPUT WITH MINI COLOR PICKER -->
                        <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top" style="border-color: var(--adm-border) !important;">
                            <input type="color" id="customColorPicker" value="#7C3AED" class="adm-color-picker-mini" title="Chọn màu trực quan" />
                            <input type="text" id="customColorInput" placeholder="Tên màu (VD: Tím Khói, Xanh Rêu Phối Cam...)" class="form-control adm-input-dark" style="height: 32px; font-size: 0.78rem; max-width: 280px;" />
                            <button type="button" id="btnAddCustomColor" class="adm-btn-action-secondary" style="height: 32px; padding: 0 12px; font-size: 0.76rem;">
                                <i class="bi bi-plus-lg"></i> Thêm màu
                            </button>
                        </div>
                    </div>

                    <!-- 3. LIVE MATRIX TABLE & BULK STOCK CONTROLS -->
                    <div class="pt-2">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold" style="font-size: 0.86rem; color: var(--adm-ink);">Bảng Biến thể Tự động sinh:</span>
                                <span class="adm-pill gray" id="lblVariantCount" style="font-size: 0.72rem;">0 phân loại</span>
                            </div>

                            <!-- BULK STOCK TOOL -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small" style="font-size: 0.72rem;">Điền tồn kho hàng loạt:</span>
                                <input type="number" min="0" id="bulkStockInput" value="15" class="form-control adm-input-dark text-center" style="height: 30px; width: 65px; font-size: 0.78rem; padding: 0;" />
                                <button type="button" id="btnApplyBulkStock" class="adm-btn-action-secondary" style="height: 30px; padding: 0 10px; font-size: 0.74rem;" title="Áp dụng số tồn này cho toàn bộ bảng">
                                    <i class="bi bi-check2-all me-1"></i> Áp dụng tất cả
                                </button>
                            </div>
                        </div>

                        <!-- DYNAMIC VARIANT TABLE -->
                        <div class="table-responsive border rounded-3" style="border-color: var(--adm-border) !important;">
                            <table class="table align-middle mb-0" id="matrixTable" style="font-size: 0.82rem; border-color: var(--adm-border);">
                                <thead>
                                    <tr style="background: var(--adm-surface-hover); font-size: 0.72rem; color: var(--adm-ink-muted); text-transform: uppercase;">
                                        <th class="ps-3 py-2">Phân loại</th>
                                        <th class="py-2" style="width: 25%;">Mã SKU</th>
                                        <th class="py-2 text-end" style="width: 22%;">Giá bán (₫)</th>
                                        <th class="py-2 text-center" style="width: 18%;">Tồn kho</th>
                                        <th class="py-2 pe-3 text-end" style="width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="matrixTableBody">
                                    <!-- Populated via JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: MEDIA, PREVIEW & SUBMIT -->
        <div class="col-lg-4">

            <!-- CARD 1: ATELIER PHOTO STUDIO & BACKGROUND ENGINE -->
            <div class="adm-card mb-4" style="border: 1px solid var(--adm-border);">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-camera text-primary" style="font-size: 1.05rem;"></i>
                        <div>
                            <h2 class="fw-bold mb-0" style="font-size: 0.92rem; color: var(--adm-ink);">
                                Studio &amp; Chuẩn hóa Ảnh
                            </h2>
                        </div>
                    </div>
                    <span id="studioProtocolBadge" class="badge" style="background: #18181B; color: #FAF8F5; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; padding: 4px 8px;">
                        ÁO / QUẦN (3 GÓC)
                    </span>
                </div>

                <!-- STUDIO BACKDROP SELECTOR -->
                <div class="p-2 mb-3 rounded-2" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">
                            Phông nền Studio:
                        </span>
                        <span class="text-muted" style="font-size: 0.68rem;">Đồng bộ toàn web</span>
                    </div>
                    <div class="d-flex gap-1" id="backdropButtonGroup">
                        <button type="button" class="btn btn-sm adm-chip-btn active flex-fill justify-content-center backdrop-btn" data-backdrop="atelier" onclick="selectBackdrop('atelier')">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #FAF8F5; border: 1px solid #D4AF37; display: inline-block;"></span>
                            <span style="font-size: 0.72rem;">Atelier Ấm</span>
                        </button>
                        <button type="button" class="btn btn-sm adm-chip-btn flex-fill justify-content-center backdrop-btn" data-backdrop="white" onclick="selectBackdrop('white')">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #FFFFFF; border: 1px solid #CBD5E1; display: inline-block;"></span>
                            <span style="font-size: 0.72rem;">Trắng Tinh</span>
                        </button>
                        <button type="button" class="btn btn-sm adm-chip-btn flex-fill justify-content-center backdrop-btn" data-backdrop="transparent" onclick="selectBackdrop('transparent')">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: repeating-conic-gradient(#808080 0% 25%, transparent 0% 50%) 50%/6px 6px; display: inline-block;"></span>
                            <span style="font-size: 0.72rem;">Trong suốt</span>
                        </button>
                    </div>
                    <input type="hidden" asp-for="StudioBackdrop" id="studioBackdropInput" value="atelier" />
                </div>

                <!-- PROTOCOL SLOT TABS -->
                <div class="d-flex gap-1 mb-2 border-bottom pb-2" style="border-color: var(--adm-border) !important;">
                    <button type="button" class="adm-chip-btn slot-tab-btn active flex-fill justify-content-center" data-slot="1" onclick="switchSlot(1)">
                        <span id="tab1Title">Mặt trước *</span>
                    </button>
                    <button type="button" class="adm-chip-btn slot-tab-btn flex-fill justify-content-center" data-slot="2" onclick="switchSlot(2)">
                        <span id="tab2Title">Mặt sau</span>
                    </button>
                    <button type="button" class="adm-chip-btn slot-tab-btn flex-fill justify-content-center" data-slot="3" onclick="switchSlot(3)">
                        <span id="tab3Title">Bên hông</span>
                    </button>
                </div>

                <!-- HIDDEN FILE INPUTS FOR 3 SLOTS -->
                <input asp-for="ImageFile" type="file" id="inputSlot1" class="d-none" accept=".jpg,.jpeg,.png,.webp" required onchange="handleSlotFileSelect(1, this)" />
                <input asp-for="ImageBackFile" type="file" id="inputSlot2" class="d-none" accept=".jpg,.jpeg,.png,.webp" onchange="handleSlotFileSelect(2, this)" />
                <input asp-for="ImageSideFile" type="file" id="inputSlot3" class="d-none" accept=".jpg,.jpeg,.png,.webp" onchange="handleSlotFileSelect(3, this)" />

                <!-- SLOT 1 CONTAINER -->
                <div class="slot-pane" id="paneSlot1">
                    <div class="adm-dropzone mb-2" id="dropZone1" onclick="triggerSlotUpload(1)">
                        <div id="placeholder1" class="text-center py-3">
                            <div id="ghostIcon1" class="mb-2"></div>
                            <div class="fw-semibold" id="slot1TitleText" style="font-size: 0.82rem; color: var(--adm-ink);">
                                Tải ảnh Mặt trước
                            </div>
                            <div class="text-muted small mt-1" id="slot1DescText" style="font-size: 0.7rem;">
                                Chụp phẳng phiu nhìn thẳng, thấy trọn vẹn phom dáng
                            </div>
                        </div>
                        <div id="previewContainer1" class="d-none position-relative">
                            <img id="previewImg1" src="#" alt="Slot 1" class="rounded-2" style="width: 100%; max-height: 220px; object-fit: contain; transition: all 0.2s;" />
                            <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle" style="width: 26px; height: 26px; padding: 0;" onclick="removeSlotImage(1, event)" title="Xóa">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnMagic1" class="adm-btn-action-primary flex-fill justify-content-center py-1" style="height: 32px; font-size: 0.74rem;" onclick="processMagicBackdrop(1)" disabled>
                            <i class="bi bi-magic me-1"></i> Tách nền &amp; Gắn Studio
                        </button>
                        <button type="button" id="btnReset1" class="adm-btn-action-secondary py-1" style="height: 32px; font-size: 0.74rem;" onclick="resetSlotImage(1)" title="Ảnh gốc" disabled>
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- SLOT 2 CONTAINER -->
                <div class="slot-pane d-none" id="paneSlot2">
                    <div class="adm-dropzone mb-2" id="dropZone2" onclick="triggerSlotUpload(2)">
                        <div id="placeholder2" class="text-center py-3">
                            <div id="ghostIcon2" class="mb-2"></div>
                            <div class="fw-semibold" id="slot2TitleText" style="font-size: 0.82rem; color: var(--adm-ink);">
                                Tải ảnh Mặt sau
                            </div>
                            <div class="text-muted small mt-1" id="slot2DescText" style="font-size: 0.7rem;">
                                Chụp lưng áo/quần hoặc góc xoay 180°
                            </div>
                        </div>
                        <div id="previewContainer2" class="d-none position-relative">
                            <img id="previewImg2" src="#" alt="Slot 2" class="rounded-2" style="width: 100%; max-height: 220px; object-fit: contain; transition: all 0.2s;" />
                            <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle" style="width: 26px; height: 26px; padding: 0;" onclick="removeSlotImage(2, event)" title="Xóa">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnMagic2" class="adm-btn-action-primary flex-fill justify-content-center py-1" style="height: 32px; font-size: 0.74rem;" onclick="processMagicBackdrop(2)" disabled>
                            <i class="bi bi-magic me-1"></i> Tách nền &amp; Gắn Studio
                        </button>
                        <button type="button" id="btnReset2" class="adm-btn-action-secondary py-1" style="height: 32px; font-size: 0.74rem;" onclick="resetSlotImage(2)" title="Ảnh gốc" disabled>
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- SLOT 3 CONTAINER -->
                <div class="slot-pane d-none" id="paneSlot3">
                    <div class="adm-dropzone mb-2" id="dropZone3" onclick="triggerSlotUpload(3)">
                        <div id="placeholder3" class="text-center py-3">
                            <div id="ghostIcon3" class="mb-2"></div>
                            <div class="fw-semibold" id="slot3TitleText" style="font-size: 0.82rem; color: var(--adm-ink);">
                                Tải ảnh Bên hông
                            </div>
                            <div class="text-muted small mt-1" id="slot3DescText" style="font-size: 0.7rem;">
                                Góc nhìn sườn áo hoặc chi tiết đường kim mũi chỉ
                            </div>
                        </div>
                        <div id="previewContainer3" class="d-none position-relative">
                            <img id="previewImg3" src="#" alt="Slot 3" class="rounded-2" style="width: 100%; max-height: 220px; object-fit: contain; transition: all 0.2s;" />
                            <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle" style="width: 26px; height: 26px; padding: 0;" onclick="removeSlotImage(3, event)" title="Xóa">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnMagic3" class="adm-btn-action-primary flex-fill justify-content-center py-1" style="height: 32px; font-size: 0.74rem;" onclick="processMagicBackdrop(3)" disabled>
                            <i class="bi bi-magic me-1"></i> Tách nền &amp; Gắn Studio
                        </button>
                        <button type="button" id="btnReset3" class="adm-btn-action-secondary py-1" style="height: 32px; font-size: 0.74rem;" onclick="resetSlotImage(3)" title="Ảnh gốc" disabled>
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- STATUS SUMMARY OF SLOTS -->
                <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between" style="border-color: var(--adm-border) !important; font-size: 0.72rem;">
                    <span class="text-muted">Tiến độ studio:</span>
                    <span id="studioProgressText" class="fw-bold" style="color: var(--adm-ink);">0/3 ảnh đã tải</span>
                </div>
                <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block" style="font-size: 0.74rem;"></span>
            </div>

            <!-- CARD 2: STATUS & SALES CHANNELS -->
            <div class="adm-card mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-toggles text-primary" style="font-size: 1rem;"></i>
                    <h2 class="fw-bold mb-0" style="font-size: 0.92rem; color: var(--adm-ink);">Trạng thái &amp; Hiển thị</h2>
                </div>

                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-0">
                    <label class="form-check-label fw-semibold" for="IsActive" style="cursor: pointer; font-size: 0.84rem; color: var(--adm-ink);">
                        Mở bán ngay trên Shop
                        <div class="text-muted fw-normal" style="font-size: 0.74rem;">Khách hàng có thể tìm kiếm và đặt mua ngay</div>
                    </label>
                    <input asp-for="IsActive" class="form-check-input ms-3" type="checkbox" role="switch" id="IsActive" checked style="cursor: pointer; width: 2.4em; height: 1.25em;" />
                </div>
            </div>

            <!-- CARD 3: SUBMIT ACTIONS -->
            <div class="adm-card" style="border: 1px solid var(--adm-border);">
                <button type="submit" class="adm-btn-action-primary py-2 mb-2 w-100 justify-content-center" style="height: 42px; font-size: 0.86rem; font-weight: 700;">
                    <i class="bi bi-check2-circle fs-5 me-1"></i>
                    <span>Lưu &amp; Kích hoạt Bán ngay</span>
                </button>

                <a asp-action="Index" class="adm-btn-action-secondary py-2 w-100 justify-content-center text-decoration-none" style="height: 38px;">
                    Hủy &amp; Quay lại
                </a>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 1. PRODUCT TYPE TOGGLE (Variants vs Simple)
        const btnTypeVariants = document.getElementById('btnTypeVariants');
        const btnTypeSimple = document.getElementById('btnTypeSimple');
        const radioVariants = document.getElementById('radioVariants');
        const radioSimple = document.getElementById('radioSimple');
        const panelMatrixVariants = document.getElementById('panelMatrixVariants');
        const panelSimpleProduct = document.getElementById('panelSimpleProduct');

        function setProductType(type) {
            if (type === 'simple') {
                radioSimple.checked = true;
                btnTypeSimple.classList.add('active');
                btnTypeVariants.classList.remove('active');
                panelMatrixVariants.classList.add('d-none');
                panelSimpleProduct.classList.remove('d-none');
            } else {
                radioVariants.checked = true;
                btnTypeVariants.classList.add('active');
                btnTypeSimple.classList.remove('active');
                panelSimpleProduct.classList.add('d-none');
                panelMatrixVariants.classList.remove('d-none');
                renderMatrix();
            }
        }

        btnTypeVariants?.addEventListener('click', () => setProductType('variants'));
        btnTypeSimple?.addEventListener('click', () => setProductType('simple'));

        // 2. ACTIVE SIZES AND COLORS STATE
        let activeSizes = ['S', 'M', 'L'];
        let activeColors = ['Đen'];
        const customColorHexMap = {};

        const FASHION_COLOR_MAP = {
            "đen": "#18181B", "black": "#18181B",
            "trắng": "#FFFFFF", "white": "#FFFFFF",
            "xám": "#71717A", "ghi": "#71717A", "gray": "#71717A",
            "be": "#E5D9C5", "kem": "#E5D9C5", "cream": "#E5D9C5", "beige": "#E5D9C5",
            "nâu": "#78350F", "brown": "#78350F",
            "xanh navy": "#1E3A8A", "navy": "#1E3A8A",
            "xanh rêu": "#4D7C0F", "olive": "#4D7C0F",
            "xanh lá": "#16A34A", "green": "#16A34A",
            "xanh dương": "#2563EB", "blue": "#2563EB",
            "xanh cobalt": "#1D4ED8", "cobalt": "#1D4ED8",
            "xanh mint": "#6EE7B7", "mint": "#6EE7B7",
            "xanh bơ": "#A3E635",
            "đỏ": "#DC2626", "red": "#DC2626",
            "đỏ rượu": "#881337", "burgundy": "#881337",
            "hồng": "#F472B6", "pink": "#F472B6",
            "hồng pastel": "#FBCFE8",
            "cam": "#EA580C", "orange": "#EA580C",
            "vàng": "#EAB308", "yellow": "#EAB308",
            "tím": "#7C3AED", "purple": "#7C3AED"
        };

        function getColorStyle(name) {
            if (!name) return '#71717A';
            if (customColorHexMap[name]) return customColorHexMap[name];
            const norm = name.toLowerCase().trim();
            if (norm.includes('/') || norm.includes('&')) {
                const parts = norm.split(/[/&]/);
                if (parts.length >= 2) {
                    const c1 = FASHION_COLOR_MAP[parts[0].trim()] || '#18181B';
                    const c2 = FASHION_COLOR_MAP[parts[1].trim()] || '#2563EB';
                    return `linear-gradient(135deg, ${c1} 50%, ${c2} 50%)`;
                }
            }
            return FASHION_COLOR_MAP[norm] || '#71717A';
        }

        function initChips() {
            document.querySelectorAll('.size-chip').forEach(btn => {
                btn.addEventListener('click', () => {
                    const size = btn.getAttribute('data-size');
                    if (btn.classList.contains('active')) {
                        btn.classList.remove('active');
                        activeSizes = activeSizes.filter(s => s !== size);
                    } else {
                        btn.classList.add('active');
                        if (!activeSizes.includes(size)) activeSizes.push(size);
                    }
                    renderMatrix();
                });
            });

            document.querySelectorAll('.color-chip').forEach(btn => {
                btn.addEventListener('click', () => {
                    const color = btn.getAttribute('data-color');
                    if (btn.classList.contains('active')) {
                        btn.classList.remove('active');
                        activeColors = activeColors.filter(c => c !== color);
                    } else {
                        btn.classList.add('active');
                        if (!activeColors.includes(color)) activeColors.push(color);
                    }
                    renderMatrix();
                });
            });
        }
        initChips();

        // ADD CUSTOM SIZE
        document.getElementById('btnAddCustomSize')?.addEventListener('click', () => {
            const input = document.getElementById('customSizeInput');
            const val = input.value.trim();
            if (!val) return;
            if (!activeSizes.includes(val)) {
                activeSizes.push(val);
                const newChip = document.createElement('button');
                newChip.type = 'button';
                newChip.className = 'adm-chip-btn size-chip active';
                newChip.setAttribute('data-size', val);
                newChip.innerHTML = `<span>${val}</span>`;
                newChip.addEventListener('click', () => {
                    if (newChip.classList.contains('active')) {
                        newChip.classList.remove('active');
                        activeSizes = activeSizes.filter(s => s !== val);
                    } else {
                        newChip.classList.add('active');
                        if (!activeSizes.includes(val)) activeSizes.push(val);
                    }
                    renderMatrix();
                });
                input.parentElement.before(newChip);
            }
            input.value = '';
            renderMatrix();
        });

        // ADD CUSTOM COLOR
        document.getElementById('btnAddCustomColor')?.addEventListener('click', () => {
            const input = document.getElementById('customColorInput');
            const picker = document.getElementById('customColorPicker');
            const val = input.value.trim();
            if (!val) return;

            const chosenHex = picker ? picker.value : '#7C3AED';
            customColorHexMap[val] = chosenHex;

            if (!activeColors.includes(val)) {
                activeColors.push(val);
                const newChip = document.createElement('button');
                newChip.type = 'button';
                newChip.className = 'adm-chip-btn color-chip active';
                newChip.setAttribute('data-color', val);
                newChip.innerHTML = `<span class="adm-swatch-dot" style="background: ${chosenHex};"></span><span>${val}</span>`;
                newChip.addEventListener('click', () => {
                    if (newChip.classList.contains('active')) {
                        newChip.classList.remove('active');
                        activeColors = activeColors.filter(c => c !== val);
                    } else {
                        newChip.classList.add('active');
                        if (!activeColors.includes(val)) activeColors.push(val);
                    }
                    renderMatrix();
                });
                input.parentElement.before(newChip);
            }
            input.value = '';
            renderMatrix();
        });

        // 3. GENERATE SLUG HELPER
        function makeSlug(str) {
            return str.toLowerCase().trim()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9 -]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        }

        // 4. RENDER MATRIX TABLE
        function renderMatrix() {
            const tbody = document.getElementById('matrixTableBody');
            const lblCount = document.getElementById('lblVariantCount');
            if (!tbody) return;

            const prodName = document.getElementById('productName')?.value.trim() || 'SP';
            const baseSlug = makeSlug(prodName).toUpperCase() || 'PROD';
            const defaultPrice = document.getElementById('productPrice')?.value || '350000';
            const bulkStock = document.getElementById('bulkStockInput')?.value || '15';

            const sizes = activeSizes.length > 0 ? activeSizes : ['FreeSize'];
            const colors = activeColors.length > 0 ? activeColors : ['Tiêu chuẩn'];

            let html = '';
            let index = 0;

            sizes.forEach(size => {
                colors.forEach(color => {
                    const sizeSlug = makeSlug(size).toUpperCase();
                    const colorSlug = makeSlug(color).toUpperCase();
                    const generatedSku = `${baseSlug}-${sizeSlug}-${colorSlug}`;
                    const cStyle = getColorStyle(color);
                    const isWhite = color.toLowerCase().includes('trắng');

                    html += `
                        <tr id="rowVariant_${index}" style="border-bottom: 1px solid var(--adm-border);">
                            <td class="ps-3 py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="adm-pill gray" style="font-size: 0.74rem; font-weight: 600;">Size: ${size}</span>
                                    <span class="adm-pill gray d-flex align-items-center gap-1" style="font-size: 0.74rem;">
                                        <span class="adm-swatch-dot" style="background: ${cStyle}; ${isWhite ? 'border: 1px solid #CBD5E1;' : ''}"></span>
                                        <span>${color}</span>
                                    </span>
                                    <input type="hidden" name="Variants[${index}].Size" value="${size}" />
                                    <input type="hidden" name="Variants[${index}].Color" value="${color}" />
                                    <input type="hidden" name="Variants[${index}].IsActive" value="true" />
                                </div>
                            </td>
                            <td>
                                <input type="text" name="Variants[${index}].SKU" value="${generatedSku}"
                                       class="form-control adm-input-dark font-monospace variant-sku-input"
                                       style="height: 32px; font-size: 0.78rem;" />
                            </td>
                            <td class="text-end">
                                <input type="number" min="0" step="1000" name="Variants[${index}].Price" value="${defaultPrice}"
                                       class="form-control adm-input-dark text-end variant-price-input"
                                       style="height: 32px; font-size: 0.78rem;" />
                            </td>
                            <td class="text-center">
                                <input type="number" min="0" name="Variants[${index}].StockQuantity" value="${bulkStock}"
                                       class="form-control adm-input-dark text-center variant-stock-input"
                                       style="height: 32px; font-size: 0.82rem; font-weight: 600;" />
                            </td>
                            <td class="pe-3 text-end">
                                <button type="button" class="btn btn-sm text-danger p-0 border-0" onclick="removeVariantRow(${index})" title="Bỏ phân loại này">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    index++;
                });
            });

            tbody.innerHTML = html;
            if (lblCount) lblCount.textContent = `${index} phân loại`;
        }

        // UPDATE PRICES OR SKUS WHEN MAIN INPUTS CHANGE
        document.getElementById('productName')?.addEventListener('input', () => {
            // Update SKUs if not manually modified
            const baseSlug = makeSlug(document.getElementById('productName').value).toUpperCase() || 'PROD';
            document.querySelectorAll('.variant-sku-input').forEach(input => {
                const parts = input.value.split('-');
                if (parts.length >= 3) {
                    input.value = `${baseSlug}-${parts[parts.length - 2]}-${parts[parts.length - 1]}`;
                }
            });
        });

        document.getElementById('productPrice')?.addEventListener('input', (e) => {
            const newPrice = e.target.value;
            if (newPrice) {
                document.querySelectorAll('.variant-price-input').forEach(input => {
                    input.value = newPrice;
                });
            }
        });

        // BULK APPLY STOCK BUTTON
        document.getElementById('btnApplyBulkStock')?.addEventListener('click', () => {
            const bulkVal = document.getElementById('bulkStockInput')?.value || '10';
            document.querySelectorAll('.variant-stock-input').forEach(input => {
                input.value = bulkVal;
            });
        });

        function removeVariantRow(index) {
            const row = document.getElementById(`rowVariant_${index}`);
            row?.remove();
            const currentRows = document.querySelectorAll('#matrixTableBody tr').length;
            const lblCount = document.getElementById('lblVariantCount');
            if (lblCount) lblCount.textContent = `${currentRows} phân loại`;
        }

        // INITIAL RENDER
        renderMatrix();

        // 5. ATELIER PHOTO STUDIO & BACKGROUND ENGINE
        let currentStudioProtocol = 'apparel';
        let currentBackdrop = 'atelier';
        let activeSlot = 1;
        const originalDataUrls = { 1: null, 2: null, 3: null };

        const ghostSvg = {
            shirtFront: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>`,
            shirtBack: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/><line x1="12" y1="2" x2="12" y2="7"/></svg>`,
            shirtSide: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M7 6h10"/><path d="M11 10h2"/></svg>`,
            shoePair: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17h18a2 2 0 0 0 2-2v-1c0-2-2-4-5-4l-4-2-3 1c-2 1-3 2.5-3 5v1a2 2 0 0 0 2 2z"/><path d="M5 21h17a1 1 0 0 0 1-1v-1c0-1.5-1.5-3-4-3l-4-1.5-3 .8c-1.5.8-2.5 2-2.5 4v.7"/><circle cx="10" cy="13" r="1"/></svg>`,
            shoeSide: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17h20v1.5a1.5 1.5 0 0 1-1.5 1.5H3.5A1.5 1.5 0 0 1 2 18.5V17z"/><path d="M2 17c0-3 1.5-5.5 4-6.5l6-3 5 2.5c2.5 1.5 3 4 3 7"/><path d="M9 14h5"/></svg>`,
            shoeSole: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="5" ry="9"/><path d="M12 5v14"/><path d="M8 9h8"/><path d="M8 15h8"/></svg>`
        };

        function setStudioProtocol(protocol) {
            currentStudioProtocol = protocol;
            const badge = document.getElementById('studioProtocolBadge');
            const tab1 = document.getElementById('tab1Title');
            const tab2 = document.getElementById('tab2Title');
            const tab3 = document.getElementById('tab3Title');

            if (protocol === 'footwear') {
                badge.textContent = 'GIÀY DÉP (2 ĐÔI & 1 BÊN)';
                badge.style.background = '#854D0E';
                tab1.textContent = '2 Đôi Nghệ Thuật *';
                tab2.textContent = 'Nghiêng 1 Bên';
                tab3.textContent = 'Đế & Chi tiết';

                document.getElementById('ghostIcon1').innerHTML = ghostSvg.shoePair;
                document.getElementById('slot1TitleText').textContent = 'Ảnh 2 Đôi Xếp Nghệ Thuật (Hero)';
                document.getElementById('slot1DescText').textContent = '2 chiếc xếp chéo góc 45° chuẩn ảnh bìa tạp chí Showroom';

                document.getElementById('ghostIcon2').innerHTML = ghostSvg.shoeSide;
                document.getElementById('slot2TitleText').textContent = 'Ảnh Nghiêng 1 Bên (Lateral Side)';
                document.getElementById('slot2DescText').textContent = 'Ảnh chụp góc ngang cạnh ngoài, thấy rõ phom dáng đế & thân';

                document.getElementById('ghostIcon3').innerHTML = ghostSvg.shoeSole;
                document.getElementById('slot3TitleText').textContent = 'Ảnh Cận Cảnh / Mặt Đế Giày';
                document.getElementById('slot3DescText').textContent = 'Góc nhìn từ trên xuống hoặc bề mặt đế giày sắc nét';
            } else {
                badge.textContent = 'ÁO / QUẦN (3 GÓC)';
                badge.style.background = '#18181B';
                tab1.textContent = 'Mặt trước *';
                tab2.textContent = 'Mặt sau';
                tab3.textContent = 'Bên hông';

                document.getElementById('ghostIcon1').innerHTML = ghostSvg.shirtFront;
                document.getElementById('slot1TitleText').textContent = 'Ảnh Mặt Trước (Front Hero)';
                document.getElementById('slot1DescText').textContent = 'Chụp phẳng phiu nhìn thẳng, thấy trọn vẹn phom dáng';

                document.getElementById('ghostIcon2').innerHTML = ghostSvg.shirtBack;
                document.getElementById('slot2TitleText').textContent = 'Ảnh Mặt Sau (Back View)';
                document.getElementById('slot2DescText').textContent = 'Chụp lưng áo/quần hoặc góc xoay 180°';

                document.getElementById('ghostIcon3').innerHTML = ghostSvg.shirtSide;
                document.getElementById('slot3TitleText').textContent = 'Ảnh Bên Hông (Side Profile)';
                document.getElementById('slot3DescText').textContent = 'Góc nhìn sườn áo hoặc chi tiết đường kim mũi chỉ';
            }
        }

        function switchSlot(slotNum) {
            activeSlot = slotNum;
            document.querySelectorAll('.slot-tab-btn').forEach(btn => {
                btn.classList.toggle('active', parseInt(btn.dataset.slot, 10) === slotNum);
            });
            document.querySelectorAll('.slot-pane').forEach((pane, idx) => {
                pane.classList.toggle('d-none', (idx + 1) !== slotNum);
            });
        }

        function triggerSlotUpload(slot) {
            const input = document.getElementById(`inputSlot${slot}`);
            input?.click();
        }

        function selectBackdrop(type) {
            currentBackdrop = type;
            document.getElementById('studioBackdropInput').value = type;
            document.querySelectorAll('.backdrop-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.backdrop === type);
            });
            [1, 2, 3].forEach(slot => {
                if (originalDataUrls[slot]) {
                    applyStudioBackdropToImg(slot);
                }
            });
        }

        function applyStudioBackdropToImg(slot) {
            const img = document.getElementById(`previewImg${slot}`);
            if (!img) return;
            if (currentBackdrop === 'atelier') {
                img.style.background = 'linear-gradient(180deg, #FAF8F5 0%, #F3EDE2 100%)';
                img.style.filter = 'drop-shadow(0 14px 18px rgba(40, 30, 20, 0.12))';
            } else if (currentBackdrop === 'white') {
                img.style.background = '#FFFFFF';
                img.style.filter = 'drop-shadow(0 10px 14px rgba(0, 0, 0, 0.08))';
            } else {
                img.style.background = 'repeating-conic-gradient(#E2E8F0 0% 25%, #FFFFFF 0% 50%) 50%/12px 12px';
                img.style.filter = 'none';
            }
        }

        function handleSlotFileSelect(slot, input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (file.size > 5 * 1024 * 1024) {
                    alert('Ảnh không được vượt quá 5MB.');
                    input.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    originalDataUrls[slot] = e.target.result;
                    const img = document.getElementById(`previewImg${slot}`);
                    img.src = e.target.result;
                    document.getElementById(`placeholder${slot}`).classList.add('d-none');
                    document.getElementById(`previewContainer${slot}`).classList.remove('d-none');
                    document.getElementById(`btnMagic${slot}`).disabled = false;
                    document.getElementById(`btnReset${slot}`).disabled = false;
                    applyStudioBackdropToImg(slot);
                    updateStudioProgress();
                };
                reader.readAsDataURL(file);
            }
        }

        function resetSlotImage(slot) {
            if (originalDataUrls[slot]) {
                const img = document.getElementById(`previewImg${slot}`);
                img.src = originalDataUrls[slot];
                applyStudioBackdropToImg(slot);
            }
        }

        function removeSlotImage(slot, e) {
            e.stopPropagation();
            const input = document.getElementById(`inputSlot${slot}`);
            if (input) input.value = '';
            originalDataUrls[slot] = null;
            const img = document.getElementById(`previewImg${slot}`);
            if (img) img.src = '#';
            document.getElementById(`previewContainer${slot}`).classList.add('d-none');
            document.getElementById(`placeholder${slot}`).classList.remove('d-none');
            document.getElementById(`btnMagic${slot}`).disabled = true;
            document.getElementById(`btnReset${slot}`).disabled = true;
            updateStudioProgress();
        }

        function updateStudioProgress() {
            let count = 0;
            [1, 2, 3].forEach(s => {
                if (originalDataUrls[s]) count++;
            });
            const lbl = document.getElementById('studioProgressText');
            if (lbl) {
                lbl.textContent = `${count}/3 ảnh đã tải`;
                lbl.style.color = count > 0 ? '#16A34A' : 'var(--adm-ink)';
            }
        }

        // SMART CLIENT-SIDE STUDIO CANVASES (BACKGROUND REMOVAL & CONTACT SHADOW)
        function processMagicBackdrop(slot) {
            const src = originalDataUrls[slot];
            if (!src) return;

            const btn = document.getElementById(`btnMagic${slot}`);
            const originalBtnHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';
            btn.disabled = true;

            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = img.naturalWidth || 800;
                canvas.height = img.naturalHeight || 800;
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const d = imgData.data;

                // Sample corner pixels
                const samples = [
                    0, 1, 2, // top-left
                    (canvas.width - 1) * 4,
                    ((canvas.height - 1) * canvas.width) * 4,
                    ((canvas.height - 1) * canvas.width + (canvas.width - 1)) * 4
                ];
                let bgR = 0, bgG = 0, bgB = 0;
                samples.forEach(idx => {
                    bgR += d[idx];
                    bgG += d[idx + 1];
                    bgB += d[idx + 2];
                });
                bgR /= 4; bgG /= 4; bgB /= 4;

                const tol = 38;
                for (let i = 0; i < d.length; i += 4) {
                    const dist = Math.sqrt((d[i] - bgR)**2 + (d[i+1] - bgG)**2 + (d[i+2] - bgB)**2);
                    if (dist < tol) {
                        d[i + 3] = 0;
                    } else if (dist < tol + 16) {
                        d[i + 3] = Math.round(((dist - tol) / 16) * 255);
                    }
                }
                ctx.putImageData(imgData, 0, 0);

                // Build Final Composite Studio
                const sCanvas = document.createElement('canvas');
                const sCtx = sCanvas.getContext('2d');
                sCanvas.width = canvas.width;
                sCanvas.height = canvas.height;

                if (currentBackdrop === 'atelier') {
                    const g = sCtx.createRadialGradient(
                        sCanvas.width / 2, sCanvas.height * 0.45, 40,
                        sCanvas.width / 2, sCanvas.height / 2, sCanvas.width * 0.75
                    );
                    g.addColorStop(0, '#FAF8F5');
                    g.addColorStop(0.7, '#F3EDE2');
                    g.addColorStop(1, '#EFE8DE');
                    sCtx.fillStyle = g;
                    sCtx.fillRect(0, 0, sCanvas.width, sCanvas.height);

                    // Contact shadow ellipse
                    sCtx.save();
                    sCtx.scale(1, 0.22);
                    const sGrad = sCtx.createRadialGradient(
                        sCanvas.width / 2, (sCanvas.height * 0.88) / 0.22, 10,
                        sCanvas.width / 2, (sCanvas.height * 0.88) / 0.22, sCanvas.width * 0.38
                    );
                    sGrad.addColorStop(0, 'rgba(40, 30, 20, 0.25)');
                    sGrad.addColorStop(0.5, 'rgba(50, 40, 30, 0.08)');
                    sGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                    sCtx.fillStyle = sGrad;
                    sCtx.beginPath();
                    sCtx.arc(sCanvas.width / 2, (sCanvas.height * 0.88) / 0.22, sCanvas.width * 0.38, 0, Math.PI * 2);
                    sCtx.fill();
                    sCtx.restore();

                    // Soft ambient drop-shadow
                    sCtx.shadowColor = 'rgba(30, 20, 15, 0.12)';
                    sCtx.shadowBlur = 20;
                    sCtx.shadowOffsetY = 10;
                    sCtx.drawImage(canvas, 0, 0);
                } else if (currentBackdrop === 'white') {
                    sCtx.fillStyle = '#FFFFFF';
                    sCtx.fillRect(0, 0, sCanvas.width, sCanvas.height);
                    sCtx.shadowColor = 'rgba(0, 0, 0, 0.08)';
                    sCtx.shadowBlur = 18;
                    sCtx.shadowOffsetY = 8;
                    sCtx.drawImage(canvas, 0, 0);
                } else {
                    sCtx.drawImage(canvas, 0, 0);
                }

                sCanvas.toBlob(blob => {
                    const processedUrl = sCanvas.toDataURL('image/png');
                    const preview = document.getElementById(`previewImg${slot}`);
                    preview.src = processedUrl;
                    applyStudioBackdropToImg(slot);

                    // Re-assign to file input using DataTransfer
                    const fileInput = document.getElementById(`inputSlot${slot}`);
                    const file = new File([blob], `studio-slot-${slot}.png`, { type: 'image/png' });
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    fileInput.files = dt.files;

                    btn.innerHTML = '<i class="bi bi-check2"></i> Đã chuẩn hóa';
                    setTimeout(() => {
                        btn.innerHTML = originalBtnHtml;
                        btn.disabled = false;
                    }, 1500);
                }, 'image/png');
            };
            img.src = src;
        }

        // DRAG AND DROP SETUP FOR ALL 3 SLOTS
        [1, 2, 3].forEach(slot => {
            const dz = document.getElementById(`dropZone${slot}`);
            const input = document.getElementById(`inputSlot${slot}`);
            if (!dz || !input) return;

            ['dragenter', 'dragover'].forEach(evt => {
                dz.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dz.classList.add('dragover');
                });
            });
            ['dragleave', 'drop'].forEach(evt => {
                dz.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dz.classList.remove('dragover');
                });
            });
            dz.addEventListener('drop', (e) => {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    input.files = files;
                    handleSlotFileSelect(slot, input);
                }
            });
        });

        // CATEGORY CHANGE LISTENER TO AUTOMATICALLY SWITCH STUDIO PROTOCOL
        const categorySelect = document.getElementById('productCategory');
        categorySelect?.addEventListener('change', () => {
            const opt = categorySelect.options[categorySelect.selectedIndex];
            const catName = opt ? opt.text.toLowerCase() : '';
            const isShoe = catName.includes('giày') || catName.includes('shoe') || catName.includes('sandal') || catName.includes('boot');
            setStudioProtocol(isShoe ? 'footwear' : 'apparel');
        });

        // Initialize Studio with default category state
        setStudioProtocol('apparel');
    </script>
}
