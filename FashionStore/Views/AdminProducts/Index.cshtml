@model List<FashionStore.Models.Entities.Product>

@{
    ViewData["Title"] = "Showroom Sản phẩm";
    var keyword = ViewBag.Keyword as string;
    bool? isActive = ViewBag.IsActive as bool?;
    int? categoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as List<FashionStore.Models.Entities.Category> ?? new List<FashionStore.Models.Entities.Category>();
    var activeCategory = categories.FirstOrDefault(c => c.Id == categoryId);
}

<!-- HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.28em; color: var(--adm-gold); text-transform: uppercase;">
                ATELIER SHOWROOM CATALOGUE
            </span>
            <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--adm-gold);"></span>
            <span class="text-muted small">@Model.Count SẢN PHẨM</span>
        </div>
        <h2 class="fw-bold mb-0 adm-heading" style="letter-spacing: -0.02em;">Quản lý Sản phẩm & Biến thể</h2>
    </div>

    <div class="d-flex align-items-center gap-3">
        <!-- VIEW MODE SWITCHER WITH ARIA-PRESSED -->
        <div class="adm-view-switcher" role="group" aria-label="Chế độ hiển thị sản phẩm">
            <button type="button" class="adm-view-btn active" id="admBtnViewGrid" title="Xem dạng Lưới ảnh" aria-pressed="true">
                <i class="bi bi-grid-fill"></i>
                <span class="d-none d-sm-inline">Lưới ảnh</span>
            </button>
            <button type="button" class="adm-view-btn" id="admBtnViewTable" title="Xem dạng Bảng dữ liệu" aria-pressed="false">
                <i class="bi bi-list-ul"></i>
                <span class="d-none d-sm-inline">Bảng chi tiết</span>
            </button>
        </div>

        <a asp-action="Create" class="adm-btn-atelier">
            <i class="bi bi-plus-lg"></i>
            <span>Thêm sản phẩm</span>
        </a>
    </div>
</div>

<!-- FILTER BAR -->
<div class="adm-filter-bar mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background: var(--adm-surface); border-color: var(--adm-border); color: var(--adm-ink-muted);">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="keyword" value="@keyword"
                       class="form-control adm-input-dark border-start-0" 
                       placeholder="Tìm kiếm theo tên sản phẩm, slug..." />
            </div>
        </div>

        <div class="col-md-3">
            <select name="categoryId" class="form-select adm-input-dark">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select name="isActive" class="form-select adm-input-dark">
                <option value="">Tất cả trạng thái hiển thị</option>
                <option value="true" selected="@(isActive == true)">Đang hiển thị trên Shop</option>
                <option value="false" selected="@(isActive == false)">Đã ẩn tạm thời</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn adm-btn-atelier py-2 px-3 flex-grow-1 justify-content-center">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            <a asp-action="Index" class="btn adm-btn-outline py-2 px-3" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- ACTIVE CATEGORY FILTER BADGE (ALLOWS INDEPENDENT CLEARING) -->
@if (activeCategory != null)
{
    <div class="d-flex align-items-center gap-2 mb-4 p-2 px-3 rounded-2" style="background: rgba(179, 136, 47, 0.1); border: 1px solid var(--adm-border-glow); width: fit-content;">
        <i class="bi bi-tag-fill" style="color: var(--adm-gold);"></i>
        <span class="small text-muted">Đang lọc theo danh mục:</span>
        <strong class="adm-heading small">@activeCategory.Name</strong>
        <a asp-action="Index" asp-route-keyword="@keyword" asp-route-isActive="@isActive"
           class="btn btn-sm btn-outline-secondary p-0 px-2 ms-2 text-decoration-none" style="font-size: 0.75rem;" title="Xóa riêng bộ lọc danh mục này">
            <i class="bi bi-x-lg me-1"></i> Xóa lọc
        </a>
    </div>
}

@if (!Model.Any())
{
    <div class="adm-card text-center py-5">
        <i class="bi bi-box-seam fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold adm-heading">Chưa có sản phẩm phù hợp</h5>
        <p class="text-muted small">Thử thay đổi điều kiện lọc hoặc xóa bộ lọc danh mục để hiển thị đầy đủ sản phẩm.</p>
        <div class="d-flex justify-content-center gap-2 mt-2">
            @if (activeCategory != null)
            {
                <a asp-action="Index" asp-route-keyword="@keyword" asp-route-isActive="@isActive" class="btn adm-btn-outline">
                    Xóa lọc danh mục "@activeCategory.Name"
                </a>
            }
            <a asp-action="Create" class="btn adm-btn-atelier">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm ngay
            </a>
        </div>
    </div>
}
else
{
    <!-- 1. GRID VIEW MODE (Showroom Product Cards) -->
    <div id="admViewGrid" class="adm-products-grid mb-4">
        @foreach (var product in Model)
        {
            var variants = product.Variants?.ToList() ?? new List<FashionStore.Models.Entities.ProductVariant>();
            var totalStock = variants.Sum(v => v.StockQuantity);
            var isLowStock = totalStock <= 5 && totalStock > 0;
            var isOutOfStock = totalStock == 0 && variants.Any();

            <div class="adm-product-card-wrap">
                <div class="adm-product-card-3d">
                    <!-- IMAGE WITH TAGS -->
                    <div class="adm-img-box">
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             loading="lazy"
                             onerror="this.src='/images/placeholder-product.png'" />

                        <div class="position-absolute top-0 start-0 m-2">
                            <span class="badge" style="background: rgba(0, 0, 0, 0.65); backdrop-filter: blur(8px); color: #fff; font-size: 0.72rem; border: 1px solid rgba(255,255,255,0.15);">
                                @(product.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </div>

                        <div class="position-absolute top-0 end-0 m-2">
                            @if (product.IsActive)
                            {
                                <span class="adm-pill adm-pill-emerald shadow-sm">Hiển thị</span>
                            }
                            else
                            {
                                <span class="adm-pill adm-pill-faint shadow-sm">Đã ẩn</span>
                            }
                        </div>
                    </div>

                    <!-- INFO: FAST-SCANNING LAYOUT -->
                    <div class="adm-product-info">
                        <div>
                            <h5 class="adm-heading fw-bold mb-1 text-truncate" title="@product.Name" style="font-size: 0.98rem;">
                                @product.Name
                            </h5>
                            <div class="text-muted font-monospace small mb-2" style="font-size: 0.72rem;">
                                @product.Slug
                            </div>

                            <!-- PRICE & STOCK ROW (EASY SCANNING) -->
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2 mb-3" style="background: var(--adm-surface-hover); border: 1px solid var(--adm-border);">
                                <div>
                                    <div class="text-muted" style="font-size: 0.68rem; text-transform: uppercase;">Giá bán</div>
                                    <div class="fw-bold" style="color: var(--adm-gold); font-size: 1.05rem;">
                                        @product.Price.ToString("N0") ₫
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="text-muted" style="font-size: 0.68rem; text-transform: uppercase;">Tồn kho</div>
                                    @if (!variants.Any())
                                    {
                                        <span class="text-muted small" style="font-size: 0.75rem;">Chưa có size</span>
                                    }
                                    else if (isOutOfStock)
                                    {
                                        <span class="badge bg-danger bg-opacity-75 text-white">Hết hàng</span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">Còn @totalStock cái</span>
                                    }
                                    else
                                    {
                                        <span class="adm-heading fw-bold font-monospace" style="font-size: 0.95rem;">@totalStock cái</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ACTIONS ROW: VARIANTS BUTTON PROMINENT -->
                        <div class="pt-2 border-top border-secondary border-opacity-10 d-flex justify-content-between align-items-center gap-2">
                            <a asp-controller="AdminProductVariants" asp-action="Index" asp-route-productId="@product.Id"
                               class="btn btn-sm adm-btn-outline flex-grow-1 py-1" style="font-size: 0.78rem;" title="Quản lý size, màu, tồn kho">
                                <i class="bi bi-layers me-1 text-warning"></i> Biến thể (@variants.Count)
                            </a>

                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem;" title="Chỉnh sửa sản phẩm">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.78rem;" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 2. TABLE VIEW MODE -->
    <div id="admViewTable" class="adm-card d-none mb-4 p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="adm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">SẢN PHẨM</th>
                        <th>DANH MỤC</th>
                        <th>GIÁ BÁN</th>
                        <th>BIẾN THỂ / TỒN KHO</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        var variants = product.Variants?.ToList() ?? new List<FashionStore.Models.Entities.ProductVariant>();
                        var totalStock = variants.Sum(v => v.StockQuantity);

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         style="width: 50px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--adm-border);"
                                         onerror="this.src='/images/placeholder-product.png'" />
                                    <div>
                                        <div class="fw-bold adm-heading">@product.Name</div>
                                        <div class="text-muted font-monospace" style="font-size: 0.72rem;">@product.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--adm-surface-hover); color: var(--adm-ink); border: 1px solid var(--adm-border);">
                                    @(product.Category?.Name ?? "Chưa phân loại")
                                </span>
                            </td>
                            <td class="fw-bold" style="color: var(--adm-gold);">
                                @product.Price.ToString("N0") ₫
                            </td>
                            <td>
                                <div><strong class="adm-text-contrast">@variants.Count</strong> phân loại</div>
                                <div class="text-muted small">Tổng tồn: <span class="fw-semibold">@totalStock</span></div>
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="adm-pill adm-pill-emerald">Đang bán</span>
                                }
                                else
                                {
                                    <span class="adm-pill adm-pill-faint">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="AdminProductVariants" asp-action="Index" asp-route-productId="@product.Id"
                                       class="btn btn-sm adm-btn-outline py-1 px-2" style="font-size: 0.75rem;" title="Quản lý biến thể">
                                        <i class="bi bi-layers text-warning"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.75rem;" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.75rem;" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
