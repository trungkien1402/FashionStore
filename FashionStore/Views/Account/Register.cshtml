@model FashionStore.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="fs-auth-page">
    <div class="fs-auth-image"
         style="background-image: url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1200&q=85')">
        <div class="fs-auth-image-content">
            <p class="text-uppercase small mb-3"
               style="letter-spacing: 3px;">Your Style, Your Story</p>
            <h2>Discover a style that belongs to you.</h2>
            <p class="mt-3 mb-0">
                Bắt đầu hành trình thời trang của riêng bạn.
            </p>
        </div>
    </div>

    <div class="fs-auth-panel">
        <div class="fs-auth-form">
            <p class="text-uppercase small fw-bold mb-3"
               style="letter-spacing: 2px; color: #a17c55;">
                Join FashionStore
            </p>

            <h1>Tạo tài khoản</h1>
            <p class="fs-auth-subtitle">
                Đăng ký thành viên để khám phá những bộ sưu tập mới nhất.
            </p>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="fs-alert"></div>

                <div class="fs-auth-field">
                    <label asp-for="FullName" class="fs-form-label"></label>
                    <input asp-for="FullName"
                           class="fs-form-control"
                           placeholder="Nguyễn Văn A"
                           autocomplete="name" />
                    <span asp-validation-for="FullName"
                          class="fs-validation"></span>
                </div>

                <div class="fs-auth-field">
                    <label asp-for="Email" class="fs-form-label"></label>
                    <input asp-for="Email"
                           class="fs-form-control"
                           placeholder="name@example.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email"
                          class="fs-validation"></span>
                </div>

                <div class="fs-auth-field">
                    <label asp-for="PhoneNumber" class="fs-form-label"></label>
                    <input asp-for="PhoneNumber"
                           class="fs-form-control"
                           placeholder="Nhập số điện thoại"
                           autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"
                          class="fs-validation"></span>
                </div>

                <div class="fs-auth-field">
                    <label asp-for="Password" class="fs-form-label"></label>
                    <input asp-for="Password"
                           class="fs-form-control"
                           placeholder="Ít nhất 6 ký tự"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password"
                          class="fs-validation"></span>
                </div>

                <div class="fs-auth-field">
                    <label asp-for="ConfirmPassword"
                           class="fs-form-label"></label>
                    <input asp-for="ConfirmPassword"
                           class="fs-form-control"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="fs-validation"></span>
                </div>

                <button type="submit" class="fs-btn w-100">
                    Tạo tài khoản
                </button>
            </form>

            <div class="fs-auth-bottom">
                Bạn đã có tài khoản?
                <a asp-controller="Account" asp-action="Login">
                    Đăng nhập
                </a>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index"
                   class="small text-muted">
                    ← Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
