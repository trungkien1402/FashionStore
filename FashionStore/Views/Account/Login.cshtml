@model FashionStore.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng Nhập — HNMTSHOP";
}

@section Styles {
    <link rel="stylesheet" href="~/css/atelier-login.css" asp-append-version="true" />
}

<div class="at-login-page" id="atLoginPage">

    <!-- Minimalist Top Navigation -->
    <header class="at-topbar">
        <a asp-controller="Home" asp-action="Index" class="at-brand-link" title="Về trang chủ HNMTSHOP">
            <span class="at-brand-text">HNMTSHOP</span>
        </a>

        <div class="at-top-actions">
            <a asp-controller="Home" asp-action="Index" class="at-top-back" title="Quay lại mua sắm">
                <i class="bi bi-arrow-left"></i>
                <span>Trang Chủ</span>
            </a>
            <a asp-controller="Account" asp-action="Register" class="at-top-action-btn">
                <span>Đăng Ký</span>
            </a>
        </div>
    </header>

    <!-- Centered Minimalist Form Card -->
    <main class="at-form-container">
        <div class="at-login-card">
            
            <div class="at-card-kicker">
                <span>TÀI KHOẢN THÀNH VIÊN</span>
            </div>

            <h1 class="at-card-title">Đăng Nhập</h1>
            <p class="at-card-desc">
                Chào mừng bạn trở lại. Vui lòng nhập thông tin để tiếp tục trải nghiệm không gian thời trang HNMT.
            </p>

            <!-- Social OAuth -->
            <div class="at-social-grid">
                <button type="button" class="at-btn-social" id="btnGoogleLogin" title="Đăng nhập với Google">
                    <svg viewBox="0 0 24 24" width="16" height="16">
                        <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                        <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                        <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.8s.2-2.1.4-2.8L1.9 6.3C.7 8.7 0 10.3 0 12s.7 3.3 1.9 5.7l3.7-2.9z"/>
                        <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 16.4C3.7 20.4 7.5 23 12 23z"/>
                    </svg>
                    <span>Google</span>
                </button>

                <button type="button" class="at-btn-social" id="btnAppleLogin" title="Đăng nhập với Apple ID">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.63-.77 1.06-1.84.94-2.91-.91.04-2.02.61-2.67 1.38-.58.68-1.09 1.77-.95 2.81 1.02.08 2.05-.51 2.68-1.28z"/>
                    </svg>
                    <span>Apple ID</span>
                </button>
            </div>

            <!-- Subtle Divider -->
            <div class="at-divider">
                <span>hoặc tiếp tục với email</span>
            </div>

            <!-- Form -->
            <form asp-action="Login" method="post" class="at-form" id="atLoginForm" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <!-- Server-Side Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="at-alert-danger" role="alert"></div>

                <!-- Email Field -->
                <div class="hnmt-pure-input-wrap">
                    <input asp-for="Email" 
                           class="hnmt-pure-input" 
                           placeholder="Email" 
                           autocomplete="email" 
                           required />
                </div>
                <span asp-validation-for="Email" class="at-input-error"></span>

                <!-- Password Field with Accessible Toggle -->
                <div class="hnmt-pure-input-wrap">
                    <input asp-for="Password" 
                           id="atPasswordInput"
                           type="password" 
                           class="hnmt-pure-input" 
                           placeholder="Password" 
                           autocomplete="current-password" 
                           required />
                    <button type="button" 
                            id="atTogglePassword" 
                            class="hnmt-pure-eye-btn"
                            aria-label="Hiện mật khẩu" 
                            aria-pressed="false"
                            title="Hiện hoặc ẩn mật khẩu">
                        <i class="bi bi-eye" id="atToggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="at-input-error"></span>

                <!-- Remember Me & Forgot Password -->
                <div class="at-options-row">
                    <label class="at-checkbox-label" for="atRememberMe">
                        <input asp-for="RememberMe" id="atRememberMe" class="at-checkbox-input" type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <button type="button" class="at-forgot-btn" id="btnOpenAtForgotModal">Quên mật khẩu?</button>
                </div>

                <!-- Primary Submit Button -->
                <button type="submit" class="hnmt-pure-submit-btn" id="atSubmitBtn">
                    Đăng nhập
                </button>
            </form>

            <!-- Bottom Register Link -->
            <div class="at-card-footer">
                <span>Bạn chưa có tài khoản?</span>
                <a asp-controller="Account" asp-action="Register" class="at-footer-link">
                    Đăng ký ngay &rarr;
                </a>
            </div>

            <!-- Security Footnote -->
            <div class="at-security-note">
                <i class="bi bi-shield-check"></i>
                <span>Bảo mật dữ liệu chuẩn mã hóa SSL</span>
            </div>

        </div>
    </main>

    <!-- Interactive Forgot Password Modal in Contemporary Clean White -->
    <div class="at-modal-backdrop" id="atForgotModal" role="dialog" aria-modal="true" aria-labelledby="atForgotTitle">
        <div class="at-modal-box">
            <button type="button" class="at-modal-close" id="btnCloseAtForgotModal" aria-label="Đóng cửa sổ">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="at-card-kicker mb-2">
                <span>KHÔI PHỤC TÀI KHOẢN</span>
            </div>
            <h3 class="at-card-title" id="atForgotTitle" style="font-size: 1.6rem;">Quên Mật Khẩu</h3>
            <p class="at-card-desc">
                Nhập email đã đăng ký của bạn. Chúng tôi sẽ gửi liên kết bảo mật để thiết lập mật khẩu mới.
            </p>

            <form id="atForgotForm" onsubmit="handleAtForgotSubmit(event)">
                <div class="at-input-group mb-3">
                    <label class="at-input-label">Địa chỉ Email</label>
                    <div class="at-input-box">
                        <i class="bi bi-envelope at-input-icon"></i>
                        <input type="email" id="atForgotEmailInput" class="at-input-field" placeholder="ten@vidu.vn" required />
                    </div>
                </div>

                <div id="atForgotAlert" style="display: none; padding: 12px 14px; border-radius: 12px; font-size: 0.84rem; margin-bottom: 16px;"></div>

                <button type="submit" class="at-btn-submit" id="btnAtSendForgot">
                    <span>Gửi Hướng Dẫn Khôi Phục</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Accessible Show/Hide Password Toggle
            const toggleBtn = document.getElementById("atTogglePassword");
            const passwordInput = document.getElementById("atPasswordInput");
            const toggleIcon = document.getElementById("atToggleIcon");

            if (toggleBtn && passwordInput && toggleIcon) {
                function togglePassword() {
                    const isPass = passwordInput.getAttribute("type") === "password";
                    if (isPass) {
                        passwordInput.setAttribute("type", "text");
                        toggleBtn.setAttribute("aria-label", "Ẩn mật khẩu");
                        toggleBtn.setAttribute("aria-pressed", "true");
                        toggleIcon.className = "bi bi-eye-slash";
                    } else {
                        passwordInput.setAttribute("type", "password");
                        toggleBtn.setAttribute("aria-label", "Hiện mật khẩu");
                        toggleBtn.setAttribute("aria-pressed", "false");
                        toggleIcon.className = "bi bi-eye";
                    }
                }

                toggleBtn.addEventListener("click", togglePassword);
                toggleBtn.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        togglePassword();
                    }
                });
            }

            // 2. Interactive Forgot Password Modal Controls
            const modal = document.getElementById("atForgotModal");
            const openBtn = document.getElementById("btnOpenAtForgotModal");
            const closeBtn = document.getElementById("btnCloseAtForgotModal");

            if (modal && openBtn && closeBtn) {
                openBtn.addEventListener("click", function () {
                    modal.classList.add("is-active");
                    const input = document.getElementById("atForgotEmailInput");
                    const loginEmail = document.querySelector('input[name="Email"]');
                    if (loginEmail && loginEmail.value) {
                        input.value = loginEmail.value;
                    }
                    setTimeout(() => input?.focus(), 100);
                });

                closeBtn.addEventListener("click", function () {
                    modal.classList.remove("is-active");
                });

                modal.addEventListener("click", function (e) {
                    if (e.target === modal) {
                        modal.classList.remove("is-active");
                    }
                });

                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && modal.classList.contains("is-active")) {
                        modal.classList.remove("is-active");
                    }
                });
            }

            // 3. Simulated Social Login click feedback
            ["btnGoogleLogin", "btnAppleLogin"].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener("click", function() {
                        const provider = id.includes("Google") ? "Google" : "Apple";
                        alert(`[HNMTSHOP] Đang kết nối tài khoản ${provider}... (Tính năng OAuth đang ở chế độ thử nghiệm).`);
                    });
                }
            });
        });

        // Forgot password simulated handler
        function handleAtForgotSubmit(e) {
            e.preventDefault();
            const email = document.getElementById("atForgotEmailInput")?.value;
            const alertBox = document.getElementById("atForgotAlert");
            const btn = document.getElementById("btnAtSendForgot");

            if (!email || !alertBox) return;

            btn.disabled = true;
            btn.textContent = "Đang gửi...";

            setTimeout(() => {
                alertBox.style.display = "block";
                alertBox.style.background = "#f0fdf4";
                alertBox.style.border = "1px solid #bbf7d0";
                alertBox.style.color = "#15803d";
                alertBox.innerHTML = `Hướng dẫn khôi phục đã được gửi tới <strong>${email}</strong>. Vui lòng kiểm tra hộp thư của bạn!`;
                btn.disabled = false;
                btn.textContent = "Đã gửi thành công";
            }, 700);
        }
    </script>
}
