@model List<FashionStore.Models.Entities.Shipment>
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Đơn hàng cần giao";
    var selectedStatus = ViewBag.SelectedStatus as ShipmentStatus?;

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Mới phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };

    string GetStatusBadgeClass(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "bg-secondary",
        ShipmentStatus.PickedUp => "bg-info text-dark",
        ShipmentStatus.InTransit => "bg-primary",
        ShipmentStatus.Delivered => "bg-success",
        ShipmentStatus.Failed => "bg-danger",
        ShipmentStatus.Returned => "bg-dark",
        _ => "bg-light text-dark"
    };

    var countAssigned = Model.Count(s => s.Status == ShipmentStatus.Assigned);
    var countInTransit = Model.Count(s => s.Status == ShipmentStatus.InTransit || s.Status == ShipmentStatus.PickedUp);
    var countDelivered = Model.Count(s => s.Status == ShipmentStatus.Delivered);
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase">Cổng thông tin Shipper</div>
            <h2 class="fw-bold mb-0">Nhiệm vụ giao hàng của tôi</h2>
            <p class="text-muted mb-0">Xem danh sách các đơn hàng được phân công và cập nhật trạng thái giao hàng.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- THẺ THỐNG KÊ NHANH -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small">Đơn mới phân công</div>
                <div class="fs-3 fw-bold text-secondary">@countAssigned</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small">Đang đi giao</div>
                <div class="fs-3 fw-bold text-primary">@countInTransit</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small">Giao thành công</div>
                <div class="fs-3 fw-bold text-success">@countDelivered</div>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả trạng thái giao --</option>
                        @foreach (ShipmentStatus st in Enum.GetValues(typeof(ShipmentStatus)))
                        {
                            if (selectedStatus == st)
                            {
                                <option value="@((int)st)" selected>@GetShipmentStatusName(st)</option>
                            }
                            else
                            {
                                <option value="@((int)st)">@GetShipmentStatusName(st)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại lọc</a>
                </div>
            </form>
        </div>
    </div>

    <!-- DANH SÁCH ĐƠN HÀNG CỦA SHIPPER -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="py-4">
                <i class="bi bi-bicycle text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Bạn chưa có đơn giao nào</h5>
                <p class="text-muted">Khi người quản lý điều phối đơn cho bạn, các đơn sẽ hiển thị tại đây.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã vận đơn</th>
                            <th>Mã đơn</th>
                            <th>Người nhận</th>
                            <th>Địa chỉ giao hàng</th>
                            <th>Tiền COD cần thu</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@s.TrackingCode</td>
                                <td><span class="badge bg-light text-dark border">@s.Order?.OrderCode</span></td>
                                <td>
                                    <div class="fw-semibold">@s.Order?.ReceiverName</div>
                                    <a href="tel:@s.Order?.Phone" class="text-decoration-none small text-success fw-bold">
                                        <i class="bi bi-telephone-fill me-1"></i>@s.Order?.Phone
                                    </a>
                                </td>
                                <td>
                                    <div class="text-wrap" style="max-width: 280px;">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@s.Order?.Address
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold @(s.CODAmount > 0 ? "text-danger" : "text-muted")">
                                        @(s.CODAmount > 0 ? s.CODAmount.ToString("N0") + " đ" : "0 đ (Đã thanh toán)")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(s.Status)">
                                        @GetShipmentStatusName(s.Status)
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-dark">
                                        <i class="bi bi-pencil-square me-1"></i>Xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
