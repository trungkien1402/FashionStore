@model FashionStore.Models.Entities.Shipment
@using FashionStore.Models.Enums

@{
    ViewData["Title"] = "Chi tiết vận đơn #" + Model.TrackingCode;

    string GetShipmentStatusName(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "Mới phân công",
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang giao hàng",
        ShipmentStatus.Delivered => "Giao thành công",
        ShipmentStatus.Failed => "Giao thất bại",
        ShipmentStatus.Returned => "Đã hoàn kho",
        _ => status.ToString()
    };

    string GetStatusClass(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Assigned => "pending",
        ShipmentStatus.PickedUp => "confirmed",
        ShipmentStatus.InTransit => "shipping",
        ShipmentStatus.Delivered => "delivered",
        ShipmentStatus.Failed => "failed",
        ShipmentStatus.Returned => "returned",
        _ => "pending"
    };
}

<div class="container-fluid px-3 py-4" style="max-width: 1000px; margin: 0 auto;">
    
    <!-- TOP BAR -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <a asp-action="Index" class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1 mb-1">
                <i class="bi bi-arrow-left"></i> Danh sách vận đơn
            </a>
            <h2 class="fw-bold mb-0 text-dark">
                Vận đơn <span class="font-monospace text-primary">#@Model.TrackingCode</span>
            </h2>
            <div class="text-muted small">Đơn hàng gốc: <strong class="text-dark">@Model.Order?.OrderCode</strong></div>
        </div>

        <span class="fs-badge-status @GetStatusClass(Model.Status)" style="font-size: 14px; padding: 8px 18px;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: currentColor;"></span>
            @GetShipmentStatusName(Model.Status)
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fs-pill-alert success">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="fs-pill-alert error">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="row g-4">
        <!-- LEFT COLUMN: RECEIVER & PACKAGES -->
        <div class="col-lg-7">
            
            <!-- COD AMOUNT HERO CARD -->
            <div class="card border rounded-4 p-4 mb-4 @(Model.CODAmount > 0 ? "border-danger bg-danger-subtle" : "border-success bg-success-subtle")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-bold text-uppercase @(Model.CODAmount > 0 ? "text-danger" : "text-success")">
                            @(Model.CODAmount > 0 ? "Tiền mặt cần thu khi giao (COD)" : "Tình trạng thanh toán")
                        </div>
                        <h2 class="fw-bold mb-0 font-monospace @(Model.CODAmount > 0 ? "text-danger" : "text-success") mt-1">
                            @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + " ₫" : "0 ₫ (ĐÃ THANH TOÁN)")
                        </h2>
                    </div>
                    <i class="bi @(Model.CODAmount > 0 ? "bi-cash-coin text-danger" : "bi-check2-circle text-success")" style="font-size: 2.5rem;"></i>
                </div>
            </div>

            <!-- RECEIVER DOSSIER -->
            <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge text-primary"></i> Thông tin khách hàng
                </h5>

                <div class="mb-3">
                    <div class="text-muted small">Người nhận</div>
                    <div class="fw-bold fs-5 text-dark">@Model.Order?.ReceiverName</div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-3">
                    <div>
                        <div class="text-muted small">Điện thoại liên hệ</div>
                        <div class="fw-bold fs-5 font-monospace text-dark">@Model.Order?.Phone</div>
                    </div>
                    <a href="tel:@Model.Order?.Phone" class="btn btn-success rounded-pill px-3 py-2 fw-bold d-flex align-items-center gap-1">
                        <i class="bi bi-telephone-fill"></i> Gọi ngay
                    </a>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Địa chỉ nhận hàng</div>
                    <div class="p-3 bg-light rounded-3 fw-semibold text-dark mt-1">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Order?.Address
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div>
                        <div class="text-muted small">Lưu ý điều phối</div>
                        <div class="alert alert-warning py-2 px-3 mt-1 small mb-0 rounded-3">
                            <i class="bi bi-info-circle me-1"></i> @Model.Note
                        </div>
                    </div>
                }
            </div>

            <!-- PACKAGED ITEMS -->
            @if (Model.Order?.Items != null)
            {
                <div class="card border rounded-4 p-4 bg-white shadow-sm">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam text-primary"></i> Danh mục trong kiện (@Model.Order.Items.Count)
                    </h5>
                    @foreach (var item in Model.Order.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-bold">@item.ProductName</div>
                                <div class="text-muted small">Size: @item.Size • Màu: @item.Color</div>
                            </div>
                            <span class="badge bg-dark rounded-pill px-3 py-2 font-monospace">x@item.Quantity</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- RIGHT COLUMN: ACTION CONTROLS & TIMELINE -->
        <div class="col-lg-5">
            <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Thao tác Giao Hàng
                </h5>

                @if (Model.Status == ShipmentStatus.Assigned)
                {
                    <div class="alert alert-info small rounded-3 mb-3">
                        <i class="bi bi-info-circle me-1"></i> Đơn mới gán. Hãy xác nhận khi bạn đã nhận kiện từ kho FashionStore.
                    </div>

                    <form asp-action="UpdateStatus" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.PickedUp)" />
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold fs-6">
                            <i class="bi bi-box-arrow-in-down me-1"></i> XÁC NHẬN ĐÃ LẤY HÀNG
                        </button>
                    </form>
                }
                else if (Model.Status == ShipmentStatus.PickedUp)
                {
                    <div class="alert alert-info small rounded-3 mb-3">
                        <i class="bi bi-info-circle me-1"></i> Đã lấy kiện hàng. Bấm bắt đầu đi giao khi bạn đang trên đường đến địa chỉ khách.
                    </div>

                    <form asp-action="UpdateStatus" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.InTransit)" />
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold fs-6">
                            <i class="bi bi-truck me-1"></i> BẮT ĐẦU ĐI GIAO HÀNG
                        </button>
                    </form>
                }
                else if (Model.Status == ShipmentStatus.InTransit)
                {
                    <div class="d-grid gap-2 mb-3">
                        <form asp-action="UpdateStatus" method="post" class="m-0"
                              onsubmit="return confirm('Xác nhận khách đã nhận đủ kiện và thu đủ tiền @(Model.CODAmount > 0 ? Model.CODAmount.ToString("N0") + "đ" : "")?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Delivered)" />
                            <button type="submit" class="btn btn-success w-100 py-3 rounded-3 fw-bold fs-6 shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> GIAO THÀNH CÔNG @(Model.CODAmount > 0 ? "(& ĐÃ THU TIỀN)" : "")
                            </button>
                        </form>

                        <button type="button" class="btn btn-outline-danger w-100 py-2 rounded-3 fw-semibold"
                                data-bs-toggle="collapse" data-bs-target="#failedForm">
                            <i class="bi bi-x-circle me-1"></i> Báo Giao Không Thành Công...
                        </button>
                    </div>

                    <!-- COLLAPSE FORM REPORT FAILURE -->
                    <div class="collapse border p-3 rounded-3 bg-light" id="failedForm">
                        <h6 class="fw-bold text-danger mb-2">Ghi nhận lý do giao thất bại</h6>
                        <form asp-action="UpdateStatus" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Failed)" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Lý do chính xác:</label>
                                <textarea name="note" class="form-control" rows="3" required
                                          placeholder="VD: Thuê bao không liên lạc được, khách hẹn dời sang chiều mai..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold">
                                Xác nhận Giao Thất Bại
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Status == ShipmentStatus.Failed)
                {
                    <div class="alert alert-danger small rounded-3 mb-3">
                        <i class="bi bi-exclamation-octagon me-1"></i> Đơn hàng giao thất bại. Bạn có thể thử liên hệ giao lại hoặc mang trả về kho.
                    </div>

                    <div class="d-grid gap-2">
                        <form asp-action="UpdateStatus" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.InTransit)" />
                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">
                                <i class="bi bi-arrow-repeat me-1"></i> Thử giao lại lần nữa
                            </button>
                        </form>

                        <form asp-action="UpdateStatus" method="post" class="m-0"
                              onsubmit="return confirm('Xác nhận đã mang kiện hàng hoàn trả lại kho FashionStore?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="@((int)ShipmentStatus.Returned)" />
                            <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-bold">
                                <i class="bi bi-arrow-return-left me-1"></i> Đã hoàn trả về kho
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Status == ShipmentStatus.Delivered)
                {
                    <div class="text-center py-4 bg-light rounded-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                        <h6 class="fw-bold mt-2 text-dark">Kiện hàng đã giao thành công</h6>
                        <p class="text-muted small mb-0">Nhiệm vụ hoàn tất xuất sắc.</p>
                    </div>
                }
                else if (Model.Status == ShipmentStatus.Returned)
                {
                    <div class="text-center py-4 bg-light rounded-3">
                        <i class="bi bi-archive-fill text-dark" style="font-size: 3rem;"></i>
                        <h6 class="fw-bold mt-2 text-dark">Đã hoàn hàng về kho</h6>
                        <p class="text-muted small mb-0">Hàng tồn kho đã được khôi phục.</p>
                    </div>
                }
            </div>

            <!-- AUDIT TIMELINE -->
            <div class="card border rounded-4 p-4 bg-white shadow-sm">
                <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-muted"></i> Nhật ký hành trình
                </h6>
                @if (Model.Histories != null && Model.Histories.Any())
                {
                    <div class="small">
                        @foreach (var h in Model.Histories.OrderByDescending(x => x.CreatedAt))
                        {
                            <div class="pb-2 mb-2 border-bottom">
                                <div class="d-flex justify-content-between">
                                    <span class="fs-badge-status @GetStatusClass(h.NewStatus)" style="font-size: 11px; padding: 2px 10px;">
                                        @GetShipmentStatusName(h.NewStatus)
                                    </span>
                                    <span class="text-muted font-monospace" style="font-size: 11px;">
                                        @h.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(h.Note))
                                {
                                    <div class="text-muted mt-1" style="font-size: 12px;">@h.Note</div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small">Chưa có nhật ký ghi nhận.</div>
                }
            </div>
        </div>
    </div>
</div>
